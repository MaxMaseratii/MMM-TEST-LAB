// verdict on NQ | ES | gold | crude (two-period test on each market's own data)
f_vd(int i) =>
    switch i
        0 => "PASS|weak|weak|no edge"
        1 => "PASS|weak|weak|no edge"
        2 => "PASS|PASS · watch|PASS · watch|weak"
        3 => "PASS|weak|PASS · watch|weak"
        4 => "PASS|no edge|no edge|no edge"
        5 => "PASS|weak|PASS · watch|no edge"
        6 => "PASS|weak|PASS · watch|no edge"
        7 => "PASS|PASS · edge|no edge|no edge"
        8 => "PASS|no edge|weak|no edge"
        9 => "PASS|no edge|no edge|no edge"
        10 => "PASS|no edge|PASS · watch|weak"
        11 => "PASS|no edge|no edge|weak"
        12 => "PASS|PASS · watch|weak|no edge"
        13 => "PASS|PASS · watch|no edge|no edge"
        14 => "PASS|PASS · watch|no edge|no edge"
        15 => "PASS|too few trades|no edge|too few trades"
        16 => "PASS|no edge|no edge|too few trades"
        => "PASS|weak|no edge|weak"
f_vdM(int i) =>
    MKT < 0 ? "not tested" : str.split(f_vd(i), "|").get(MKT)

// target of each setup (k) at your exit style · and of each tested strategy (stats index i)
f_prK(int k) =>
    k >= 12 or (NEWR and (k == 2 or k == 9)) ? 0.0 : k == 1 ? 0.75 : k == 6 or k == 7 or k == 11 ? 0.0 : k >= 8 ? 1.0 : 0.5

f_rrK(int k, bool h) =>
    k == 0 or k == 2 or k == 5 or k == 7 ? 6.0 : k == 1 ? (h ? 3.0 : 6.0) : k == 15 or k == 16 ? 5.0 : k == 17 ? 3.0 : 2.0

f_tgK(int k) =>
    float rr = f_rrK(k, PROP)
    "1:" + str.tostring(rr, "#") + " RR" + (PROP and f_prK(k) > 0 ? " · ½ at " + str.tostring(f_prK(k), "#.##") + "R" : PROP ? " · full" : "") + (k == 0 or k == 5 ? " or opp. break" : k == 2 and NEWR ? " or next session open" : k == 8 ? " or gap-open exit" : k == 12 ? (NEWR ? " or 100 candles" : " or block time-out") : k == 13 or k == 14 ? " or 60 4H candles" : k == 15 ? " or 16:59" : k == 16 ? " or 2-candle exit" : k == 17 ? " or 09:30 low exit" : k >= 9 ? " or 60 candles" : "")

f_tgI(int i) =>
    switch i
        0 => "½ at 0.5R → 1:6 RR"
        1 => "½ at 0.75R → 1:3 RR"
        2 => "1:6 RR · full · next session open"
        3 => "½ at 0.5R → 1:2 RR"
        4 => "½ at 0.5R → 1:2 RR"
        5 => "1:6 RR or opp. break"
        6 => "1:2 RR · limit"
        7 => "1:2 RR · market at the block birth"
        8 => "1:6 RR"
        9 => "1:2 RR · gap-open exit"
        10 => "1:2 RR · longs: limit at MP"
        11 => "1:2 RR"
        12 => "1:2 RR (max 1:8)"
        13 => "1:2 RR (max 1:8)"
        14 => "1:2 RR (max 1:3)"
        15 => "1:5 RR · stop 40"
        16 => "1:5 RR · 2-candle exit"
        => "1:3 RR · 09:30 low exit"

// setup k → row of the tested numbers (f_sd)
f_si(int k) =>
    switch k
        7 => 8
        8 => 9
        9 => 10
        10 => 11
        11 => 14
        12 => 7
        13 => 12
        14 => 13
        => k
// strategy code → setup k (-1 = none)
f_ki(string c) =>
    switch c
        "X.M4" => 0
        "C.M3" => 1
        "C.M4" => 2
        "X.M5" => 3
        "C.M5" => 4
        "X.M1" => 5
        "X.M2" => 6
        "C.M1" => 7
        "C.M2" => 8
        "XCS.M1" => 9
        "XCS.M2" => 10
        "XCS.M5" => 11
        "X.M3" => 12
        "XCS.M3" => 13
        "XCS.M4" => 14
        "C.M6" => 15
        "C.M7" => 16
        "C.M8" => 17
        => -1
f_ii(string c) =>
    int k = f_ki(c)
    k < 0 ? -1 : f_si(k)
// this chart's results of setup k: "n|w|sR|…" (from the engine that runs it)
f_stS(int k) =>
    string src = k <= 11 ? sStr : k == 12 ? (tf5 ? s5Str : "") : k == 15 or k == 16 ? (lrChart ? sLStr : "") : s2Str
    array<string> a = str.split(na(src) ? "" : src, ";")
    k < a.size() ? a.get(k) : ""
f_part(int i, int p) =>
    str.split(str.split(f_sd(i), "|").get(p), ",")
f_sg(string v) =>
    str.tonumber(v) > 0 ? "+" + v : v
f_ep(int i) =>
    i <= 4 and not (i == 2 and MKT <= 0)

// money at your size from tested points: W won · L lost · Net
f_wl(float won, float lost) =>
    float w = won * PV1 * UNITS
    float l = lost * PV1 * UNITS
    "W: +" + f_usd(w) + " · L: " + f_usd(-l) + " · Net: " + (w - l >= 0 ? "+" : "") + f_usd(w - l)

// the two exits of an edge, blended: [FULL, ½ OUT] as arrays n,wr,av,pf,t,maxL,maxW,won,lost (size 1 = not tested)
f_ex(int i) =>
    array<string> m = f_part(i, MKT <= 0 ? 2 : 4 + MKT)
    array<string> h = f_part(i, 4)
    array<string> o = array.new<string>()
    if h.size() > 10 and MKT <= 0
        o := array.from(h.get(6), h.get(1), h.get(2), h.get(3), h.get(4), h.get(7), h.get(8), h.get(9), h.get(10))
    array<string> nt = array.from("-")
    m := m.size() >= 9 ? m : nt
    o := o.size() > 0 ? o : nt
    array<string> fu = f_ep(i) ? o : m
    array<string> hf = f_ep(i) ? m : o
    [fu, hf]

color TB_FRM = #3C3C3C
color TB_BRD = #282828
var table LV = na
var table IN = na
if barstate.isfirst
    if lvOn
        LV := table.new(f_pos(lvPos), 2, 24, bgcolor=EL_BG, frame_color=TB_FRM, frame_width=1, border_color=TB_BRD, border_width=1)
        table.merge_cells(LV, 0, 0, 1, 0)
    if tbOn
        IN := table.new(f_pos(tbPos), 3, 11, bgcolor=EL_BG, frame_color=TB_FRM, frame_width=1, border_color=TB_BRD, border_width=1)
        table.merge_cells(IN, 0, 0, 2, 0)
        table.merge_cells(IN, 1, 9, 2, 9)
        table.merge_cells(IN, 0, 10, 2, 10)

// LIVE ─────────────────────────────────────────────────────────────────────
f_lv(int r, string a, string b, color c, string z, string tip = "") =>
    f_cell(LV, 0, r, a, EL_LBL, r % 2 == 0 ? EL_ROW : EL_ALT, text.align_left, z, tip)
    f_cell(LV, 1, r, b, c, r % 2 == 0 ? EL_ROW : EL_ALT, text.align_left, z)
    r + 1

// what a setup is waiting for right now: [pending?, text]
f_pend(int k) =>
    bool   p = false
    string t = ""
    if k <= 6
        p := RDS.get(k)
        t := (k == 0 or k == 5 ? (zSide == 1 ? "▲" : "▼") : k == 6 ? (cSide == 1 ? "▲" : "▼") : "▲") + " Pending" + ((k == 0 or k == 5) and not na(zTrig) ? " · 15m close " + (zSide == 1 ? "above " : "below ") + f_px(zTrig) : (k == 3 or k == 6) and not na(cTrig) ? " · 15m close past " + f_px(cTrig) + " → limit at 75%" : " · all filters line up")
    else if k == 9
        p := xP1D != 0
        t := (xP1D == 1 ? "▲" : "▼") + " Pending · 15m close " + (xP1D == 1 ? "above " : "below ") + f_px(xP1L) + " = P5+ break" + (xP1D == 1 and NEWR ? " → buy limit at MP (75%) of that candle" : "")
    else if k == 10
        p := xP2D != 0
        t := (xP2D == 1 ? "▲" : "▼") + " Pending · 15m close " + (xP2D == 1 ? "above " : "below ") + f_px(xP2L)
    else if k == 11
        p := xAD != 0
        t := (xAD == 1 ? "▲" : "▼") + " Armed · iBlock " + f_px(xAB) + "–" + f_px(xAT) + " touched pre-market · needs a 15m AFs+ · " + str.tostring(xAN) + " candles left"
    else if k == 12
        p := not tf5
        t := "Needs a 1m–5m chart"
    else if k == 13 or k == 14
        p := k == 13 ? x3Dir != 0 : x3Dir == 1
        t := (x3Dir == 1 ? "▲" : "▼") + " 4H filter live · " + str.tostring(x3Left) + " 4H left · wait a 15m pullback BC, then a BuBC"
    else if k == 15 or k == 16
        p := not lrChart or (mdC >= 570 and mdC < 720 and lrT15 == 1)
        t := not lrChart ? "Needs the 1m chart" : "▲ Window open · 15m up · wait a 1m CDL with its T1 at a level" + (lrLast != "" ? " · last: " + lrLast : "")
    else if k == 17
        p := not na(ocTrig)
        t := "▲ 09:30 candle · needs a 15m close above " + f_px(ocTrig) + " at 09:45"
    [p, t]

if barstate.islast and lvOn
    string z = f_sz(tbSz)
    table.clear(LV, 0, 1, 1, 23)
    f_cell(LV, 0, 0, "─ MMM EDGE PRO · " + syminfo.ticker + " · " + str.format_time(time, "EEE HH:mm", NY) + " NY ─" + (tfOk ? "" : " use a 1m–15m chart"), EL_GOLD, EL_BG, text.align_center, z)
    int r = 1
    string wTx = wC == 1 ? "Asia ★ best · to 20:00" : wC == 2 ? "Asia · to 00:00" : wC == 3 ? (skpOn ? "Late Asia · only X.M5 · to 02:00" : "Late Asia · to 02:00") : wC == 4 ? "NY AM · ★ from 10:30" : wC == 5 ? "NY AM ★ best · to 13:30" : mdC < 570 ? "Closed · opens 09:30" : "Closed · opens 18:00"
    r := f_lv(r, "Window", wTx, wC == 1 or wC == 5 ? EL_GOLD : wC == 2 or wC == 4 ? EL_POS : wC == 3 ? EL_WARN : EL_MUTE, z)
    string bTx = "Daily " + f_dir(dBias) + " · 1H " + f_dir(hBias) + " · 15m " + (zSide == 0 ? "—" : (zSide == 1 ? "▲ T" : "▼ T") + str.tostring(zTier)) + (GSRC == 0 ? "" : " · MMPD " + (gH >= 80 ? "XP" : gLw <= 20 ? "XD" : na(gM) ? "—" : str.tostring(gM, "#")))
    r := f_lv(r, "Bias", bTx, dBias == 1 ? c_up : dBias == -1 ? c_dn : EL_LBL, z)
    // the market: what passed here, and what you turned on that the Market Check blocks
    string blk = ""
    for k = 0 to 17
        if f_in(k) and not f_mok(k)
            blk += (blk == "" ? "" : ", ") + f_code(k)
    string mTx = MKT == 0 ? "NQ · all 18 passed" : MKT < 0 ? MKTN + " · not tested: NQ rules and numbers" : MKTN + " · passed here: " + (PASSL == "" ? "none yet" : str.replace_all(PASSL, ",", ", "))
    r := f_lv(r, "Market", mTx + (blk == "" ? "" : " · off here: " + blk), blk == "" ? EL_LBL : EL_WARN, z, "Market Check (④) is " + (mkChk ? "ON: a strategy trades only on a market where it made money in both test periods there." : "OFF: everything you turned on trades.") + " Stop " + str.tostring(FIXPT) + " pts · cost " + str.tostring(COST) + " a trade.")
    // open trades and what they risk together
    int   oN = 0
    float oR = 0.0
    array<int>   lK = array.new<int>(18, 0)
    array<int>   lSd = array.new<int>(18, 0)
    array<float> lE = array.new<float>(18, na)
    array<float> lSp = array.new<float>(18, na)
    array<float> lTg = array.new<float>(18, na)
    for tr in str.split(lAll, ";")
        array<string> f = str.split(tr, "|")
        int k = int(nz(f_num(f, 1), -1))
        if k >= 0 and k <= 17
            int sd = int(f_num(f, 2))
            oN += 1
            oR += math.max(sd * (f_num(f, 4) - f_num(f, 5)), 0.0) * PV1 * (int(f_num(f, 3)) == 3 ? NR : UNITS)
            lK.set(k, int(nz(f_num(f, 3))))
            lSd.set(k, sd)
            lE.set(k, f_num(f, 4))
            lSp.set(k, f_num(f, 5))
            lTg.set(k, f_num(f, 6))
    r := f_lv(r, "Open", oN == 0 ? "Flat" : str.tostring(oN) + " trade" + (oN > 1 ? "s" : "") + " · " + SZTX + " each · −" + f_usd(oR) + " if all stops hit (" + str.tostring(100 * oR / pfDD, "#") + "% of DD)", oN == 0 ? EL_MUTE : oR > pfDD * 0.3 ? EL_NEG : EL_VAL, z)
    // PROP line of the picked strategy: pass rate at your size, days, best size (back-to-back evals on this chart)
    string propTx = ""
    color  propC  = EL_MUTE
    if pfOn
        array<string> sP = str.split(na(PROP ? pHStr : pFStr) ? "" : PROP ? pHStr : pFStr, ";")
        array<string> sims = sP.size() > 0 ? str.split(sP.get(0), "|") : array.new<string>()
        float nSes = sP.size() > 1 ? nz(str.tonumber(sP.get(1))) : 0.0
        if SELK == 12 or SELK == 15 or SELK == 16
            propTx := "not simulated · " + selS + " runs on " + (SELK == 12 ? "5m" : "1m") + " candles"
        else if PROP and UNITS < 2
            propTx := "½ out needs 2+ contracts"
        else
            [p0, f0, d0] = f_pfd(sims, 0)
            float n0  = p0 + f0
            float bPr = -1.0
            float bDy = 1e9
            int   bJ  = -1
            for j = 1 to 12
                [pj, fj, dj] = f_pfd(sims, j)
                if pj + fj >= 3 and pj > 0 and not (PROP and SZU.get(j) < 2)
                    float prj = pj / (pj + fj)
                    if prj > bPr + 1e-9 or (math.abs(prj - bPr) < 1e-9 and dj / pj < bDy)
                        bPr := prj
                        bDy := dj / pj
                        bJ  := j
            propTx := (n0 == 0 ? "no evaluation finished yet" : str.tostring(100 * p0 / n0, "#") + "% passed at " + SZTX + " (" + str.tostring(p0, "#") + " ✔ " + str.tostring(f0, "#") + " ✖)" + (p0 > 0 ? " · ~" + str.tostring(d0 / p0, "#") + " trading days to pass" : "")) + (bJ < 0 ? "" : " · best size " + f_ct(SZU.get(bJ)) + " → " + str.tostring(100 * bPr, "#") + "%") + " · tested on " + str.tostring(nSes, "#") + " trading days"
            propC  := n0 == 0 ? EL_MUTE : p0 / n0 >= 0.6 ? EL_POS : p0 / n0 >= 0.4 ? EL_WARN : EL_NEG
    string propTip = "Back-to-back evaluations of " + selS + " on this chart's history · drawdown " + f_usd(pfDD) + " " + pfTyp + " · DLL " + (pfDLL > 0 ? f_usd(pfDLL) : "off") + " · target " + f_usd(pfTgt) + " · min " + str.tostring(pfMinD) + " days. A trading day = one session, 18:00 to 17:00 New York. Days to pass = the average for the evaluations that passed. Tested on = all the trading days of this chart's history since the first trade of this strategy. Pick the strategy in ⑤ Tables."
    bool pDone = false
    // the strategies you trade: shown when PENDING / LIMIT / OPEN / traded today · the picked one always
    string today = str.format_time(time + 6 * 3600000, "yyyyMMdd", NY)
    int shown = 0
    for k = 0 to 17
        if f_on(k) and r < 20
            int    stt = lK.get(k)
            int    sd  = lSd.get(k)
            string ar  = sd == 1 ? "▲" : "▼"
            [pend, pTx] = f_pend(k)
            int    dn  = dayK == today ? dEN.get(k) : 0
            if stt > 0 or pend or dn > 0 or k == SELK
                shown += 1
                // open profit of this setup's live trades (after cost), in $ and RR
                float uU = 0.0
                float uR = 0.0
                int   uN = 0
                bool  uH = false
                if DTS.size() > 0
                    for d in DTS
                        if d.live and d.k == k and d.st >= 2
                            uN += 1
                            uR += f_liveR(d, 0, close)
                            uU += f_liveR(d, 0, close) * math.abs(d.e - d.sp0) * PV1 * UNITS
                            uH := uH or d.hHit or d.st == 3
                string st = stt == 1 ? (sd == 1 ? "▲ Long" : "▼ Short") + " · limit waiting" : stt >= 2 ? (sd == 1 ? "▲ Long" : "▼ Short") + (uH ? " Runner (½ banked)" : " Open") + " · " + (uU >= 0 ? "+" : "−") + f_usd(math.abs(uU)) + " (" + f_sgn(uN > 0 ? uR / uN : 0.0, "#.##") + " RR)" : pTx
                if not (stt > 0 or pend)
                    st := "No setup now"
                r := f_lv(r, f_code(k), st, stt >= 2 ? (uU >= 0 ? EL_POS : EL_NEG) : stt == 1 ? (sd == 1 ? c_up : c_dn) : pend ? EL_GOLD : EL_LBL, z, f_tgK(k))
                if r < 21
                    string dT = "Today: " + str.tostring(dn) + " trade" + (dn == 1 ? "" : "s")
                    if dn > 0
                        int nW = dEW.get(k)
                        int nL = dEL.get(k)
                        float nt = dNet.get(k)
                        dT += " | " + str.tostring(nW) + " ✔" + (nW > 0 ? " (" + dWT.get(k) + ")" : "") + " | " + str.tostring(nL) + " ✖" + (nL > 0 ? " (" + dLT.get(k) + ")" : "") + " | Net: " + (nt >= 0 ? "+" : "−") + f_usd(math.abs(nt))
                    r := f_lv(r, "", dT, dn > 0 ? (dNet.get(k) >= 0 ? EL_POS : EL_NEG) : EL_MUTE, z)
                if pfOn and k == SELK
                    r := f_lv(r, "Prop", propTx, propC, z, propTip)
                    pDone := true
    if pfOn and not pDone
        r := f_lv(r, "Prop · " + selS, (f_on(SELK) ? "" : "off · ") + propTx, propC, z, propTip)
    if shown == 0
        r := f_lv(r, "Edges", tfOk ? "Nothing pending or open · " + (wC == 0 ? "wait for the window" : "waiting for every filter") : "Edges need a chart of 15m or lower", EL_MUTE, z)

// STATISTICS — the ONE picked strategy: Full and ½ out side by side ─────────────────
f_ic(int c, int r, string t, color tc, string z) =>
    f_cell(IN, c, r, t, tc, r % 2 == 0 ? EL_ROW : EL_ALT, text.align_left, z)

if barstate.islast and tbOn
    string z = f_sz(tbSz)
    int i = f_ii(selS)
    string vd = f_vdM(i)
    f_cell(IN, 0, 0, "─ " + NML.get(SELK) + " · " + (MKT <= 0 ? "NQ 2022–26" : MKTN + " Dec 25 – Oct 26 · " + vd) + " · " + SZTX + " ─", MKT <= 0 or str.startswith(vd, "PASS") ? EL_GOLD : EL_WARN, EL_BG, text.align_center, z, MKT <= 0 ? "Every number = the whole test (NQ 2022–25 + MNQ 2026 together), after costs. Money = your size. The website shows each period." : "Every number = this market's own test, both periods together (Dec 2025 – Oct 2026; 1m / 5m setups use fewer months), after costs, with the tested exit. PASS = it made money in both periods here. Money = your size.")
    [fu, hf] = f_ex(i)
    float pk = f_prK(SELK)
    f_ic(0, 1, "Tested exit", EL_LBL, z)
    f_ic(1, 1, "FULL · 1:" + str.tostring(f_rrK(SELK, false), "#") + " RR", EL_GOLD, z)
    f_ic(2, 1, "½ OUT · ½ at " + str.tostring(pk > 0 ? pk : 1.0, "#.##") + "R → 1:" + str.tostring(f_rrK(SELK, true), "#") + " RR", EL_GOLD, z)
    array<string> rl = array.from("WR (win rate) · target", "avg RR", "PF", "t-score", "Losses / wins in a row", "Trades", "Money")
    for q = 0 to 6
        f_ic(0, 2 + q, rl.get(q), EL_LBL, z)
    for b = 0 to 1
        array<string> a = b == 0 ? fu : hf
        if a.size() < 9
            f_ic(b + 1, 2, "not tested" + (MKT > 0 ? " on " + MKTN : ""), EL_MUTE, z)
        else
            f_ic(b + 1, 2, a.get(1) + "% · 1:" + str.tostring(f_rrK(SELK, b == 1), "#") + " RR", EL_VAL, z)
            f_ic(b + 1, 3, f_sg(a.get(2)), str.tonumber(a.get(2)) > 0 ? EL_POS : EL_NEG, z)
            f_ic(b + 1, 4, a.get(3), EL_VAL, z)
            f_ic(b + 1, 5, a.get(4), str.tonumber(a.get(4)) >= 2 ? EL_POS : EL_WARN, z)
            f_ic(b + 1, 6, a.get(5) + " L / " + a.get(6) + " W", EL_VAL, z)
            f_ic(b + 1, 7, a.get(0), EL_VAL, z)
            f_ic(b + 1, 8, f_wl(str.tonumber(a.get(7)), str.tonumber(a.get(8))), EL_POS, z)
    array<string> lf = str.split(f_stS(SELK), "|")
    float n = nz(f_num(lf, 0))
    f_ic(0, 9, "This chart", EL_LBL, z)
    f_ic(1, 9, n == 0 ? (f_on(SELK) ? "no trades yet" : f_in(SELK) ? "off on " + MKTN + " · Market Check (④)" : "off · turn it on in ④") : str.tostring(n, "#") + " trades · WR " + str.tostring(100 * nz(f_num(lf, 1)) / n, "#") + "% · avg RR " + f_sgn(nz(f_num(lf, 2)) / n, "#.00") + " · " + (PROP and SELK <= 11 ? "½" : "full"), EL_LBL, z)
    f_cell(IN, 0, 10, "WR = win rate · avg RR = average result per trade (1 = one stop) · PF = money won ÷ money lost · t-score 2+ = real edge · research only, not advice", EL_MUTE, EL_BG, text.align_left, z)
