// ═══════════════════════════════════════════════════════════════════════
// DELETE HELPERS
// ═══════════════════════════════════════════════════════════════════════
deleteTradeVisuals(EntrySignal t) =>
    if not na(t)
        line.delete(t.entryLine)
        line.delete(t.slLine)
        line.delete(t.tpLine)
        label.delete(t.entryLabel)
        label.delete(t.slLabel)
        label.delete(t.tpLabel)

deleteZoneLines(ZoneLines zl) =>
    if not na(zl.vahLine)
        line.delete(zl.vahLine)
    if not na(zl.valLine)
        line.delete(zl.valLine)
    if not na(zl.pocLabel)
        label.delete(zl.pocLabel)
    if zl.allBinLines.size() > 0
        for _bi = 0 to zl.allBinLines.size() - 1
            if not na(zl.allBinLines.get(_bi))
                line.delete(zl.allBinLines.get(_bi))

deleteBullVisuals(BullStructure bs) =>
    if not na(bs.cb)
        box.delete(bs.cb)
    if not na(bs.cb_half)
        box.delete(bs.cb_half)
    if not na(bs.cb_mid)
        line.delete(bs.cb_mid)
    if not na(bs.cb_high_base)
        line.delete(bs.cb_high_base)
    if not na(bs.cb_low_base)
        line.delete(bs.cb_low_base)
    if not na(bs.cb_high_ext)
        line.delete(bs.cb_high_ext)
    if not na(bs.cb_low_ext)
        line.delete(bs.cb_low_ext)
    if not na(bs.bb_line)
        line.delete(bs.bb_line)
    if not na(bs.bb_lbl)
        label.delete(bs.bb_lbl)
    if not na(bs.sl)
        line.delete(bs.sl)
    if not na(bs.sl_lbl)
        label.delete(bs.sl_lbl)
    if not na(bs.poc_box)
        box.delete(bs.poc_box)
    if not na(bs.poc_lbl)
        label.delete(bs.poc_lbl)
    if bs.lqg_labels.size() > 0
        for lbl in bs.lqg_labels
            label.delete(lbl)
    if not na(bs.vp)
        deleteZoneLines(bs.vp)

deleteBearVisuals(BearStructure bs) =>
    if not na(bs.cb)
        box.delete(bs.cb)
    if not na(bs.cb_half)
        box.delete(bs.cb_half)
    if not na(bs.cb_mid)
        line.delete(bs.cb_mid)
    if not na(bs.cb_high_base)
        line.delete(bs.cb_high_base)
    if not na(bs.cb_low_base)
        line.delete(bs.cb_low_base)
    if not na(bs.cb_high_ext)
        line.delete(bs.cb_high_ext)
    if not na(bs.cb_low_ext)
        line.delete(bs.cb_low_ext)
    if not na(bs.bb_line)
        line.delete(bs.bb_line)
    if not na(bs.bb_lbl)
        label.delete(bs.bb_lbl)
    if not na(bs.sh)
        line.delete(bs.sh)
    if not na(bs.sh_lbl)
        label.delete(bs.sh_lbl)
    if not na(bs.poc_box)
        box.delete(bs.poc_box)
    if not na(bs.poc_lbl)
        label.delete(bs.poc_lbl)
    if bs.lqg_labels.size() > 0
        for lbl in bs.lqg_labels
            label.delete(lbl)
    if not na(bs.vp)
        deleteZoneLines(bs.vp)

emptyZL() =>
    ZoneLines.new(na, na, array.new<line>(), array.new<int>(), na, bar_index)

