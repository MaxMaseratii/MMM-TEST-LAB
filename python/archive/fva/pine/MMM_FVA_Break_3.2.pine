// ═══════════════════════════════════════════════════════════════════════
// NEW: ENTRY AND SL CALCULATION LOGIC
// ═══════════════════════════════════════════════════════════════════════
type CycleTracker
    int dir
    int count

var CycleTracker cycleState = CycleTracker.new(0, 0)

method check_update(CycleTracker ctx, bool is_long) =>
    int d = is_long ? 1 : -1
    bool allowed = true
    if ctx.dir != d
        ctx.dir := d
        ctx.count := 1
    else
        ctx.count += 1
    if limitEntriesPerCycle and ctx.count > maxEntriesPerCycle
        allowed := false
    allowed

f_get_candle_entry(string mode, float c_open, float c_high, float c_low, float c_close) =>
    float ep = c_close
    if mode == "Open"
        ep := c_open
    else if mode == "50% High-Low"
        ep := (c_high + c_low) / 2.0
    else if mode == "50% Open-Close"
        ep := (c_open + c_close) / 2.0
    ep

getBullSL(float swing_sl, float box_sl) =>
    float final_sl = na
    if sl_use_swing and not na(swing_sl)
        final_sl := swing_sl
    else if sl_use_box and not na(box_sl)
        final_sl := box_sl
    if na(final_sl)
        final_sl := not na(box_sl) ? box_sl : swing_sl
    final_sl

getBearSL(float swing_sl, float box_sl) =>
    float final_sl = na
    if sl_use_swing and not na(swing_sl)
        final_sl := swing_sl
    else if sl_use_box and not na(box_sl)
        final_sl := box_sl
    if na(final_sl)
        final_sl := not na(box_sl) ? box_sl : swing_sl
    final_sl

// ═══════════════════════════════════════════════════════════════════════
// UTILITY
// ═══════════════════════════════════════════════════════════════════════
get_size(s) =>
    switch s
        "Tiny"        => size.tiny
        "Small"       => size.small
        "Normal"      => size.normal
        "Large"       => size.large
        "Extra Large" => size.huge
        "Huge"        => size.huge
        => size.small

get_style(s) =>
    s == "Solid" ? line.style_solid : s == "Dotted" ? line.style_dotted : s == "Dashed" ? line.style_dashed : line.style_solid

get_safe_mid(int a, int b) =>
    math.max(int((a + b) / 2), bar_index - 9500)

getTablePosition(string pos) =>
    switch pos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Middle Left"  => position.middle_left
        "Middle Right" => position.middle_right
        => position.middle_right

getTableTextSize(string sz) =>
    switch sz
        "Tiny"        => size.tiny
        "Small"       => size.small
        "Normal"      => size.normal
        "Large"       => size.large
        "Extra Large" => size.huge
        "Huge"        => size.huge
        => size.small

getSizeFromString(string sz) =>
    switch sz
        "Tiny"        => size.tiny
        "Small"       => size.small
        "Normal"      => size.normal
        "Large"       => size.large
        "Extra Large" => size.huge
        "Huge"        => size.huge
        => size.small

f_wl(int w, int l) =>
    int tot  = w + l
    string wr = tot > 0 ? str.tostring(w * 100.0 / math.max(float(tot), 1.0), "#") + "%" : "—"
    str.tostring(w) + "/" + str.tostring(l) + " (" + wr + ")"

// ═══════════════════════════════════════════════════════════════════════
// RISK CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════
float tickSize        = syminfo.mintick
riskPerTrade          = cycleType == "Pay-out" ? (capitalDrawdown * payoutRiskPct / 100.0) : (capitalDrawdown / challengeDays)
totalRNeeded          = profitTarget / riskPerTrade
minDailyR             = totalRNeeded / challengeDays
expectedTotalLoss     = expectedConsecLoss * riskPerTrade
color finalEntryLineColor = autoDetectColor ? (color.r(chart.bg_color) + color.g(chart.bg_color) + color.b(chart.bg_color) > 382 ? color.black : color.white) : entryLineColor

