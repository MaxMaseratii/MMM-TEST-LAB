//@version=6
indicator("Gamma Walls and Institutional Bias @MaxMaserati", shorttitle="Gamma Bias Pro @MaxMaserati", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=500)

import TradingView/LibraryCOT/2 as cot

// v4 (Oct 28 2026)
//  · Histogram 3 candles from price (Gap From Price moves it) · it always sits between price and the level labels.
//  · Lines Start At: Source (where the level was born) · Current Price · Histogram · Line Length counted from that start.
//  · Every level type has its own color, width and style · solid by default, thicker = more important · magnets and the plan dotted.
//  · Call wall today = deep blue · call wall 90D = green · all labels Tiny by default.
// v3 · zero gamma line black · Show Prices switch (OFF by default) · short line labels · short table, full text on hover.
// v2 · typed / pasted walls only from today's 18:00 open · auto walls labeled est. · flip-based market type · OI matched on history
//      · zones = walls + magnets only · breaks score the fast market · BUY / SELL arrows with "wrong if" and "job done" prices.

// ─── 90-DAY WALLS ───
grp_g = "1. 90-Day Walls (Big Picture)"
callWallIn = input.price(0.0, "90D Call Wall (0 = auto)", group=grp_g, tooltip="From your options gamma data: today to +3 months, net view. The longest positive (call) bar. 0 = the indicator estimates it.")
putWallIn  = input.price(0.0, "90D Put Wall (0 = auto)", group=grp_g, tooltip="The longest negative (put) bar on the 3-month view. Use a split view if the put bars are tiny. 0 = the indicator estimates it.")
zeroIn     = input.price(0.0, "90D Zero Gamma (0 = auto)", group=grp_g, tooltip="The Zero Gamma level from the 3-month view. 0 = the indicator estimates it.")
oiDays     = input.int(90, "Auto Estimate Lookback (Days)", minval=20, maxval=250, group=grp_g, tooltip="Only used when a box above is 0. Built from DAILY bars, so it is the same on every timeframe.")
stepIn     = input.float(0.0, "Auto Estimate Strike Step (0 = Auto)", minval=0.0, group=grp_g)
roundBoost = input.bool(true, "Auto Estimate: Boost Round Strikes", group=grp_g)
histDays   = input.int(10, "History Days With Walls", minval=1, maxval=60, group=grp_g)

