flipIn     = input.price(0.0, "Today GEX Flip (0 = auto)", group=grp_d, tooltip="The GEX Flip level on the same-day (0DTE) view. 0 = estimated from your paste.")
magnetsN   = input.int(2, "Magnets To Show", minval=0, maxval=5, group=grp_d, tooltip="The next biggest BLUE bars after today's call wall. Price is pulled toward them.")

