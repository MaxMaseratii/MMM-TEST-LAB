boxReentryMode = input.string("Box Edge", "Reversal Box Exit At", options=["Box Edge", "Midline"], tooltip="Determines how deep price must re-enter the block to trigger the Emergency Exit.\n\nBox Edge: Exits when price completely fails and touches the far opposite edge of the block.\nMidline: Exits aggressively the moment price crosses back over the 50% equilibrium line.", group="🚪 Exits")

