// =====================================================
float autoCalculatedRisk = cycleType == "Pay-out" ? (capitalDrawdown * payoutRiskPct / 100.0) : (capitalDrawdown / challengeDays)
float riskPerTrade = overrideRiskPerTrade ? riskPerTrade_input : autoCalculatedRisk

float totalRNeeded        = profitTarget / riskPerTrade
float minDailyR           = totalRNeeded / challengeDays
float idealDailyRR        = totalRNeeded / challengeDays
int   totalWinsNeeded     = math.round(totalRNeeded / rrRatio)
int   idealTradesPerDay   = math.round(idealDailyRR / 2.0)
int   totalTrades         = totalWinsNeeded + expectedConsecLoss
float expectedTotalLoss   = expectedConsecLoss * riskPerTrade

