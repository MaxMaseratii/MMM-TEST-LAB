enableBlockCDL     = input.bool(true, "5️⃣ CDLx/CDSx Block (Reversal Limit)", tooltip="Places a resting limit order at your designated zone inside a confirmed Reversal block (CDLx/CDSx). Waits patiently for price to pull back and touch it.", group="📦 BLOCK ENTRIES")
enableBlockLD      = input.bool(false, "6️⃣ LDx/SDx Block (Continuation Limit)", tooltip="Places a resting limit order at your designated zone inside a confirmed Continuation block (LDx/SDx). Waits patiently for price to pull back and touch it.", group="📦 BLOCK ENTRIES")

grp_blk_set = "📦 BLOCK ENTRY SETTINGS"
blockEnterPremDisc = input.bool(false, "Long in PREMIUM / Short in DISCOUNT", tooltip="AGGRESSIVE ENTRY (Shallow Pullback): Limits trigger early.\n\nLONGS: Enter in the upper Premium half (75% mark, halfway between Box High and Midline).\nSHORTS: Enter in the lower Discount half (25% mark, halfway between Box Low and Midline).", group=grp_blk_set)
blockEnterDiscPrem = input.bool(true, "Long in DISCOUNT / Short in PREMIUM", tooltip="OPTIMAL SMC ENTRY (Deep Pullback): Filters weak setups for better R:R.\n\nLONGS: Enter deep in the lower Discount half (25% mark, halfway between Box Low and Midline).\nSHORTS: Enter high in the upper Premium half (75% mark, halfway between Box High and Midline).", group=grp_blk_set)
