// =====================================================
// TRADE LINE STYLES
// =====================================================
tradeLabelSize  = input.string("Normal", "Trade Label Size", options=["Small", "Normal", "Large", "Extra Large", "Huge"], group="📊 Trade Line Styles", tooltip="Controls the font size of Entry, SL, and TP labels.")
lineExtension   = input.int(30,        "Line Extension (Bars)", minval=5, group="📊 Trade Line Styles")
tradeLineWidth  = input.int(2,         "Trade Line Width",      minval=1, maxval=10, group="📊 Trade Line Styles", tooltip="Controls the thickness of active trade Entry, SL, and TP lines.")
entryLineColor  = input.color(color.white, "Entry Line Color",    group="📊 Trade Line Styles")
