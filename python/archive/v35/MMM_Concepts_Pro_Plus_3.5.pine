//@version=6
indicator("MMM Concepts Pro+ @MaxMaserati", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// =====================================================
// MMM CONCEPTS PRO+ — the ZONE engine "x" of the MMM foundation
//   Zone (box) = expander BC + the candles that close back inside it.
//   Flip         = CDLx / CDSx  (box closed through AGAINST the trend)
//   Continuation = LDx1, LDx2… / SDx1, SDx2… (count runs until the next flip)
//   Gate (NO GATE / MMPD 27 / MMPD fast / MMPD Delta) decides which breaks
//   are OFFICIAL. Only official breaks get entries, alerts and HTF bias.
//   Block TF data = last CLOSED block candle only. No repaint.
// =====================================================

// =====================================================
// ESSENTIAL GLOBAL CONTROLS
// =====================================================
group_global = "⚡ Global Performance & Spacing"
use_hist_limit = input.bool(true, "Limit Historical Bars (Faster Load)", group=group_global)
max_bars_back  = input.int(500, "Max History Bars", minval=100, maxval=20000, group=group_global)
offsetGap      = input.int(2, "Offset Gap (Bars)", minval=0, maxval=20, group=group_global, tooltip="Horizontally offsets labels and signals to prevent overlap with candle bodies.")

in_calc_range = not use_hist_limit or (last_bar_index - bar_index <= max_bars_back)

// =====================================================
// SMART "A&B" OVERLAP HANDLING ENGINE & TIME HELPER
// =====================================================
type RenderGroup
    float         price
    array<string> labels
    color         ln_col
    int           ln_width
    string        ln_style
    int           b_time
    int           e_time
    int           priority
    bool          draw_dot
    color         dot_col
    string        dot_sz
    string        lbl_pos

var array<RenderGroup> render_groups = array.new<RenderGroup>()
var array<line>        drawn_lines   = array.new<line>()
var array<label>       drawn_labels  = array.new<label>()
var array<label>       drawn_dots    = array.new<label>()

f_sz(string s) =>
    s == "Huge" ? size.huge : s == "Extra Large" ? size.huge : s == "Large" ? size.large : s == "Normal" ? size.normal : size.small

var int bar_time_diff = timeframe.in_seconds() * 1000
f_future_time(int ext) =>
    int diff = time - nz(time[1], time)
    if diff <= 0
        diff := bar_time_diff
    if diff <= 0
        diff := 60000
    time + math.round(diff * ext)

f_add_level(float p_price, string p_text, color p_col, int p_width, string p_style, int p_start_t, int p_end_t, int p_prio, bool p_draw_dot, color p_dot_col, string p_dot_sz, string p_lbl_pos) =>
    bool found = false
    float eps = math.max(syminfo.mintick * 0.51, 1e-5)
    int safe_start = nz(p_start_t, time)
    int safe_end   = nz(p_end_t, time)
    int final_b    = math.min(safe_start, safe_end)
    int final_e    = math.max(safe_start, safe_end)

    if render_groups.size() > 0
        for grp in render_groups
            if math.abs(grp.price - p_price) <= eps
                found := true
                if str.length(p_text) > 0 and array.indexof(grp.labels, p_text) == -1
                    grp.labels.push(p_text)
                grp.b_time := math.min(grp.b_time, final_b)
                grp.e_time := math.max(grp.e_time, final_e)
                if p_prio > grp.priority
                    grp.ln_col   := p_col
                    grp.ln_width := p_width
                    grp.ln_style := p_style
                    grp.priority := p_prio
                    grp.lbl_pos  := p_lbl_pos
                break

    if not found
        array<string> new_labels = array.new<string>()
        if str.length(p_text) > 0
            new_labels.push(p_text)
        render_groups.push(RenderGroup.new(
            price    = p_price,
            labels   = new_labels,
            ln_col   = p_col,
            ln_width = p_width,
            ln_style = p_style,
            b_time   = final_b,
            e_time   = final_e,
            priority = p_prio,
            draw_dot = p_draw_dot,
            dot_col  = p_dot_col,
            dot_sz   = p_dot_sz,
            lbl_pos  = p_lbl_pos
        ))

f_draw_groups() =>
    if drawn_lines.size() > 0
        for ln in drawn_lines
            line.delete(ln)
        drawn_lines.clear()
    if drawn_labels.size() > 0
        for lb in drawn_labels
            label.delete(lb)
        drawn_labels.clear()

    if render_groups.size() > 0
        for grp in render_groups
            string combined_txt = array.join(grp.labels, " & ")
            drawn_lines.push(line.new(grp.b_time, grp.price, grp.e_time, grp.price, xloc=xloc.bar_time, color=grp.ln_col, width=grp.ln_width, style=grp.ln_style))
            int lbl_x = grp.e_time
            string lbl_style_val = label.style_label_left
            if grp.lbl_pos == "down"
                lbl_x := math.round(math.avg(grp.b_time, grp.e_time))
                lbl_style_val := label.style_label_down
            else if grp.lbl_pos == "up"
                lbl_x := math.round(math.avg(grp.b_time, grp.e_time))
                lbl_style_val := label.style_label_up

            drawn_labels.push(label.new(lbl_x, grp.price, combined_txt, xloc=xloc.bar_time, textcolor=grp.ln_col, color=color(na), style=lbl_style_val, size=size.small))
    render_groups.clear()

// =====================================================
// TIMEFRAME SETTINGS
// =====================================================
tfMode = input.string("Manual", "Timeframe Mode", options=["Manual", "Auto Combination"], group="🕐 Timeframe Settings")
autoMultiplier = input.string("4x", "Auto Multiplier", options=["4x", "6x"], tooltip="Applies when Mode is 'Auto Combination'", group="🕐 Timeframe Settings")
blockTimeframe = input.timeframe('', "Block Timeframe", group="🕐 Timeframe Settings")
ltfExecutionTF = input.timeframe('', "LTF Execution Timeframe", group="🕐 Timeframe Settings")

// =====================================================
// PRIMARY CONTROLS
// =====================================================
enableNeutralCandleBoxes = input.bool(true, "Enable MMM Expander & Contraction Block", group="⚡ PRIMARY CONTROLS")
blockMode = input.string("MMM Expander Block", "Block Mode", options=["MMM Contraction Block", "MMM Expander Block"], group="⚡ PRIMARY CONTROLS")
showBlockMidlines = input.bool(true, "Show Block Midlines", group="⚡ PRIMARY CONTROLS")
showCDLabels = input.bool(true, "Show CDLx/CDSx Reversal Labels", group="⚡ PRIMARY CONTROLS")
CDLabelSize = input.string("Small", "CDEx Label Size", options=["Small", "Normal", "Large", "Extra Large", "Huge"], group="⚡ PRIMARY CONTROLS")
CDLongColor = input.color(color.new(#0f7c0f, 0), "CDLx Color", inline='cdex1', group="⚡ PRIMARY CONTROLS")
CDShortColor = input.color(color.new(#ff0000, 0), "CDSx Color", inline='cdex1', group="⚡ PRIMARY CONTROLS")
showBiasLine = input.bool(false, 'Enable MMCB', inline='mmcb1', group='⚡ PRIMARY CONTROLS')
custom_timeframe = input.timeframe('240', 'TF', inline='mmcb1', group='⚡ PRIMARY CONTROLS')
showBiasLabels = input.bool(true, 'MMM Bias Candle', inline='mmcb1', group='⚡ PRIMARY CONTROLS')
showContractionBoxes = input.bool(true, "Show Contraction Boxes", inline='univ1', group='⚡ PRIMARY CONTROLS')
showContractionLines = input.bool(true, "Show Contraction Lines", inline='univ1', group='⚡ PRIMARY CONTROLS')
showOnlyCDLPlus = input.bool(false, "Show Only CDLx+/CDSx+", inline='univ2', group='⚡ PRIMARY CONTROLS')
showOnlyCDLxCDSx = input.bool(false, "Show Only CDLx/CDSx", inline='univ2', group='⚡ PRIMARY CONTROLS')

// =====================================================
// 🧱 BOX GROWTH (G1 vs G0)
// =====================================================
boxGrowMode = input.string("Grow with wicks (G1)", "Box Growth", options=["Grow with wicks (G1)", "Fixed range (G0)"], group="🧱 Box Growth", tooltip="G1 GROW: the box keeps the MMM definition. Inside candles whose wicks go past the edge (and close back inside) push the edge out to the new last high / last low. The protected level sits past the liquidity already taken = fewer fake breaks, wider stop.\n\nG0 FIXED: like B&C. The box is frozen at the range it had when it was born (the expander candle range). It breaks earlier and gives a tighter stop, but fakes out more.\n\nTest both. Let the data decide.")
bool boxGrow = boxGrowMode == "Grow with wicks (G1)"

// =====================================================
// 🚦 GATE (which breaks are official)
// =====================================================
grp_gate    = "🚦 Gate (Official Breaks)"
gate_mode   = input.string("NO GATE", "Gate", options=["NO GATE", "MMPD 27", "MMPD fast", "MMPD Delta"], group=grp_gate, tooltip="NO GATE = every break is official (normal break, no filter).\n\nMMPD 27 / MMPD fast / MMPD Delta = the MMM Pro Edge rhythm, read on the BLOCK timeframe:\n• Flip (CDLx / CDSx) is official only if the old leg reached its extreme first: oscillator ≤ 20 before a CDLx, ≥ 80 before a CDSx.\n• Continuation (LDx / SDx) is official only if the leg reached its OWN extreme (bull ≥ 80) and THEN the pullback reached the OPPOSITE extreme (≤ 20) before the break.\n\nMMPD Delta = the natural order-flow version (built on candle delta).\nThe structure never changes with the gate. Only official breaks get entries and alerts.")
gate_fast   = input.int(9, "MMPD fast Length", minval=5, maxval=50, group=grp_gate)
show_failed = input.bool(false, "Show Failed Breaks (small grey)", group=grp_gate, tooltip="OFF = only official breaks are drawn.\nON = breaks that failed the gate are drawn in grey, lowercase (cdlx, ldx3...).")
showNextLvl = input.bool(true, "Show Next LDx / SDx Level", group=grp_gate, tooltip="Draws the level that makes the NEXT continuation, with its number (▸ LDx3). A body close through it = LDx3.")

// =====================================================
// 🧭 HTF BIAS (HTF in LTF)
// =====================================================
grp_htfb   = "🧭 HTF Bias"
htf_mode   = input.string("Off", "HTF Bias From", options=["Off", "Last Flip (CDLx/CDSx)", "Last Continuation (LDx/SDx)", "Last BC"], group=grp_htfb, tooltip="The zone engine runs on the HTF (last CLOSED HTF candle only, no repaint).\n\nLast Flip = direction of the last HTF CDLx / CDSx (the trend).\nLast Continuation = direction of the last HTF LDx / SDx made AFTER the last flip. No continuation yet = no bias.\nLast BC = direction of the last HTF body close candle.\n\nOff = no HTF filter.")
htf_bias_tf = input.timeframe("240", "HTF Bias Timeframe", group=grp_htfb)
htf_filter = input.bool(true, "Entries With HTF Bias Only", group=grp_htfb)
htf_table  = input.bool(true, "Show HTF Bias Box", inline="hb", group=grp_htfb)
htf_tbl_pos = input.string("Bottom Center", "", options=["Top Left","Top Center","Top Right","Bottom Left","Bottom Center","Bottom Right"], inline="hb", group=grp_htfb)

// =====================================================
// 📰 NEWS BLOCK (no trades)
