enableAlerts = input.bool(true, "Enable Dynamic Alerts", tooltip="Sends an alert when a signal is created, activated, or closed (TP/SL). Make sure to create an alert in TradingView using 'Any alert() function call' condition.", group="🔔 ALERTS")

