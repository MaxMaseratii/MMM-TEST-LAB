// =====================================================
// AUTO TIMEFRAME FUNCTION
// =====================================================
f_get_auto_tf(string _tf, string _multStr) =>
    int mult = _multStr == "4x" ? 4 : 6
    int tf_sec = timeframe.in_seconds(_tf)

    string res = _tf
    if not na(tf_sec)
        int tf_mins = math.round(tf_sec / 60)
        if tf_mins < 1440
            res := str.tostring(tf_mins * mult)
        else if tf_mins == 1440
            res := str.tostring(mult) + "D"
        else if tf_mins == 10080
            res := str.tostring(mult) + "W"
        else
            res := str.tostring(mult) + "M"
    res

// =====================================================
// STRICT BODY CLOSE LOGIC
// =====================================================
BullishBodyClose = close > high[1]
BearishBodyClose = close < low[1]
isNeutralCandle  = not BullishBodyClose and not BearishBodyClose

// =====================================================
// HTF DATA
// =====================================================
blockTF = tfMode == "Auto Combination" ? f_get_auto_tf(timeframe.period, autoMultiplier) : (blockTimeframe == '' ? timeframe.period : blockTimeframe)

// NO REPAINT: on a higher block TF we read the LAST CLOSED block candle
// ([1] + lookahead_on). History and live behave the same: a block candle is
// processed on the first chart candle after it closed. On the chart TF the
// candle is read directly (no delay).
bool blockSameTF = timeframe.in_seconds(blockTF) <= timeframe.in_seconds(timeframe.period)

f_blockNow() =>
    bool bAff = high <= high[1] and low <= low[1] and close <= high[1] and close >= low[1] and high >= low[1]
    bool sAff = low >= low[1] and high >= high[1] and close <= high[1] and close >= low[1] and low <= high[1]
    [time, time_close, high, low, close, nz(volume), open, high[1], low[1], time[1], bAff, sAff]

f_blockPrev() =>
    [t0, tc0, h0, l0, c0, v0, o0, ph0, pl0, pt0, ba0, sa0] = f_blockNow()
    [t0[1], tc0[1], h0[1], l0[1], c0[1], v0[1], o0[1], ph0[1], pl0[1], pt0[1], ba0[1], sa0[1]]

[n_time, n_tclose, n_high, n_low, n_close, n_vol, n_open, n_phigh, n_plow, n_ptime, n_bAff, n_sAff] = f_blockNow()
[s_time, s_tclose, s_high, s_low, s_close, s_vol, s_open, s_phigh, s_plow, s_ptime, s_bAff, s_sAff] = request.security(syminfo.tickerid, blockTF, f_blockPrev(), lookahead=barmerge.lookahead_on)

htf_time       = blockSameTF ? n_time   : s_time
htf_time_close = blockSameTF ? n_tclose : s_tclose
htf_high       = blockSameTF ? n_high   : s_high
htf_low        = blockSameTF ? n_low    : s_low
htf_close      = blockSameTF ? n_close  : s_close
htf_volume     = blockSameTF ? n_vol    : s_vol
htf_open       = blockSameTF ? n_open   : s_open
htf_prev_high  = blockSameTF ? n_phigh  : s_phigh
htf_prev_low   = blockSameTF ? n_plow   : s_plow
htf_prev_time  = blockSameTF ? n_ptime  : s_ptime
htf_bullAff    = blockSameTF ? n_bAff   : s_bAff
htf_bearAff    = blockSameTF ? n_sAff   : s_sAff

var prev_htf_block_time = 0
newHTFBlockCandle = not na(htf_time) and htf_time != prev_htf_block_time
prev_htf_block_time := nz(htf_time, prev_htf_block_time)

htf_isBullishBodyClose = htf_close > htf_prev_high
htf_isBearishBodyClose = htf_close < htf_prev_low
htf_isNeutralCandle    = not htf_isBullishBodyClose and not htf_isBearishBodyClose

// =====================================================
// GATE OSCILLATORS (same math as Super MMPD / MMM Pro Edge)
// =====================================================
const color FAIL_COL = #9e9e9e
const string NY = "America/New_York"
bool gateOn = gate_mode != "NO GATE"

f_xsa(float src, int len) =>
    var float out = na
    float ma = ta.sma(src, len)
    out := na(out) ? ma : (src + out * (len - 1)) / len
    out

f_mmpd(int len) =>
    float cl = (close - ta.lowest(low, len)) / (ta.highest(high, len) - ta.lowest(low, len)) * 100
    float s1 = f_xsa(cl, 5)
    float s2 = f_xsa(s1, 3)
    float c  = (3 * s1 - 2 * s2 - 50) * 1.032 + 50
    float o  = ta.ema(((2 * close + high + low + open) / 5 - ta.lowest(low, len + 7)) / (ta.highest(high, len + 7) - ta.lowest(low, len + 7)) * 100, 13)
    [c, o]

f_dma() =>
    float v  = na(volume) or volume == 0 ? 1.0 : volume
    float dl = close > open and close > close[1] ? v : close < open and close < close[1] ? -v : close > close[1] ? v * 0.5 : close < close[1] ? -v * 0.5 : 0.0
    float ds = ta.ema(dl, 3)
    float lo = ta.lowest(ds, 14)
    float dr = ta.highest(ds, 14) - lo
    float c  = ta.ema(dr > 0 ? (ds - lo) / dr * 100 : 50, 3)
    float o  = ta.ema(c, 13)
    [c, o]

f_gateNow() =>
    [c1, o1] = f_mmpd(27)
    [c2, o2] = f_mmpd(gate_fast)
    [c3, o3] = f_dma()
    float hi = gate_mode == "MMPD 27" ? math.max(c1, o1) : gate_mode == "MMPD fast" ? math.max(c2, o2) : math.max(c3, o3)
    float lo = gate_mode == "MMPD 27" ? math.min(c1, o1) : gate_mode == "MMPD fast" ? math.min(c2, o2) : math.min(c3, o3)
    [hi, lo]

f_gatePrev() =>
    [hi, lo] = f_gateNow()
    [hi[1], lo[1]]

[g_hi_now, g_lo_now] = f_gateNow()
[g_hi_htf, g_lo_htf] = request.security(syminfo.tickerid, blockTF, f_gatePrev(), lookahead=barmerge.lookahead_on)
float gHi = blockSameTF ? g_hi_now : g_hi_htf
float gLo = blockSameTF ? g_lo_now : g_lo_htf

// Gate memory (impulse -> pullback -> continuation), block TF candles
var bool hitXD   = false   // oscillator <= 20 since the last flip
var bool hitXP   = false   // oscillator >= 80 since the last flip
var bool bullImp = false   // bull leg reached its own extreme (>= 80)
var bool bullPb  = false   // then the pullback reached <= 20
var bool bearImp = false
var bool bearPb  = false

// =====================================================
// HTF BIAS — compact copy of the zone engine on the HTF (closed candle only)
// =====================================================
f_htfZone() =>
    var float exH   = na
    var float exL   = na
    var int   exDir = 0
    var bool  waiting = false
    var bool  live  = false
    var float bH    = na
    var float bL    = na
    var int   bType = 0      // 1 = Supply (after BuBC), -1 = Demand (after BeBC)
    var int   bias  = 0
    var int   lastC = 0
    var int   lastBC = 0
    var float revH  = na
    var float revL  = na
    bool bu = close > high[1]
    bool be = close < low[1]
    bool bc = bu or be
    bool flipped = false
    if live
        if bc and (close > bH or close < bL)
            bool up = close > bH
            if up and bType == -1 and bias != 1
                bias    := 1
                lastC   := 0
                revH    := bH
                revL    := bL
                flipped := true
            else if not up and bType == 1 and bias != -1
                bias    := -1
                lastC   := 0
                revH    := bH
                revL    := bL
                flipped := true
            live    := false
            exH     := high
            exL     := low
            exDir   := up ? 1 : -1
            waiting := true
        else if boxGrow
            bH := math.max(bH, high)
            bL := math.min(bL, low)
    else if waiting
        if bc
            exH   := high
            exL   := low
            exDir := bu ? 1 : -1
        else if close <= exH and close >= exL
            live    := true
            bH      := exH
            bL      := exL
            bType   := exDir
            waiting := false
        else
            waiting := false
    else if bc
        exH     := high
        exL     := low
        exDir   := bu ? 1 : -1
        waiting := true
    if not flipped
        if bu and be[1] and bias != 1
            bias    := 1
            lastC   := 0
            revH    := high
            revL    := low[1]
            flipped := true
        else if be and bu[1] and bias != -1
            bias    := -1
            lastC   := 0
            revH    := high[1]
            revL    := low
            flipped := true
    if not flipped
        if bias == 1 and bu and not na(revH) and close > revH
            lastC := 1
            revH  := high
        else if bias == -1 and be and not na(revL) and close < revL
            lastC := -1
            revL  := low
    if bu
        lastBC := 1
    if be
        lastBC := -1
    [nz(bias[1]), nz(lastC[1]), nz(lastBC[1])]

[htfSig, htfCont, htfBC] = request.security(syminfo.tickerid, htf_bias_tf, f_htfZone(), lookahead=barmerge.lookahead_on)
int  htfBias  = htf_mode == "Last Flip (CDLx/CDSx)" ? htfSig : htf_mode == "Last Continuation (LDx/SDx)" ? htfCont : htf_mode == "Last BC" ? htfBC : 0
bool htfLong  = htf_mode == "Off" or not htf_filter or htfBias == 1
bool htfShort = htf_mode == "Off" or not htf_filter or htfBias == -1

// ═══════════════════════════════════════════════════════════════
// NEWS ENGINE (shared by every MMM indicator) — light: no library,
// no external request. Events = built-in CPI/FOMC/NFP + pasted calendar.
// ═══════════════════════════════════════════════════════════════
const string NWS_TZ = "America/New_York"

f_nwImpOk(string imp) =>
    imp == "H" ? news_red : imp == "M" ? news_org : imp == "L" ? news_yel : imp == "N" ? news_gry : false

f_nwCol(string imp) =>
    imp == "H" ? color.red : imp == "M" ? color.orange : imp == "L" ? color.yellow : color.gray

f_nwRank(string imp) =>
    imp == "H" ? 4 : imp == "M" ? 3 : imp == "L" ? 2 : 1

f_nwDate(string d, int hh, int mm) =>
    int t = na
    if str.length(d) == 10
        float y = str.tonumber(str.substring(d, 0, 4))
        float m = str.tonumber(str.substring(d, 5, 7))
        float dd = str.tonumber(str.substring(d, 8, 10))
        if not na(y) and not na(m) and not na(dd)
            t := timestamp(NWS_TZ, int(y), int(m), int(dd), hh, mm)
    t

var array<int>    nwT = array.new<int>()
var array<string> nwI = array.new<string>()
var array<string> nwN = array.new<string>()

if barstate.isfirst
    array<int>    tT = array.new<int>()
    array<string> tI = array.new<string>()
    array<string> tN = array.new<string>()
    if news_builtin
        for d in str.split(cpi_dates, ",")
            int t = f_nwDate(str.trim(d), 8, 30)
            if not na(t)
                tT.push(t)
                tI.push("H")
                tN.push("USD CPI")
        for d in str.split(fomc_dates, ",")
            int t1 = f_nwDate(str.trim(d), 14, 0)
            int t2 = f_nwDate(str.trim(d), 14, 30)
            if not na(t1)
                tT.push(t1)
                tI.push("H")
                tN.push("USD FOMC Statement")
                tT.push(t2)
                tI.push("H")
                tN.push("USD FOMC Press Conference")
        for y = 2024 to 2028
            for m = 1 to 12
                for dd = 1 to 7
                    int t = timestamp(NWS_TZ, y, m, dd, 8, 30)
                    if dayofweek(t, NWS_TZ) == dayofweek.friday
                        tT.push(t)
                        tI.push("H")
                        tN.push("USD NFP")
                        break
    string curList = "," + str.replace_all(str.upper(news_cur), " ", "") + ","
    for ln in str.split(str.replace_all(news_paste, ";", "\n"), "\n")
        array<string> tk = str.split(str.trim(ln), " ")
        if tk.size() >= 4
            string dS  = tk.get(0)
            string tS  = tk.get(1)
            string cur = str.upper(tk.get(2))
            string imp = str.upper(tk.get(3))
            if str.length(tS) == 5 and str.contains(curList, "," + cur + ",") and f_nwImpOk(imp)
                float hh = str.tonumber(str.substring(tS, 0, 2))
                float mm = str.tonumber(str.substring(tS, 3, 5))
                if not na(hh) and not na(mm)
                    int t = f_nwDate(dS, int(hh), int(mm))
                    if not na(t)
                        string ttl = cur
                        if tk.size() > 4
                            for k = 4 to tk.size() - 1
                                ttl += " " + tk.get(k)
                        tT.push(t)
                        tI.push(imp)
                        tN.push(ttl)
    if tT.size() > 0
        array<int> ord = tT.sort_indices(order.ascending)
        for k = 0 to ord.size() - 1
            nwT.push(tT.get(ord.get(k)))
            nwI.push(tI.get(ord.get(k)))
            nwN.push(tN.get(ord.get(k)))

int    nwPre   = news_pre * 60000
int    nwPost  = news_post * 60000
int    nwWarn  = (news_dot_min == "15" ? 15 : 30) * 60000
int    nwBarMs = timeframe.in_seconds(timeframe.period) * 1000
int    nwEnd   = nz(time_close, time + nwBarMs)
var int nwPtr  = 0
bool   nwHit   = false
string nwWarnTxt = ""
string nwWarnImp = ""
if timeframe.isintraday and nwT.size() > 0
    while nwPtr < nwT.size()
        if nwT.get(nwPtr) + math.max(nwPost, 0) < time
            nwPtr += 1
        else
            break
    if nwPtr < nwT.size()
        for j = nwPtr to nwT.size() - 1
            int et = nwT.get(j)
            if et - math.max(nwPre, nwWarn) >= nwEnd
                break
            if time < et + nwPost and nwEnd > et - nwPre
                nwHit := true
            int wt = et - nwWarn
            if wt >= time and wt < nwEnd
                nwWarnTxt += (str.length(nwWarnTxt) > 0 ? "\n" : "") + str.format_time(et, "HH:mm", NWS_TZ) + " NY · " + nwI.get(j) + " · " + nwN.get(j)
                if str.length(nwWarnImp) == 0 or f_nwRank(nwI.get(j)) > f_nwRank(nwWarnImp)
                    nwWarnImp := nwI.get(j)
bool newsBlock = news_on and nwHit

bgcolor(news_bg and nwHit ? color.new(color.orange, 85) : na, title="News Window")

// Warning dot — on the candle holding (news time - 15/30 min), live or closed.
var label[] nwDots = array.new<label>()
if news_dot and str.length(nwWarnTxt) > 0
    color  dc   = f_nwCol(nwWarnImp)
    bool   atHi = news_dot_at == "High"
    string dTx  = news_dot_txt ? "◉ " + nwWarnTxt : ""
    label  dl   = label.new(bar_index, atHi ? high : low, dTx, yloc=atHi ? yloc.abovebar : yloc.belowbar, style=news_dot_txt ? (atHi ? label.style_label_down : label.style_label_up) : label.style_circle, color=news_dot_txt ? color(na) : dc, textcolor=dc, size=size.tiny, tooltip="News in " + news_dot_min + " min:\n" + nwWarnTxt)
    if barstate.isconfirmed
        nwDots.push(dl)
        if nwDots.size() > 100
            label.delete(nwDots.shift())

// Official-event flags (for alertcondition)
bool ev_cdl = false
bool ev_cds = false
bool ev_ld  = false
bool ev_sd  = false

// =====================================================
// LTF DATA
// =====================================================
ltfTF = ltfExecutionTF == '' ? timeframe.period : ltfExecutionTF

[ltf_time, ltf_time_close, ltf_high, ltf_low, ltf_close, ltf_open] =
     request.security(syminfo.tickerid, ltfTF, [time, time_close, high, low, close, open], lookahead=barmerge.lookahead_off)

var prev_ltf_time = 0
newLTFCandle = ltf_time != prev_ltf_time
prev_ltf_time := ltf_time

ltf_prev_high = request.security(syminfo.tickerid, ltfTF, high[1], lookahead=barmerge.lookahead_off)
ltf_prev_low  = request.security(syminfo.tickerid, ltfTF, low[1],  lookahead=barmerge.lookahead_off)

ltf_isBullishBodyClose = ltf_close > ltf_prev_high
ltf_isBearishBodyClose = ltf_close < ltf_prev_low

// =====================================================
// HVC DETECTION FUNCTIONS
// =====================================================
f_isHighestBullishVolume() =>
    isBullish = close > open
    if not isBullish
        false
    else
        highest_bull_vol = 0.0
        for i = 0 to math.min(hvcLookbackPeriod - 1, bar_index)
            if close[i] > open[i] and not na(volume[i])
                if volume[i] > highest_bull_vol
                    highest_bull_vol := volume[i]
        volume >= highest_bull_vol and not na(volume)

f_isHighestBearishVolume() =>
    isBearish = close < open
    if not isBearish
        false
    else
        highest_bear_vol = 0.0
        for i = 0 to math.min(hvcLookbackPeriod - 1, bar_index)
            if close[i] < open[i] and not na(volume[i])
                if volume[i] > highest_bear_vol
                    highest_bear_vol := volume[i]
        volume >= highest_bear_vol and not na(volume)

getHvcLabelSize(sizeStr) =>
    switch sizeStr
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
        => size.normal

getArrowSymbol(isBullish, styleStr) =>
    if isBullish
        switch styleStr
            "Thin (↑/↓)"     => "↑"
            "Bold (⬆/⬇)"     => "⬆"
            "Triangle (▲/▼)" => "▲"
            "Pointer (➔/➔)"  => "➔"
            => "⬆"
    else
        switch styleStr
            "Thin (↑/↓)"     => "↓"
            "Bold (⬆/⬇)"     => "⬇"
            "Triangle (▲/▼)" => "▼"
            "Pointer (➔/➔)"  => "➔"
            => "⬇"

isCurrentHighestBullish = f_isHighestBullishVolume()
isCurrentHighestBearish = f_isHighestBearishVolume()

var bullishHvcLabels = array.new<label>()
var bearishHvcLabels = array.new<label>()

if showIVC and (showHvcLabels or showHvcArrowSymbol or showHvcText or showHvcVolumeValue) and in_calc_range
    if isCurrentHighestBullish
        bullishParts = array.new_string()
        if showHvcArrowSymbol
            array.push(bullishParts, getArrowSymbol(true, hvcArrowStyle))
        if showHvcVolumeValue
            array.push(bullishParts, str.tostring(volume, format.volume))
        if showHvcText
            array.push(bullishParts, "HBuV")
        bullishText = array.join(bullishParts, "\n")

        if array.size(bullishParts) > 0
            offset = (high - low) * (hvcLabelOffsetPercent / 100.0)
            useSize = showHvcArrowSymbol and not showHvcText and not showHvcVolumeValue ? getHvcLabelSize(hvcArrowSize) : getHvcLabelSize(hvcLabelSize)
            newBullLabel = label.new(x=bar_index, y=low - offset, text=bullishText, style=label.style_label_up, color=color.new(color.white, 100), textcolor=colorIVCBull, size=useSize)
            array.push(bullishHvcLabels, newBullLabel)
            if array.size(bullishHvcLabels) > maxHvcLabels
                label.delete(array.shift(bullishHvcLabels))

    if isCurrentHighestBearish
        bearishParts = array.new_string()
        if showHvcText
            array.push(bearishParts, "HBeV")
        if showHvcVolumeValue
            array.push(bearishParts, str.tostring(volume, format.volume))
        if showHvcArrowSymbol
            array.push(bearishParts, getArrowSymbol(false, hvcArrowStyle))
        bearishText = array.join(bearishParts, "\n")

        if array.size(bearishParts) > 0
            offset = (high - low) * (hvcLabelOffsetPercent / 100.0)
            useSize = showHvcArrowSymbol and not showHvcText and not showHvcVolumeValue ? getHvcLabelSize(hvcArrowSize) : getHvcLabelSize(hvcLabelSize)
            newBearLabel = label.new(x=bar_index, y=high + offset, text=bearishText, style=label.style_label_down, color=color.new(color.white, 100), textcolor=colorIVCBear, size=useSize)
            array.push(bearishHvcLabels, newBearLabel)
            if array.size(bearishHvcLabels) > maxHvcLabels
                label.delete(array.shift(bearishHvcLabels))

// =====================================================
// CANDLE COLORING
// =====================================================
shouldColorCandle = colorCurrentCandle or barstate.isconfirmed

color candleColor = na
if shouldColorCandle
    if showIVC and showIVCColoring and (isCurrentHighestBullish or isCurrentHighestBearish)
        if isCurrentHighestBullish
            candleColor := colorIVCBull
        else if isCurrentHighestBearish
            candleColor := colorIVCBear
    else if showBodyCloseColoring and BullishBodyClose
        candleColor := bullishBodyCloseColor
    else if showBodyCloseColoring and BearishBodyClose
        candleColor := bearishBodyCloseColor
    else if showNeutralCandleColoring and isNeutralCandle
        candleColor := neutralCandleColor

barcolor(candleColor)

// =====================================================
// HELPER FUNCTIONS
// =====================================================
getSizeFromString(sizeStr) =>
    switch sizeStr
        "Small"       => size.small
        "Normal"      => size.normal
        "Large"       => size.large
        "Extra Large" => size.huge
        "Huge"        => size.huge
        => size.small

getLineStyle(styleStr) =>
    switch styleStr
        "Solid"  => line.style_solid
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_dotted

f_timeframeToString(t) =>
    s = str.length(t) == 0 ? timeframe.period : t
    switch s
        '1'   => 'M1'
        '3'   => 'M3'
        '5'   => 'M5'
        '15'  => 'M15'
        '30'  => 'M30'
        '45'  => 'M45'
        '60'  => 'H1'
        '120' => 'H2'
        '180' => 'H3'
        '240' => 'H4'
        '360' => 'H6'
        '480' => 'H8'
        '720' => 'H12'
        'D'   => 'D'
        'W'   => 'W'
        'M'   => 'M'
        => s

getTablePosition(string pos) =>
    switch pos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Middle Left"  => position.middle_left
        "Middle Right" => position.middle_right
        => position.top_right

getTableTextSize(string sz) =>
    switch sz
        "Small"       => size.small
        "Normal"      => size.normal
        "Large"       => size.large
        "Extra Large" => size.huge
        "Huge"        => size.huge
        => size.small

getBlockLabelText(bool isBullish, string tfString, string labelFormat, string ldsdLabel) =>
    basePrefix = showBidAskLabels ? (isBullish ? "Bid" : "Ask") : ""
    labelTxt = ""
    switch labelFormat
        'Block+TF+LD/SDx' =>
            labelTxt := (basePrefix != "" ? basePrefix + " " : "") + (tfString != "" ? tfString + " " : "") + ldsdLabel
        'TF+LD/SDx' =>
            labelTxt := (tfString != "" ? tfString + " " : "") + ldsdLabel
        'Block+LD/SDx' =>
            labelTxt := (basePrefix != "" ? basePrefix + " " : "") + ldsdLabel
        'LD/SDx only' =>
            labelTxt := ldsdLabel
        'None' =>
            labelTxt := ""
    labelTxt

getCDLPlusLabelText(bool isBullish, string tfString, string labelFormat) =>
    prefix = isBullish ? "CDLx+" : "CDSx+"
    switch labelFormat
        'CDLx+ + TF' => prefix + " " + tfString
        'CDLx+ Only' => prefix
        'TF Only'    => tfString
        'None'       => ""
        => ""

getExtendedTime(int baseTime, int bars) =>
    int(baseTime + bars * (time_close - time))

f_wl(int w, int l) =>
    int tot = w + l
    string wr = tot > 0 ? str.tostring(w * 100.0 / tot, "#") + "%" : "—"
    str.tostring(w) + "/" + str.tostring(l) + " (" + wr + ")"

// =====================================================
// TRADE TYPE
// =====================================================
type Trade
    line   eLine
    line   sLine
    line   tLine
    label  eLbl
    label  sLbl
    label  tLbl
    float  entry
    float  sl
    float  tp
    bool   isLong
    bool   triggered
    bool   activated
    int    creationBar
    string entryType
    string entryCategory
    float  boxHigh
    float  boxLow
    float  boxMid
    int    creationTime
    label  ldsdLabel
    bool   fromCDLPlus
    float  riskDollars
    float  riskPoints
    bool   forceExit       // Flags a trade for premature exit
    string forceExitReason // Logs reason for premature exit

// SEPARATE ARRAYS FOR EACH ENTRY TYPE
var Trade[] trades_BlockCDLPlus  = array.new<Trade>(0)
var Trade[] trades_BlockCDL      = array.new<Trade>(0)
var Trade[] trades_BlockLD       = array.new<Trade>(0)
var Trade[] trades_CandleCDLPlus = array.new<Trade>(0)
var Trade[] trades_CandleCDL     = array.new<Trade>(0)
var Trade[] trades_CandleLD      = array.new<Trade>(0)

// =====================================================
// SWEEP LINE TYPE
// =====================================================
type SweepLine
    line   theLine
    label  theLabel
    float  price
    int    startTime
    int    endTime
    string sweepType
    bool   isBullish
    float  candleExt = na   // the sweep candle's low (low sweep) / high (high sweep)

var SweepLine lastBullishSweep = na
var SweepLine lastBearishSweep = na

deleteSweepLine(SweepLine sweep) =>
    if not na(sweep)
        line.delete(sweep.theLine)
        label.delete(sweep.theLabel)

// =====================================================
// SWEEP DETECTION
// =====================================================
pivotH = ta.pivothigh(high, swingLength, swingLength)
pivotL = ta.pivotlow(low,  swingLength, swingLength)

var float swH = na
var float swHC = na
var float swHM = na
var int   swHTime = na
var float swL = na
var float swLC = na
var float swLM = na
var int   swLTime = na

if not na(pivotH)
    swH  := high[swingLength]
    swHC := close[swingLength]
    swHM := (high[swingLength] + low[swingLength]) / 2
    swHTime := int(time[swingLength])

if not na(pivotL)
    swL  := low[swingLength]
    swLC := close[swingLength]
    swLM := (high[swingLength] + low[swingLength]) / 2
    swLTime := int(time[swingLength])

// =====================================================
// BIAS FUNCTIONS
// =====================================================
candleBiasHTF() =>
    bullishStrength = close - low
    bearishStrength = high - close
    totalRange = bullishStrength + bearishStrength
    bullPercent = totalRange > 0 ? bullishStrength / totalRange * 100 : na
    bearPercent = totalRange > 0 ? bearishStrength / totalRange * 100 : na
    bullishBodyClose  = close > high[1]
    bearishBodyClose  = close < low[1]
    bullishAffinity   = high <= high[1] and low <= low[1] and close <= high[1] and close >= low[1] and high >= low[1]
    bearishAffinity   = low >= low[1] and high >= high[1] and close <= high[1] and close >= low[1] and low <= high[1]
    seekDestroy       = high > high[1] and low < low[1] and close <= high[1] and close >= low[1]
    insideCandle      = high < high[1] and low > low[1]
    string txt = ''
    color biasColor = na
    int biasDirection = 0
    if bullishBodyClose
        txt := 'Bullish Body Close ' + (bullishStrength > bearishStrength ? 'Plus' : 'Minus')
        biasColor := color.green
        biasDirection := 1
    else if bearishBodyClose
        txt := 'Bearish Body Close ' + (bearishStrength > bullishStrength ? 'Plus' : 'Minus')
        biasColor := color.red
        biasDirection := -1
    else if bullishAffinity
        txt := 'Bullish Affinity ' + (bullishStrength > bearishStrength ? 'Plus' : 'Minus')
        biasColor := color.green
        biasDirection := 1
    else if bearishAffinity
        txt := 'Bearish Affinity ' + (bearishStrength > bullishStrength ? 'Plus' : 'Minus')
        biasColor := color.red
        biasDirection := -1
    else if seekDestroy
        txt := 'Seek & Destroy'
        biasColor := bullishStrength > bearishStrength ? color.green : color.red
        biasDirection := bullishStrength > bearishStrength ? 1 : -1
    else if insideCandle
        txt := 'Close Inside'
        biasColor := bullishStrength > bearishStrength ? color.green : color.red
        biasDirection := bullishStrength > bearishStrength ? 1 : -1
    [txt, biasColor, bullPercent, bearPercent, biasDirection]

calculateModifiedDelta(idx) =>
    vol = volume[idx]
    float buyVol = 0.0
    float sellVol = 0.0
    float candleRange = high[idx] - low[idx]
    if candleRange == 0
        buyVol := vol / 2
        sellVol := vol / 2
    else if close[idx] > open[idx]
        float buyRatio = (close[idx] - low[idx]) / candleRange
        buyVol   := math.round(vol * math.max(0.5, buyRatio))
        sellVol  := vol - buyVol
    else
        float sellRatio = (high[idx] - close[idx]) / candleRange
        sellVol   := math.round(vol * math.max(0.5, sellRatio))
        buyVol    := vol - sellVol
    [buyVol, sellVol, buyVol - sellVol]

// =====================================================
// MMCB BIAS LINES
// =====================================================
var line[]  biasOpenLines   = array.new<line>(0)
var line[]  biasHighLines   = array.new<line>(0)
var line[]  biasLowLines    = array.new<line>(0)
var line[]  biasCloseLines  = array.new<line>(0)
var label[] biasOpenLabels  = array.new<label>(0)
var label[] biasHighLabels  = array.new<label>(0)
var label[] biasLowLabels   = array.new<label>(0)
var label[] biasCloseLabels = array.new<label>(0)
var line    currentLiveOpenLine  = na
var label   currentLiveOpenLabel = na
var int     mult = 1
var string  lastDrawnBiasText   = ""
var color   lastDrawnBiasColor  = color.gray
var float   lastDrawnBullPercent = 0.0
var float   lastDrawnBearPercent = 0.0

var position_value = switch table_position
    'Top Left'     => position.top_left
    'Top Right'    => position.top_right
    'Middle Left'  => position.middle_left
    'Middle Right' => position.middle_right
    'Bottom Left'  => position.bottom_left
    'Bottom Right' => position.bottom_right
    => position.top_right

var table_size = switch table_size_input
    'Normal'      => size.normal
    'Small'       => size.small
    'Tiny'        => size.tiny
    'Large'       => size.large
    'Extra Large' => size.huge
    'Huge'        => size.huge
    => size.small

var mmm_signals_table = table.new(position=position_value, columns=1, rows=30, bgcolor=#000000, border_width=1)

maxLookback = 5000
useTF = custom_timeframe == '' ? timeframe.period : custom_timeframe

if barstate.isnew and showBiasLine
    htfOpen  = time(useTF)
    htfClose = time_close(useTF)
    if htfOpen >= time and htfOpen <= time_close
        mult := math.ceil((htfClose - htfOpen) / (time_close - time))

highNdx = math.min(math.abs(ta.highestbars(mult)), maxLookback)
lowNdx  = math.min(math.abs(ta.lowestbars(mult)),  maxLookback)

[_high, _low, _time, tClose] = request.security(syminfo.tickerid, useTF, [high, low, time, time_close])
[_open, _close] = request.security(syminfo.tickerid, useTF, [open, close])
htf_live_open = request.security(syminfo.tickerid, useTF, open,  gaps=barmerge.gaps_off)
htf_live_time = request.security(syminfo.tickerid, useTF, time,  gaps=barmerge.gaps_off)
var prev_htf_time = 0.0
new_htf_candle = _time != prev_htf_time
prev_htf_time := _time
[htfBiasText, htfBiasColor, htfBullPercent, htfBearPercent, htfBiasDirection] = request.security(syminfo.tickerid, useTF, candleBiasHTF(), gaps=barmerge.gaps_off)

if in_calc_range and barstate.isconfirmed
    currentBarDuration = time_close - time

    if (tClose > time and tClose <= time_close and showBiasLine) or (timeframe.period == useTF and showBiasLine and barstate.isnew)
        highTime = highNdx > bar_index ? _time : math.max(_time, time[math.min(highNdx, bar_index)])
        lowTime  = lowNdx  > bar_index ? _time : math.max(_time, time[math.min(lowNdx,  bar_index)])
        tfString = f_timeframeToString(useTF)
        lastDrawnBiasText    := htfBiasText
        lastDrawnBiasColor   := htfBiasColor
        lastDrawnBullPercent := htfBullPercent
        lastDrawnBearPercent := htfBearPercent
        extendedTime = tClose + (extendLines ? extensionLength * currentBarDuration : 0)
        if showOpenLine  and not na(_open)
            array.push(biasOpenLines,  line.new(x1=_time, y1=_open, x2=extendedTime, y2=_open,  xloc=xloc.bar_time, color=line_color_open,  width=biasLineWidth))
        if showHighLine
            array.push(biasHighLines,  line.new(x1=highTime, y1=_high, x2=extendedTime, y2=_high, xloc=xloc.bar_time, color=line_color_high, width=biasLineWidth))
        if showLowLine
            array.push(biasLowLines,   line.new(x1=lowTime,  y1=_low,  x2=extendedTime, y2=_low,  xloc=xloc.bar_time, color=line_color_low,  width=biasLineWidth))
        if showCloseLine and not na(_close)
            array.push(biasCloseLines, line.new(x1=_time, y1=_close, x2=extendedTime, y2=_close, xloc=xloc.bar_time, color=line_color_close, width=biasLineWidth))
        while array.size(biasOpenLines)  > maxBiasLines
            line.delete(array.shift(biasOpenLines))
        while array.size(biasHighLines)  > maxBiasLines
            line.delete(array.shift(biasHighLines))
        while array.size(biasLowLines)   > maxBiasLines
            line.delete(array.shift(biasLowLines))
        while array.size(biasCloseLines) > maxBiasLines
            line.delete(array.shift(biasCloseLines))
        if showBiasLabels and not na(htfBiasText)
            highTextColor = htfBiasDirection == 1 ? #006400 : line_color_high
            lowTextColor  = htfBiasDirection == -1 ? #8B0000 : line_color_low
            if showOpenLine  and showOpenLabel
                array.push(biasOpenLabels,  label.new(x=int(extendedTime), y=_open,  text=tfString + " Open", color=color.new(color.black, 100), textcolor=line_color_open,  style=label.style_label_left, size=getSizeFromString(biasLabelSize), xloc=xloc.bar_time))
            if showHighLabel
                array.push(biasHighLabels,  label.new(x=int(extendedTime), y=_high,  text=tfString + "H" + (htfBiasDirection == 1 ? " TGT" : ""), color=color.new(color.black, 100), textcolor=highTextColor, style=label.style_label_left, size=getSizeFromString(biasLabelSize), xloc=xloc.bar_time))
            if showLowLabel
                array.push(biasLowLabels,   label.new(x=int(extendedTime), y=_low,   text=tfString + "L" + (htfBiasDirection == -1 ? " TGT" : ""), color=color.new(color.black, 100), textcolor=lowTextColor,  style=label.style_label_left, size=getSizeFromString(biasLabelSize), xloc=xloc.bar_time))
            if showCloseLine and showCloseLabel
                array.push(biasCloseLabels, label.new(x=int(extendedTime), y=_close, text=tfString + "C", color=color.new(color.black, 100), textcolor=line_color_close, style=label.style_label_left, size=getSizeFromString(biasLabelSize), xloc=xloc.bar_time))
            while array.size(biasOpenLabels)  > maxBiasLines
                label.delete(array.shift(biasOpenLabels))
            while array.size(biasHighLabels)  > maxBiasLines
                label.delete(array.shift(biasHighLabels))
            while array.size(biasLowLabels)   > maxBiasLines
                label.delete(array.shift(biasLowLabels))
            while array.size(biasCloseLabels) > maxBiasLines
                label.delete(array.shift(biasCloseLabels))

if in_calc_range and barstate.islast
    currentBarDuration = time_close - time
    if showLiveOpen and showBiasLine and not na(htf_live_open)
        line.delete(currentLiveOpenLine)
        label.delete(currentLiveOpenLabel)
        liveExtendedTime = time + currentBarDuration + (extendLines ? extensionLength * currentBarDuration : 0)
        currentLiveOpenLine  := line.new(x1=htf_live_time, y1=htf_live_open, x2=liveExtendedTime, y2=htf_live_open, xloc=xloc.bar_time, color=liveOpenColor, width=liveOpenWidth)
        currentLiveOpenLabel := label.new(x=int(liveExtendedTime), y=htf_live_open, text=f_timeframeToString(useTF) + " Open Live", color=color.new(color.black, 100), textcolor=liveOpenColor, style=label.style_label_left, size=getSizeFromString(biasLabelSize), xloc=xloc.bar_time)
    extendedTime = time_close + (extendLines ? extensionLength * currentBarDuration : 0)
    for l in biasOpenLines
        line.set_x2(l, extendedTime)
    for l in biasHighLines
        line.set_x2(l, extendedTime)
    for l in biasLowLines
        line.set_x2(l, extendedTime)
    for l in biasCloseLines
        line.set_x2(l, extendedTime)
    if showOpenLabel
        for lb in biasOpenLabels
            label.set_x(lb, int(extendedTime))
    if showHighLabel
        for lb in biasHighLabels
            label.set_x(lb, int(extendedTime))
    if showLowLabel
        for lb in biasLowLabels
            label.set_x(lb, int(extendedTime))
    if showCloseLabel
        for lb in biasCloseLabels
            label.set_x(lb, int(extendedTime))

// =====================================================
// CONTRACTION BLOCKS TYPE
// =====================================================
type NeutralBox
    box    boxes
    float  high
    float  low
    line   highLine
    line   lowLine
    line   midLine
    bool   boxActive
    int    startBar
    float  breakoutVolume
    string breakoutDirection
    label  CDLabel
    float  totalVolume
    int    barCount
    string boxType
    float  expanderVolume
    float  expanderATR
    float  netCVD
    float  buyVolume
    float  sellVolume
    bool   hasCDLabel
    int    breakBar
    line   extHighLine
    line   extLowLine
    float  affinityBoundary
    int    affinityCount
    float  boxBoundary
    label  boxLabel
    int    startTime
    float  originalHigh
    float  originalLow
    bool   isCDLPlus
    float  openPrice
    float  closePrice
    float  midlinePrice
    bool   zoneTouched
    bool   waitingForConfirmer
    float  entryZonePrice
    label  ldsdLabel
    bool   isRev    = false   // the break was a flip (CDLx / CDSx)
    bool   official = true    // the break passed the gate (and, for continuations, the trend)

var NeutralBox[] neutralBoxes              = array.new<NeutralBox>(0)
var NeutralBox[] violatedHighNeutralBoxes = array.new<NeutralBox>(0)
var NeutralBox[] violatedLowNeutralBoxes  = array.new<NeutralBox>(0)

type LDSDLabel
    label  theLabel
    string labelType
    int    ldsdNumber
    int    creationTime

var LDSDLabel[] ldsdLabels = array.new<LDSDLabel>(0)

type CDExDot
    float  price
    int    startBar
    int    startTime
    string dotType
    label  dotLabel

var CDExDot[] cdexDots = array.new<CDExDot>(0)

var color NEUTRAL_ACCUMULATION_COLOR = color.new(color.green, neutralBoxTransparency)
var color NEUTRAL_DISTRIBUTION_COLOR = color.new(color.red,   neutralBoxTransparency)
var color NEUTRAL_NEUTRAL_COLOR      = color.new(color.gray,  neutralBoxTransparency)

var int    neutralCount               = 0
var float  neutralHigh                = na
var float  neutralLow                 = na
var int    neutralStartBar            = na
var bool   trackingNeutral            = false
var float  neutralAccumulatedVolume = 0.0
var float  neutralNetCVD            = 0.0
var float  neutralBuyVolume         = 0.0
var float  neutralSellVolume        = 0.0
var string lastExpanderType          = "none"
var float  lastExpanderVolume       = 0.0
var float  lastExpanderATR          = 0.0
var float  lastExpanderHigh         = 0.0
var float  lastExpanderLow          = 0.0
var bool   waitingForInsideClose    = false
var int    pendingExpanderBar       = na
var float  affinityTrackedBoundary  = na
var float  displayBoxBoundary       = na
var int    pendingExpanderTime      = na
var float  originalBoxHigh          = na
var float  originalBoxLow           = na

cachedAvgVol = ta.sma(volume, neutralVolumeLookback)
cachedATR    = ta.atr(14)
useExpanderBoundaries = blockMode == "MMM Expander Block"

var NeutralBox currentLiveBox = na

// =====================================================
// CDLx+/CDSx+ TYPE
// =====================================================
type CDLPlusBlock
    line   theLine
    label  theLabel
    float  price
    int    barIndex
    string type
    int    creationBar
    int    creationTime
    box    theBox
    line   highLine
    line   lowLine
    line   midLine
    label  blockLabel
    float  highPrice
    float  lowPrice
    float  openPrice
    float  closePrice
    float  midlinePrice
    bool   zoneTouched
    bool   official = true

var CDLPlusBlock[] cdlPlusBlocks  = array.new<CDLPlusBlock>(0)
var bool prevWasBullishBC         = false
var bool prevWasBearishBC         = false

isCandleOutsideAllUnbrokenBoxes(int offset, NeutralBox liveBox) =>
    candleH = high[offset]
    candleL = low[offset]
    outsideAllBoxes = true
    if not na(liveBox) and liveBox.boxActive
        if candleL <= liveBox.high and candleH >= liveBox.low
            outsideAllBoxes := false
    if outsideAllBoxes and array.size(neutralBoxes) > 0
        for i = 0 to array.size(neutralBoxes) - 1
            box_item = array.get(neutralBoxes, i)
            if box_item.boxActive and candleL <= box_item.high and candleH >= box_item.low
                outsideAllBoxes := false
                break
    outsideAllBoxes

createCDLPlusBlock(string pType, int barIdx, int barTime, float priceH, float priceL, float openP, float closeP, string tfString, bool isOfficial) =>
    blk = CDLPlusBlock.new()
    blk.official      := isOfficial
    blk.type          := pType
    blk.price         := pType == "CDLx+" ? priceL : priceH
    blk.barIndex      := barIdx
    blk.creationBar   := bar_index
    blk.creationTime  := barTime
    blk.highPrice     := priceH
    blk.lowPrice      := priceL
    blk.openPrice     := openP
    blk.closePrice    := closeP
    blk.midlinePrice  := (priceH + priceL) / 2
    blk.zoneTouched   := false

    extTime = getExtendedTime(time, 20)
    lineColor = pType == "CDLx+" ? cdlxPlusColor : cdsxPlusColor
    lineWidth = pType == "CDLx+" ? cdlxPlusWidth : cdsxPlusWidth

    blk.theLine := in_calc_range ? line.new(x1=barTime, y1=blk.price, x2=extTime, y2=blk.price, color=lineColor, style=line.style_solid, width=lineWidth, xloc=xloc.bar_time) : na

    labelText = cdlPlusLblFmt != 'None' ? getCDLPlusLabelText(pType == "CDLx+", tfString, cdlPlusLblFmt) : ""
    labelText := isOfficial ? labelText : str.lower(labelText)
    if labelText != "" and in_calc_range
        blk.theLabel := label.new(x=extTime, y=blk.price, text=labelText, color=color.new(color.white, 100), textcolor=isOfficial ? lineColor : FAIL_COL, style=label.style_label_left, size=getSizeFromString(cdlPlusLblSize), xloc=xloc.bar_time)

    boxColor = pType == "CDLx+" ? NEUTRAL_ACCUMULATION_COLOR : NEUTRAL_DISTRIBUTION_COLOR
    if showContractionBoxes and in_calc_range
        blk.theBox := box.new(left=barTime, top=priceH, right=time, bottom=priceL, bgcolor=boxColor, border_color=na, xloc=xloc.bar_time)
    if showContractionLines and in_calc_range
        blk.highLine := line.new(x1=barTime, y1=priceH, x2=time, y2=priceH, color=lineColor, width=boxLineWidth, style=getLineStyle(boxLineStyle), xloc=xloc.bar_time)
        blk.lowLine  := line.new(x1=barTime, y1=priceL, x2=time, y2=priceL, color=lineColor, width=boxLineWidth, style=getLineStyle(boxLineStyle), xloc=xloc.bar_time)
    if showBlockMidlines and showContractionLines and in_calc_range
        midPrice = (priceH + priceL) / 2
        blk.midLine := line.new(x1=barTime, y1=midPrice, x2=time, y2=midPrice, color=lineColor, style=line.style_dotted, width=midlineWidth, xloc=xloc.bar_time)
    blk

deleteCDLPlusBlock(CDLPlusBlock blk) =>
    line.delete(blk.theLine)
    if not na(blk.theLabel)
        label.delete(blk.theLabel)
    if not na(blk.theBox)
        box.delete(blk.theBox)
    if not na(blk.highLine)
        line.delete(blk.highLine)
    if not na(blk.lowLine)
        line.delete(blk.lowLine)
    if not na(blk.midLine)
        line.delete(blk.midLine)
    if not na(blk.blockLabel)
        label.delete(blk.blockLabel)

extendCDLPlusBlock(CDLPlusBlock blk) =>
    extTime = getExtendedTime(time, 20)
    line.set_x2(blk.theLine, extTime)
    if not na(blk.theLabel)
        label.set_x(blk.theLabel, extTime)
    if not na(blk.theBox)
        box.set_right(blk.theBox, time)
    if not na(blk.highLine)
        line.set_x2(blk.highLine, time)
    if not na(blk.lowLine)
        line.set_x2(blk.lowLine, time)
    if not na(blk.midLine)
        line.set_x2(blk.midLine, time)

// =====================================================
// TRADE MANAGEMENT
// =====================================================
deleteTrade(Trade trade) =>
    if not na(trade)
        line.delete(trade.eLine)
        line.delete(trade.sLine)
        line.delete(trade.tLine)
        label.delete(trade.eLbl)
        label.delete(trade.sLbl)
        label.delete(trade.tLbl)
        if not na(trade.ldsdLabel)
            label.delete(trade.ldsdLabel)

createTrade(bool isLong, float entryPrice, float slPrice, float tpPrice, string entryType, string entryCategory, float boxHigh, float boxLow, int signalTime) =>
    trade = Trade.new()
    trade.isLong        := isLong
    trade.entry         := entryPrice
    trade.sl            := slPrice
    trade.tp            := tpPrice
    trade.triggered     := false
    trade.activated     := false
    trade.creationBar   := bar_index
    trade.creationTime  := signalTime
    trade.entryType     := entryType
    trade.entryCategory := entryCategory
    trade.boxHigh       := boxHigh
    trade.boxLow        := boxLow
    trade.boxMid        := (boxHigh + boxLow) / 2
    trade.ldsdLabel     := na
    trade.fromCDLPlus   := false
    trade.forceExit     := false
    trade.forceExitReason := ""

    float rp = math.abs(entryPrice - slPrice)
    trade.riskPoints  := rp
    trade.riskDollars := rp * pointValue * positionSize

    if array.size(firstTradeTime_arr) == 0
        array.push(firstTradeTime_arr, signalTime)

    int endBar = bar_index + lineExtension

    trade.eLine := in_calc_range ? line.new(x1=bar_index, y1=entryPrice, x2=endBar, y2=entryPrice, xloc=xloc.bar_index, color=entryLineColor, width=tradeLineWidth) : na
    trade.sLine := in_calc_range ? line.new(x1=bar_index, y1=slPrice,    x2=endBar, y2=slPrice,    xloc=xloc.bar_index, color=slLineColor,    width=tradeLineWidth, style=line.style_dashed) : na
    trade.tLine := in_calc_range ? line.new(x1=bar_index, y1=tpPrice,    x2=endBar, y2=tpPrice,    xloc=xloc.bar_index, color=tpLineColor,    width=tradeLineWidth, style=line.style_dotted) : na

    float riskCash   = rp * pointValue * positionSize
    float profitCash = riskCash * rrRatio
    color transpBg   = color.new(color.white, 100)

    eText = (isLong ? "LONG " : "SHORT ") + entryType + " @ " + str.tostring(entryPrice, format.mintick) + " | $" + str.tostring(positionSize) + "ct"
    sText = "SL @ " + str.tostring(slPrice, format.mintick) + "  -$" + str.tostring(riskCash, "#")
    tText = "TP @ " + str.tostring(tpPrice, format.mintick) + "  +" + str.tostring(rrRatio, "#.#") + "R  +$" + str.tostring(profitCash, "#")

    trade.eLbl := in_calc_range ? label.new(x=endBar + offsetGap, y=entryPrice, text=eText, xloc=xloc.bar_index, style=label.style_label_left, color=transpBg, textcolor=universalTextColor ? color.black : entryTextColor,   size=getSizeFromString(tradeLabelSize)) : na
    trade.sLbl := in_calc_range ? label.new(x=endBar + offsetGap, y=slPrice,    text=sText, xloc=xloc.bar_index, style=label.style_label_left, color=transpBg, textcolor=universalTextColor ? color.black : slTextColor,      size=getSizeFromString(tradeLabelSize)) : na
    trade.tLbl := in_calc_range ? label.new(x=endBar + offsetGap, y=tpPrice,    text=tText, xloc=xloc.bar_index, style=label.style_label_left, color=transpBg, textcolor=universalTextColor ? color.black : tpTextColor,   size=getSizeFromString(tradeLabelSize)) : na
    trade

// Every new trade passes the same two filters: no news window, and the HTF
// bias (when enabled) points the same way. A rejected trade is erased.
addTradeToCategory(Trade t, string category) =>
    bool ok = not newsBlock and (t.isLong ? htfLong : htfShort)
    if not ok
        deleteTrade(t)
    else
        targetArray = switch category
            "BlockCDLPlus"   => trades_BlockCDLPlus
            "BlockCDL"       => trades_BlockCDL
            "BlockLD"        => trades_BlockLD
            "CandleCDLPlus"  => trades_CandleCDLPlus
            "CandleCDL"      => trades_CandleCDL
            "CandleLD"       => trades_CandleLD
            => trades_BlockCDL
        maxLimit = switch category
            "BlockCDLPlus"   => maxEntries_BlockCDLPlus
            "BlockCDL"       => maxEntries_BlockCDL
            "BlockLD"        => maxEntries_BlockLD
            "CandleCDLPlus"  => maxEntries_CandleCDLPlus
            "CandleCDL"      => maxEntries_CandleCDL
            "CandleLD"       => maxEntries_CandleLD
            => 1
        while array.size(targetArray) >= maxLimit
            oldTrade = array.shift(targetArray)
            deleteTrade(oldTrade)
        array.push(targetArray, t)
        array.set(manualExitWarningFlag, 0, false)
    ok

closeOppositeTrades(bool keepLongs) =>
    for category in array.from("BlockCDLPlus", "BlockCDL", "BlockLD", "CandleCDLPlus", "CandleCDL", "CandleLD")
        targetArray = switch category
            "BlockCDLPlus"   => trades_BlockCDLPlus
            "BlockCDL"       => trades_BlockCDL
            "BlockLD"        => trades_BlockLD
            "CandleCDLPlus"  => trades_CandleCDLPlus
            "CandleCDL"      => trades_CandleCDL
            "CandleLD"       => trades_CandleLD
            => trades_BlockCDL
        i = array.size(targetArray) - 1
        while i >= 0
            if array.size(targetArray) > i
                t = array.get(targetArray, i)
                if (keepLongs and not t.isLong) or (not keepLongs and t.isLong)
                    t.forceExit := true
                    t.forceExitReason := "Opposite Signal"
                    array.set(targetArray, i, t)
            i -= 1

calculateCandleEntry(float candleH, float candleL, float candleO, float candleC) =>
    float e = na
    if candleEntryMode == "Close"
        e := candleC
    else if candleEntryMode == "Open"
        e := candleO
    else if candleEntryMode == "50% High-Low"
        e := (candleH + candleL) / 2
    else if candleEntryMode == "50% Close-Open"
        e := (candleC + candleO) / 2
    e

calculateBoxEntry(bool isLong, float boxH, float boxL, float boxMid, string mode) =>
    float e = na
    if mode == "Long in PREMIUM / Short in DISCOUNT"
        e := isLong ? (boxH + boxMid) / 2 : (boxL + boxMid) / 2
    else if mode == "Long in DISCOUNT / Short in PREMIUM"
        e := isLong ? (boxL + boxMid) / 2 : (boxH + boxMid) / 2
    else if mode == "Enter at 50% midline"
        e := boxMid
    else if mode == "Enter at breakout edge"
        e := isLong ? boxH : boxL
    e

getZonePrice(bool isLong, float boxH, float boxL, float boxMid) =>
    float zoneP = na
    if blockEntryMode == "Long in PREMIUM / Short in DISCOUNT"
        zoneP := isLong ? (boxH + boxMid) / 2 : (boxL + boxMid) / 2
    else if blockEntryMode == "Long in DISCOUNT / Short in PREMIUM"
        zoneP := isLong ? (boxL + boxMid) / 2 : (boxH + boxMid) / 2
    else if blockEntryMode == "Enter at 50% midline"
        zoneP := boxMid
    else if blockEntryMode == "Enter at breakout edge"
        zoneP := isLong ? boxH : boxL
    zoneP

checkZoneTouched(bool isLong, float zonePrice, float currentLow, float currentHigh) =>
    isLong ? (currentLow <= zonePrice) : (currentHigh >= zonePrice)

// =====================================================
// CONTRACTION BLOCKS LOGIC
// =====================================================
bool flipThisBar = false   // a CDLx / CDSx happened on this block candle
bool flipPass    = true    // ...and it passed the gate
bool contThisBar = false   // an LDx / SDx happened on this block candle
bool contPass    = true

if enableNeutralCandleBoxes and barstate.isconfirmed and newHTFBlockCandle and in_calc_range
    isCurrentNonBodyClose   = htf_isNeutralCandle
    isCurrentBodyClose      = htf_isBullishBodyClose or htf_isBearishBodyClose
    isCurrentBullishAffinity = htf_bullAff
    isCurrentBearishAffinity = htf_bearAff

    // GATE MEMORY — this block candle's oscillator (only matters when a gate is on)
    if gateOn and not na(gHi) and not na(gLo)
        if gHi >= 80
            hitXP := true
            if currentBias == "CDLx"
                bullImp := true
            if currentBias == "CDSx" and bearImp
                bearPb := true
        if gLo <= 20
            hitXD := true
            if currentBias == "CDSx"
                bearImp := true
            if currentBias == "CDLx" and bullImp
                bullPb := true

    if minNeutralCandles == 1
        if waitingForInsideClose and not na(lastExpanderHigh) and not na(lastExpanderLow)
            if isCurrentBodyClose
                lastExpanderType   := htf_isBullishBodyClose ? "BuBC" : "BeBC"
                lastExpanderVolume := htf_volume
                lastExpanderATR    := cachedATR
                lastExpanderHigh   := htf_high
                lastExpanderLow    := htf_low
                pendingExpanderBar  := bar_index
                pendingExpanderTime := int(htf_time)
                affinityTrackedBoundary := na
                displayBoxBoundary      := na
            else if (isCurrentNonBodyClose or isCurrentBullishAffinity or isCurrentBearishAffinity) and htf_close <= lastExpanderHigh and htf_close >= lastExpanderLow
                boxType = lastExpanderType == "BuBC" ? "Supply" : "Demand"
                if lastExpanderType == "BeBC"
                    affinityTrackedBoundary := lastExpanderLow
                    displayBoxBoundary      := lastExpanderLow
                    originalBoxHigh         := lastExpanderHigh
                    originalBoxLow          := lastExpanderLow
                else
                    affinityTrackedBoundary := lastExpanderHigh
                    displayBoxBoundary      := lastExpanderHigh
                    originalBoxHigh         := lastExpanderHigh
                    originalBoxLow          := lastExpanderLow
                float boxHigh = lastExpanderHigh
                float boxLow  = lastExpanderLow
                [buyVol, sellVol, deltaVal] = calculateModifiedDelta(0)
                neutralNetCVD      := deltaVal
                neutralBuyVolume   := buyVol
                neutralSellVolume  := sellVol
                ndbPercent  = volume > 0 ? deltaVal / volume : 0.0
                boxColor    = ndbPercent >= ndbThreshold ? NEUTRAL_ACCUMULATION_COLOR : ndbPercent <= -ndbThreshold ? NEUTRAL_DISTRIBUTION_COLOR : NEUTRAL_NEUTRAL_COLOR
                lineColor   = lastExpanderType == "BuBC" ? bullishBodyCloseColor : bearishBodyCloseColor
                newBox      = box(na)
                newHighLine = line(na)
                newLowLine  = line(na)
                newMidLine  = line(na)
                newBoxLabel = label(na)
                shouldShowLiveBox = not showOnlyCDLPlus and not showOnlyCDLxCDSx
                if shouldShowLiveBox
                    if showContractionBoxes
                        newBox := box.new(left=pendingExpanderTime, top=boxHigh, right=time, bottom=boxLow, bgcolor=boxColor, border_color=na, xloc=xloc.bar_time)
                    if showContractionLines
                        newHighLine := line.new(x1=pendingExpanderTime, y1=boxHigh, x2=time, y2=boxHigh, color=lineColor, width=boxLineWidth, style=getLineStyle(boxLineStyle), xloc=xloc.bar_time)
                        newLowLine  := line.new(x1=pendingExpanderTime, y1=boxLow,  x2=time, y2=boxLow,  color=lineColor, width=boxLineWidth, style=getLineStyle(boxLineStyle), xloc=xloc.bar_time)
                    if showBlockMidlines and showContractionLines
                        midPrice = (boxHigh + boxLow) / 2
                        newMidLine := line.new(x1=pendingExpanderTime, y1=midPrice, x2=time, y2=midPrice, color=lineColor, style=line.style_dotted, width=midlineWidth, xloc=xloc.bar_time)
                    if blockLabelFormat != 'None' and (showBidAskLabels or blockLabelFormat == 'TF Only')
                        tfString    = f_timeframeToString(blockTF)
                        labelText   = getBlockLabelText(boxType == "Demand", tfString, blockLabelFormat, "")
                        labelStyle  = boxType == "Demand" ? label.style_label_up : label.style_label_down
                        labelY      = boxType == "Demand" ? boxLow : boxHigh
                        newBoxLabel := label.new(x=f_future_time(offsetGap), y=labelY, text=labelText, style=labelStyle, size=getSizeFromString(cdlPlusLblSize), color=color.new(color.white, 100), textcolor=lineColor, xloc=xloc.bar_time)
                currentLiveBox := NeutralBox.new(boxes=newBox, high=boxHigh, low=boxLow, highLine=newHighLine, lowLine=newLowLine, midLine=newMidLine, boxActive=true, startBar=pendingExpanderBar, breakoutVolume=0.0, breakoutDirection="none", CDLabel=label(na), totalVolume=volume, barCount=1, boxType=boxType, expanderVolume=lastExpanderVolume, expanderATR=lastExpanderATR, netCVD=deltaVal, buyVolume=buyVol, sellVolume=sellVol, hasCDLabel=false, breakBar=0, extHighLine=line(na), extLowLine=line(na), affinityBoundary=affinityTrackedBoundary, affinityCount=0, boxBoundary=displayBoxBoundary, boxLabel=newBoxLabel, startTime=pendingExpanderTime, originalHigh=originalBoxHigh, originalLow=originalBoxLow, isCDLPlus=false, openPrice=htf_open, closePrice=htf_close, midlinePrice=(boxHigh+boxLow)/2, zoneTouched=false, waitingForConfirmer=false, entryZonePrice=na, ldsdLabel=label(na))
                currentLiveBox.entryZonePrice := getZonePrice(currentLiveBox.boxType == "Demand", boxHigh, boxLow, (boxHigh + boxLow) / 2)
                trackingNeutral             := true
                neutralCount                := 1
                neutralHigh                 := htf_high
                neutralLow                  := htf_low
                neutralStartBar             := pendingExpanderBar
                neutralAccumulatedVolume    := volume
                waitingForInsideClose       := false
                pendingExpanderBar          := na
                pendingExpanderTime         := na
            else
                waitingForInsideClose := false
                pendingExpanderBar    := na
                pendingExpanderTime   := na
        else if isCurrentBodyClose and not trackingNeutral
            lastExpanderType    := htf_isBullishBodyClose ? "BuBC" : "BeBC"
            lastExpanderVolume  := htf_volume
            lastExpanderATR     := cachedATR
            lastExpanderHigh    := htf_high
            lastExpanderLow     := htf_low
            waitingForInsideClose := true
            pendingExpanderBar    := bar_index
            pendingExpanderTime   := int(htf_time)
            affinityTrackedBoundary := na
            displayBoxBoundary      := na

    if (isCurrentNonBodyClose or isCurrentBullishAffinity or isCurrentBearishAffinity) and minNeutralCandles == 1 and not na(currentLiveBox) and trackingNeutral
        neutralCount += 1
        if boxGrow and currentLiveBox.boxType == "Demand" and isCurrentBullishAffinity
            if htf_low < affinityTrackedBoundary
                closedInsideOriginalBox = htf_close >= currentLiveBox.originalLow and htf_close <= currentLiveBox.originalHigh
                if closedInsideOriginalBox
                    displayBoxBoundary      := affinityTrackedBoundary
                    affinityTrackedBoundary := htf_low
                    currentLiveBox.affinityCount := currentLiveBox.affinityCount + 1
        else if boxGrow and currentLiveBox.boxType == "Supply" and isCurrentBearishAffinity
            if htf_high > affinityTrackedBoundary
                closedInsideOriginalBox = htf_close >= currentLiveBox.originalLow and htf_close <= currentLiveBox.originalHigh
                if closedInsideOriginalBox
                    displayBoxBoundary      := affinityTrackedBoundary
                    affinityTrackedBoundary := htf_high
                    currentLiveBox.affinityCount := currentLiveBox.affinityCount + 1
        neutralHigh                  := math.max(neutralHigh, htf_high)
        neutralLow                   := math.min(neutralLow,  htf_low)
        neutralAccumulatedVolume     := neutralAccumulatedVolume + volume
        [buyVol, sellVol, deltaVal]  = calculateModifiedDelta(0)
        neutralNetCVD                := neutralNetCVD + deltaVal
        neutralBuyVolume             := neutralBuyVolume + buyVol
        neutralSellVolume            := neutralSellVolume + sellVol
        float boxHigh = neutralHigh
        float boxLow  = neutralLow
        if not boxGrow
            // G0 FIXED: the box keeps the range it was born with.
            boxHigh := currentLiveBox.originalHigh
            boxLow  := currentLiveBox.originalLow
        else if useExpanderBoundaries and not na(lastExpanderHigh) and not na(lastExpanderLow)
            if currentLiveBox.boxType == "Demand"
                boxLow  := displayBoxBoundary
                if lastExpanderHigh >= neutralHigh
                    boxHigh := lastExpanderHigh
            else
                boxHigh := displayBoxBoundary
                if lastExpanderLow <= neutralLow
                    boxLow := lastExpanderLow
        shouldShowLiveBox = not showOnlyCDLPlus and not showOnlyCDLxCDSx
        if shouldShowLiveBox
            if showContractionBoxes and not na(currentLiveBox.boxes)
                box.set_top(currentLiveBox.boxes, boxHigh)
                box.set_bottom(currentLiveBox.boxes, boxLow)
                box.set_right(currentLiveBox.boxes, time)
            if showContractionLines
                if not na(currentLiveBox.highLine)
                    line.set_y1(currentLiveBox.highLine, boxHigh)
                    line.set_y2(currentLiveBox.highLine, boxHigh)
                    line.set_x2(currentLiveBox.highLine, time)
                if not na(currentLiveBox.lowLine)
                    line.set_y1(currentLiveBox.lowLine, boxLow)
                    line.set_y2(currentLiveBox.lowLine, boxLow)
                    line.set_x2(currentLiveBox.lowLine, time)
            if not na(currentLiveBox.boxLabel)
                label.set_y(currentLiveBox.boxLabel, currentLiveBox.boxType == "Demand" ? boxLow : boxHigh)
            if showBlockMidlines and showContractionLines and not na(currentLiveBox.midLine)
                midPrice = (boxHigh + boxLow) / 2
                line.set_y1(currentLiveBox.midLine, midPrice)
                line.set_y2(currentLiveBox.midLine, midPrice)
                line.set_x2(currentLiveBox.midLine, time)
        currentLiveBox.high         := boxHigh
        currentLiveBox.low          := boxLow
        currentLiveBox.totalVolume  := neutralAccumulatedVolume
        currentLiveBox.barCount     := neutralCount
        currentLiveBox.netCVD       := neutralNetCVD
        currentLiveBox.buyVolume    := neutralBuyVolume
        currentLiveBox.sellVolume   := neutralSellVolume
        currentLiveBox.affinityBoundary := affinityTrackedBoundary
        currentLiveBox.boxBoundary  := displayBoxBoundary
        currentLiveBox.midlinePrice := (boxHigh + boxLow) / 2
        currentLiveBox.entryZonePrice := getZonePrice(currentLiveBox.boxType == "Demand", boxHigh, boxLow, (boxHigh + boxLow) / 2)
        ndbPercent = neutralAccumulatedVolume > 0 ? neutralNetCVD / neutralAccumulatedVolume : 0.0
        newBoxColor = ndbPercent >= ndbThreshold ? NEUTRAL_ACCUMULATION_COLOR : ndbPercent <= -ndbThreshold ? NEUTRAL_DISTRIBUTION_COLOR : NEUTRAL_NEUTRAL_COLOR
        if not showOnlyCDLxCDSx and showContractionBoxes and not na(currentLiveBox.boxes)
            box.set_bgcolor(currentLiveBox.boxes, newBoxColor)

    if isCurrentBodyClose
        if trackingNeutral and neutralCount >= minNeutralCandles and not na(currentLiveBox)
            closeBreaksAbove = htf_close > currentLiveBox.high
            closeBreaksBelow = htf_close < currentLiveBox.low
            bodyCloseSwept   = false
            if not closeBreaksAbove and not closeBreaksBelow and boxGrow
                if currentLiveBox.boxType == "Demand" and htf_isBullishBodyClose
                    if htf_low < affinityTrackedBoundary
                        closedInsideOriginalBox = htf_close >= currentLiveBox.originalLow and htf_close <= currentLiveBox.originalHigh
                        if closedInsideOriginalBox
                            displayBoxBoundary      := affinityTrackedBoundary
                            affinityTrackedBoundary := htf_low
                            currentLiveBox.affinityCount := currentLiveBox.affinityCount + 1
                            bodyCloseSwept := true
                else if currentLiveBox.boxType == "Supply" and htf_isBearishBodyClose
                    if htf_high > affinityTrackedBoundary
                        closedInsideOriginalBox = htf_close >= currentLiveBox.originalLow and htf_close <= currentLiveBox.originalHigh
                        if closedInsideOriginalBox
                            displayBoxBoundary      := affinityTrackedBoundary
                            affinityTrackedBoundary := htf_high
                            currentLiveBox.affinityCount := currentLiveBox.affinityCount + 1
                            bodyCloseSwept := true
            if closeBreaksAbove or closeBreaksBelow
                if closeBreaksAbove
                    lastExpanderType := "BuBC"
                else
                    lastExpanderType := "BeBC"
                lastExpanderVolume := htf_volume
                lastExpanderATR    := cachedATR
                lastExpanderHigh   := htf_high
                lastExpanderLow    := htf_low
                if minNeutralCandles == 1
                    waitingForInsideClose   := true
                    pendingExpanderBar      := bar_index
                    pendingExpanderTime     := int(htf_time)
                    affinityTrackedBoundary := na
                    displayBoxBoundary      := na
                CDLabel      = label(na)
                // FLIP: the box is closed through AGAINST the trend. A Demand box
                // broken up while the trend is already CDLx is NOT a new CDLx
                // (no "CDL after CDL") — the continuation rule handles it.
                bool   isReversal = false
                bool   revPass    = true
                string cdexText   = ""
                color  cdexColor  = color(na)
                float  cdexY      = 0.0
                if currentLiveBox.boxType == "Supply" and closeBreaksBelow and currentBias != "CDSx"
                    isReversal := true
                    cdexText   := "CDSx"
                    cdexColor  := CDShortColor
                    cdexY      := currentLiveBox.low
                else if currentLiveBox.boxType == "Demand" and closeBreaksAbove and currentBias != "CDLx"
                    isReversal := true
                    cdexText   := "CDLx"
                    cdexColor  := CDLongColor
                    cdexY      := currentLiveBox.high
                if isReversal
                    revPass     := not gateOn or (cdexText == "CDLx" ? hitXD : hitXP)
                    flipThisBar := true
                    flipPass    := revPass
                    if showCDLabels and (revPass or show_failed)
                        string cdTip = cdexText + (revPass ? " (official)" : " (failed " + gate_mode + ")") + " | box " + str.tostring(currentLiveBox.low, format.mintick) + " - " + str.tostring(currentLiveBox.high, format.mintick)
                        CDLabel := label.new(x=int(math.avg(currentLiveBox.startTime, htf_time)), y=cdexY, text=revPass ? cdexText : str.lower(cdexText), style=cdexText == "CDLx" ? label.style_label_down : label.style_label_up, size=getSizeFromString(CDLabelSize), color=color.new(color.white, 100), textcolor=revPass ? cdexColor : FAIL_COL, xloc=xloc.bar_time, tooltip=cdTip)
                        if cdexText == "CDSx"
                            dotLabel = label.new(x=f_future_time(offsetGap), y=currentLiveBox.high, text="•", style=label.style_none, size=size.tiny, color=color.new(CDLongColor, 0), textcolor=CDLongColor, xloc=xloc.bar_time)
                            array.push(cdexDots, CDExDot.new(currentLiveBox.high, currentLiveBox.startBar, int(htf_time), "CDSx", dotLabel))
                        else
                            dotLabel = label.new(x=f_future_time(offsetGap), y=currentLiveBox.low, text="•", style=label.style_none, size=size.tiny, color=color.new(CDShortColor, 0), textcolor=CDShortColor, xloc=xloc.bar_time)
                            array.push(cdexDots, CDExDot.new(currentLiveBox.low, currentLiveBox.startBar, int(htf_time), "CDLx", dotLabel))
                    hitXD   := false
                    hitXP   := false
                    bullImp := false
                    bullPb  := false
                    bearImp := false
                    bearPb  := false
                    if cdexText == "CDLx"
                        lastSignalType  := revPass ? "CDLx" : "cdlx"
                        lastSignalPrice := currentLiveBox.high
                        lastWasReversal := true
                        lastRevBoxHigh  := currentLiveBox.high
                        lastRevBoxLow   := currentLiveBox.low
                        currentBias     := "CDLx"
                        ldCount := 0
                        sdCount := 0
                        ev_cdl  := revPass
                        if array.size(ldsdLabels) > 0
                            i = array.size(ldsdLabels) - 1
                            while i >= 0
                                if array.size(ldsdLabels) > i
                                    ldsdItem = array.get(ldsdLabels, i)
                                    if ldsdItem.labelType == "SDx"
                                        label.delete(ldsdItem.theLabel)
                                        array.remove(ldsdLabels, i)
                                i -= 1
                        closeOppositeTrades(true)
                        if enableCandleCDL and revPass
                            float e = calculateCandleEntry(htf_high, htf_low, htf_open, htf_close)
                            float slBase = (masterSLMode == "Block Extremes (HH/LL)" and not na(lastRevBoxLow)) ? lastRevBoxLow : htf_low
                            slP = slBase - (slTicksCandle * syminfo.mintick)
                            riskP = math.abs(e - slP)
                            tpP = e + (riskP * rrRatio)
                            newTrade = createTrade(true, e, slP, tpP, "PO4 CDLx", "CandleCDL", currentLiveBox.high, currentLiveBox.low, int(htf_time))
                            if addTradeToCategory(newTrade, "CandleCDL")
                                lastAction := "PO4 CDLx entry created"
                                if enableAlerts
                                    alert(lastAction, alert.freq_all)
                        marketDirection := "LONG"
                    else
                        lastSignalType  := revPass ? "CDSx" : "cdsx"
                        lastSignalPrice := currentLiveBox.low
                        lastWasReversal := true
                        lastRevBoxHigh  := currentLiveBox.high
                        lastRevBoxLow   := currentLiveBox.low
                        currentBias     := "CDSx"
                        sdCount := 0
                        ldCount := 0
                        ev_cds  := revPass
                        if array.size(ldsdLabels) > 0
                            i = array.size(ldsdLabels) - 1
                            while i >= 0
                                if array.size(ldsdLabels) > i
                                    ldsdItem = array.get(ldsdLabels, i)
                                    if ldsdItem.labelType == "LDx"
                                        label.delete(ldsdItem.theLabel)
                                        array.remove(ldsdLabels, i)
                                i -= 1
                        closeOppositeTrades(false)
                        if enableCandleCDL and revPass
                            // SHORT: stop above the block high / candle high, target below.
                            float e = calculateCandleEntry(htf_high, htf_low, htf_open, htf_close)
                            float slBase = (masterSLMode == "Block Extremes (HH/LL)" and not na(lastRevBoxHigh)) ? lastRevBoxHigh : htf_high
                            slP = slBase + (slTicksCandle * syminfo.mintick)
                            riskP = math.abs(e - slP)
                            tpP = e - (riskP * rrRatio)
                            newTrade = createTrade(false, e, slP, tpP, "PO4 CDSx", "CandleCDL", currentLiveBox.high, currentLiveBox.low, int(htf_time))
                            if addTradeToCategory(newTrade, "CandleCDL")
                                lastAction := "PO4 CDSx entry created"
                                if enableAlerts
                                    alert(lastAction, alert.freq_all)
                        marketDirection := "SHORT"
                // A continuation box (broken WITH the trend) is official only when
                // the trend agrees and the continuation gate is open.
                bool contBoxOk = closeBreaksAbove ? (currentBias == "CDLx" and (not gateOn or (bullImp and bullPb))) : (currentBias == "CDSx" and (not gateOn or (bearImp and bearPb)))
                currentLiveBox.isRev      := isReversal
                currentLiveBox.official   := isReversal ? revPass : contBoxOk
                currentLiveBox.breakoutDirection := closeBreaksAbove ? "up" : "down"
                currentLiveBox.CDLabel    := CDLabel
                currentLiveBox.hasCDLabel := isReversal and (revPass or show_failed)
                currentLiveBox.breakBar   := bar_index
                currentLiveBox.boxActive  := false
                shouldShowThisBox = (not showOnlyCDLPlus and not showOnlyCDLxCDSx) or (showOnlyCDLxCDSx and currentLiveBox.hasCDLabel)
                if shouldShowThisBox
                    if showOnlyCDLxCDSx and currentLiveBox.hasCDLabel
                        if na(currentLiveBox.boxes) and showContractionBoxes
                            ndbPercent = currentLiveBox.totalVolume > 0 ? currentLiveBox.netCVD / currentLiveBox.totalVolume : 0.0
                            boxColor = ndbPercent >= ndbThreshold ? NEUTRAL_ACCUMULATION_COLOR : ndbPercent <= -ndbThreshold ? NEUTRAL_DISTRIBUTION_COLOR : NEUTRAL_NEUTRAL_COLOR
                            currentLiveBox.boxes := box.new(left=currentLiveBox.startTime, top=currentLiveBox.high, right=time, bottom=currentLiveBox.low, bgcolor=boxColor, border_color=na, xloc=xloc.bar_time)
                        if na(currentLiveBox.highLine) and showContractionLines
                            lineColor = currentLiveBox.boxType == "Supply" ? bullishBodyCloseColor : bearishBodyCloseColor
                            currentLiveBox.highLine := line.new(x1=currentLiveBox.startTime, y1=currentLiveBox.high, x2=time, y2=currentLiveBox.high, color=lineColor, width=boxLineWidth, style=getLineStyle(boxLineStyle), xloc=xloc.bar_time)
                        if na(currentLiveBox.lowLine) and showContractionLines
                            lineColor = currentLiveBox.boxType == "Supply" ? bullishBodyCloseColor : bearishBodyCloseColor
                            currentLiveBox.lowLine := line.new(x1=currentLiveBox.startTime, y1=currentLiveBox.low, x2=time, y2=currentLiveBox.low, color=lineColor, width=boxLineWidth, style=getLineStyle(boxLineStyle), xloc=xloc.bar_time)
                        if na(currentLiveBox.midLine) and showBlockMidlines and showContractionLines
                            lineColor = currentLiveBox.boxType == "Supply" ? bullishBodyCloseColor : bearishBodyCloseColor
                            midPrice = (currentLiveBox.high + currentLiveBox.low) / 2
                            currentLiveBox.midLine := line.new(x1=currentLiveBox.startTime, y1=midPrice, x2=time, y2=midPrice, color=lineColor, style=line.style_dotted, width=midlineWidth, xloc=xloc.bar_time)
                    if showContractionBoxes and not na(currentLiveBox.boxes)
                        box.set_right(currentLiveBox.boxes, time)
                    if showContractionLines
                        if not na(currentLiveBox.highLine)
                            line.set_x2(currentLiveBox.highLine, time)
                        if not na(currentLiveBox.lowLine)
                            line.set_x2(currentLiveBox.lowLine, time)
                        if not na(currentLiveBox.midLine)
                            line.set_x2(currentLiveBox.midLine, time)
                else
                    if not na(currentLiveBox.boxes)
                        box.delete(currentLiveBox.boxes)
                        currentLiveBox.boxes := na
                    if not na(currentLiveBox.highLine)
                        line.delete(currentLiveBox.highLine)
                        currentLiveBox.highLine := na
                    if not na(currentLiveBox.lowLine)
                        line.delete(currentLiveBox.lowLine)
                        currentLiveBox.lowLine := na
                    if not na(currentLiveBox.midLine)
                        line.delete(currentLiveBox.midLine)
                        currentLiveBox.midLine := na
                    if not na(currentLiveBox.boxLabel)
                        label.delete(currentLiveBox.boxLabel)
                        currentLiveBox.boxLabel := na
                array.push(neutralBoxes, currentLiveBox)
                currentLiveBox             := na
                trackingNeutral            := false
                neutralCount               := 0
                neutralHigh                := na
                neutralLow                 := na
                neutralStartBar            := na
                neutralAccumulatedVolume   := 0.0
                neutralNetCVD              := 0.0
                neutralBuyVolume           := 0.0
                neutralSellVolume          := 0.0

    // LD/SD DETECTION — runs whatever entries are switched on (the count and
    // labels are structure, not an entry setting). A continuation needs a BODY
    // CLOSE beyond the last level (a wick through it is only a sweep), and it is
    // never counted on the flip candle itself.
    if lastWasReversal and not flipThisBar and barstate.isconfirmed and newHTFBlockCandle and in_calc_range
        if currentBias == "CDLx" and htf_isBullishBodyClose and not na(lastRevBoxHigh)
            if htf_close > lastRevBoxHigh
                ldCount += 1
                contThisBar := true
                contPass    := not gateOn or (bullImp and bullPb)
                bullImp     := false
                bullPb      := false
                ev_ld       := contPass
                ldLabel  = "LDx" + str.tostring(ldCount)
                tfString = f_timeframeToString(blockTF)
                label sharedLDLabel = na
                if (showCDLabels or showOnlyCDLxCDSx) and showLDSDLabels and (contPass or show_failed)
                    ldLabelText = showTimeframeLabel ? getBlockLabelText(true, tfString, blockLabelFormat, ldLabel) : getBlockLabelText(true, "", blockLabelFormat, ldLabel)
                    sharedLDLabel := label.new(x=int(math.avg(nz(lastRevHT, htf_time), htf_time)), y=lastRevBoxHigh, text=contPass ? ldLabelText : str.lower(ldLabelText), style=label.style_label_down, size=getSizeFromString(blockLabelSize), color=color.new(color.white, 100), textcolor=contPass ? CDLongColor : FAIL_COL, xloc=xloc.bar_time, tooltip=ldLabel + (contPass ? " (official)" : " (failed " + gate_mode + ")"))
                    array.push(ldsdLabels, LDSDLabel.new(sharedLDLabel, "LDx", ldCount, int(htf_time)))
                if enableCandleLD and contPass
                    float e = calculateCandleEntry(htf_high, htf_low, htf_open, htf_close)
                    float slBase = (masterSLMode == "Block Extremes (HH/LL)" and not na(lastRevBoxLow)) ? lastRevBoxLow : htf_low
                    slP = slBase - (slTicksCandle * syminfo.mintick)
                    riskP = math.abs(e - slP)
                    tpP = e + (riskP * rrRatio)
                    newTrade = createTrade(true, e, slP, tpP, "PO4 " + ldLabel, "CandleLD", htf_high, htf_low, int(htf_time))
                    newTrade.ldsdLabel := sharedLDLabel
                    newTrade.fromCDLPlus := false
                    if addTradeToCategory(newTrade, "CandleLD")
                        lastAction := "PO4 " + ldLabel + " entry created"
                        if enableAlerts
                            alert(lastAction, alert.freq_all)
                lastSignalType := contPass ? ldLabel : str.lower(ldLabel)
                lastRevBoxHigh := htf_high
        else if currentBias == "CDSx" and htf_isBearishBodyClose and not na(lastRevBoxLow)
            if htf_close < lastRevBoxLow
                sdCount += 1
                contThisBar := true
                contPass    := not gateOn or (bearImp and bearPb)
                bearImp     := false
                bearPb      := false
                ev_sd       := contPass
                sdLabel  = "SDx" + str.tostring(sdCount)
                tfString = f_timeframeToString(blockTF)
                label sharedSDLabel = na
                if (showCDLabels or showOnlyCDLxCDSx) and showLDSDLabels and (contPass or show_failed)
                    sdLabelText = showTimeframeLabel ? getBlockLabelText(false, tfString, blockLabelFormat, sdLabel) : getBlockLabelText(false, "", blockLabelFormat, sdLabel)
                    sharedSDLabel := label.new(x=int(math.avg(nz(lastRevLT, htf_time), htf_time)), y=lastRevBoxLow, text=contPass ? sdLabelText : str.lower(sdLabelText), style=label.style_label_up, size=getSizeFromString(blockLabelSize), color=color.new(color.white, 100), textcolor=contPass ? CDShortColor : FAIL_COL, xloc=xloc.bar_time, tooltip=sdLabel + (contPass ? " (official)" : " (failed " + gate_mode + ")"))
                    array.push(ldsdLabels, LDSDLabel.new(sharedSDLabel, "SDx", sdCount, int(htf_time)))
                if enableCandleLD and contPass
                    float e = calculateCandleEntry(htf_high, htf_low, htf_open, htf_close)
                    float slBase = (masterSLMode == "Block Extremes (HH/LL)" and not na(lastRevBoxHigh)) ? lastRevBoxHigh : htf_high
                    slP = slBase + (slTicksCandle * syminfo.mintick)
                    riskP = math.abs(e - slP)
                    tpP = e - (riskP * rrRatio)
                    newTrade = createTrade(false, e, slP, tpP, "PO4 " + sdLabel, "CandleLD", htf_high, htf_low, int(htf_time))
                    newTrade.ldsdLabel := sharedSDLabel
                    newTrade.fromCDLPlus := false
                    if addTradeToCategory(newTrade, "CandleLD")
                        lastAction := "PO4 " + sdLabel + " entry created"
                        if enableAlerts
                            alert(lastAction, alert.freq_all)
                lastSignalType := contPass ? sdLabel : str.lower(sdLabel)
                lastRevBoxLow := htf_low
        while array.size(ldsdLabels) > 50
            LDSDLabel oldL = array.shift(ldsdLabels)
            label.delete(oldL.theLabel)

    // CDLx+/CDSx+ CREATION
    runCDLPlusLogic = showCDLPlus or enableCandleCDLPlus or enableBlockCDLPlus
    if runCDLPlusLogic and barstate.isconfirmed and newHTFBlockCandle and in_calc_range
        currentIsBullBC = htf_isBullishBodyClose
        currentIsBearBC = htf_isBearishBodyClose
        bool shouldCheckForCDLPlus = false
        bool cdlPlusIsOutsideBoxes  = false
        if cdlPlusMode == "All CDLx+"
            shouldCheckForCDLPlus := true
            cdlPlusIsOutsideBoxes := isCandleOutsideAllUnbrokenBoxes(0, currentLiveBox)
        else
            cdlPlusIsOutsideBoxes := isCandleOutsideAllUnbrokenBoxes(0, currentLiveBox)
            shouldCheckForCDLPlus := cdlPlusIsOutsideBoxes

        if shouldCheckForCDLPlus
            shouldShowCDLPlus = showCDLPlus and ((not showOnlyCDLxCDSx) or showOnlyCDLPlus)
            tfString = f_timeframeToString(blockTF)

            // BuBC right after a BeBC. Three cases:
            //  - a box CDLx already fired on this candle -> same event, no recount
            //  - trend not bull yet                        -> CDLx+ FLIP
            //  - trend already bull                        -> LDx#+ CONTINUATION
            //    (unless an LDx was already counted on this candle)
            if prevWasBearishBC and currentIsBullBC
                bool   isReversalCDLPlus = false
                string cdlPlusLabel = ""
                bool   plusPass = true
                if flipThisBar
                    plusPass := flipPass
                else if currentBias != "CDLx"
                    isReversalCDLPlus := true
                    plusPass := not gateOn or hitXD
                    flipThisBar := true
                    flipPass    := plusPass
                    ev_cdl      := plusPass
                    lastSignalType := plusPass ? "CDLx+" : "cdlx+"
                    currentBias    := "CDLx"
                    ldCount        := 0
                    sdCount        := 0
                    lastRevBoxHigh := htf_high
                    lastRevBoxLow  := htf_prev_low
                    lastWasReversal := true
                    hitXD   := false
                    hitXP   := false
                    bullImp := false
                    bullPb  := false
                    bearImp := false
                    bearPb  := false
                    if array.size(ldsdLabels) > 0
                        i = array.size(ldsdLabels) - 1
                        while i >= 0
                            if array.size(ldsdLabels) > i
                                ldsdItem = array.get(ldsdLabels, i)
                                if ldsdItem.labelType == "SDx"
                                    label.delete(ldsdItem.theLabel)
                                    array.remove(ldsdLabels, i)
                            i -= 1
                    closeOppositeTrades(true)
                else if contThisBar
                    plusPass := contPass
                else
                    ldCount  += 1
                    contThisBar := true
                    plusPass := not gateOn or (bullImp and bullPb)
                    contPass := plusPass
                    bullImp  := false
                    bullPb   := false
                    ev_ld    := plusPass
                    cdlPlusLabel := "LDx" + str.tostring(ldCount) + "+"
                    lastSignalType := plusPass ? cdlPlusLabel : str.lower(cdlPlusLabel)
                    label sharedLDLabel = na
                    if shouldShowCDLPlus and (showCDLabels or showOnlyCDLxCDSx) and showLDSDLabels and (plusPass or show_failed)
                        ldLabelText = showTimeframeLabel ? getBlockLabelText(true, tfString, blockLabelFormat, cdlPlusLabel) : getBlockLabelText(true, "", blockLabelFormat, cdlPlusLabel)
                        sharedLDLabel := label.new(x=int(math.avg(nz(lastRevHT, htf_time), htf_time)), y=lastRevBoxHigh, text=plusPass ? ldLabelText : str.lower(ldLabelText), style=label.style_label_down, size=getSizeFromString(blockLabelSize), color=color.new(color.white, 100), textcolor=plusPass ? CDLongColor : FAIL_COL, xloc=xloc.bar_time)
                        array.push(ldsdLabels, LDSDLabel.new(sharedLDLabel, "LDx", ldCount, int(htf_time)))
                    if enableCandleLD and plusPass
                        float e = calculateCandleEntry(htf_high, htf_low, htf_open, htf_close)
                        float slBase = (masterSLMode == "Block Extremes (HH/LL)" and not na(lastRevBoxLow)) ? lastRevBoxLow : htf_low
                        slP = slBase - (slTicksCandle * syminfo.mintick)
                        riskP = math.abs(e - slP)
                        tpP = e + (riskP * rrRatio)
                        newTrade = createTrade(true, e, slP, tpP, "PO4 " + cdlPlusLabel, "CandleLD", htf_high, htf_prev_low, int(htf_time))
                        newTrade.ldsdLabel := sharedLDLabel
                        newTrade.fromCDLPlus := true
                        if addTradeToCategory(newTrade, "CandleLD")
                            lastAction := "PO4 " + cdlPlusLabel + " entry created (CDLx+)"
                            if enableAlerts
                                alert(lastAction, alert.freq_all)
                lastRevBoxHigh := htf_high
                if shouldShowCDLPlus and showCDLxPlus and (plusPass or show_failed)
                    blk = createCDLPlusBlock("CDLx+", bar_index, int(htf_prev_time), htf_high, htf_prev_low, htf_open, htf_close, tfString, plusPass)
                    array.push(cdlPlusBlocks, blk)
                if enableCandleCDLPlus and plusPass
                    lastSignalPrice := htf_high
                    float e = calculateCandleEntry(htf_high, htf_low, htf_open, htf_close)
                    float slBase = (masterSLMode == "Block Extremes (HH/LL)") ? htf_prev_low : htf_low
                    slP = slBase - (slTicksCandle * syminfo.mintick)
                    riskP = math.abs(e - slP)
                    tpP = e + (riskP * rrRatio)
                    newTrade = createTrade(true, e, slP, tpP, "CDLx+", "CandleCDLPlus", htf_high, htf_prev_low, int(htf_time))
                    newTrade.fromCDLPlus := true
                    if addTradeToCategory(newTrade, "CandleCDLPlus")
                        marketDirection := "LONG"
                        lastAction := "CDLx+ entry created" + (isReversalCDLPlus ? " (Reversal)" : " (Continuation)")
                        if enableAlerts
                            alert(lastAction, alert.freq_all)

            if prevWasBullishBC and currentIsBearBC
                bool   isReversalCDLPlus = false
                string cdlPlusLabel = ""
                bool   plusPass = true
                if flipThisBar
                    plusPass := flipPass
                else if currentBias != "CDSx"
                    isReversalCDLPlus := true
                    plusPass := not gateOn or hitXP
                    flipThisBar := true
                    flipPass    := plusPass
                    ev_cds      := plusPass
                    lastSignalType := plusPass ? "CDSx+" : "cdsx+"
                    currentBias    := "CDSx"
                    ldCount        := 0
                    sdCount        := 0
                    lastRevBoxHigh := htf_prev_high
                    lastRevBoxLow  := htf_low
                    lastWasReversal := true
                    hitXD   := false
                    hitXP   := false
                    bullImp := false
                    bullPb  := false
                    bearImp := false
                    bearPb  := false
                    if array.size(ldsdLabels) > 0
                        i = array.size(ldsdLabels) - 1
                        while i >= 0
                            if array.size(ldsdLabels) > i
                                ldsdItem = array.get(ldsdLabels, i)
                                if ldsdItem.labelType == "LDx"
                                    label.delete(ldsdItem.theLabel)
                                    array.remove(ldsdLabels, i)
                            i -= 1
                    closeOppositeTrades(false)
                else if contThisBar
                    plusPass := contPass
                else
                    sdCount  += 1
                    contThisBar := true
                    plusPass := not gateOn or (bearImp and bearPb)
                    contPass := plusPass
                    bearImp  := false
                    bearPb   := false
                    ev_sd    := plusPass
                    cdlPlusLabel := "SDx" + str.tostring(sdCount) + "+"
                    lastSignalType := plusPass ? cdlPlusLabel : str.lower(cdlPlusLabel)
                    label sharedSDLabel = na
                    if shouldShowCDLPlus and (showCDLabels or showOnlyCDLxCDSx) and showLDSDLabels and (plusPass or show_failed)
                        sdLabelText = showTimeframeLabel ? getBlockLabelText(false, tfString, blockLabelFormat, cdlPlusLabel) : getBlockLabelText(false, "", blockLabelFormat, cdlPlusLabel)
                        sharedSDLabel := label.new(x=int(math.avg(nz(lastRevLT, htf_time), htf_time)), y=lastRevBoxLow, text=plusPass ? sdLabelText : str.lower(sdLabelText), style=label.style_label_up, size=getSizeFromString(blockLabelSize), color=color.new(color.white, 100), textcolor=plusPass ? CDShortColor : FAIL_COL, xloc=xloc.bar_time)
                        array.push(ldsdLabels, LDSDLabel.new(sharedSDLabel, "SDx", sdCount, int(htf_time)))
                    if enableCandleLD and plusPass
                        float e = calculateCandleEntry(htf_high, htf_low, htf_open, htf_close)
                        float slBase = (masterSLMode == "Block Extremes (HH/LL)" and not na(lastRevBoxHigh)) ? lastRevBoxHigh : htf_high
                        slP = slBase + (slTicksCandle * syminfo.mintick)
                        riskP = math.abs(e - slP)
                        tpP = e - (riskP * rrRatio)
                        newTrade = createTrade(false, e, slP, tpP, "PO4 " + cdlPlusLabel, "CandleLD", htf_prev_high, htf_low, int(htf_time))
                        newTrade.ldsdLabel := sharedSDLabel
                        newTrade.fromCDLPlus := true
                        if addTradeToCategory(newTrade, "CandleLD")
                            lastAction := "PO4 " + cdlPlusLabel + " entry created (CDSx+)"
                            if enableAlerts
                                alert(lastAction, alert.freq_all)
                lastRevBoxLow := htf_low
                if shouldShowCDLPlus and showCDSxPlus and (plusPass or show_failed)
                    blk = createCDLPlusBlock("CDSx+", bar_index, int(htf_prev_time), htf_prev_high, htf_low, htf_open, htf_close, tfString, plusPass)
                    array.push(cdlPlusBlocks, blk)
                if enableCandleCDLPlus and plusPass
                    lastSignalPrice := htf_low
                    float e = calculateCandleEntry(htf_high, htf_low, htf_open, htf_close)
                    float slBase = (masterSLMode == "Block Extremes (HH/LL)") ? htf_prev_high : htf_high
                    slP = slBase + (slTicksCandle * syminfo.mintick)
                    riskP = math.abs(e - slP)
                    tpP = e - (riskP * rrRatio)
                    newTrade = createTrade(false, e, slP, tpP, "CDSx+", "CandleCDLPlus", htf_prev_high, htf_low, int(htf_time))
                    newTrade.fromCDLPlus := true
                    if addTradeToCategory(newTrade, "CandleCDLPlus")
                        marketDirection := "SHORT"
                        lastAction := "CDSx+ entry created" + (isReversalCDLPlus ? " (Reversal)" : " (Continuation)")
                        if enableAlerts
                            alert(lastAction, alert.freq_all)

        prevWasBullishBC := currentIsBullBC
        prevWasBearishBC := currentIsBearBC

// =====================================================
// LTF ZONE TOUCH + LIMIT ENTRY CONFIRMATION
// =====================================================

// 1. Long Limit Entries (Demand Blocks & CDLx+ & LDx)
if array.size(violatedHighNeutralBoxes) > 0 and (enableBlockCDL or enableBlockLD) and in_calc_range
    for i = 0 to array.size(violatedHighNeutralBoxes) - 1
        box_item = array.get(violatedHighNeutralBoxes, i)
        if not box_item.zoneTouched
            isLongBox = true
            float boxMid = (box_item.high + box_item.low) / 2
            float zonePrice = getZonePrice(isLongBox, box_item.high, box_item.low, boxMid)

            if checkZoneTouched(isLongBox, zonePrice, low, high)
                box_item.zoneTouched := true
                array.set(violatedHighNeutralBoxes, i, box_item)

                isReversal    = box_item.isRev
                shouldCreate  = (isReversal ? enableBlockCDL : enableBlockLD) and box_item.official
                entryCategory = isReversal ? "BlockCDL" : "BlockLD"

                if shouldCreate
                    float e = zonePrice
                    float slBase = (masterSLMode == "Block Extremes (HH/LL)") ? box_item.low : low
                    float slP = slBase - (slTicksBox * syminfo.mintick)
                    float riskP = math.abs(e - slP)
                    float tpP = e + (riskP * rrRatio)

                    string tfString  = showTimeframeLabel ? f_timeframeToString(blockTF) + " " : ""
                    string entryLabel = isReversal ? tfString + "CDLx Limit" : tfString + "LDx" + (ldCount > 0 ? str.tostring(ldCount) : "") + " Limit"
                    newTrade = createTrade(isLongBox, e, slP, tpP, entryLabel, entryCategory, box_item.high, box_item.low, int(time))
                    if addTradeToCategory(newTrade, entryCategory)
                        lastAction := entryLabel + " triggered @ " + str.tostring(e, format.mintick)
                        if enableAlerts
                            alert(lastAction, alert.freq_all)

// 2. Short Limit Entries (Supply Blocks & CDSx+ & SDx)
if array.size(violatedLowNeutralBoxes) > 0 and (enableBlockCDL or enableBlockLD) and in_calc_range
    for i = 0 to array.size(violatedLowNeutralBoxes) - 1
        box_item = array.get(violatedLowNeutralBoxes, i)
        if not box_item.zoneTouched
            isLongBox = false
            float boxMid = (box_item.high + box_item.low) / 2
            float zonePrice = getZonePrice(isLongBox, box_item.high, box_item.low, boxMid)

            if checkZoneTouched(isLongBox, zonePrice, low, high)
                box_item.zoneTouched := true
                array.set(violatedLowNeutralBoxes, i, box_item)

                isReversal    = box_item.isRev
                shouldCreate  = (isReversal ? enableBlockCDL : enableBlockLD) and box_item.official
                entryCategory = isReversal ? "BlockCDL" : "BlockLD"

                if shouldCreate
                    float e = zonePrice
                    float slBase = (masterSLMode == "Block Extremes (HH/LL)") ? box_item.high : high
                    float slP = slBase + (slTicksBox * syminfo.mintick)
                    float riskP = math.abs(e - slP)
                    float tpP = e - (riskP * rrRatio)

                    string tfString  = showTimeframeLabel ? f_timeframeToString(blockTF) + " " : ""
                    string entryLabel = isReversal ? tfString + "CDSx Limit" : tfString + "SDx" + (sdCount > 0 ? str.tostring(sdCount) : "") + " Limit"
                    newTrade = createTrade(isLongBox, e, slP, tpP, entryLabel, entryCategory, box_item.high, box_item.low, int(time))
                    if addTradeToCategory(newTrade, entryCategory)
                        lastAction := entryLabel + " triggered @ " + str.tostring(e, format.mintick)
                        if enableAlerts
                            alert(lastAction, alert.freq_all)

// 3. CDLx+/CDSx+ Limit Entries
if array.size(cdlPlusBlocks) > 0 and enableBlockCDLPlus and in_calc_range
    for i = 0 to array.size(cdlPlusBlocks) - 1
        blk = array.get(cdlPlusBlocks, i)
        if not blk.zoneTouched and blk.official
            isLongBox = blk.type == "CDLx+"
            float boxMid = (blk.highPrice + blk.lowPrice) / 2
            float zonePrice = getZonePrice(isLongBox, blk.highPrice, blk.lowPrice, boxMid)

            if isLongBox and low <= zonePrice
                blk.zoneTouched := true
                array.set(cdlPlusBlocks, i, blk)
                float e = zonePrice
                float slBase = (masterSLMode == "Block Extremes (HH/LL)") ? blk.lowPrice : low
                float slP = slBase - (slTicksBox * syminfo.mintick)
                float riskP = math.abs(e - slP)
                float tpP = e + (riskP * rrRatio)

                newTrade = createTrade(true, e, slP, tpP, "CDLx+ Limit", "BlockCDLPlus", blk.highPrice, blk.lowPrice, int(time))
                if addTradeToCategory(newTrade, "BlockCDLPlus")
                    lastAction := "CDLx+ Limit triggered @ " + str.tostring(e, format.mintick)
                    if enableAlerts
                        alert(lastAction, alert.freq_all)

            else if not isLongBox and high >= zonePrice
                blk.zoneTouched := true
                array.set(cdlPlusBlocks, i, blk)
                float e = zonePrice
                float slBase = (masterSLMode == "Block Extremes (HH/LL)") ? blk.highPrice : high
                float slP = slBase + (slTicksBox * syminfo.mintick)
                float riskP = math.abs(e - slP)
                float tpP = e - (riskP * rrRatio)

                newTrade = createTrade(false, e, slP, tpP, "CDSx+ Limit", "BlockCDLPlus", blk.highPrice, blk.lowPrice, int(time))
                if addTradeToCategory(newTrade, "BlockCDLPlus")
                    lastAction := "CDSx+ Limit triggered @ " + str.tostring(e, format.mintick)
                    if enableAlerts
                        alert(lastAction, alert.freq_all)

// =====================================================
// SWEEP DETECTION AND PREMATURE EXITS
// =====================================================
if showSweepLines and barstate.isconfirmed and in_calc_range
    if not na(swH) and high > swH and close < swH
        string lblTxt = ""
        string sweepStrength = ""
        if close > swHC
            lblTxt := sweepLabelMode == "X Mode" ? "X" : "W.Sw"
            sweepStrength := "WEAK"
        else if close < swHC and close > swHM
            lblTxt := sweepLabelMode == "X Mode" ? "X+" : "S.Sw"
            sweepStrength := "STRONG"
        else if close < swHM
            lblTxt := sweepLabelMode == "X Mode" ? "X++" : "SS.Sw"
            sweepStrength := "SUPER_STRONG"
        deleteSweepLine(lastBearishSweep)
        ln  = line.new(x1=swHTime, y1=swH, x2=time, y2=swH, color=sweepLineColor, width=sweepLineWidth, xloc=xloc.bar_time)
        lbl = label.new(x=time, y=swH, text=lblTxt, style=label.style_label_left, color=color.new(color.white, 100), textcolor=sweepLineColor, size=getSizeFromString(sweepLabelSize), xloc=xloc.bar_time, tooltip="Buy-side sweep. Deleted when a candle CLOSES above this sweep candle high.")
        lastBearishSweep := SweepLine.new(ln, lbl, swH, swHTime, time, lblTxt, false, high)
        for category in array.from("BlockCDLPlus", "BlockCDL", "BlockLD", "CandleCDLPlus", "CandleCDL", "CandleLD")
            targetArray = switch category
                "BlockCDLPlus"   => trades_BlockCDLPlus
                "BlockCDL"       => trades_BlockCDL
                "BlockLD"        => trades_BlockLD
                "CandleCDLPlus"  => trades_CandleCDLPlus
                "CandleCDL"      => trades_CandleCDL
                "CandleLD"       => trades_CandleLD
                => trades_BlockCDL
            i = array.size(targetArray) - 1
            while i >= 0
                if array.size(targetArray) > i
                    t = array.get(targetArray, i)
                    shouldExit = false
                    if t.isLong
                        if sweepStrength == "WEAK" and exitOnWeakSweep
                            shouldExit := true
                        else if sweepStrength == "STRONG" and exitOnStrongSweep
                            shouldExit := true
                        else if sweepStrength == "SUPER_STRONG" and exitOnSuperStrongSweep
                            shouldExit := true
                        if shouldExit
                            t.forceExit := true
                            t.forceExitReason := "Sweep (" + lblTxt + ")"
                            array.set(targetArray, i, t)
                i -= 1

    if not na(swL) and low < swL and close > swL
        string lblTxt = ""
        string sweepStrength = ""
        if close < swLC
            lblTxt := sweepLabelMode == "X Mode" ? "X" : "W.Sw"
            sweepStrength := "WEAK"
        else if close > swLC and close < swLM
            lblTxt := sweepLabelMode == "X Mode" ? "X+" : "S.Sw"
            sweepStrength := "STRONG"
        else if close > swLM
            lblTxt := sweepLabelMode == "X Mode" ? "X++" : "SS.Sw"
            sweepStrength := "SUPER_STRONG"
        deleteSweepLine(lastBullishSweep)
        ln  = line.new(x1=swLTime, y1=swL, x2=time, y2=swL, color=sweepLineColor, width=sweepLineWidth, xloc=xloc.bar_time)
        lbl = label.new(x=time, y=swL, text=lblTxt, style=label.style_label_left, color=color.new(color.white, 100), textcolor=sweepLineColor, size=getSizeFromString(sweepLabelSize), xloc=xloc.bar_time, tooltip="Sell-side sweep. Deleted when a candle CLOSES below this sweep candle low.")
        lastBullishSweep := SweepLine.new(ln, lbl, swL, swLTime, time, lblTxt, true, low)
        for category in array.from("BlockCDLPlus", "BlockCDL", "BlockLD", "CandleCDLPlus", "CandleCDL", "CandleLD")
            targetArray = switch category
                "BlockCDLPlus"   => trades_BlockCDLPlus
                "BlockCDL"       => trades_BlockCDL
                "BlockLD"        => trades_BlockLD
                "CandleCDLPlus"  => trades_CandleCDLPlus
                "CandleCDL"      => trades_CandleCDL
                "CandleLD"       => trades_CandleLD
                => trades_BlockCDL
            i = array.size(targetArray) - 1
            while i >= 0
                if array.size(targetArray) > i
                    t = array.get(targetArray, i)
                    shouldExit = false
                    if not t.isLong
                        if sweepStrength == "WEAK" and exitOnWeakSweep
                            shouldExit := true
                        else if sweepStrength == "STRONG" and exitOnStrongSweep
                            shouldExit := true
                        else if sweepStrength == "SUPER_STRONG" and exitOnSuperStrongSweep
                            shouldExit := true
                        if shouldExit
                            t.forceExit := true
                            t.forceExitReason := "Sweep (" + lblTxt + ")"
                            array.set(targetArray, i, t)
                i -= 1

// A sweep dies when a candle CLOSES beyond the sweep candle itself.
if barstate.isconfirmed and not na(lastBearishSweep) and time > lastBearishSweep.endTime and close > lastBearishSweep.candleExt
    deleteSweepLine(lastBearishSweep)
    lastBearishSweep := na

if barstate.isconfirmed and not na(lastBullishSweep) and time > lastBullishSweep.endTime and close < lastBullishSweep.candleExt
    deleteSweepLine(lastBullishSweep)
    lastBullishSweep := na

// =====================================================
// TRADE MONITORING (STRICT STATE ENGINE)
// =====================================================
totalUnrealizedPL := 0.0

for category in array.from("BlockCDLPlus", "BlockCDL", "BlockLD", "CandleCDLPlus", "CandleCDL", "CandleLD")
    targetArray = switch category
        "BlockCDLPlus"   => trades_BlockCDLPlus
        "BlockCDL"       => trades_BlockCDL
        "BlockLD"        => trades_BlockLD
        "CandleCDLPlus"  => trades_CandleCDLPlus
        "CandleCDL"      => trades_CandleCDL
        "CandleLD"       => trades_CandleLD
        => trades_BlockCDL

    if array.size(targetArray) > 0
        i = array.size(targetArray) - 1
        while i >= 0
            if array.size(targetArray) > i
                t = array.get(targetArray, i)
                endBar = bar_index + lineExtension

                line.set_x2(t.eLine, endBar)
                line.set_x2(t.sLine, endBar)
                line.set_x2(t.tLine, endBar)
                label.set_x(t.eLbl, endBar)
                label.set_x(t.sLbl, endBar)
                label.set_x(t.tLbl, endBar)

                if t.activated
                    bool liveHitTP = t.isLong ? (high >= t.tp) : (low <= t.tp)
                    bool liveHitSL = t.isLong ? (low <= t.sl)  : (high >= t.sl)

                    if liveHitTP or liveHitSL
                        line.set_color(t.eLine, color.gray)
                        line.set_color(t.sLine, color.gray)
                        line.set_color(t.tLine, color.gray)
                        label.set_textcolor(t.eLbl, color.gray)
                        label.set_textcolor(t.sLbl, color.gray)
                        label.set_textcolor(t.tLbl, color.gray)

                if t.activated
                    float _rD   = math.abs(t.entry - t.sl)
                    float _dist = t.isLong ? (close - t.entry) : (t.entry - close)
                    if _rD > 0
                        totalUnrealizedPL += (_dist / _rD) * t.riskDollars

                if barstate.isconfirmed
                    bool tradeRemoved = false

                    if not t.activated and (bar_index - t.creationBar) > 500
                        t.forceExit := true
                        t.forceExitReason := "Expired"

                    if not t.activated and not t.forceExit and newsBlock
                        t.forceExit := true
                        t.forceExitReason := "News Window"

                    if t.activated and exitBoxReentry and not t.forceExit
                        bool shouldExit = false
                        if str.contains(t.entryType, "CDLx") or str.contains(t.entryType, "CDSx")
                            if boxReentryMode == "Box Edge"
                                shouldExit := (t.isLong and close < t.boxLow) or (not t.isLong and close > t.boxHigh)
                            else if boxReentryMode == "Midline"
                                shouldExit := (t.isLong and close < t.boxMid) or (not t.isLong and close > t.boxMid)
                        if shouldExit
                            t.forceExit := true
                            t.forceExitReason := "Box Re-entry"

                    if not t.activated and not t.forceExit and bar_index > t.creationBar
                        bool hitTpEarly = t.isLong ? (high >= t.tp) : (low <= t.tp)
                        bool hitSlEarly = t.isLong ? (low <= t.sl) : (high >= t.sl)

                        if hitTpEarly or hitSlEarly
                            t.forceExit := true
                            t.forceExitReason := "Missed (TGT/SL Hit Before Entry)"
                        else
                            bool hitEntry = t.isLong ? (low <= t.entry) : (high >= t.entry)
                            if hitEntry
                                t.activated := true
                                lastAction := t.entryType + " ACTIVATED"
                                if enableAlerts
                                    alert(lastAction, alert.freq_all)
                                line.set_style(t.eLine, line.style_solid)
                                line.set_color(t.eLine, entryLineColor)

                    if (t.activated or t.forceExit)
                        bool isWin = false
                        float pnl = 0.0
                        float rr = 0.0
                        string exitMsg = ""
                        bool exitTriggered = false

                        if t.forceExit
                            array.set(manualExitWarningFlag, 0, true)
                            float exitPrice = close
                            float _rD = math.abs(t.entry - t.sl)
                            if t.activated and _rD > 0
                                pnl := t.isLong ? ((exitPrice - t.entry) / _rD) * t.riskDollars : ((t.entry - exitPrice) / _rD) * t.riskDollars
                            rr := t.riskDollars > 0 ? pnl / t.riskDollars : 0.0
                            isWin := pnl >= 0
                            exitMsg := " ⚠️ Exited: " + t.forceExitReason + " (" + (isWin ? "+" : "") + str.tostring(rr, "#.##") + "R)"
                            exitTriggered := true
                            if not t.activated
                                exitMsg := " Cancelled: " + t.forceExitReason
                        else
                            bool hitTP = t.isLong ? (high >= t.tp)  : (low <= t.tp)
                            bool hitSL = t.isLong ? (low <= t.sl)   : (high >= t.sl)

                            if hitTP or hitSL
                                isWin := hitTP and not hitSL
                                pnl := isWin ? t.riskDollars * rrRatio : -t.riskDollars
                                rr  := isWin ? rrRatio : -1.0
                                exitMsg := isWin ? " ✅ HIT TP" : " ❌ HIT SL"
                                exitTriggered := true

                        if exitTriggered
                            if isWin
                                totalWins_all      += 1
                                totalProfitDollars += pnl
                                totalPosRR         += rr
                                consecWins         := lastOutcome == "win" ? consecWins + 1 : 1
                                consecLosses       := 0
                                maxConsecWins      := math.max(maxConsecWins, consecWins)
                                lastOutcome        := "win"
                                switch category
                                    "CandleCDLPlus" => w_CandleCDLPlus += 1
                                    "CandleCDL"     => w_CandleCDL     += 1
                                    "CandleLD"      => w_CandleLD      += 1
                                    "BlockCDLPlus"  => w_BlockCDLPlus  += 1
                                    "BlockCDL"      => w_BlockCDL      += 1
                                    "BlockLD"       => w_BlockLD       += 1
                            else
                                if t.activated
                                    totalLosses_all  += 1
                                    totalLossDollars += math.abs(pnl)
                                    totalNegRR       += math.abs(rr)
                                    consecLosses     := lastOutcome == "loss" ? consecLosses + 1 : 1
                                    consecWins       := 0
                                    maxConsecLosses  := math.max(maxConsecLosses, consecLosses)
                                    lastOutcome      := "loss"
                                    switch category
                                        "CandleCDLPlus" => l_CandleCDLPlus += 1
                                        "CandleCDL"     => l_CandleCDL     += 1
                                        "CandleLD"      => l_CandleLD      += 1
                                        "BlockCDLPlus"  => l_BlockCDLPlus  += 1
                                        "BlockCDL"      => l_BlockCDL      += 1
                                        "BlockLD"       => l_BlockLD       += 1

                            float curEq     = totalProfitDollars - totalLossDollars
                            peakEquity     := math.max(peakEquity, curEq)
                            maxDrawdownStat := math.max(maxDrawdownStat, peakEquity - curEq)

                            lastAction := t.entryType + exitMsg
                            if enableAlerts
                                alert(lastAction, alert.freq_all)
                            deleteTrade(t)
                            array.remove(targetArray, i)
            i -= 1

// =====================================================
// CDLx+/CDSx+ MANAGEMENT
// =====================================================
if showCDLPlus and array.size(cdlPlusBlocks) > 0 and ((not showOnlyCDLxCDSx) or showOnlyCDLPlus)
    i = array.size(cdlPlusBlocks) - 1
    while i >= 0
        blk = array.get(cdlPlusBlocks, i)
        shouldDelete = barstate.isconfirmed and blk.creationBar != bar_index and ((blk.type == "CDLx+" and close < blk.price) or (blk.type == "CDSx+" and close > blk.price))
        if shouldDelete
            deleteCDLPlusBlock(blk)
            array.remove(cdlPlusBlocks, i)
        i -= 1
    if array.size(cdlPlusBlocks) > 0
        for item in cdlPlusBlocks
            extendCDLPlusBlock(item)

// =====================================================
// BOX MANAGEMENT
// =====================================================
neutralBoxesSize = array.size(neutralBoxes)
if neutralBoxesSize > 0
    i = neutralBoxesSize - 1
    while i >= 0
        if array.size(neutralBoxes) > i
            neutralBox = array.get(neutralBoxes, i)
            // Every box in this list is already broken by a CLOSE. Route it by
            // the direction it actually broke, never by whichever wick came first.
            if neutralBox.breakoutDirection == "up"
                if showOnlyCDLxCDSx and not neutralBox.hasCDLabel
                    if not na(neutralBox.highLine)
                        line.delete(neutralBox.highLine)
                    if not na(neutralBox.lowLine)
                        line.delete(neutralBox.lowLine)
                    if not na(neutralBox.midLine)
                        line.delete(neutralBox.midLine)
                    if not na(neutralBox.boxes)
                        box.delete(neutralBox.boxes)
                    if not na(neutralBox.boxLabel)
                        label.delete(neutralBox.boxLabel)
                    if not na(neutralBox.CDLabel)
                        label.delete(neutralBox.CDLabel)
                    if not na(neutralBox.ldsdLabel)
                        label.delete(neutralBox.ldsdLabel)
                else
                    array.push(violatedHighNeutralBoxes, neutralBox)
                array.remove(neutralBoxes, i)
            else if neutralBox.breakoutDirection == "down"
                if showOnlyCDLxCDSx and not neutralBox.hasCDLabel
                    if not na(neutralBox.highLine)
                        line.delete(neutralBox.highLine)
                    if not na(neutralBox.lowLine)
                        line.delete(neutralBox.lowLine)
                    if not na(neutralBox.midLine)
                        line.delete(neutralBox.midLine)
                    if not na(neutralBox.boxes)
                        box.delete(neutralBox.boxes)
                    if not na(neutralBox.boxLabel)
                        label.delete(neutralBox.boxLabel)
                    if not na(neutralBox.CDLabel)
                        label.delete(neutralBox.CDLabel)
                    if not na(neutralBox.ldsdLabel)
                        label.delete(neutralBox.ldsdLabel)
                else
                    array.push(violatedLowNeutralBoxes, neutralBox)
                array.remove(neutralBoxes, i)
        i -= 1

violatedHighNeutralBoxesSize = array.size(violatedHighNeutralBoxes)
if violatedHighNeutralBoxesSize > 0
    i = violatedHighNeutralBoxesSize - 1
    while i >= 0
        if array.size(violatedHighNeutralBoxes) > i
            neutralBox = array.get(violatedHighNeutralBoxes, i)
            if showOnlyCDLxCDSx and not neutralBox.hasCDLabel
                if not na(neutralBox.highLine)
                    line.delete(neutralBox.highLine)
                if not na(neutralBox.lowLine)
                    line.delete(neutralBox.lowLine)
                if not na(neutralBox.midLine)
                    line.delete(neutralBox.midLine)
                if not na(neutralBox.boxes)
                    box.delete(neutralBox.boxes)
                if not na(neutralBox.boxLabel)
                    label.delete(neutralBox.boxLabel)
                if not na(neutralBox.CDLabel)
                    label.delete(neutralBox.CDLabel)
                if not na(neutralBox.ldsdLabel)
                    label.delete(neutralBox.ldsdLabel)
                array.remove(violatedHighNeutralBoxes, i)
            else
                shouldExtend = extendLinesAfterBreak and showContractionLines
                if showOnlyCDLxCDSx
                    shouldExtend := shouldExtend and neutralBox.hasCDLabel
                if shouldExtend
                    if na(neutralBox.extLowLine) and not na(neutralBox.lowLine)
                        lineColor = neutralBox.boxType == "Supply" ? bullishBodyCloseColor : bearishBodyCloseColor
                        neutralBox.extLowLine := line.new(x1=time, y1=neutralBox.low, x2=time, y2=neutralBox.low, color=lineColor, width=extendedLineWidth, style=getLineStyle(extendedLineStyle), xloc=xloc.bar_time)
                    else if not na(neutralBox.extLowLine)
                        line.set_x2(neutralBox.extLowLine, time)
                if neutralBox.hasCDLabel and extendCDLxCDSxBoxes
                    if showContractionBoxes and not na(neutralBox.boxes)
                        box.set_right(neutralBox.boxes, time)
                    if showContractionLines and not na(neutralBox.midLine)
                        line.set_x2(neutralBox.midLine, time)
                if barstate.isconfirmed and close < neutralBox.low
                    if not na(neutralBox.highLine)
                        line.delete(neutralBox.highLine)
                    if not na(neutralBox.lowLine)
                        line.delete(neutralBox.lowLine)
                    if not na(neutralBox.extLowLine)
                        line.delete(neutralBox.extLowLine)
                    if not na(neutralBox.midLine)
                        line.delete(neutralBox.midLine)
                    if showContractionBoxes and not na(neutralBox.boxes)
                        box.delete(neutralBox.boxes)
                    if not na(neutralBox.CDLabel)
                        label.delete(neutralBox.CDLabel)
                    if not na(neutralBox.boxLabel)
                        label.delete(neutralBox.boxLabel)
                    if not na(neutralBox.ldsdLabel)
                        label.delete(neutralBox.ldsdLabel)
                    array.remove(violatedHighNeutralBoxes, i)
        i -= 1

violatedLowNeutralBoxesSize = array.size(violatedLowNeutralBoxes)
if violatedLowNeutralBoxesSize > 0
    i = violatedLowNeutralBoxesSize - 1
    while i >= 0
        if array.size(violatedLowNeutralBoxes) > i
            neutralBox = array.get(violatedLowNeutralBoxes, i)
            if showOnlyCDLxCDSx and not neutralBox.hasCDLabel
                if not na(neutralBox.highLine)
                    line.delete(neutralBox.highLine)
                if not na(neutralBox.lowLine)
                    line.delete(neutralBox.lowLine)
                if not na(neutralBox.midLine)
                    line.delete(neutralBox.midLine)
                if not na(neutralBox.boxes)
                    box.delete(neutralBox.boxes)
                if not na(neutralBox.boxLabel)
                    label.delete(neutralBox.boxLabel)
                if not na(neutralBox.CDLabel)
                    label.delete(neutralBox.CDLabel)
                if not na(neutralBox.ldsdLabel)
                    label.delete(neutralBox.ldsdLabel)
                array.remove(violatedLowNeutralBoxes, i)
            else
                shouldExtend = extendLinesAfterBreak and showContractionLines
                if showOnlyCDLxCDSx
                    shouldExtend := shouldExtend and neutralBox.hasCDLabel
                if shouldExtend
                    if na(neutralBox.extHighLine) and not na(neutralBox.highLine)
                        lineColor = neutralBox.boxType == "Supply" ? bullishBodyCloseColor : bearishBodyCloseColor
                        neutralBox.extHighLine := line.new(x1=time, y1=neutralBox.high, x2=time, y2=neutralBox.high, color=lineColor, width=extendedLineWidth, style=getLineStyle(extendedLineStyle), xloc=xloc.bar_time)
                    else if not na(neutralBox.extHighLine)
                        line.set_x2(neutralBox.extHighLine, time)
                if neutralBox.hasCDLabel and extendCDLxCDSxBoxes
                    if showContractionBoxes and not na(neutralBox.boxes)
                        box.set_right(neutralBox.boxes, time)
                    if showContractionLines and not na(neutralBox.midLine)
                        line.set_x2(neutralBox.midLine, time)
                if barstate.isconfirmed and close > neutralBox.high
                    if not na(neutralBox.highLine)
                        line.delete(neutralBox.highLine)
                    if not na(neutralBox.lowLine)
                        line.delete(neutralBox.lowLine)
                    if not na(neutralBox.extHighLine)
                        line.delete(neutralBox.extHighLine)
                    if not na(neutralBox.midLine)
                        line.delete(neutralBox.midLine)
                    if showContractionBoxes and not na(neutralBox.boxes)
                        box.delete(neutralBox.boxes)
                    if not na(neutralBox.CDLabel)
                        label.delete(neutralBox.CDLabel)
                    if not na(neutralBox.boxLabel)
                        label.delete(neutralBox.boxLabel)
                    if not na(neutralBox.ldsdLabel)
                        label.delete(neutralBox.ldsdLabel)
                    array.remove(violatedLowNeutralBoxes, i)
        i -= 1

if (showCDLabels or showOnlyCDLxCDSx) and array.size(cdexDots) > 0
    i = array.size(cdexDots) - 1
    while i >= 0
        if array.size(cdexDots) > i
            dot = array.get(cdexDots, i)
            if barstate.isconfirmed and ((dot.dotType == "CDSx" and close > dot.price) or (dot.dotType == "CDLx" and close < dot.price))
                label.delete(dot.dotLabel)
                array.remove(cdexDots, i)
        i -= 1

// =====================================================
// RISK TABLE
// =====================================================
if show_risk_table and barstate.islast
    var table _rT = table.new(getTablePosition(riskTablePos), 2, 11, bgcolor=#000000, frame_color=color.rgb(60,60,60), frame_width=1, border_color=color.rgb(40,40,40), border_width=1)
    color _rg = color.rgb(22,22,22)
    int   _r  = 0
    table.cell(_rT, 0, _r, "─ RISK ─", text_color=#e1b31a, text_size=getTableTextSize(riskTableSz), bgcolor=#000000)
    table.merge_cells(_rT, 0, _r, 1, _r)
    _r += 1
    table.cell(_rT, 0, _r, "Drawdown",      text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    table.cell(_rT, 1, _r, "$" + str.tostring(capitalDrawdown, "#,###"), text_color=color.red, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    _r += 1
    table.cell(_rT, 0, _r, "Profit TGT",   text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    table.cell(_rT, 1, _r, "$" + str.tostring(profitTarget, "#,###"), text_color=#27ffc3, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    _r += 1
    table.cell(_rT, 0, _r, cycleType,      text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    table.cell(_rT, 1, _r, str.tostring(challengeDays) + " Days", text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    _r += 1
    table.cell(_rT, 0, _r, overrideRiskPerTrade ? "Risk/Trade (Manual)" : "Risk/Trade (Auto)",   text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    table.cell(_rT, 1, _r, "$" + str.tostring(riskPerTrade, "#.##") + " × " + str.tostring(positionSize) + "ct", text_color=color.orange, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    _r += 1
    table.cell(_rT, 0, _r, "R:R",          text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    table.cell(_rT, 1, _r, "1:" + str.tostring(rrRatio, "#.#"), text_color=color.lime, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    _r += 1
    table.cell(_rT, 0, _r, "Total R Needed",text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    table.cell(_rT, 1, _r, str.tostring(totalRNeeded, "#.#") + "R", text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    _r += 1
    table.cell(_rT, 0, _r, "Min Daily R",  text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    table.cell(_rT, 1, _r, str.tostring(minDailyR, "#.##") + "R", text_color=#27ffc3, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    _r += 1
    table.cell(_rT, 0, _r, "Wins Goal",    text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    table.cell(_rT, 1, _r, str.tostring(totalWinsNeeded), text_color=color.lime, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    _r += 1
    table.cell(_rT, 0, _r, "Consec Loss",  text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    table.cell(_rT, 1, _r, str.tostring(expectedConsecLoss) + " ($" + str.tostring(expectedTotalLoss, "#,###") + ")", text_color=color.red, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    _r += 1
    table.cell(_rT, 0, _r, "SL Mode",      text_color=color.white, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)
    table.cell(_rT, 1, _r, masterSLMode == "Candle High/Low" ? "Candles" : "Block HH/LL", text_color=color.orange, text_size=getTableTextSize(riskTableSz), bgcolor=_rg)

// =====================================================
// STATISTICS TABLE
// =====================================================
if show_stats_table and barstate.islast
    var table _sT = table.new(getTablePosition(statsTablePos), 3, 28, bgcolor=#000000, frame_color=color.gray, frame_width=1)
    string _sz  = statsTableSz
    int    _cT_ = totalWins_all + totalLosses_all
    float  _wr  = _cT_ > 0 ? totalWins_all / _cT_ * 100 : 0.0
    float  _nPL = totalProfitDollars - totalLossDollars
    float  _avgW = totalWins_all   > 0 ? totalPosRR / totalWins_all   : 0.0
    float  _avgL = totalLosses_all > 0 ? totalNegRR / totalLosses_all : 1.0
    float  _pF   = totalLossDollars > 0 ? totalProfitDollars / totalLossDollars : na
    float  _exp  = _cT_ > 0 ? _nPL / _cT_ : 0.0

    int _firstTime = na
    if array.size(firstTradeTime_arr) > 0
        _firstTime := array.get(firstTradeTime_arr, 0)

    string _sD   = na(_firstTime) ? "No Trades" : str.format("{0,date,MMM dd yyyy}", _firstTime)

    int st = 0
    table.cell(_sT, 0, st, "═ STATISTICS ═", bgcolor=#000000, text_color=#e1b31a, text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 0, st, 2, st)
    st += 1
    table.cell(_sT, 0, st, "Since",      bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, _sD,          bgcolor=#000000, text_color=#27ffc3,                text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 1, st, 2, st)
    st += 1
    table.cell(_sT, 0, st, "Risk/Trade", bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, "$" + str.tostring(riskPerTrade, "#.##") + (overrideRiskPerTrade ? " (Manual)" : " (Auto)"), bgcolor=#000000, text_color=color.orange, text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 1, st, 2, st)
    st += 1
    int _aT = trades_BlockCDLPlus.size() + trades_BlockCDL.size() + trades_BlockLD.size() + trades_CandleCDLPlus.size() + trades_CandleCDL.size() + trades_CandleLD.size()
    table.cell(_sT, 0, st, "Total/Live", bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, str.tostring(_cT_ + _aT),             bgcolor=#000000, text_color=color.white, text_size=getTableTextSize(_sz))
    table.cell(_sT, 2, st, "(" + str.tostring(_aT) + " live)",   bgcolor=#000000, text_color=#27ffc3,    text_size=getTableTextSize(_sz))
    st += 1
    table.cell(_sT, 0, st, "W / L",      bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, str.tostring(totalWins_all),   bgcolor=#000000, text_color=color.lime, text_size=getTableTextSize(_sz))
    table.cell(_sT, 2, st, str.tostring(totalLosses_all), bgcolor=#000000, text_color=color.red,  text_size=getTableTextSize(_sz))
    st += 1
    float _req_wr = 1.0 / (1.0 + rrRatio) * 100.0
    string _wr_rr_txt = (_cT_ > 0 ? str.tostring(_wr, "#.#") + "%" : "—") + "  @  1:" + str.tostring(rrRatio, "#.#") + "R"
    color  _rr_bg = _cT_ == 0 ? color.new(color.gray, 80) : _wr >= _req_wr + 5 ? color.new(color.green, 70) : _wr >= _req_wr ? color.new(color.orange, 70) : color.new(color.red, 80)
    color  _rr_vc = _cT_ == 0 ? color.gray : _wr >= _req_wr + 5 ? color.lime : _wr >= _req_wr ? color.orange : color.red
    table.cell(_sT, 0, st, "WR / RR",    bgcolor=_rr_bg, text_color=color.white, text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, _wr_rr_txt,   bgcolor=_rr_bg, text_color=_rr_vc,      text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 1, st, 2, st)
    st += 1
    table.cell(_sT, 0, st, "Need",        bgcolor=_rr_bg, text_color=color.white, text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, str.tostring(_req_wr, "#.#") + "% min", bgcolor=_rr_bg, text_color=color.white, text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 1, st, 2, st)
    st += 1
    table.cell(_sT, 0, st, "Avg R W/L",  bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, totalWins_all   > 0 ? "+" + str.tostring(_avgW, "#.#") : "—", bgcolor=#000000, text_color=color.lime, text_size=getTableTextSize(_sz))
    table.cell(_sT, 2, st, totalLosses_all > 0 ? "-" + str.tostring(_avgL, "#.#") : "—", bgcolor=#000000, text_color=color.red,  text_size=getTableTextSize(_sz))
    st += 1
    string _pfTx = not na(_pF) ? str.tostring(_pF, "#.##") : (totalWins_all > 0 ? "∞" : "—")
    color  _pfCl = (not na(_pF) and _pF >= 2) ? color.lime : (not na(_pF) and _pF >= 1) ? color.orange : (na(_pF) and totalWins_all > 0) ? color.lime : color.red
    table.cell(_sT, 0, st, "Prof Factor", bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, _pfTx, bgcolor=#000000, text_color=_pfCl, text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 1, st, 2, st)
    st += 1
    table.cell(_sT, 0, st, "Expectancy", bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, _cT_ > 0 ? ((_exp >= 0 ? "+$" : "-$") + str.tostring(math.abs(_exp), "#.##")) : "—", bgcolor=#000000, text_color=_exp >= 0 ? color.lime : color.red, text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 1, st, 2, st)
    st += 1
    table.cell(_sT, 0, st, "Consec W/L", bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, str.tostring(maxConsecWins),    bgcolor=#000000, text_color=color.lime, text_size=getTableTextSize(_sz))
    table.cell(_sT, 2, st, str.tostring(maxConsecLosses), bgcolor=#000000, text_color=color.red,  text_size=getTableTextSize(_sz))
    st += 1
    table.cell(_sT, 0, st, "Max DD",     bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, maxDrawdownStat > 0 ? "$" + str.tostring(maxDrawdownStat, "#,###") : "—", bgcolor=#000000, text_color=color.red, text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 1, st, 2, st)
    st += 1
    table.cell(_sT, 0, st, "Total P/L",  bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, totalWins_all   > 0 ? "+$" + str.tostring(totalProfitDollars, "#,###") : "—", bgcolor=#000000, text_color=color.lime, text_size=getTableTextSize(_sz))
    table.cell(_sT, 2, st, totalLosses_all > 0 ? "-$" + str.tostring(totalLossDollars,   "#,###") : "—", bgcolor=#000000, text_color=color.red,  text_size=getTableTextSize(_sz))
    st += 1
    color _nBg = _nPL >= 0 ? color.new(color.green, 70) : color.new(color.red, 70)
    table.cell(_sT, 0, st, "NET P/L",    bgcolor=_nBg, text_color=color.white, text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, _cT_ > 0 ? ((_nPL >= 0 ? "+$" : "-$") + str.tostring(math.abs(_nPL), "#,###")) : "—", bgcolor=_nBg, text_color=_nPL >= 0 ? color.lime : color.red, text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 1, st, 2, st)
    st += 1
    table.cell(_sT, 0, st, "Unrealized", bgcolor=#000000, text_color=color.rgb(210,210,210), text_size=getTableTextSize(_sz))
    table.cell(_sT, 1, st, totalUnrealizedPL != 0 ? (totalUnrealizedPL > 0 ? "+$" : "-$") + str.tostring(math.abs(totalUnrealizedPL), "#,###") : "—", bgcolor=#000000, text_color=totalUnrealizedPL >= 0 ? color.lime : color.red, text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 1, st, 2, st)
    st += 1

    if array.get(manualExitWarningFlag, 0)
        table.cell(_sT, 0, st, "⚠️ ALERT", bgcolor=color.new(color.red, 40), text_color=color.white, text_size=getTableTextSize(_sz))
        table.cell(_sT, 1, st, "MANUAL EXIT OR DO NOT ENTER", bgcolor=color.new(color.red, 40), text_color=color.white, text_size=getTableTextSize(_sz))
        table.merge_cells(_sT, 1, st, 2, st)
        st += 1

    table.cell(_sT, 0, st, "── BY ENTRY ──", bgcolor=#000000, text_color=#e1b31a, text_size=getTableTextSize(_sz))
    table.merge_cells(_sT, 0, st, 2, st)
    st += 1
    if enableCandleCDLPlus
        table.cell(_sT, 0, st, "1️⃣ CDLx+ Candle",     bgcolor=#000000, text_color=color.fuchsia, text_size=getTableTextSize(_sz))
        table.cell(_sT, 1, st, f_wl(w_CandleCDLPlus, l_CandleCDLPlus), bgcolor=#000000, text_color=color.white, text_size=getTableTextSize(_sz))
        table.merge_cells(_sT, 1, st, 2, st)
        st += 1
    if enableCandleCDL
        table.cell(_sT, 0, st, "2️⃣ PO4 CDLx/CDSx",  bgcolor=#000000, text_color=color.orange,  text_size=getTableTextSize(_sz))
        table.cell(_sT, 1, st, f_wl(w_CandleCDL, l_CandleCDL), bgcolor=#000000, text_color=color.white, text_size=getTableTextSize(_sz))
        table.merge_cells(_sT, 1, st, 2, st)
        st += 1
    if enableCandleLD
        table.cell(_sT, 0, st, "3️⃣ PO4 LDx/SDx",    bgcolor=#000000, text_color=#27ffc3,       text_size=getTableTextSize(_sz))
        table.cell(_sT, 1, st, f_wl(w_CandleLD,  l_CandleLD),  bgcolor=#000000, text_color=color.white, text_size=getTableTextSize(_sz))
        table.merge_cells(_sT, 1, st, 2, st)
        st += 1
    if enableBlockCDLPlus
        table.cell(_sT, 0, st, "4️⃣ CDLx+ Blk Limit", bgcolor=#000000, text_color=color.purple,    text_size=getTableTextSize(_sz))
        table.cell(_sT, 1, st, f_wl(w_BlockCDLPlus, l_BlockCDLPlus),  bgcolor=#000000, text_color=color.white, text_size=getTableTextSize(_sz))
        table.merge_cells(_sT, 1, st, 2, st)
        st += 1
    if enableBlockCDL
        table.cell(_sT, 0, st, "5️⃣ CDLx/CDSx Limit", bgcolor=#000000, text_color=color.aqua,    text_size=getTableTextSize(_sz))
        table.cell(_sT, 1, st, f_wl(w_BlockCDL,  l_BlockCDL),  bgcolor=#000000, text_color=color.white, text_size=getTableTextSize(_sz))
        table.merge_cells(_sT, 1, st, 2, st)
        st += 1
    if enableBlockLD
        table.cell(_sT, 0, st, "6️⃣ LDx/SDx Limit",   bgcolor=#000000, text_color=color.yellow,  text_size=getTableTextSize(_sz))
        table.cell(_sT, 1, st, f_wl(w_BlockLD,   l_BlockLD),   bgcolor=#000000, text_color=color.white, text_size=getTableTextSize(_sz))
        table.merge_cells(_sT, 1, st, 2, st)

// =====================================================
// SIGNALS TABLE
// =====================================================

if show_mmm_table and barstate.islast
    table.clear(mmm_signals_table, 0, 0, 0, 29)

    htfString = tfMode == "Auto Combination" ?
                 "Auto (" + autoMultiplier + "): " + f_timeframeToString(timeframe.period) + " → " + f_timeframeToString(blockTF) :
                 (blockTimeframe == '' ? "Chart TF" : f_timeframeToString(blockTF))
    ltfString = ltfExecutionTF == '' ? "Chart TF" : f_timeframeToString(ltfTF)

    table.cell(mmm_signals_table, 0, 0, 'MMM 3.0 Pro [HTF: ' + htfString + ' | LTF: ' + ltfString + ']', text_color=color.white, text_size=table_size)

    row = 1

    blockCDLPlus_act = 0
    blockCDLPlus_pnd = 0
    for t in trades_BlockCDLPlus
        if t.activated
            blockCDLPlus_act += 1
        else
            blockCDLPlus_pnd += 1
    blockCDL_active  = 0
    blockCDL_pending = 0
    for t in trades_BlockCDL
        if t.activated
            blockCDL_active += 1
        else
            blockCDL_pending += 1
    blockLD_active  = 0
    blockLD_pending = 0
    for t in trades_BlockLD
        if t.activated
            blockLD_active += 1
        else
            blockLD_pending += 1
    candleCDLPlus_act = 0
    candleCDLPlus_pnd = 0
    for t in trades_CandleCDLPlus
        if t.activated
            candleCDLPlus_act += 1
        else
            candleCDLPlus_pnd += 1
    candleCDL_active  = 0
    candleCDL_pending = 0
    for t in trades_CandleCDL
        if t.activated
            candleCDL_active += 1
        else
            candleCDL_pending += 1
    candleLD_active  = 0
    candleLD_pending = 0
    for t in trades_CandleLD
        if t.activated
            candleLD_active += 1
        else
            candleLD_pending += 1

    table.cell(mmm_signals_table, 0, row, '1️⃣ CDLx+/CDSx+ Candle: ' + str.tostring(candleCDLPlus_act) + 'A | ' + str.tostring(candleCDLPlus_pnd) + 'P | ' + str.tostring(maxEntries_CandleCDLPlus) + 'Max', text_color=enableCandleCDLPlus ? color.white : color.gray, text_size=table_size)
    row += 1
    table.cell(mmm_signals_table, 0, row, '2️⃣ PO4 CDLx/CDSx: ' + str.tostring(candleCDL_active) + 'A | ' + str.tostring(candleCDL_pending) + 'P | ' + str.tostring(maxEntries_CandleCDL) + 'Max', text_color=enableCandleCDL ? color.white : color.gray, text_size=table_size)
    row += 1
    table.cell(mmm_signals_table, 0, row, '3️⃣ PO4 LDx/SDx: ' + str.tostring(candleLD_active) + 'A | ' + str.tostring(candleLD_pending) + 'P | ' + str.tostring(maxEntries_CandleLD) + 'Max', text_color=enableCandleLD ? color.white : color.gray, text_size=table_size)
    row += 1
    table.cell(mmm_signals_table, 0, row, '4️⃣ CDLx+/CDSx+ Limit: ' + str.tostring(blockCDLPlus_act) + 'A | ' + str.tostring(blockCDLPlus_pnd) + 'P | ' + str.tostring(maxEntries_BlockCDLPlus) + 'Max', text_color=enableBlockCDLPlus ? color.white : color.gray, text_size=table_size)
    row += 1
    table.cell(mmm_signals_table, 0, row, '5️⃣ CDLx/CDSx Limit: ' + str.tostring(blockCDL_active) + 'A | ' + str.tostring(blockCDL_pending) + 'P | ' + str.tostring(maxEntries_BlockCDL) + 'Max', text_color=enableBlockCDL ? color.white : color.gray, text_size=table_size)
    row += 1
    table.cell(mmm_signals_table, 0, row, '6️⃣ LDx/SDx Limit: ' + str.tostring(blockLD_active) + 'A | ' + str.tostring(blockLD_pending) + 'P | ' + str.tostring(maxEntries_BlockLD) + 'Max', text_color=enableBlockLD ? color.white : color.gray, text_size=table_size)
    row += 1
    table.cell(mmm_signals_table, 0, row, '══════════════', text_color=color.gray, text_size=table_size)
    row += 1

    if showBiasSection and currentBias != "NONE"
        biasText  = (currentBias == "CDLx" ? "Bias: CDLx → LDx" + str.tostring(ldCount) : "Bias: CDSx → SDx" + str.tostring(sdCount)) + " | Gate: " + gate_mode + " | Box: " + (boxGrow ? "G1" : "G0")
        biasColor = currentBias == "CDLx" ? color.green : color.red
        table.cell(mmm_signals_table, 0, row, biasText, text_color=biasColor, text_size=table_size)
        row += 1
        table.cell(mmm_signals_table, 0, row, '══════════════', text_color=color.gray, text_size=table_size)
        row += 1

    if showSignalSection
        color signalColor = color.gray
        if str.contains(lastSignalType, "CDLx") or str.contains(lastSignalType, "LD")
            signalColor := color.green
        else if str.contains(lastSignalType, "CDSx") or str.contains(lastSignalType, "SD")
            signalColor := color.red
        table.cell(mmm_signals_table, 0, row, 'Last Signal: ' + lastSignalType, text_color=signalColor, text_size=table_size)
        row += 1
        color actionColor = color.white
        if str.contains(lastAction, "created") or str.contains(lastAction, "triggered")
            actionColor := color.yellow
        else if str.contains(lastAction, "ACTIVATED")
            actionColor := color.aqua
        else if str.contains(lastAction, "TP")
            actionColor := color.green
        else if str.contains(lastAction, "SL") or str.contains(lastAction, "exited") or str.contains(lastAction, "Cancelled") or str.contains(lastAction, "Exited")
            actionColor := color.red
        table.cell(mmm_signals_table, 0, row, lastAction, text_color=actionColor, text_size=table_size)
        row += 1
        table.cell(mmm_signals_table, 0, row, 'Zone: ' + blockEntryMode, text_color=color.gray, text_size=table_size)
        row += 1

    if showBiasLine and not na(lastDrawnBiasText)
        table.cell(mmm_signals_table, 0, row, '══════════════', text_color=color.gray, text_size=table_size)
        row += 1
        table.cell(mmm_signals_table, 0, row, lastDrawnBiasText, text_color=lastDrawnBiasColor, text_size=table_size)
        row += 1
        table.cell(mmm_signals_table, 0, row, 'Bull: ' + str.tostring(lastDrawnBullPercent, '#.#') + '% | Bear: ' + str.tostring(lastDrawnBearPercent, '#.#') + '%', text_color=color.gray, text_size=table_size)

// =====================================================
// NEXT LDx / SDx LEVEL — the level whose body close makes the next continuation
// =====================================================
var float prevRevH = na
var float prevRevL = na
if barstate.isconfirmed
    if not na(lastRevBoxHigh) and (na(prevRevH) or lastRevBoxHigh != prevRevH)
        prevRevH := lastRevBoxHigh
        lastRevHT := int(nz(htf_time, time))
    if not na(lastRevBoxLow) and (na(prevRevL) or lastRevBoxLow != prevRevL)
        prevRevL := lastRevBoxLow
        lastRevLT := int(nz(htf_time, time))

var line  nextLn  = na
var label nextLbl = na
if barstate.islast
    line.delete(nextLn)
    label.delete(nextLbl)
    if showNextLvl and (currentBias == "CDLx" or currentBias == "CDSx")
        bool   nUp  = currentBias == "CDLx"
        float  nP   = nUp ? lastRevBoxHigh : lastRevBoxLow
        int    nT   = nUp ? lastRevHT : lastRevLT
        string nTx  = "▸ " + (nUp ? "LDx" + str.tostring(ldCount + 1) : "SDx" + str.tostring(sdCount + 1))
        color  nCol = color.new(nUp ? CDLongColor : CDShortColor, 30)
        if not na(nP) and not na(nT)
            int nEnd = f_future_time(offsetGap)
            nextLn  := line.new(nT, nP, nEnd, nP, xloc=xloc.bar_time, color=nCol, style=line.style_dotted, width=1)
            nextLbl := label.new(nEnd, nP, nTx, xloc=xloc.bar_time, style=label.style_label_left, color=color(na), textcolor=nCol, size=size.small, tooltip="A body close " + (nUp ? "above" : "below") + " this level = " + str.substring(nTx, 2))

// =====================================================
// HTF BIAS BOX
// =====================================================
f_htfPos(string p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Bottom Left"   => position.bottom_left
        "Bottom Right"  => position.bottom_right
        => position.bottom_center

var table biasTbl = table.new(f_htfPos(htf_tbl_pos), 1, 1, bgcolor=#000000, border_width=1, frame_color=color.new(color.white, 70), frame_width=1)
if barstate.islast
    if htf_table and htf_mode != "Off"
        string bSrc = htf_mode == "Last Flip (CDLx/CDSx)" ? "Flip" : htf_mode == "Last Continuation (LDx/SDx)" ? "Cont" : "BC"
        string bDir = htfBias == 1 ? "BULL" : htfBias == -1 ? "BEAR" : "NONE"
        color  bCol = htfBias == 1 ? bullishBodyCloseColor : htfBias == -1 ? bearishBodyCloseColor : color.silver
        table.cell(biasTbl, 0, 0, "HTF " + f_timeframeToString(htf_bias_tf) + " · " + bSrc + " · " + bDir + (newsBlock ? " · NEWS" : ""), text_color=bCol, text_size=size.small)
    else
        table.clear(biasTbl, 0, 0)

alertcondition(ev_cdl, "CDLx Flip (official)", "CDLx - bullish flip (zone engine)")
alertcondition(ev_cds, "CDSx Flip (official)", "CDSx - bearish flip (zone engine)")
alertcondition(ev_ld, "LDx Continuation (official)", "LDx - bullish continuation (zone engine)")
alertcondition(ev_sd, "SDx Continuation (official)", "SDx - bearish continuation (zone engine)")

// Execute final unified A&B overlap drawing checks on the last bar
if barstate.islast
    f_draw_groups()