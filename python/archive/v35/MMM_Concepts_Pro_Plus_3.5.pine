slTicksBox = input.int(0, "SL Ticks Beyond Block", minval=0, tooltip="Buffer ticks placed outside the absolute invalidation edge (low of demand / high of supply) of the resting Block.", group=grp_blk_set)

blockEntryMode = blockEnterPremDisc ? "Long in PREMIUM / Short in DISCOUNT" : blockEnterMidline ? "Enter at 50% midline" : blockEnterEdge ? "Enter at breakout edge" : "Long in DISCOUNT / Short in PREMIUM"

