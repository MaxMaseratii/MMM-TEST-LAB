//@version=6
indicator("MMM Pro @MaxMaserati", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=300)

// ═══════════════════════════════════════════════════════════════════════════
// MMM PRO — original visual engine (voids, eBlocks, entries, candle coloring)
// driven by the MMM Pro Foundation 3-phase state machine.
//
// MMM FOUNDATION — this is the CANDLE engine "c":
//   Flip         = CDLc / CDSc (the T1 reversal)
//   Continuation = LDc1, LDc2… / SDc1, SDc2… (count runs until the next flip)
//   Gate (NO GATE / MMPD 27 / MMPD fast / MMPD Delta) decides which breaks
//   are OFFICIAL. Only official breaks arm with-trend entries and alerts.
//
// STATE MACHINE (transplanted verbatim in behaviour):
//   - STATIC anchors (Pn / Rn): frozen once set per range, numbered to tier.
//   - DYNAMIC trackers: 4 slots (raw/gap x Bu/Be), "like replaces like".
//   - Tn origins (POLine) with coupled cause markers — Husband & Wife.
//   - ShiftMarkers + Forced guardians for CDS/CDL lifetime.
//   - Right-edge levels sharing a price MERGE into one line, labels
//     joined with " & " (original behaviour) — nothing hidden, nothing
//     overlapping.
// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — 8 groups. Every on/off switch lives in "2. Display"; every other
// group holds only the settings for that feature.
// ═══════════════════════════════════════════════════════════════════════════

// ─── 1. GENERAL ───
grp_gen          = "1. General"
label_naming_scheme = input.string("MC / GMC / MP / GMP", "Label Naming", options=["MC / GMC / MP / GMP", "UC / XUC / UP / XUP"], group=grp_gen, tooltip="Naming used on every structural label.\n\nMC / GMC / MP / GMP / MCR / GMCR — standard MMM naming.\n\nUC / XUC / UP / XUP / UCR / XUCR — Urgency naming. U = Urgency (raw body close), XU = Extreme Urgency (gap-confirmed).")
bull_col         = input.color(#01d401, "Bull", inline="mcol", group=grp_gen, tooltip="Master colors. Used by PO4 origins, GMC / MC / GMP / MP levels, LD / SD markers, entry lines, urgency lines and eBlocks / iBlocks.")
bear_col         = input.color(#c2185b, "Bear", inline="mcol", group=grp_gen)
line_ext         = input.int(13, "Line Extension (Candles)", minval=0, maxval=50, group=grp_gen, tooltip="How far EVERY level line extends to the right of the current bar: PO4, GMC, MC, GMP, MP, entries and urgency lines. eBlocks / iBlocks have their own length in group 6.")
size_secondary   = input.string("small", "Level Label Size", options=["tiny","small","normal","large"], group=grp_gen, tooltip="Label size for GMC, MC, GMP, MP, MCR / GMCR and forced guardian levels. T# and P# have their own sizes in group 3.")
size_marker      = input.string("small", "Marker Label Size", options=["tiny","small","normal","large"], group=grp_gen, tooltip="Label size for CDS / CDL, LD / SD, entry and urgency labels.")
purge_internal   = input.bool(true, "Purge lowercase internal cds/cdl on Tn-Pn break", group=grp_gen, tooltip="ON: when a range closes — by an LD / SD continuation OR by a reversal — its small-letter internal cds / cdl markers are cleared.\n\nOFF: they stay on the chart as history, in small letters, until price closes back through them.")
show_tn_step     = input.bool(true, "MMM Trend & Momentum Markers", group=grp_gen, tooltip="Small markers at the right end of the lines, just in front of the labels.\n\n🟢 / 🔴 = the START of the leg — its T1 origin. It never moves and stays until that T1 is violated.\n\n🟩 / 🟥 = the LAST level of the leg — the newest Tn. This one moves, stepping forward on every LD / SD.\n\nOne pair per side: green for bull, red for bear. When only T1 exists the two print together as \"🟢🟩\". Colors are set with the Bull / Bear pickers below.")
tm_bull_col      = input.color(#006400, "Bull", inline="tmcol", group=grp_gen)
tm_bear_col      = input.color(#c2185b, "Bear", inline="tmcol", group=grp_gen)
eng_tag          = input.bool(true, "Engine Tag  (CDLc / CDSc / LDc / SDc)", group=grp_gen, tooltip="Adds the engine letter to every break so you always know which MMM engine made it.\nc = Candle engine (MMM Pro) · x = Zone engine (Concepts Pro+) · s = Swing engine (Order Flow Suite).")
max_history      = input.int(40, "Memory Guard (Max Structures Kept)", minval=5, maxval=200, group=grp_gen, tooltip="Hard cap on how many past origins, markers and guardians are kept in memory. Oldest dropped first. Raising this too high can trigger TradingView's 'Memory limits exceeded' error, which silently stops ALL drawing.")

// ─── 2. DISPLAY — every on/off switch in one place ───
grp_disp         = "2. Display"
show_orig_lines  = input.bool(true,  "PO4 Origins (T1, T2, T3...)", group=grp_disp, tooltip="BuPO4 / BePO4 — the origin of each trend leg. T1 is born of a reversal (CDL / CDS); T2, T3... are born of a continuation (LD / SD). \"Forced\" = the origin was placed on a candle that is NOT a body close in the break direction (an NBC broke the level).")
show_gmc_lines   = input.bool(true,  "Resumption / Control Levels (GMC, MCR, GMCR)", group=grp_disp, tooltip="Trend-direction levels. GMC = gap-confirmed momentum in the trend phase. MCR / GMCR = the resumption after a pullback.")
show_ant         = input.bool(true,  "MC Line (Momentum Control)", group=grp_disp, tooltip="The raw trend-direction body close before any gap confirms it. Only exists in the trend phase — before a pullback forms. The moment the next candle gaps, it upgrades to GMC and this line is retired.")
show_gmp_lines   = input.bool(true,  "GMP (Gap-Confirmed Pullbacks)", group=grp_disp, tooltip="Counter-trend body closes confirmed by a gap. The first one of each range is numbered (GMP1, GMP2...).")
show_mp_lines    = input.bool(true,  "MP (Raw Pullbacks)", group=grp_disp, tooltip="Counter-trend body closes not yet confirmed by a gap. Upgrades to GMP the moment a gap confirms it.")
show_pb          = input.bool(false, "LD / SD Markers", group=grp_disp, tooltip="LD (Long Delivery) / SD (Short Delivery) — the break of the numbered pullback that confirms a continuation and creates the next T-tier. A '+' (LD1+) means the broken pullback was gap-confirmed: a strong break.")
show_int_cd      = input.bool(false, "Internal cds / cdl (small letters)", group=grp_disp, tooltip="Small-letter cds / cdl are internal breaks inside the T#–P# range: later pullback breaks, R# breaks, and breaks made by the unnumbered GMCR / MCR. OFF hides them (and their Forced guardian lines). They are still tracked. Capital CDS / CDL always show.")
show_ent         = input.bool(true,  "Entry Lines", group=grp_disp)
show_zones       = input.bool(true,  "eBlocks / iBlocks", group=grp_disp)
show_tc          = input.bool(false, "Urgency Gap Anticipation Lines", group=grp_disp, tooltip="After a body close, the prior bar's high (bull) or low (bear) — the edge a gap would have to clear. Shows ✕ once price trades back through it.")
show_all_gaps    = input.bool(false, "Structural Voids (UDG / UOG / ULG)", group=grp_disp)
show_ccm_color   = input.bool(true,  "Candle Conviction Coloring", group=grp_disp)
hvc_enable       = input.bool(false, "Volume Intensity Coloring", group=grp_disp, tooltip="Recolors High / Ultra-High relative volume candles using footprint data. Requires a TradingView Premium / Ultimate plan (request.footprint).")
show_nbc_color   = input.bool(true,  "NBC Candle Coloring", group=grp_disp, tooltip="Colors every NBC (Non-Body-Close) candle — a candle that is neither a BuX nor a BeX body close — in one flat color, so the candles that actually carry structure stand out. Color is set in group 8 (white by default).")

// ─── 3. TREND & PULLBACK SEQUENCE ───
grp_tier         = "3. Trend & Pullback Sequence"
show_tiers       = input.bool(true, "Show Tier Numbers (T1, T2... / P1, P2...)", group=grp_tier, tooltip="Tags each origin with its trend-tier (T1, T2, T3...) and each numbered pullback / resumption with the range number it belongs to.")
t1_width         = input.int(3, "T1   Width", inline="t1sty", group=grp_tier, tooltip="T1 — the origin of a brand-new trend (reversal).")
t1_line_style    = input.string("Solid", "Style", options=["Solid","Dashed","Dotted"], inline="t1sty", group=grp_tier)
t1_size          = input.string("normal", "Label", options=["tiny","small","normal","large"], inline="t1sty", group=grp_tier)
tn_width         = input.int(2, "T2+  Width", inline="tnsty", group=grp_tier, tooltip="T2, T3, T4... — origins born of a continuation (LD / SD).")
tn_line_style    = input.string("Solid", "Style", options=["Solid","Dashed","Dotted"], inline="tnsty", group=grp_tier)
tn_size          = input.string("small", "Label", options=["tiny","small","normal","large"], inline="tnsty", group=grp_tier)
p1_width         = input.int(2, "P1   Width", inline="p1sty", group=grp_tier, tooltip="P1 — the first pullback of a new trend.")
p1_line_style    = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], inline="p1sty", group=grp_tier)
p1_size          = input.string("normal", "Label", options=["tiny","small","normal","large"], inline="p1sty", group=grp_tier)
pn_width         = input.int(2, "P2+  Width", inline="pnsty", group=grp_tier, tooltip="P2, P3, P4... — the first pullback of each continuation range.")
pn_line_style    = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], inline="pnsty", group=grp_tier)
pn_size          = input.string("small", "Label", options=["tiny","small","normal","large"], inline="pnsty", group=grp_tier)
po4_trig_mode    = input.string("Keep Extending", "PO4 On Touch", options=["Keep Extending","Stop Extending","Hide"], group=grp_tier, tooltip="What a PO4 line does when price comes back and touches it (a retest, not a break).\n\nKeep Extending — stays and keeps extending.\nStop Extending — stays, frozen at the touch candle.\nHide — hidden once touched.\n\nA close THROUGH a PO4 always deletes it, whatever this is set to.")
max_orig_lines   = input.int(10, "Max PO4 Lines Drawn", minval=0, maxval=500, group=grp_tier, tooltip="Only the newest N origins are drawn. 0 = no limit. This only hides older lines — it never deletes an origin or its CDS / CDL.")
p1_validate_mode = input.string("MPO (Raw Pullback)", "Pullbacks Plotted", options=["MPO (Raw Pullback)", "GMPO (Gap-Confirmed Only)"], group=grp_tier, tooltip="MPO — not strict. Both raw (MP) and gap-confirmed (GMP) pullbacks count. A raw MP anchors P# straight away and can validate LD / SD.\n\nGMPO — STRICT. A raw MP is not treated as a pullback at all. It waits until a gap confirms it, and only then becomes the numbered P#. So it cannot validate LD / SD and cannot become T1 on a reversal while it is still raw. Expect far fewer T-tiers and fewer reversals — only gap-backed structure.")
pb_absorb_filter = input.bool(true, "Absorbed P# Filter", group=grp_tier, tooltip="Fixes the WEAK first BC.\n\nA raw P# (not gap-confirmed) is ABSORBED when price takes it back while:\n- the pullback never closed past the P# candle's own far edge (its low for a BeX P#, its high for a BuX P#), and\n- no R# has locked yet.\n\nON: an absorbed P# is NOT an LD / SD. It is erased and the range goes back to the trend phase, so the next opposite BC can become the real P#.\n\nA deep pullback that closed past the P# candle's edge still gives a normal LD / SD. A gap-confirmed GMP# is never absorbed.")
pb_nbc_forced    = input.bool(true, "NBC Forced Pullback", group=grp_tier, tooltip="Fixes the NBC-ONLY pullback.\n\nIn the trend phase (no P# yet), if an NBC candle CLOSES through the last trend-phase body close (the MC or GMC), the pullback is real even though no opposite BC printed. That NBC's open becomes the P#, labelled \"NBC Forced MP#\". If the same candle broke a GMC, its CDS / CDL is married to this P#.\n\nMPO mode only — GMPO (strict) still needs a gap-confirmed P#.")

// ─── 4. LEVELS (GMC / MC / GMP / MP / Urgency) ───
grp_lvl          = "4. Levels"
label_gmp_mp     = input.string("GMP / MP", "Pullback Naming", options=["GMP / MP", "GM Pullback / M Pullback"], group=grp_lvl, tooltip="Short or long-form pullback labels. Also converted by the Urgency naming scheme (→ XUP / UP).")
ant_mode         = input.string("Last Active Only", "MC Line Mode", options=["Both","Last Active Only"], group=grp_lvl, tooltip="Both — keep the latest bull MC and latest bear MC at the same time.\nLast Active Only — a new MC on one side clears the other side's MC.")
tc_mode          = input.string("Last Active Only", "Urgency Line Mode", options=["Both","Last Active Only"], group=grp_lvl, tooltip="Both — keep the latest buy and sell urgency lines at the same time.\nLast Active Only — a new one on one side clears the other side's.")
max_cont_lines   = input.int(5, "Max CDS / CDL Markers & Guardians Drawn", minval=0, maxval=500, group=grp_lvl, tooltip="Only the newest N standalone CDS / CDL markers and forced guardians are drawn. 0 = no limit.")

// ─── 5. ENTRY LINES ───
// Three entry families, each with its own switch. Inside each family pick the
// type: U = Urgency (raw body close), XU = Extreme Urgency (gap-confirmed),
// PO4 = the Origin (the open of that structure's candle).
grp_ent          = "5. Entry Lines"
ent_trend        = input.bool(true,  "Trend",        inline="etr", group=grp_ent, tooltip="TREND entries — in the leg's own direction, from the levels printed BEFORE any pullback forms.\n\nU = MC (raw body close). Only on H1 and higher — never drawn below H1.\nXU = GMC (gap-confirmed).\nPO4 = the leg's origin (T1, T2, T3...).")
ent_tr_u         = input.bool(false, "U",            inline="etr", group=grp_ent)
ent_tr_xu        = input.bool(true,  "XU",           inline="etr", group=grp_ent)
ent_tr_o         = input.bool(true,  "PO4",          inline="etr", group=grp_ent)
ent_pb           = input.bool(false, "Pullback",     inline="epb", group=grp_ent, tooltip="PULLBACK entries — trading AGAINST the trend. ONLY on the numbered pullback of each range (MP1 / GMP1, GMP2, GMP3...). Internal small-letter mp / gmp never get an entry. Off by default.\n\nU = MP# (raw). Ignored in GMPO (strict) mode.\nXU = GMP# (gap-confirmed).\nPO4 = the open of the P# candle — the pullback's own origin.")
ent_pb_u         = input.bool(false, "U",            inline="epb", group=grp_ent)
ent_pb_xu        = input.bool(true,  "XU",           inline="epb", group=grp_ent)
ent_pb_o         = input.bool(false, "PO4",          inline="epb", group=grp_ent)
ent_ct           = input.bool(true,  "Continuation", inline="ect", group=grp_ent, tooltip="CONTINUATION entries — with the trend, after the pullback. ONLY on the numbered resumption (MCR# / GMCR#). Internal resumptions never get an entry.\n\nU = MCR# (raw).\nXU = GMCR# (gap-confirmed).\nPO4 = the open of the R# candle — the origin that becomes the next T-tier on LD / SD.")
ent_ct_u         = input.bool(false, "U",            inline="ect", group=grp_ent)
ent_ct_xu        = input.bool(true,  "XU",           inline="ect", group=grp_ent)
ent_ct_o         = input.bool(false, "PO4",          inline="ect", group=grp_ent)
ent_best_zone    = input.bool(true,  "Best Entry Zone (T1)", group=grp_ent, tooltip="Trend family only. Shades the area from the CDL down to the LOWEST LOW of the leg (bull), or from the CDS up to the HIGHEST HIGH of the leg (bear) — the best area to look for a trend entry.\n\nThe leg extreme is measured from the old trend's origin to the reversal, and it keeps extending if a later wick goes deeper while the T1 lives. The zone lives exactly as long as its T1.")
ent_mode         = input.string("MMM Entry", "Entry Mode", options=["MMM Entry", "SBE", "Both"], group=grp_ent, tooltip="MMM Entry — the normal MMM Pro entry line.\n\nSBE (Suggested Best Entry) — most structures are born when price breaks OUT of a balance zone (a cluster of NBC candles). SBE places a second entry at the edge of that zone: the LOW of the zone for a bullish structure, the HIGH of the zone for a bearish one. It is only shown where MMM Pro already gives an entry, and only when it is a better (deeper) price than the MMM entry.\n\nBoth — show both lines.")
sbe_min_nbc      = input.int(1, "SBE Min NBC Candles", minval=1, maxval=20, inline="sbe", group=grp_ent, tooltip="How many NBC candles the balance zone needs before the break for an SBE to be placed. Body: build the zone from candle bodies (open / close) instead of wicks (high / low).")
sbe_body         = input.bool(true, "Body", inline="sbe", group=grp_ent)
ent_open_only    = input.bool(false, "Only at 3rd BC Gap", group=grp_ent, tooltip="XU entries only.\n\nOn: the entry is always the 3rd candle's body-close edge (its low / high) — the strongest confirmation only.\n\nOff: the entry adapts to the 3rd candle type — body close → its low / high; strong affinity rejection → the void midline; otherwise → the gap candle's open.")
ent_style        = input.string("Compact", "Label Style", options=["Text","Symbol","Compact"], group=grp_ent, tooltip="Text: \"Long Entry\" / \"Short Entry\"\nSymbol: ⬆ / ⬇\nCompact: \"Long ⬆\" / \"Short ⬇\"\n\nA ✓ is added only when price comes BACK and touches the entry on a later candle — never on the candle that plotted it.")
ent_trig_mode    = input.string("Keep Extending", "On Trigger", options=["Keep Extending","Stop Extending","Hide"], group=grp_ent, tooltip="What an entry line does once price comes back and touches it.\n\nKeep Extending — stays, with a ✓.\nStop Extending — stays with a ✓, frozen at the touch candle.\nHide — removed once touched (the newest stays until a close breaks it).")
max_ent          = input.int(10, "Max Entries Drawn", minval=0, maxval=500, group=grp_ent, tooltip="Only the newest N origin entries are drawn. 0 = no limit.")

// ─── 6. eBLOCKS / iBLOCKS ───
grp_zones        = "6. eBlocks / iBlocks"
zone_po4         = input.bool(false, "eBlock  (T1 Origins)", group=grp_zones, tooltip="eBlock — the highest tier. Drawn ONLY on T1 origins, where a reversal (CDL / CDS) started a new trend. Labelled \"eBlock CDL\" / \"eBlock CDS\".")
zone_res         = input.bool(false, "iBlock  (Official Resumptions T2, T3...)", group=grp_zones, tooltip="iBlock — official resumption blocks. Drawn on every T2, T3, T4... origin, born of an LD / SD continuation (LD+ / SD+ included). Labelled \"MMM iBlock L / S\".")
zone_gmc         = input.bool(false, "XU iBlock  (Extreme Urgency — GMC)", group=grp_zones, tooltip="Extreme Urgency. Drawn on gap-confirmed momentum levels (GMC / GMCR): a body close the next candle confirmed with a gap. Labelled \"MMM XU iBlock L / S\".")
zone_mc          = input.bool(false, "U iBlock  (Urgency — MC)", group=grp_zones, tooltip="Urgency — the lowest tier. Drawn on raw body closes (MC / MCR) not yet gap-confirmed. Off by default: once one gap-confirms it becomes an XU iBlock instead. Labelled \"MMM U iBlock L / S\".")
zone_show_name   = input.bool(true,  "Name Inside Box", inline="zlbl", group=grp_zones, tooltip="Name: draws the block's name inside the box, pinned to its right edge.\nVolume: adds a label on the block's edge with the anchor candle's relative volume, e.g. \"Strong: 180% 🔥\".")
zone_show_vol    = input.bool(false, "Volume Strength", inline="zlbl", group=grp_zones)
zone_ext         = input.int(7, "Block Extension (Candles)", minval=0, maxval=100, group=grp_zones, tooltip="How many candles every block extends past the current bar.")
zone_calc_basis  = input.string("High/Low", "Calculation Basis", options=["High/Low", "Open/Close (Body)"], group=grp_zones, tooltip="Whether the block divides the full wick range or only the candle body.")
zone_tier        = input.string("50% (0-50% / 50-100%)", "Zone Selection", options=["Extreme (0-12.5% / 87.5-100%)", "Balanced (12.5-25% / 75-87.5%)", "Standard (25-50% / 50-75%)", "50% (0-50% / 50-100%)"], group=grp_zones)
show_50_line     = input.bool(false, "50% Line", inline="50_line", group=grp_zones, tooltip="The dashed midline through each block (the 50% of the anchor candle), plus its short connector to the candle edge. Off by default.")
line_50_style    = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], inline="50_line", group=grp_zones)
line_50_width    = input.int(1, "Width", minval=1, maxval=10, inline="50_line", group=grp_zones)
max_zones        = input.int(5, "Max Blocks Drawn", minval=0, maxval=500, group=grp_zones, tooltip="Only the newest N blocks are drawn. 0 = no limit.")

// ─── 7. STRUCTURAL VOIDS ───
grp_gaps         = "7. Structural Voids"
show_upg         = input.bool(true, "UDG", inline="g1", group=grp_gaps, tooltip="Unfair Delivery Gap — delivery skipped entirely between candle 1 and candle 3. Strongest tier.")
bull_upg_css     = input.color(color.new(#2157f3,80), "Bull", inline="g1", group=grp_gaps)
bear_upg_css     = input.color(color.new(#ff1100,80), "Bear", inline="g1", group=grp_gaps)
show_og          = input.bool(true, "UOG", inline="g2", group=grp_gaps, tooltip="Unfair Opening Gap — a clean open above the prior high (bull) or below the prior low (bear).")
bull_og_css      = input.color(color.new(#2157f3,50), "Bull", inline="g2", group=grp_gaps)
bear_og_css      = input.color(color.new(#ff1100,50), "Bear", inline="g2", group=grp_gaps)
show_vi          = input.bool(true, "ULG", inline="g3", group=grp_gaps, tooltip="Unfair Liquidity Gap — bodies don't overlap but wicks do. The subtlest tier.")
bull_vi_css      = input.color(color.new(#2157f3,0), "Bull", inline="g3", group=grp_gaps)
bear_vi_css      = input.color(color.new(#ff1100,0), "Bear", inline="g3", group=grp_gaps)
min_udg_ticks    = input.int(2, "Min UDG Size (Ticks)", group=grp_gaps, tooltip="Minimum gap size to count as a UDG. Filters out microscopic 1-tick gaps. This also drives GMC / GMP gap confirmation.")
gapExtMode       = input.string("Filled & Unfilled (Sliced)", "Extension Mode", options=["Minimalistic","Until First Touch","Until Filled","Filled & Unfilled (Sliced)"], group=grp_gaps, tooltip="Minimalistic: fixed length (Mini Length).\nUntil First Touch: extends until price first touches it.\nUntil Filled: extends until fully filled.\nSliced: split into slices that change color as price fills them.")
mini_len         = input.int(3, "Mini Length", minval=1, maxval=50, inline="gsz", group=grp_gaps)
slices_count     = input.int(8, "Slices", minval=2, maxval=30, inline="gsz", group=grp_gaps)
col_partial      = input.color(color.new(color.gray,90), "Touched Slice", group=grp_gaps)
show_midlines    = input.bool(false, "Midlines", inline="gopt", group=grp_gaps)
hide_filled      = input.bool(true, "Delete When Filled", inline="gopt", group=grp_gaps)
show_gap_labels  = input.bool(false, "Void Labels", inline="g6", group=grp_gaps)
gap_lbl_side     = input.string("Left", "", options=["Left","Right"], inline="g6", group=grp_gaps)
gap_lbl_col      = input.color(color.white, "", inline="g6", group=grp_gaps)
maxGaps          = input.int(5, "Max Voids Drawn", minval=0, maxval=500, group=grp_gaps, tooltip="Only the newest N voids are kept. 0 = no limit.")

// ─── 8. CANDLE COLORING ───
grp_ccm          = "8. Candle Coloring"
ccm_mmm_theme    = input.bool(true, "MMM Theme (Cyan / Purple)", group=grp_ccm, tooltip="Off = Classic theme (green / red).\n\nAll candle coloring is applied only once a candle has CLOSED — the live candle keeps its normal color.")
nbc_col          = input.color(color.white, "NBC Candle Color", group=grp_ccm, tooltip="Color for every NBC (Non-Body-Close) candle. Turn it on / off in group 2.")
ccm_gap_bull_col = input.color(color.red,  "Gap Absorbed  Bull", inline="ccm1", group=grp_ccm, tooltip="Net-bull close with a red body, and net-bear close with a green body.")
ccm_gap_bear_col = input.color(color.lime, "Bear", inline="ccm1", group=grp_ccm)
ccm_pause_col    = input.color(#9e9e9e, "Balanced", inline="ccm2", group=grp_ccm)
ccm_doji_col     = input.color(#616161, "Doji", inline="ccm2", group=grp_ccm)
hvc_show_ultra   = input.bool(true, "Ultra-High", inline="hvcs", group=grp_ccm, tooltip="Volume Intensity tiers shown (turn the feature on in group 2).")
hvc_show_high    = input.bool(true, "High", inline="hvcs", group=grp_ccm)
hvc_filter_poc_va = input.bool(false, "Must Close Beyond POC & VA", group=grp_ccm, tooltip="On: a bull Ultra/High candle must close above POC and VAH; a bear one below POC and VAL.")
hvc_bull_ultra_col = input.color(#006400, "Ultra Bull", inline="hvc1", group=grp_ccm)
hvc_bull_high_col  = input.color(#01d401, "High Bull",  inline="hvc1", group=grp_ccm)
hvc_bear_ultra_col = input.color(#880e4f, "Ultra Bear", inline="hvc2", group=grp_ccm)
hvc_bear_high_col  = input.color(#ff00ff, "High Bear",  inline="hvc2", group=grp_ccm)
