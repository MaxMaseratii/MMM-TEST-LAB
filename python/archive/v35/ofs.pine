//@version=6
indicator("MMM Market Structure & Order Flow Suite @MaxMaserati 3.4", "MMM Order Flow @MaxMaserati 3.4", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════
// MMM ORDER FLOW SUITE 3.4 — the SWING engine of the MMM foundation
//
//  ENGINE  Swing High / Low = the extreme of a leg, locked by the first
//          opposite BC. A close through a swing = a break.
//          Flip        = CDLs / CDSs  (first break against the trend)
//          Continuation= LDs1, LDs2… / SDs1, SDs2… (count runs until the
//                        next flip; only swings of the CURRENT leg count)
//          SH1, SH2… / SL1, SL2… = the number of the break each swing
//          will make if it is taken next.
//  GATE    Same impulse → pullback → continuation rhythm as MMM Pro Edge:
//          Flip official   = the old leg reached its extreme
//                            (CDL: oscillator ≤ 20 · CDS: ≥ 80)
//          Continuation    = the leg reached its own extreme, THEN the
//          official          pullback reached the opposite extreme.
//          NO GATE = every break is official.
//          The engine never changes with the gate: the gate only decides
//          which breaks are shown, alerted and traded.
//  Every decision is taken on CLOSED candles. No repaint.
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════
const color DEEP_GREEN = #006400
const color DEEP_RED   = #8b0000
const color LINE_BULL  = #00b400
const color LINE_BEAR  = #c80000
const color PROT_BULL  = #103c10
const color PROT_BEAR  = #ff0000
const color BULL_TGT   = #046319
const color BEAR_TGT   = #ae0303
const color FAIL_COL   = #9e9e9e
const int   MAX_MARKS  = 50
const int   FP_VA      = 70
const int   SETUP_EXT  = 8
const string NY        = "America/New_York"

// ═══════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════
type SwingLine
    line         id
    label        lbl
    float        price
    int          t1
    int          bIndex
    bool         isProtected
    array<line>  breakLines
    array<label> breakLbls

type GapBox
    box   b
    line  l
    label lbl
    float top
    float bot
    bool  isBull
    bool  isLine
    bool  isTouched
    bool  stoppedExtending
    color origBg
    color origBorder
    color origLine
    int   creationBar

type AxData
    label lbl
    label tri
    float trigger
    bool  isBull

type Setup
    bool  isBull
    float entry
    float sl
    float tp
    float prot
    box   zone
    line  eLn
    line  slLn
    line  tpLn
    label eLbl
    label slLbl
    label tpLbl
    bool  filled
    bool  done
    int   startBar

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
grp_cndl = "Auction State (Candles)"
show_candles = input.bool(true, "Enable Auction State Colors", group=grp_cndl)
c_bull_bc    = input.color(#27ffc3, "BuBC (Bullish Unfair)", group=grp_cndl, tooltip="Candle CLOSED above the previous high. Buyers won the auction.")
c_bear_bc    = input.color(#9c27b0, "BeBC (Bearish Unfair)", group=grp_cndl, tooltip="Candle CLOSED below the previous low. Sellers won the auction.")
c_nbc        = input.color(color.white, "NBC (Fair Pricing)", group=grp_cndl, tooltip="Close stayed inside the previous range. Balanced two-way auction.")

grp_of = "Order Flow (Delta & Volume)"
use_footprint     = input.bool(true, "Use Real Footprint Delta", group=grp_of, tooltip="Needs TradingView Premium. Falls back to synthetic delta when footprint data is missing.")
fp_ticks          = input.int(10, "Ticks per Row", minval=1, group=grp_of)
vol_len           = input.int(20, "Volume Average Length", minval=2, group=grp_of)
strong_vol_factor = input.float(1.5, "Strong Volume (x Average)", minval=1.0, step=0.1, group=grp_of, tooltip="Volume must be this many times the average of the PREVIOUS bars to count as STRONG.")

grp_acc = "Momentum Ignition (Accelerators)"
ax_col_on           = input.bool(true, "AX Candle Coloring", inline="axo", group=grp_acc, tooltip="Colors AX candles deep green / deep red. Independent from the labels.")
ax_lbl_on           = input.bool(true, "AX Labels", inline="axo", group=grp_acc, tooltip="BuAx / BeAx labels and triangles. Independent from the coloring. A label is deleted when a candle CLOSES beyond its AX candle (below the low for BuAx, above the high for BeAx).")
max_ax              = input.int(25, "Max AX Labels", minval=1, maxval=100, group=grp_acc)
detect_plus_only    = input.bool(false, "Plus Velocity Only (BuAx+/BeAx+)", group=grp_acc)
size_factor         = input.float(1.5, "Range Expansion Factor", minval=1.0, step=0.1, group=grp_acc)
use_vol_filter      = input.bool(true, "Require Strong Volume", group=grp_acc)
use_delta_filter    = input.bool(true, "Enable Delta Confirmation", inline="ax1", group=grp_acc)
delta_factor        = input.float(1.5, "Delta Expansion", minval=1.0, step=0.1, inline="ax1", group=grp_acc)
ax_must_be_wickless = input.bool(false, "Strict: AX Must Be Wickless", group=grp_acc)
show_bull           = input.bool(true, "Bullish AX", inline="ax2", group=grp_acc)
show_bear           = input.bool(true, "Bearish AX", inline="ax2", group=grp_acc)
show_triangles      = input.bool(true, "Show Triangles", inline="ax3", group=grp_acc)
