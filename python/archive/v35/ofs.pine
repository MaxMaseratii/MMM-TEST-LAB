lbl_size_str        = input.string("tiny", "Label Size", options=["tiny", "small", "normal", "large"], group=grp_acc)

grp_strc = "Market Structure (Swing Engine)"
showSwings          = input.bool(true, "Show Swings (SH/SL)", inline="s1", group=grp_strc)
showLabelsRight     = input.bool(true, "Project Labels Right", inline="s1", group=grp_strc)
maxSwings           = input.int(10, "Max Swings per Side", minval=2, maxval=50, group=grp_strc)
eng_letter          = input.string("s", "Engine Letter", options=["s", "r", "none"], group=grp_strc, tooltip="Letter added to every break so you know which engine made it.\ns = Swing (recommended: \"r\" is already used for Resumption in MMM Pro).\nr = Range.\nnone = plain CDL / CDS / LD / SD.")
showNumbers         = input.bool(true, "Number Breaks + Swings", group=grp_strc, tooltip="After a CDL: LD1, LD2, LD3… until the next CDS. Swing highs of the new leg show SH1, SH2… = the LD number they make if taken next. Mirror for CDS / SD / SL.")
showBreaks          = input.bool(true, "Show Breaks", inline="s2", group=grp_strc, tooltip="LD / SD only print for swings of the CURRENT leg (made after the last flip). Old-trend swings are deleted silently when taken.")
showStars           = input.bool(true, "Grade Break Quality", inline="s2", group=grp_strc, tooltip="1-4 stars. +1 above-average volume, +2 STRONG volume, +1 delta agrees, +1 break candle is an Accelerator (⚡). 0 stars = no stars shown.")
showSweeps          = input.bool(true, "Show Strong Sweeps (SWP+)", group=grp_strc, tooltip="Wick takes a swing, close comes back inside, with STRONG volume and delta pushing back. Deleted when a candle CLOSES beyond the sweep candle (below its low for a low sweep, above its high for a high sweep).")
showProtectedLevels = input.bool(true, "Show Protected Levels", group=grp_strc)

grp_gate = "Gate (Which Breaks Are Official)"
gate_mode   = input.string("NO GATE", "Gate", options=["NO GATE", "MMPD 27", "MMPD fast", "MMPD Delta"], group=grp_gate, tooltip="NO GATE = every break is official (normal break, no filter).\n\nMMPD 27 / MMPD fast / MMPD Delta = the same rhythm as MMM Pro Edge:\n• Flip (CDL / CDS) is official only if the old leg reached its extreme first: oscillator ≤ 20 before a CDL, ≥ 80 before a CDS.\n• Continuation (LD / SD) is official only if the leg reached its OWN extreme (bull ≥ 80) and THEN the pullback reached the OPPOSITE extreme (≤ 20) before the break.\n\nMMPD Delta = the natural order-flow version (built on candle delta).\n\nThe engine is the same for every gate. Only official breaks get entries, alerts and HTF bias.")
gate_fast   = input.int(9, "MMPD fast Length", minval=5, maxval=50, group=grp_gate)
show_failed = input.bool(false, "Show Failed Breaks (small grey)", group=grp_gate, tooltip="OFF = only official breaks are drawn.\nON = breaks that failed the gate are drawn small, in grey, lowercase.")

grp_htf = "HTF Bias (HTF in LTF)"
htf_mode   = input.string("Off", "HTF Bias From", options=["Off", "Last Flip (CDL/CDS)", "Last Continuation (LD/SD)", "Last BC"], group=grp_htf, tooltip="The swing engine runs on the HTF (last CLOSED HTF candle only, no repaint).\n\nLast Flip = direction of the last HTF CDL / CDS (the trend).\nLast Continuation = direction of the last HTF LD / SD made AFTER the last flip. No continuation yet = no bias.\nLast BC = direction of the last HTF body close candle.\n\nOff = no HTF filter.")
htf_tf     = input.timeframe("60", "HTF Timeframe", group=grp_htf)
htf_filter = input.bool(true, "Entries With HTF Bias Only", group=grp_htf)
htf_table  = input.bool(true, "Show HTF Bias Box", group=grp_htf)

grp_ent = "Entry Lines (after official breaks)"
show_entries = input.bool(true, "Show Entry Lines", group=grp_ent)
min_stars    = input.int(2, "Min Break Stars", minval=0, maxval=4, group=grp_ent, tooltip="Only breaks graded this high or more get an entry setup.")
entry_anchor = input.string("Break Open", "Limit Order On", options=["Break Open", "50% Leg"], group=grp_ent, tooltip="Break Open = body origin of the break candle (first reaction). 50% Leg = halfway between the protected level and the break candle extreme (deeper, better price, fills less).")
stop_pts_in  = input.float(0.0, "Stop (pts) — 0 = Auto", minval=0.0, step=1.0, group=grp_ent, tooltip="Auto: NQ/MNQ = 50 pts, ES/MES = 20 pts. Other symbols: distance to the protected level.")
rr_ratio     = input.float(2.0, "Reward : Risk", minval=0.5, step=0.5, group=grp_ent)
c_zone_bull  = input.color(#27ffc3, "Long Zone", inline="e1", group=grp_ent)
c_zone_bear  = input.color(#9c27b0, "Short Zone", inline="e1", group=grp_ent)

grp_news = "News Block (no trades)"
news_on    = input.bool(true, "Block Entries Around News", group=grp_news, tooltip="No new entry setup, and any UNFILLED setup is cancelled, on a candle that touches a news window (New York time). Intraday charts only.\nCPI / NFP: 08:30. FOMC: 14:00 statement + 14:30 press conference.")
news_nfp   = input.bool(true, "NFP = First Friday of the Month", group=grp_news, tooltip="BLS sometimes moves NFP (holidays, shutdowns). Add those dates to the CPI list if needed.")
news_pre   = input.int(5, "Minutes Before", minval=0, maxval=120, inline="nw", group=grp_news)
news_post  = input.int(15, "Minutes After", minval=0, maxval=240, inline="nw", group=grp_news)
cpi_dates  = input.text_area("2026-01-13,2026-02-13,2026-03-11,2026-04-10,2026-05-12,2026-06-10,2026-07-14,2026-08-12,2026-09-11,2026-10-14,2026-11-10,2026-12-10,2027-01-13,2027-02-11,2027-03-10,2027-04-13,2027-05-12,2027-06-10,2027-07-14,2027-08-11,2027-09-14,2027-10-14,2027-11-10,2027-12-10", "CPI Dates (YYYY-MM-DD)", group=grp_news, tooltip="Comma separated, New York date. Source: BLS release schedule. Add older dates to block them in backtests.")
fomc_dates = input.text_area("2025-01-29,2025-03-19,2025-05-07,2025-06-18,2025-07-30,2025-09-17,2025-10-29,2025-12-10,2026-01-28,2026-03-18,2026-04-29,2026-06-17,2026-07-29,2026-09-16,2026-10-28,2026-12-09,2027-01-27,2027-03-17,2027-04-28,2027-06-09,2027-07-28,2027-09-15,2027-10-27,2027-12-08", "FOMC Decision Dates (YYYY-MM-DD)", group=grp_news, tooltip="Comma separated, decision day only. 2027 dates are tentative — check federalreserve.gov.")
news_bg    = input.bool(true, "Shade News Windows", group=grp_news)

grp_wick = "Un-Auctioned Price (Wickless)"
show_uh_ul      = input.bool(true, "Enable UH$/UL$ Detection", group=grp_wick, tooltip="Candles closing flat at their extreme leave un-auctioned price. Deleted when a candle CLOSES beyond the level (above UH$, below UL$).")
dots_on_ax_only = input.bool(false, "Strict: AX Candles Only", group=grp_wick)
uh_col          = input.color(color.red, "UH Color", inline="w2", group=grp_wick)
