//@version=6
indicator("MMM Concepts Pro+ @MaxMaserati 3.6", "MMM Concepts Pro+ 3.6", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════
// MMM CONCEPTS PRO+ 3.6 — the ZONE engine "x" of the MMM foundation
//
//  The MMM Pro T# / P# / R# system, driven by box breaks:
//  BOX   = an expander BC + the candles that close back inside it.
//  T#    = the last PO4 x. Bull: BuPO4x below price · Bear: BePO4x above.
//  P#    = the FIRST box after T# = the pullback start (bull: its high,
//          bear: its low). We trade between T# and P#.
//  R#    = the first box after the P# box ended = the resumption base
//          (bull: its low, bear: its high). A close back through it erases it.
//  LDx#  = a body close past P#  -> R# becomes T(#+1).
//  CDLx / CDSx = a body close past the last T# -> the P# edge becomes T1.
//  Every other box break is ignored, so only useful breaks print.
//  HUSBAND & WIFE: a break label lives on its PO4; close through the PO4 and
//  the PO4, its break and its eBlock / iBlock go together.
//  No entries, no stops: see the MMM Indicator Test Plan.
//  Block TF data = last CLOSED block candle only. No repaint.
// ═══════════════════════════════════════════════════════════════

const color BOX_ACC  = #1b8a3a
const color BOX_DIS  = #b3261e
const color BOX_NEU  = #808080

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
grp_tf = "1. Block Timeframe (HTF in LTF)"
tfMode         = input.string("Manual", "Timeframe Mode", options=["Manual", "Auto Combination"], group=grp_tf, tooltip="Manual = the block timeframe below.\nAuto Combination = the chart timeframe × 4 or × 6 (M15 chart -> H1 or H1:30 blocks).\nBoxes and breaks are built on the block timeframe and drawn on the chart. Only CLOSED block candles are used.")
autoMultiplier = input.string("4x", "Auto Multiplier", options=["4x", "6x"], group=grp_tf)
blockTimeframe = input.timeframe("", "Block Timeframe", group=grp_tf, tooltip="Empty = chart timeframe.")
