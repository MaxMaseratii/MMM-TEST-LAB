bear_vi_css     = input.color(color.new(#ff1100, 0), "Be", inline="g3", group=grp_gaps)
gapExtMode      = input.string("Until First Touch", "Extension Mode", options=["3 Candles (Fixed)", "Until First Touch", "Until Filled"], group=grp_gaps)
