st_help = input.bool(false, "Explanation Table", inline="sth", group=grp_st, tooltip="A separate small table that says what the BC Flow numbers mean.")
st_hpos = input.string("Bottom Left", "", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], inline="sth", group=grp_st)

// ═══════════════════════════════════════════════════════════════
// SHARED MODULES
// ═══════════════════════════════════════════════════════════════
string ENG = eng_letter == "none" ? "" : eng_letter

// ═══════════════════════════════════════════════════════════════
// GATE OSCILLATORS (same math as Super MMPD / MMM Pro Edge)
// ═══════════════════════════════════════════════════════════════
const color FAIL_COL = #9e9e9e
bool gateOn = gate_mode != "NO GATE"
bool show_failed = false   // MMM Pro Edge: a break that fails the gate is never made, so nothing fails

f_xsa(float src, int len) =>
    var float out = na
    float ma = ta.sma(src, len)
    out := na(out) ? ma : (src + out * (len - 1)) / len
    out

f_mmpd(int len) =>
    float cl = (close - ta.lowest(low, len)) / (ta.highest(high, len) - ta.lowest(low, len)) * 100
    float s1 = f_xsa(cl, 5)
    float s2 = f_xsa(s1, 3)
    float c  = (3 * s1 - 2 * s2 - 50) * 1.032 + 50
    float o  = ta.ema(((2 * close + high + low + open) / 5 - ta.lowest(low, len + 7)) / (ta.highest(high, len + 7) - ta.lowest(low, len + 7)) * 100, 13)
    [c, o]

f_dma() =>
    float v  = na(volume) or volume == 0 ? 1.0 : volume
    float dl = close > open and close > close[1] ? v : close < open and close < close[1] ? -v : close > close[1] ? v * 0.5 : close < close[1] ? -v * 0.5 : 0.0
    float ds = ta.ema(dl, 3)
    float lo = ta.lowest(ds, 14)
    float dr = ta.highest(ds, 14) - lo
    float c  = ta.ema(dr > 0 ? (ds - lo) / dr * 100 : 50, 3)
    float o  = ta.ema(c, 13)
    [c, o]

f_gateNow() =>
    [c1, o1] = f_mmpd(27)
    [c2, o2] = f_mmpd(gate_fast)
    [c3, o3] = f_dma()
    float hi = gate_mode == "MMPD 27" ? math.max(c1, o1) : gate_mode == "MMPD fast" ? math.max(c2, o2) : math.max(c3, o3)
    float lo = gate_mode == "MMPD 27" ? math.min(c1, o1) : gate_mode == "MMPD fast" ? math.min(c2, o2) : math.min(c3, o3)
    [hi, lo]

f_gatePrev() =>
    [hi, lo] = f_gateNow()
    [hi[1], lo[1]]

// Gate memory (impulse -> pullback -> continuation)
var bool hitXD   = false   // oscillator <= 20 since the last flip
var bool hitXP   = false   // oscillator >= 80 since the last flip
var bool bullImp = false   // bull leg reached its own extreme (>= 80)
var bool bullPb  = false   // then the pullback reached <= 20
var bool bearImp = false
var bool bearPb  = false

// Zone slice of an origin candle / box: which part is drawn depends on the
// Premium / Discount side and the depth.
f_zoneSlice(float top, float bot, bool isBull) =>
    bool  lowSide = zone_side == "Long in Discount / Short in Premium" ? isBull : not isBull
    float rng = top - bot
    float zT = na
    float zB = na
    if zone_tier == "Extreme (0-12.5% / 87.5-100%)"
        zT := lowSide ? bot + rng * 0.125 : top
        zB := lowSide ? bot : bot + rng * 0.875
    else if zone_tier == "Balanced (12.5-25% / 75-87.5%)"
        zT := lowSide ? bot + rng * 0.25 : bot + rng * 0.875
        zB := lowSide ? bot + rng * 0.125 : bot + rng * 0.75
    else if zone_tier == "Standard (25-50% / 50-75%)"
        zT := lowSide ? bot + rng * 0.50 : bot + rng * 0.75
        zB := lowSide ? bot + rng * 0.25 : bot + rng * 0.50
    else
        zT := lowSide ? bot + rng * 0.50 : top
        zB := lowSide ? bot : bot + rng * 0.50
    [zT, zB]
// ═══════════════════════════════════════════════════════════════
// STRUCTURE TIMEFRAME — last CLOSED structure candle ([1] + lookahead_on).
// On the chart timeframe the candle is read directly (no delay).
// ═══════════════════════════════════════════════════════════════
f_get_auto_tf(string _tf, string _multStr) =>
    int mult = _multStr == "4x" ? 4 : 6
    int tf_sec = timeframe.in_seconds(_tf)
    string res = _tf
    if not na(tf_sec)
        int tf_mins = math.round(tf_sec / 60)
        if tf_sec < 60
            res := str.tostring(tf_sec * mult) + "S"
        else if tf_mins < 1440
            res := str.tostring(tf_mins * mult)
        else if tf_mins == 1440
            res := str.tostring(mult) + "D"
        else if tf_mins == 10080
            res := str.tostring(mult) + "W"
        else
            res := str.tostring(mult) + "M"
    res

f_tfName(string t) =>
    string s = str.length(t) == 0 ? timeframe.period : t
    switch s
        "1"   => "M1"
        "3"   => "M3"
        "5"   => "M5"
        "15"  => "M15"
        "30"  => "M30"
        "45"  => "M45"
        "60"  => "H1"
        "120" => "H2"
        "180" => "H3"
        "240" => "H4"
        "360" => "H6"
        "480" => "H8"
        "720" => "H12"
        => s

string blockTF     = tfMode == "Auto Combination" ? f_get_auto_tf(timeframe.period, autoMultiplier) : (structTimeframe == "" ? timeframe.period : structTimeframe)
bool   blockSameTF = timeframe.in_seconds(blockTF) <= timeframe.in_seconds(timeframe.period)
string TFP         = showTfLabel and not blockSameTF ? f_tfName(blockTF) + " " : ""

// Structure candle: OHLCV, its history, a close-location delta and its RVOL.
f_blockNow() =>
    float rg = high - low
    float v  = nz(volume)
    float dl = rg > 0 ? v * ((close - low) - (high - close)) / rg : 0.0
    float av = ta.sma(v, 20)[1]
    float rv = nz(av) > 0 ? v / av : 0.0
    [time, open, high, low, close, v, high[1], low[1], high[2], low[2], open[1], close[1], time[1], dl, rv]

f_blockPrev() =>
    [t0, o0, h0, l0, c0, v0, ph0, pl0, ph2, pl2, po0, pc0, pt0, dl0, rv0] = f_blockNow()
    [t0[1], o0[1], h0[1], l0[1], c0[1], v0[1], ph0[1], pl0[1], ph2[1], pl2[1], po0[1], pc0[1], pt0[1], dl0[1], rv0[1]]

[n_t, n_o, n_h, n_l, n_c, n_v, n_h1, n_l1, n_h2, n_l2, n_o1, n_c1, n_t1, n_dl, n_rv] = f_blockNow()
[s_t, s_o, s_h, s_l, s_c, s_v, s_h1, s_l1, s_h2, s_l2, s_o1, s_c1, s_t1, s_dl, s_rv] = request.security(syminfo.tickerid, blockTF, f_blockPrev(), lookahead=barmerge.lookahead_on)
[g_hi_htf, g_lo_htf] = request.security(syminfo.tickerid, blockTF, f_gatePrev(), lookahead=barmerge.lookahead_on)
[g_hi_now, g_lo_now] = f_gateNow()

int   bT  = blockSameTF ? n_t  : s_t
float bO  = blockSameTF ? n_o  : s_o
float bH  = blockSameTF ? n_h  : s_h
float bL  = blockSameTF ? n_l  : s_l
float bC  = blockSameTF ? n_c  : s_c
float bV  = blockSameTF ? n_v  : s_v
float bH1 = blockSameTF ? n_h1 : s_h1
float bL1 = blockSameTF ? n_l1 : s_l1
float bH2 = blockSameTF ? n_h2 : s_h2
float bL2 = blockSameTF ? n_l2 : s_l2
float bO1 = blockSameTF ? n_o1 : s_o1
float bC1 = blockSameTF ? n_c1 : s_c1
int   bT1 = blockSameTF ? n_t1 : s_t1
float bDl = blockSameTF ? n_dl : s_dl
float bRv = blockSameTF ? n_rv : s_rv
float bVp = bRv * 100
float gHi = blockSameTF ? g_hi_now : g_hi_htf
float gLo = blockSameTF ? g_lo_now : g_lo_htf

var int prevBlockT = 0
bool newBlock = not na(bT) and bT != prevBlockT
prevBlockT := nz(bT, prevBlockT)
bool stepNow = barstate.isconfirmed and newBlock
// Zone name from the naming scheme. isFlip = T1 (CDL / CDS), else T2+ (LD / SD).
f_zoneName(bool isFlip, bool isBull, string eng) =>
    string fl = (isBull ? "CDL" : "CDS") + eng
    string co = (isBull ? "LD" : "SD") + eng
    zone_naming == "eBlock / iBlock" ? (isFlip ? "MMM eBlock " + fl : "MMM iBlock " + co) : zone_naming == "External / Internal Entry Zone" ? (isFlip ? "External Entry Zone " + fl : "Internal Entry Zone " + co) : (isFlip ? "Flip Zone " + fl : "Continuation Zone " + co)
// ═══════════════════════════════════════════════════════════════
// RIGHT-EDGE LEVELS — levels sharing a price MERGE into one line whose label
// joins every name with " & " (MMM Pro system). Highest priority styles it.
// ═══════════════════════════════════════════════════════════════
type EdgeLvl
    float         price
    array<string> labels
    color         ln_col
    int           ln_width
    string        ln_style
    int           b_time
    int           e_time
    int           priority
    string        txt_sz
    string        tip

var array<EdgeLvl> render_groups = array.new<EdgeLvl>()
var array<line>    drawn_lines   = array.new<line>()
var array<label>   drawn_labels  = array.new<label>()
var array<box>     drawn_boxes   = array.new<box>()

f_eps() => math.max(syminfo.mintick * 0.51, 1e-5)

f_szs(string s) =>
    s == "large" ? size.large : s == "normal" ? size.normal : s == "small" ? size.small : size.tiny

f_add_level(float p_price, string p_text, color p_col, int p_width, string p_style, int p_start_t, int p_end_t, int p_prio, string p_txt_sz, string p_tip) =>
    bool found = false
    int b0 = math.min(nz(p_start_t, time), nz(p_end_t, time))
    int e0 = math.max(nz(p_start_t, time), nz(p_end_t, time))
    if render_groups.size() > 0
        for grp in render_groups
            if math.abs(grp.price - p_price) <= f_eps()
                found := true
                if str.length(p_text) > 0 and array.indexof(grp.labels, p_text) == -1
                    grp.labels.push(p_text)
                grp.b_time := math.min(grp.b_time, b0)
                grp.e_time := math.max(grp.e_time, e0)
                if str.length(p_tip) > 0
                    grp.tip := str.length(grp.tip) > 0 ? grp.tip + "\n" + p_tip : p_tip
                if p_prio > grp.priority
                    grp.ln_col   := p_col
                    grp.ln_width := p_width
                    grp.ln_style := p_style
                    grp.priority := p_prio
                    grp.txt_sz   := p_txt_sz
                break
    if not found
        array<string> nl = array.new<string>()
        if str.length(p_text) > 0
            nl.push(p_text)
        render_groups.push(EdgeLvl.new(p_price, nl, p_col, p_width, p_style, b0, e0, p_prio, p_txt_sz, p_tip))

f_clear_drawn() =>
    if drawn_lines.size() > 0
        for ln in drawn_lines
            line.delete(ln)
        drawn_lines.clear()
    if drawn_labels.size() > 0
        for lb in drawn_labels
            label.delete(lb)
        drawn_labels.clear()
    if drawn_boxes.size() > 0
        for bx in drawn_boxes
            box.delete(bx)
        drawn_boxes.clear()

f_draw_groups() =>
    if render_groups.size() > 0
        for grp in render_groups
            drawn_lines.push(line.new(grp.b_time, grp.price, grp.e_time, grp.price, xloc=xloc.bar_time, color=grp.ln_col, width=grp.ln_width, style=grp.ln_style))
            drawn_labels.push(label.new(grp.e_time, grp.price, array.join(grp.labels, " & "), xloc=xloc.bar_time, textcolor=grp.ln_col, color=color(na), style=label.style_label_left, size=f_szs(grp.txt_sz), tooltip=grp.tip))
    render_groups.clear()

var int bar_time_diff = timeframe.in_seconds() * 1000
f_future_time(int ext) =>
    int diff = time - nz(time[1], time)
    if diff <= 0
        diff := bar_time_diff
    if diff <= 0
        diff := 60000
    time + math.round(diff * ext)
// ═══════════════════════════════════════════════════════════════
// OUTSIDE-RANGE ALLOCATOR — inside the marker range = always drawn; outside =
// a 50 / 50 bull / bear budget, newest first. q = [bull left, bear left].
// ═══════════════════════════════════════════════════════════════
f_inR(float p, float hi, float lo) =>
    not na(hi) and not na(lo) and not na(p) and p <= hi + f_eps() and p >= lo - f_eps()

f_boxInR(float top, float bot, float hi, float lo) =>
    not na(hi) and not na(lo) and top <= hi + f_eps() and bot >= lo - f_eps()

// Items born on the candle of the highest / lowest marker (one STRUCTURE candle
// = spanMs wide) are allowed even with Max = 0.
f_onMarker(int t, int hiT, int loT, int spanMs) =>
    int w = math.max(nz(spanMs), 1)
    not na(t) and ((not na(hiT) and t >= hiT and t < hiT + w) or (not na(loT) and t >= loT and t < loT + w))

f_quota() =>
    int qBull = int(math.ceil(maxLines / 2.0))
    array.from(qBull, maxLines - qBull)

f_take(array<int> q, bool inside, bool isBull) =>
    bool ok = inside
    if not ok
        int k = isBull ? 0 : 1
        if q.get(k) > 0
            q.set(k, q.get(k) - 1)
            ok := true
    ok
// ═══════════════════════════════════════════════════════════════
// MMM ZONE ENGINE (x) — box break logic inside the MMM Pro T# / P# / R# system.
// One block candle per call when doStep is true (state lives inside).
//  BOX     = expander BC + the candles that close back inside it.
//            G1 grow: an inside candle's wick past the edge pushes the edge out.
//            G0 fixed: the box keeps the range it was born with.
//  TREND   = the last PO4 x (Tn). Bull: BuPO4x below price · Bear: BePO4x above.
//  P#      = the FIRST box after Tn = the pullback start.
//            Bull: its HIGH is the level · Bear: its LOW is the level.
//  R#      = the first box formed after the P# box ended = the resumption base.
//            Bull: its LOW · Bear: its HIGH. A close back through it erases it.
//  LDx#    = a body close past P# -> R# becomes T(#+1) (no R# = the pullback extreme).
//  CDLx / CDSx = a body close past the last T# -> the P# level becomes the new T1
//            (no P# = the extreme of the leg). Every other box break is ignored.
// Returns the state + this candle's events.
// ═══════════════════════════════════════════════════════════════
// GATE (gOn): P# is a small p until the leg reached its own extreme and THEN
// the pullback reached the opposite extreme (gh / gl = oscillator high / low).
// A close past a small p deletes it (no LDx). R# only forms after the P# is
// confirmed. Flips stay structural.
f_zoneEngine(bool doStep, float o, float h, float l, float c, float v, float ph, float pl, int t, bool grow, bool expMode, bool gOn, float gh, float gl) =>
    var bool  zWait = false
    var float exH   = na
    var float exL   = na
    var int   exT   = na
    var int   exDir = 0
    var bool  zLive = false
    var float bxH   = na
    var float bxL   = na
    var int   bxT   = na
    var int   bxId  = 0
    var float bxD   = 0.0
    var float bxV   = 0.0
    var int   side  = 0
    var int   tier  = 0
    var float tnP   = na
    var int   tnT   = na
    var float pP    = na
    var int   pT    = na
    var int   pId   = -1
    var bool  pLive = false
    var float pOH   = na
    var float pOL   = na
    var float rP    = na
    var int   rT    = na
    var int   rId   = -1
    var bool  rLive = false
    var float rOH   = na
    var float rOL   = na
    var float legHi = na
    var float legHiL = na
    var int   legHiT = na
    var float legLo = na
    var float legLoH = na
    var int   legLoT = na
    var float pbHi  = na
    var float pbHiL = na
    var int   pbHiT = na
    var float pbLo  = na
    var float pbLoH = na
    var int   pbLoT = na
    var bool  imp   = false
    var bool  pConf = false
    int   evType = 0
    int   evDir  = 0
    int   evNum  = 0
    float brkP   = na
    int   brkT   = na
    float nTnP   = na
    int   nTnT   = na
    float nOH    = na
    float nOL    = na
    int   nOT    = na
    bool  endF   = false
    float endH   = na
    float endL   = na
    int   endT   = na
    int   endRole = 0
    float endNdb = 0.0
    int   formRole = -1
    if doStep and not na(c) and not na(ph) and not na(pl)
        bool  bu  = c > ph
        bool  be  = c < pl
        bool  bc  = bu or be
        float rg  = h - l
        float dlt = rg > 0 ? nz(v) * ((c - l) - (h - c)) / rg : 0.0
        bool  formed = false
        // 1. BOX DETECTOR
        if zLive
            if c > bxH or c < bxL
                endF    := true
                endH    := bxH
                endL    := bxL
                endT    := bxT
                endRole := bxId == pId ? 1 : bxId == rId ? 2 : 0
                endNdb  := bxV > 0 ? bxD / bxV : 0.0
                if bxId == pId
                    pLive := false
                if bxId == rId
                    rLive := false
                zLive := false
                zWait := bc
                if bc
                    exH   := h
                    exL   := l
                    exT   := t
                    exDir := bu ? 1 : -1
            else
                if grow
                    bxH := math.max(bxH, h)
                    bxL := math.min(bxL, l)
                bxD += dlt
                bxV += nz(v)
        else if zWait
            if bc
                exH   := h
                exL   := l
                exT   := t
                exDir := bu ? 1 : -1
            else
                zLive  := true
                zWait  := false
                formed := true
                bxId   += 1
                bxT    := exT
                bxD    := dlt
                bxV    := nz(v)
                if expMode
                    bxH := grow ? math.max(exH, h) : exH
                    bxL := grow ? math.min(exL, l) : exL
                else
                    bxH := h
                    bxL := l
        else if bc
            zWait := true
            exH   := h
            exL   := l
            exT   := t
            exDir := bu ? 1 : -1
        // live P# / R# boxes carry their level while they grow
        if zLive and bxId == pId
            pP  := side == 1 ? bxH : bxL
            pOH := bxH
            pOL := bxL
        if zLive and bxId == rId
            rP  := side == 1 ? bxL : bxH
            rOH := bxH
            rOL := bxL
        // 2. EXTREMES (leg since Tn, pullback since P#)
        if side != 0
            if na(legHi) or h > legHi
                legHi  := h
                legHiL := l
                legHiT := t
            if na(legLo) or l < legLo
                legLo  := l
                legLoH := h
                legLoT := t
        if not na(pP)
            if na(pbHi) or h > pbHi
                pbHi  := h
                pbHiL := l
                pbHiT := t
            if na(pbLo) or l < pbLo
                pbLo  := l
                pbLoH := h
                pbLoT := t
        // GATE: the leg reached its OWN extreme (bull >= 80 / bear <= 20)
        bool pConfBefore = pConf
        if gOn and side != 0 and not imp and not na(gh) and not na(gl) and ((side == 1 and gh >= 80) or (side == -1 and gl <= 20))
            imp := true
        bool pKill = false
        // 3. STRUCTURE: Reversal > Continuation > R# invalidation
        if side == 1
            if c < tnP
                evType := 1
                evDir  := -1
                brkP   := tnP
                brkT   := tnT
                bool hasP = not na(pP)
                nTnP := hasP ? pP : legHi
                nTnT := hasP ? pT : legHiT
                nOH  := hasP ? pOH : legHi
                nOL  := hasP ? pOL : legHiL
                nOT  := hasP ? pT : legHiT
            else if not na(pP) and c > pP and gOn and not pConfBefore
                pKill := true
            else if not na(pP) and c > pP
                evType := 2
                evDir  := 1
                evNum  := tier
                brkP   := pP
                brkT   := pT
                bool hasR = not na(rP)
                nTnP := hasR ? rP : pbLo
                nTnT := hasR ? rT : pbLoT
                nOH  := hasR ? rOH : pbLoH
                nOL  := hasR ? rOL : pbLo
                nOT  := hasR ? rT : pbLoT
            else if not na(rP) and c < rP
                rP    := na
                rT    := na
                rId   := -1
                rLive := false
        else if side == -1
            if c > tnP
                evType := 1
                evDir  := 1
                brkP   := tnP
                brkT   := tnT
                bool hasP = not na(pP)
                nTnP := hasP ? pP : legLo
                nTnT := hasP ? pT : legLoT
                nOH  := hasP ? pOH : legLoH
                nOL  := hasP ? pOL : legLo
                nOT  := hasP ? pT : legLoT
            else if not na(pP) and c < pP and gOn and not pConfBefore
                pKill := true
            else if not na(pP) and c < pP
                evType := 2
                evDir  := -1
                evNum  := tier
                brkP   := pP
                brkT   := pT
                bool hasR = not na(rP)
                nTnP := hasR ? rP : pbHi
                nTnT := hasR ? rT : pbHiT
                nOH  := hasR ? rOH : pbHi
                nOL  := hasR ? rOL : pbHiL
                nOT  := hasR ? rT : pbHiT
            else if not na(rP) and c > rP
                rP    := na
                rT    := na
                rId   := -1
                rLive := false
        else if endF
            // GENESIS: the first box break starts the first trend
            evType := 1
            evDir  := c > endH ? 1 : -1
            brkP   := evDir == 1 ? endH : endL
            brkT   := endT
            nTnP   := evDir == 1 ? endL : endH
            nTnT   := endT
            nOH    := endH
            nOL    := endL
            nOT    := endT
        if pKill
            // small p closed through before the gate confirmed it -> deleted, no LDx / SDx
            pP    := na
            pT    := na
            pId   := -1
            pLive := false
            rP    := na
            rT    := na
            rId   := -1
            rLive := false
            pbHi  := na
            pbLo  := na
        if evType != 0
            imp   := not gOn
            pConf := false
            side  := evDir
            tier  := evType == 1 ? 1 : tier + 1
            tnP   := nTnP
            tnT   := nTnT
            pP    := na
            pT    := na
            pId   := -1
            pLive := false
            rP    := na
            rT    := na
            rId   := -1
            rLive := false
            legHi  := h
            legHiL := l
            legHiT := t
            legLo  := l
            legLoH := h
            legLoT := t
            pbHi  := na
            pbLo  := na
        // GATE: p -> P# once the pullback reached the OPPOSITE extreme after the leg's own extreme
        bool pConfPrev = pConf
        if gOn and evType == 0 and not pKill and not na(pP) and not pConf and imp and not na(gh) and not na(gl) and ((side == 1 and gl <= 20) or (side == -1 and gh >= 80))
            pConf := true
        // 4. ROLE of a box born on this candle
        if formed
            formRole := 0
            if side != 0 and na(pP)
                pId   := bxId
                pLive := true
                pP    := side == 1 ? bxH : bxL
                pT    := bxT
                pOH   := bxH
                pOL   := bxL
                pbHi  := bxH
                pbHiL := bxL
                pbHiT := bxT
                pbLo  := bxL
                pbLoH := bxH
                pbLoT := bxT
                formRole := 1
            else if side != 0 and not pLive and na(rP) and (not gOn or pConfPrev)
                rId   := bxId
                rLive := true
                rP    := side == 1 ? bxL : bxH
                rT    := bxT
                rOH   := bxH
                rOL   := bxL
                formRole := 2
    float liveNdb = bxV > 0 ? bxD / bxV : 0.0
    int   liveRole = zLive ? (bxId == pId ? 1 : bxId == rId ? 2 : 0) : -1
    [side, tier, tnP, tnT, pP, pT, rP, rT, evType, evDir, evNum, brkP, brkT, nTnP, nTnT, nOH, nOL, nOT, zLive, bxH, bxL, bxT, liveNdb, liveRole, endF, endH, endL, endT, endRole, endNdb, pConf]
// ═══════════════════════════════════════════════════════════════
// HTF BIAS — compact copies of the three MMM engines, run on the HTF.
// Last CLOSED HTF candle only ([1] + lookahead_on) = no repaint.
// Each returns [flip side, continuation side, last BC, BC origin]
// origin: 2 = the last BC was a flip candle, 1 = a continuation candle, 0 = plain.
// ═══════════════════════════════════════════════════════════════
f_htfSwing() =>
    var float   tH    = high
    var float   tL    = low
    var int     tSt   = 0
    var int     sig   = 0
    var int     lastC = 0
    var int     cdlB  = -1
    var int     cdsB  = -1
    var float[] hs    = array.new<float>()
    var int[]   hsb   = array.new<int>()
    var float[] ls    = array.new<float>()
    var int[]   lsb   = array.new<int>()
    bool flipEv = false
    bool contEv = false
    bool bu = close > high[1]
    bool be = close < low[1]
    if tSt == 0
        tH := math.max(tH, high)
        tL := math.min(tL, low)
    if tSt == 1 and high >= tH
        tH := high
    if tSt == -1 and low <= tL
        tL := low
    if be and tSt >= 0
        hs.push(tH)
        hsb.push(bar_index)
        tSt := -1
        tL  := low
    else if bu and tSt <= 0
        ls.push(tL)
        lsb.push(bar_index)
        tSt := 1
        tH  := high
    bool lowDone = false
    if ls.size() > 0
        for i = ls.size() - 1 to 0
            float p = ls.get(i)
            int   b = lsb.get(i)
            if b < bar_index and close < p
                if not lowDone
                    bool flip = sig != -1
                    if flip or b > cdsB
                        lowDone := true
                        if flip
                            cdsB   := bar_index
                            lastC  := 0
                            flipEv := true
                        else
                            lastC  := -1
                            contEv := true
                        sig := -1
                ls.remove(i)
                lsb.remove(i)
    bool highDone = false
    if hs.size() > 0
        for i = hs.size() - 1 to 0
            float p = hs.get(i)
            int   b = hsb.get(i)
            if b < bar_index and close > p
                if not highDone
                    bool flip = sig != 1
                    if flip or b > cdlB
                        highDone := true
                        if flip
                            cdlB   := bar_index
                            lastC  := 0
                            flipEv := true
                        else
                            lastC  := 1
                            contEv := true
                        sig := 1
                hs.remove(i)
                hsb.remove(i)
    while ls.size() > 20
        ls.shift()
        lsb.shift()
    while hs.size() > 20
        hs.shift()
        hsb.shift()
    [sig, lastC, flipEv, contEv]

f_htfCandle() =>
    var int   side  = 0
    var float tn    = na
    var float pb    = na
    var float rs    = na
    var int   lastC = 0
    bool flipEv = false
    bool contEv = false
    bool bu   = close > high[1]
    bool be   = close < low[1]
    bool done = false
    if side == 1
        if close < tn
            side   := -1
            tn     := na(pb) ? open : pb
            pb     := na
            rs     := na
            lastC  := 0
            done   := true
            flipEv := true
        else if not na(pb) and close > pb
            tn     := na(rs) ? open : rs
            pb     := na
            rs     := na
            lastC  := 1
            done   := true
            contEv := true
    else if side == -1
        if close > tn
            side   := 1
            tn     := na(pb) ? open : pb
            pb     := na
            rs     := na
            lastC  := 0
            done   := true
            flipEv := true
        else if not na(pb) and close < pb
            tn     := na(rs) ? open : rs
            pb     := na
            rs     := na
            lastC  := -1
            done   := true
            contEv := true
    else
        if bu or be
            side   := bu ? 1 : -1
            tn     := open
            done   := true
            flipEv := true
    if not done
        if side == 1
            if not na(rs) and close < rs
                rs := na
            if be and na(pb)
                pb := open
            else if bu and not na(pb) and na(rs)
                rs := open
        else if side == -1
            if not na(rs) and close > rs
                rs := na
            if bu and na(pb)
                pb := open
            else if be and not na(pb) and na(rs)
                rs := open
    [side, lastC, flipEv, contEv]

f_htfZone() =>
    var int lastC = 0
    [zs, zt, ztn, ztt, zp, zpt, zr, zrt, zev, zdir, znum, zbp, zbt, zntp, zntt, zoh, zol, zot, zlive, zbh, zbl, zbt2, zndb, zrole, zef, zeh, zel, zet, zer, zen, zpc] = f_zoneEngine(true, open, high, low, close, volume, high[1], low[1], time, true, true, false, na, na)
    if zev == 1
        lastC := 0
    if zev == 2
        lastC := zdir
    [zs, lastC, zev == 1, zev == 2]

f_htfAll() =>
    var int lastBC = 0
    var int bcOrg  = 0
    [s1, c1, f1, n1] = f_htfSwing()
    [s2, c2, f2, n2] = f_htfCandle()
    [s3, c3, f3, n3] = f_htfZone()
    bool useX = htf_eng == "Zone x (boxes)"
    bool useC = htf_eng == "Candle c (PO4)"
    int  sd = useX ? s3 : useC ? s2 : s1
    int  cn = useX ? c3 : useC ? c2 : c1
    bool fe = useX ? f3 : useC ? f2 : f1
    bool ne = useX ? n3 : useC ? n2 : n1
    bool bu = close > high[1]
    bool be = close < low[1]
    if bu or be
        lastBC := bu ? 1 : -1
        bcOrg  := fe ? 2 : ne ? 1 : 0
    [nz(sd[1]), nz(cn[1]), nz(lastBC[1]), nz(bcOrg[1])]

[htfSig, htfCont, htfBC, htfOrg] = request.security(syminfo.tickerid, htf_tf, f_htfAll(), lookahead=barmerge.lookahead_on)
int  htfBias = htf_src == "Last BC" ? htfBC : htf_src == "Last Flip (CDL / CDS)" ? htfSig : htf_src == "Last Continuation (LD / SD)" ? htfCont : 0

// true when a break in direction dir goes AGAINST the HTF bias
f_againstHtf(int dir) =>
    htf_src != "Off" and htfBias != 0 and htfBias != dir

f_htfPos(string p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Bottom Left"   => position.bottom_left
        "Bottom Right"  => position.bottom_right
        => position.bottom_center
// ═══════════════════════════════════════════════════════════════
// NEWS ENGINE (shared by every MMM indicator) — light: no library and no
// external request. Events come from the one calendar box.
// ═══════════════════════════════════════════════════════════════
const string NWS_TZ = "America/New_York"

type NewsMark
    label dot
    label txt
    box   bg
    float price
    bool  atHi
    int   bar
    int   wS
    int   wE

f_nwImpOk(string imp) =>
    imp == "H" ? news_red : imp == "M" ? news_org : imp == "L" ? news_yel : imp == "N" ? news_gry : false

f_nwCol(string imp) =>
    imp == "H" ? color.red : imp == "M" ? color.orange : imp == "L" ? color.yellow : color.gray

f_nwRank(string imp) =>
    imp == "H" ? 4 : imp == "M" ? 3 : imp == "L" ? 2 : 1

f_nwDate(string d, int hh, int mm) =>
    int t = na
    if str.length(d) == 10
        float y  = str.tonumber(str.substring(d, 0, 4))
        float m  = str.tonumber(str.substring(d, 5, 7))
        float dd = str.tonumber(str.substring(d, 8, 10))
        if not na(y) and not na(m) and not na(dd)
            t := timestamp(NWS_TZ, int(y), int(m), int(dd), hh, mm)
    t

var array<int>    nwT = array.new<int>()
var array<string> nwI = array.new<string>()
var array<string> nwN = array.new<string>()

if barstate.isfirst
    array<int>    tT = array.new<int>()
    array<string> tI = array.new<string>()
    array<string> tN = array.new<string>()
    string curList = "," + str.replace_all(str.upper(news_cur), " ", "") + ","
    for ln in str.split(str.replace_all(news_paste, ";", "\n"), "\n")
        array<string> tk = str.split(str.trim(ln), " ")
        if tk.size() >= 4
            string dS  = tk.get(0)
            string tS  = tk.get(1)
            string cur = str.upper(tk.get(2))
            string imp = str.upper(tk.get(3))
            if str.length(tS) == 5 and str.contains(curList, "," + cur + ",") and f_nwImpOk(imp)
                float hh = str.tonumber(str.substring(tS, 0, 2))
                float mm = str.tonumber(str.substring(tS, 3, 5))
                if not na(hh) and not na(mm)
                    int t = f_nwDate(dS, int(hh), int(mm))
                    if not na(t)
                        string ttl = ""
                        if tk.size() > 4
                            for k = 4 to tk.size() - 1
                                ttl += (k > 4 ? " " : "") + tk.get(k)
                        tT.push(t)
                        tI.push(imp)
                        tN.push(str.length(ttl) > 0 ? ttl : cur)
    if tT.size() > 0
        array<int> ord = tT.sort_indices(order.ascending)
        for k = 0 to ord.size() - 1
            nwT.push(tT.get(ord.get(k)))
            nwI.push(tI.get(ord.get(k)))
            nwN.push(tN.get(ord.get(k)))

int    nwPre    = news_pre * 60000
int    nwPost   = news_post * 60000
int    nwWarn   = (news_warn == "15" ? 15 : 30) * 60000
int    nwBarMs  = timeframe.in_seconds(timeframe.period) * 1000
int    nwEnd    = nz(time_close, time + nwBarMs)
var int nwPtr   = 0
bool   nwInWin  = false
int    nwWinS   = na
int    nwWinE   = na
string nwWarnTxt = ""
string nwWarnTip = ""
string nwWarnImp = ""
int    nwWarnS  = na
int    nwWarnE  = na
if timeframe.isintraday and nwT.size() > 0
    while nwPtr < nwT.size()
        if nwT.get(nwPtr) + nwPost < time
            nwPtr += 1
        else
            break
    if nwPtr < nwT.size()
        for j = nwPtr to nwT.size() - 1
            int et = nwT.get(j)
            if et - math.max(nwPre, nwWarn) >= nwEnd
                break
            if time < et + nwPost and nwEnd > et - nwPre
                nwInWin := true
                nwWinS  := na(nwWinS) ? et - nwPre : math.min(nwWinS, et - nwPre)
                nwWinE  := na(nwWinE) ? et + nwPost : math.max(nwWinE, et + nwPost)
            int wt = et - nwWarn
            if wt >= time and wt < nwEnd
                string nm = nwN.get(j)
                if not str.contains(nwWarnTxt, nm)
                    nwWarnTxt += (str.length(nwWarnTxt) > 0 ? "/" : "") + nm
                nwWarnTip += (str.length(nwWarnTip) > 0 ? "\n" : "") + str.format_time(et, "HH:mm", NWS_TZ) + " NY · " + nwI.get(j) + " · " + nm
                nwWarnS := na(nwWarnS) ? et - nwPre : math.min(nwWarnS, et - nwPre)
                nwWarnE := na(nwWarnE) ? et + nwPost : math.max(nwWarnE, et + nwPost)
                if str.length(nwWarnImp) == 0 or f_nwRank(nwI.get(j)) > f_nwRank(nwWarnImp)
                    nwWarnImp := nwI.get(j)
bool newsBlock = nwInWin
bool newsWarn  = str.length(nwWarnTxt) > 0

var array<NewsMark> nwMarks = array.new<NewsMark>()
var int nwKillE = na   // end of a window whose dot was taken: no new shading before it

f_nwMake(bool keep) =>
    color dc   = f_nwCol(nwWarnImp)
    bool  atHi = news_dot_at == "High"
    float p    = atHi ? high : low
    label d    = news_dot ? label.new(bar_index, p, "", style=label.style_circle, color=dc, textcolor=dc, size=size.tiny, tooltip="News in " + news_warn + " min:\n" + nwWarnTip) : na
    label tx   = news_lbl ? label.new(bar_index, p, nwWarnTxt, style=close < open ? label.style_label_down : label.style_label_up, color=color(na), textcolor=dc, size=size.tiny, tooltip=nwWarnTip) : na
    if keep
        nwMarks.push(NewsMark.new(d, tx, na, p, atHi, bar_index, nwWarnS, nwWarnE))
    keep

// Live candle: a temporary dot (rolled back every tick). Closed candle: kept.
if newsWarn and (news_dot or news_lbl)
    f_nwMake(barstate.isconfirmed)

if barstate.isconfirmed and timeframe.isintraday
    // Background: shade the window of the newest mark (or start one when the
    // warning candle was missed).
    if nwInWin and news_bg and (na(nwKillE) or time >= nwKillE)
        NewsMark m = na
        if nwMarks.size() > 0
            m := nwMarks.last()
        if na(m) or time >= m.wE
            m := NewsMark.new(na, na, na, na, true, bar_index, nwWinS, nwWinE)
            nwMarks.push(m)
        if na(m.bg)
            m.bg := box.new(time, high, nwEnd, low, xloc=xloc.bar_time, border_color=na, bgcolor=color.new(color.orange, 85))
        else
            m.bg.set_right(nwEnd)
            m.bg.set_top(math.max(m.bg.get_top(), high))
            m.bg.set_bottom(math.min(m.bg.get_bottom(), low))
    // Deletion: a later candle takes the dot -> dot, label and background go together.
    if news_del and nwMarks.size() > 0
        for i = nwMarks.size() - 1 to 0
            NewsMark m = nwMarks.get(i)
            if not na(m.price) and bar_index > m.bar
                bool hit = news_del_mode == "Touch" ? (m.atHi ? high >= m.price : low <= m.price) : (m.atHi ? close > m.price : close < m.price)
                if hit
                    if not na(m.wE)
                        nwKillE := na(nwKillE) ? m.wE : math.max(nwKillE, m.wE)
                    label.delete(m.dot)
                    label.delete(m.txt)
                    box.delete(m.bg)
                    nwMarks.remove(i)
    // Caps: dots + labels share one count, backgrounds have their own.
    int nDot = 0
    int nBg  = 0
    if nwMarks.size() > 0
        for i = nwMarks.size() - 1 to 0
            NewsMark m = nwMarks.get(i)
            if not na(m.dot) or not na(m.txt)
                nDot += 1
                if nDot > news_max
                    label.delete(m.dot)
                    label.delete(m.txt)
                    m.dot := na
                    m.txt := na
            if not na(m.bg)
                nBg += 1
                if nBg > news_bg_max
                    box.delete(m.bg)
                    m.bg := na
            if na(m.dot) and na(m.txt) and na(m.bg) and time >= m.wE
                nwMarks.remove(i)
// ═══════════════════════════════════════════════════════════════
// BC FLOW STATS (chart timeframe) + VOLATILITY STOP (S6) IN POINTS
//  run          = BCs in one direction until the first opposite BC
//  pure run     = BCs in a row with NO NBC between
//  flip         = an opposite BC · continuation = a same-side BC after an NBC pause
// Index 0 = bull runs, 1 = bear runs.
// ═══════════════════════════════════════════════════════════════
var int stDir   = 0
var int stPure  = 0
var int stRun   = 0
var int stNbc   = 0
var int stConts = 0
var array<float> stPureFlipS = array.from(0.0, 0.0)
var array<int>   stPureFlipN = array.from(0, 0)
var array<float> stPureNbcS  = array.from(0.0, 0.0)
var array<int>   stPureNbcN  = array.from(0, 0)
var array<float> stRunS      = array.from(0.0, 0.0)
var array<int>   stRunN      = array.from(0, 0)
var array<float> stNbcFlipS  = array.from(0.0, 0.0)
var array<int>   stNbcFlipN  = array.from(0, 0)
var array<float> stNbcContS  = array.from(0.0, 0.0)
var array<int>   stNbcContN  = array.from(0, 0)
var array<float> stContS     = array.from(0.0, 0.0)
var array<int>   stImmFlip   = array.from(0, 0)

f_stAdd(array<float> s, array<int> n, int k, float v) =>
    s.set(k, s.get(k) + v)
    n.set(k, n.get(k) + 1)

if barstate.isconfirmed and bar_index > 0
    int sd = close > high[1] ? 1 : close < low[1] ? -1 : 0
    int sk = stDir == 1 ? 0 : 1
    if sd == 0
        if stDir != 0
            if stNbc == 0 and stPure > 0
                f_stAdd(stPureNbcS, stPureNbcN, sk, stPure)
            stNbc  += 1
            stPure := 0
    else if stDir == 0
        stDir   := sd
        stPure  := 1
        stRun   := 1
        stNbc   := 0
        stConts := 0
    else if sd == stDir
        if stNbc > 0
            f_stAdd(stNbcContS, stNbcContN, sk, stNbc)
            stConts += 1
            stPure  := 1
        else
            stPure += 1
        stRun += 1
        stNbc := 0
    else
        if stNbc == 0
            f_stAdd(stPureFlipS, stPureFlipN, sk, stPure)
            stImmFlip.set(sk, stImmFlip.get(sk) + 1)
        f_stAdd(stRunS, stRunN, sk, stRun)
        f_stAdd(stNbcFlipS, stNbcFlipN, sk, stNbc)
        stContS.set(sk, stContS.get(sk) + stConts)
        stDir   := sd
        stPure  := 1
        stRun   := 1
        stNbc   := 0
        stConts := 0

float stAtrV  = ta.atr(st_atr)
float stFixV  = st_fix > 0 ? st_fix : str.contains(syminfo.root, "NQ") ? 50.0 : str.contains(syminfo.root, "ES") ? 20.0 : na

f_stAvg(array<float> s, array<int> n, int k) =>
    n.get(k) > 0 ? str.tostring(s.get(k) / n.get(k), "#.##") + "  (" + str.tostring(n.get(k)) + ")" : "—"

f_stPos(string p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

var table stHelp = table.new(f_stPos(st_hpos), 1, 1, bgcolor=#000000, frame_color=color.new(color.white, 70), frame_width=1)
var table stTbl = table.new(f_stPos(st_pos), 3, 14, bgcolor=#000000, frame_color=color.new(color.white, 70), frame_width=1, border_color=color.new(color.white, 85), border_width=1)
if barstate.islast and st_on
    string sz = st_sz == "Tiny" ? size.tiny : st_sz == "Normal" ? size.normal : size.small
    color  hd = #e1b31a
    color  wt = color.white
    color  bu = #27ffc3
    color  be = #c77dff
    table.cell(stTbl, 0, 0, "MMM BC FLOW · " + f_tfName(timeframe.period), text_color=hd, text_size=sz)
    table.cell(stTbl, 1, 0, "BULL runs", text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 0, "BEAR runs", text_color=be, text_size=sz)
    table.cell(stTbl, 0, 1, "Pure run → opposite BC: avg BCs (n)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 1, f_stAvg(stPureFlipS, stPureFlipN, 0), text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 1, f_stAvg(stPureFlipS, stPureFlipN, 1), text_color=be, text_size=sz)
    table.cell(stTbl, 0, 2, "Pure run → first NBC: avg BCs (n)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 2, f_stAvg(stPureNbcS, stPureNbcN, 0), text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 2, f_stAvg(stPureNbcS, stPureNbcN, 1), text_color=be, text_size=sz)
    table.cell(stTbl, 0, 3, "Run with NBC pauses → flip: avg BCs (n)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 3, f_stAvg(stRunS, stRunN, 0), text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 3, f_stAvg(stRunS, stRunN, 1), text_color=be, text_size=sz)
    table.cell(stTbl, 0, 4, "NBCs before a FLIP: avg (n)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 4, f_stAvg(stNbcFlipS, stNbcFlipN, 0), text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 4, f_stAvg(stNbcFlipS, stNbcFlipN, 1), text_color=be, text_size=sz)
    table.cell(stTbl, 0, 5, "NBCs before a CONTINUATION: avg (n)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 5, f_stAvg(stNbcContS, stNbcContN, 0), text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 5, f_stAvg(stNbcContS, stNbcContN, 1), text_color=be, text_size=sz)
    table.cell(stTbl, 0, 6, "Continuations per run: avg", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 6, stRunN.get(0) > 0 ? str.tostring(stContS.get(0) / stRunN.get(0), "#.##") : "—", text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 6, stRunN.get(1) > 0 ? str.tostring(stContS.get(1) / stRunN.get(1), "#.##") : "—", text_color=be, text_size=sz)
    table.cell(stTbl, 0, 7, "Flip straight after a BC (no NBC): %", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 7, stRunN.get(0) > 0 ? str.tostring(stImmFlip.get(0) * 100.0 / stRunN.get(0), "#.#") + "%" : "—", text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 7, stRunN.get(1) > 0 ? str.tostring(stImmFlip.get(1) * 100.0 / stRunN.get(1), "#.#") + "%" : "—", text_color=be, text_size=sz)
    table.cell(stTbl, 0, 8, "ATR(" + str.tostring(st_atr) + ") = average candle range, pts", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 8, str.tostring(stAtrV, format.mintick), text_color=wt, text_size=sz)
    table.merge_cells(stTbl, 1, 8, 2, 8)
    table.cell(stTbl, 0, 9, "S6 volatility stop 1.0 / 1.5 / 2.0 × ATR, pts", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 9, str.tostring(stAtrV, "#.##") + " / " + str.tostring(stAtrV * 1.5, "#.##") + " / " + str.tostring(stAtrV * 2.0, "#.##"), text_color=color.orange, text_size=sz)
    table.merge_cells(stTbl, 1, 9, 2, 9)
    table.cell(stTbl, 0, 10, "S0 fixed stop, pts (1:2 target)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 10, na(stFixV) ? "set it in the inputs" : str.tostring(stFixV, "#.##") + "  →  TP " + str.tostring(stFixV * 2, "#.##"), text_color=color.orange, text_size=sz)
    table.merge_cells(stTbl, 1, 10, 2, 10)
if barstate.islast and st_help
    table.cell(stHelp, 0, 0, "BC FLOW — Run = BCs one way until the first opposite BC · Pure = no NBC between · Flip = opposite BC · Continuation = same-side BC after an NBC pause · (n) = how many counted · S6 = ATR stop · S0 = fixed stop", text_color=color.silver, text_size=size.tiny, text_halign=text.align_left)
// ═══════════════════════════════════════════════════════════════
// XD / XP LABELS (MMM Pro Edge) — gate on only, read on the STRUCTURE candle.
// XD = oscillator <= 20 (Extreme Discount) at the candle low · XP = >= 80 at
// the high. A live label follows the extreme while the oscillator stays in the
// zone; once it left the zone, a close through the label deletes it.
// ═══════════════════════════════════════════════════════════════
type XdxpMark
    float price
    int   t
    int   side
    bool  live

var array<XdxpMark> xdxpArr = array.new<XdxpMark>()

if stepNow and gateOn and not na(gHi) and not na(gLo)
    XdxpMark xdLastD = na
    XdxpMark xdLastP = na
    if xdxpArr.size() > 0
        for xm in xdxpArr
            if xm.side == 1 and xm.live
                xdLastD := xm
            if xm.side == -1 and xm.live
                xdLastP := xm
    if gLo <= 20
        if not na(xdLastD)
            if bL < xdLastD.price
                xdLastD.price := bL
                xdLastD.t     := bT
        else
            xdxpArr.push(XdxpMark.new(bL, bT, 1, true))
    else if not na(xdLastD)
        xdLastD.live := false
    if gHi >= 80
        if not na(xdLastP)
            if bH > xdLastP.price
                xdLastP.price := bH
                xdLastP.t     := bT
        else
            xdxpArr.push(XdxpMark.new(bH, bT, -1, true))
    else if not na(xdLastP)
        xdLastP.live := false
    if xdxpArr.size() > 0
        for i = xdxpArr.size() - 1 to 0
            XdxpMark xm = xdxpArr.get(i)
            if not xm.live and ((xm.side == 1 and bC < xm.price - syminfo.mintick * 0.5) or (xm.side == -1 and bC > xm.price + syminfo.mintick * 0.5))
                xdxpArr.remove(i)
    while xdxpArr.size() > 30
        xdxpArr.shift()

// Called inside the render (barstate.islast), after the levels.
f_xdxpDraw() =>
    if gateOn and show_xdxp and xdxpArr.size() > 0
        int xdN = 0
        for i = xdxpArr.size() - 1 to 0
            if xdN >= xdxp_max
                break
            XdxpMark xm = xdxpArr.get(i)
            xdN += 1
            bool xdIsD = xm.side == 1
            drawn_labels.push(label.new(xm.t, xm.price, TFP + (xdIsD ? "XD" : "XP"), xloc=xloc.bar_time, style=xdIsD ? label.style_label_up : label.style_label_down, color=color.new(xdIsD ? LINE_BULL : LINE_BEAR, xm.live ? 0 : 35), textcolor=color.white, size=xdxp_size == "normal" ? size.normal : xdxp_size == "tiny" ? size.tiny : size.small, tooltip=(xdIsD ? "XD = Extreme Discount: " : "XP = Extreme Premium: ") + gate_mode + (xdIsD ? " <= 20" : " >= 80") + (xm.live ? " (still in the zone)" : "")))

// ═══════════════════════════════════════════════════════════════
// BASIC HELPERS
// ═══════════════════════════════════════════════════════════════
f_size(string s) =>
    s == "auto" ? size.auto : s == "small" ? size.small : s == "normal" ? size.normal : s == "large" ? size.large : size.tiny

f_fmt_delta(float d) =>
    float  a   = math.abs(d)
    string pfx = d >= 0.0 ? "+" : ""
    a >= 1000000.0 ? pfx + str.tostring(math.round(d / 1000000.0, 1)) + "M" : a >= 1000.0 ? pfx + str.tostring(math.round(d / 1000.0, 1)) + "K" : pfx + str.tostring(math.round(d))

f_synthetic_delta() =>
    float delta = 0.0
    float v     = nz(volume)
    if v > 0
        float pm = close - open
        float pr = high - low
        if pr > 0
            float bp = math.abs(pm) / pr
            float uw = high - math.max(open, close)
            float lw = math.min(open, close) - low
            float cp = (close - low) / pr
            if pm > 0
                float br = math.min(0.85, 0.50 + bp * 0.25 + (lw > uw ? 0.10 : 0.0) + (cp > 0.7 ? 0.05 : 0.0))
                delta := v * (br * 2.0 - 1.0)
            else if pm < 0
                float sr = math.min(0.85, 0.50 + bp * 0.25 + (uw > lw ? 0.10 : 0.0) + (cp < 0.3 ? 0.05 : 0.0))
                delta := v * -(sr * 2.0 - 1.0)
            else
                delta := uw > lw * 1.5 ? v * -0.40 : lw > uw * 1.5 ? v * 0.40 : v * (cp > 0.5 ? 0.04 : -0.04)
        else
            delta := pm > 0 ? v * 0.20 : pm < 0 ? v * -0.20 : 0.0
    delta

// ═══════════════════════════════════════════════════════════════
// CORE SERIES (all request.* / ta.* calls unconditional)
// ═══════════════════════════════════════════════════════════════
float candle_range = high - low

// RVOL vs the PREVIOUS bars (current bar is not inside its own average)
float avgVolume       = ta.sma(nz(volume), vol_len)[1]
float rvol            = nz(avgVolume) > 0 ? nz(volume) / avgVolume : 0.0
bool  strong_vol      = rvol >= strong_vol_factor
bool  strong_vol_prev = nz(rvol[1]) >= strong_vol_factor

footprint fp        = request.footprint(fp_ticks, FP_VA)
float fp_delta      = use_footprint and not na(fp) ? fp.delta() : na
bool  using_real_fp = not na(fp_delta)
float current_delta = using_real_fp ? fp_delta : f_synthetic_delta()

// Auction state: a break needs a CLOSE beyond the prior extreme
float candle_mid     = (high + low) / 2.0
bool  curr_BuBC      = close > high[1]
bool  curr_BeBC      = close < low[1]
bool  curr_BuBC_Plus = curr_BuBC and close > candle_mid
bool  curr_BeBC_Plus = curr_BeBC and close < candle_mid
bool  is_any_BC      = curr_BuBC or curr_BeBC

// Un-auctioned extremes
float _tk    = syminfo.mintick
bool  raw_ul = close >= open and (math.min(open, close) - low) <= _tk and candle_range > _tk
bool  raw_uh = close <= open and (high - math.max(open, close)) <= _tk and candle_range > _tk

// ═══════════════════════════════════════════════════════════════
// STEP 1 — ACCELERATORS (computed FIRST so structure can use them)
// ═══════════════════════════════════════════════════════════════
var float bc_range_1 = 0.0
var float bc_range_2 = 0.0
var float bc_delta_1 = 0.0
var float bc_delta_2 = 0.0
var bool  bc_real_1  = false
var bool  bc_real_2  = false

bool  base_ready    = bc_range_1 > 0 and bc_range_2 > 0
float avg_bc_range  = (bc_range_1 + bc_range_2) / 2.0
float avg_bc_delta  = (math.abs(bc_delta_1) + math.abs(bc_delta_2)) / 2.0
bool  delta_base_ok = avg_bc_delta > 0 and bc_real_1 == using_real_fp and bc_real_2 == using_real_fp

bool  bull_accel  = false
bool  bear_accel  = false
bool  is_plus     = false
float range_ratio = 0.0
float delta_ratio = 0.0

if base_ready and curr_BuBC and (not detect_plus_only or curr_BuBC_Plus)
    float rr      = candle_range / avg_bc_range
    float dr      = delta_base_ok ? math.abs(current_delta) / avg_bc_delta : 0.0
    bool  rng_ok  = rr >= size_factor
    bool  dlt_ok  = not use_delta_filter or (current_delta > 0 and (not delta_base_ok or dr >= delta_factor))
    bool  vol_ok  = not use_vol_filter or strong_vol
    bool  wick_ok = not ax_must_be_wickless or raw_ul
    if rng_ok and dlt_ok and vol_ok and wick_ok
        bull_accel  := true
        is_plus     := curr_BuBC_Plus
        range_ratio := rr
        delta_ratio := dr

if base_ready and curr_BeBC and (not detect_plus_only or curr_BeBC_Plus)
    float rr      = candle_range / avg_bc_range
    float dr      = delta_base_ok ? math.abs(current_delta) / avg_bc_delta : 0.0
    bool  rng_ok  = rr >= size_factor
    bool  dlt_ok  = not use_delta_filter or (current_delta < 0 and (not delta_base_ok or dr >= delta_factor))
    bool  vol_ok  = not use_vol_filter or strong_vol
    bool  wick_ok = not ax_must_be_wickless or raw_uh
    if rng_ok and dlt_ok and vol_ok and wick_ok
        bear_accel  := true
        is_plus     := curr_BeBC_Plus
        range_ratio := rr
        delta_ratio := dr

if barstate.isconfirmed and is_any_BC
    bc_range_2 := bc_range_1
    bc_range_1 := candle_range
    bc_delta_2 := bc_delta_1
    bc_delta_1 := current_delta
    bc_real_2  := bc_real_1
    bc_real_1  := using_real_fp

// ═══════════════════════════════════════════════════════════════
// TYPES & STATE
// ═══════════════════════════════════════════════════════════════
// A break, married to the PO4 swing that made it.
type Cause
    string kind
    float  price
    int    t1
    int    t2
    bool   isBull
    bool   pass
    bool   against
    int    score
    bool   ax
    string tip

type Swing
    float        price
    int          t
    int          bIdx
    bool         isHigh
    int          tier
    bool         official
    int          seq
    bool         swept
    float        oH
    float        oL
    int          oT
    array<Cause> causes
    bool         conf
    int          cIdx

type GapBox
    box   b
    line  l
    label lbl
    float top
    float bot
    bool  isBull
    bool  isLine
    bool  isTouched
    bool  stoppedExtending
    color origBg
    color origBorder
    color origLine
    int   creationBar
    int   t

type AxData
    label lbl
    label tri
    float trigger
    bool  isBull
    int   t

var Swing[]  swingHighs  = array.new<Swing>()
var Swing[]  swingLows   = array.new<Swing>()
var GapBox[] visual_gaps = array.new<GapBox>()
var AxData[] active_axs  = array.new<AxData>()
var label[]  sweep_lbls  = array.new<label>()
var float[]  sweep_lvls  = array.new<float>()
var float[]  sweep_px    = array.new<float>()
var int[]    sweep_t     = array.new<int>()
var bool[]   sweep_isLow = array.new<bool>()

var int   blkIdx        = 0
var int   signalState   = 0
var int   trendState    = 0
var int   lastCdlBar    = -1
var int   lastCdsBar    = -1
var int   ldCount       = 0
var int   sdCount       = 0
var int   po4Seq        = 0
var float trackHigh     = na
var int   trackHighTime = na
var float trackHighL    = na
var float trackLow      = na
var int   trackLowTime  = na
var float trackLowH     = na

bool cdl_event      = false
bool cds_event      = false
bool ld_event       = false
bool sd_event       = false
bool swp_low_event  = false
bool swp_high_event = false

// ═══════════════════════════════════════════════════════════════
// STRUCTURE HELPERS (they read the STRUCTURE candle's volume and delta)
// ═══════════════════════════════════════════════════════════════
f_breakScore(bool isBull, float rv, float dl, bool ax) =>
    int  volPts = rv >= strong_vol_factor ? 2 : rv >= 1.0 ? 1 : 0
    bool agree  = isBull ? dl > 0 : dl < 0
    volPts + (agree ? 1 : 0) + (ax ? 1 : 0)

f_breakTip(string kind, bool isBull, bool pass, float rv, float dl, bool ax, bool bcOk) =>
    bool   agree = isBull ? dl > 0 : dl < 0
    string ctag  = ax ? (isBull ? "BuAx (accelerator)" : "BeAx (accelerator)") : bcOk ? (isBull ? "BuBC" : "BeBC") : "NBC (soft break)"
    string src   = blockSameTF ? (using_real_fp ? "FOOTPRINT" : "SYNTHETIC") : "SYNTHETIC (structure TF " + f_tfName(blockTF) + ")"
    TFP + kind + (pass ? "" : " (failed " + gate_mode + ")") + " | Candle: " + ctag + "\nVolume: " + str.tostring(rv, "#.##") + "x avg" + (rv >= strong_vol_factor ? " (STRONG)" : "") + "\nDelta: " + f_fmt_delta(dl) + (agree ? " (agrees)" : " (against)") + "\nSource: " + src

f_newSwing(bool isHigh, float price, int t, float oOther, int idx) =>
    Swing.new(price, t, idx, isHigh, 0, true, 0, false, isHigh ? price : oOther, isHigh ? oOther : price, t, array.new<Cause>(), false, 0)

// GATE (MMM Pro Edge): a new leg / a continuation needs a fresh confirmation.
f_clearConf() =>
    if swingHighs.size() > 0
        for s in swingHighs
            s.conf := false
    if swingLows.size() > 0
        for s in swingLows
            s.conf := false

// Memory guard: plain swings go first, then the oldest PO4s.
f_guard(Swing[] arr) =>
    while arr.size() > maxKeep
        int idx = 0
        for j = 0 to arr.size() - 1
            if arr.get(j).tier == 0
                idx := j
                break
        arr.remove(idx)

// Only STRONG sweeps get a label. Returns true when it is a strong rejection.
f_sweep(float price, bool isLowSweep, float rv, float dl, float ext, int t) =>
    bool rej       = isLowSweep ? dl > 0 : dl < 0
    bool strongRej = rej and rv >= strong_vol_factor
    if strongRej and showSweeps
        string tip = (isLowSweep ? "Sell-side" : "Buy-side") + " liquidity swept, close back inside\nVolume: " + str.tostring(rv, "#.##") + "x avg (STRONG)\nDelta: " + f_fmt_delta(dl) + " (pushing back)\nDeleted on a close " + (isLowSweep ? "below this candle low" : "above this candle high")
        label lb = label.new(t, price, TFP + "SWP+", xloc=xloc.bar_time, color=color(na), textcolor=isLowSweep ? LINE_BULL : LINE_BEAR, style=isLowSweep ? label.style_label_up : label.style_label_down, size=size.tiny, tooltip=tip)
        sweep_lbls.push(lb)
        sweep_lvls.push(ext)
        sweep_px.push(price)
        sweep_t.push(t)
        sweep_isLow.push(isLowSweep)
        if sweep_lbls.size() > MAX_MARKS
            label.delete(sweep_lbls.shift())
            sweep_lvls.shift()
            sweep_px.shift()
            sweep_t.shift()
            sweep_isLow.shift()
    strongRej

f_addGap(int left, int right, float top, float bot, bool isBull, bool isLine, string txt, color bg, color border, color lnCol, bool fixedStop) =>
    float mid = math.avg(top, bot)
    box bx = isLine ? box.new(left, top, right, bot, border_color=border, bgcolor=color(na), border_style=line.style_dotted) : box.new(left, top, right, bot, border_color=color(na), bgcolor=bg)
    line ln = line.new(left, mid, right, mid, color=lnCol, style=isLine ? line.style_dotted : line.style_solid)
    label lb = show_gap_labels ? label.new(gap_lbl_side == "Right" ? right : left, mid, txt, color=color.new(color.white, 100), textcolor=gap_lbl_col, style=label.style_none, size=size.tiny) : na
    visual_gaps.push(GapBox.new(bx, ln, lb, top, bot, isBull, isLine, false, fixedStop, bg, border, lnCol, bar_index, time))

// ═══════════════════════════════════════════════════════════════
// STEP 2 — STRUCTURE (one closed STRUCTURE candle per step: HTF in LTF)
// ═══════════════════════════════════════════════════════════════
if stepNow
    blkIdx += 1
    // Order flow of the structure candle: real footprint only on the chart TF
    float sDl   = blockSameTF ? current_delta : bDl
    bool  sAxBu = blockSameTF and bull_accel
    bool  sAxBe = blockSameTF and bear_accel
    bool  bBu   = bC > bH1
    bool  bBe   = bC < bL1

    // 2a. GATE (MMM Pro Edge): the leg reached its OWN extreme (bull >= 80 / bear <= 20)
    if gateOn and not na(gHi) and not na(gLo)
        if gHi >= 80 and signalState == 1
            bullImp := true
        if gLo <= 20 and signalState == -1
            bearImp := true

    // 2b. Track the running extreme of the current leg (and its candle)
    if trendState == 0
        if na(trackHigh) or bH > trackHigh
            trackHigh     := bH
            trackHighTime := bT
            trackHighL    := bL
        if na(trackLow) or bL < trackLow
            trackLow     := bL
            trackLowTime := bT
            trackLowH    := bH
    if trendState == 1 and bH >= trackHigh
        trackHigh     := bH
        trackHighTime := bT
        trackHighL    := bL
    if trendState == -1 and bL <= trackLow
        trackLow     := bL
        trackLowTime := bT
        trackLowH    := bH

    // 2c. The first opposite break candle locks the swing
    if bBe and trendState >= 0
        swingHighs.push(f_newSwing(true, trackHigh, trackHighTime, trackHighL, blkIdx))
        f_guard(swingHighs)
        trendState   := -1
        trackLow     := bL
        trackLowTime := bT
        trackLowH    := bH
    else if bBu and trendState <= 0
        swingLows.push(f_newSwing(false, trackLow, trackLowTime, trackLowH, blkIdx))
        f_guard(swingLows)
        trendState    := 1
        trackHigh     := bH
        trackHighTime := bT
        trackHighL    := bL

    // 2d. Swing lows: a CLOSE below = break (CDSs / SDs#, or a silent delete
    //     for an old-trend swing). A wick only = sweep, the swing stays.
    bool lowBroken = false
    bool lowSwept  = false
    if swingLows.size() > 0
        for i = swingLows.size() - 1 to 0
            Swing s = swingLows.get(i)
            if s.bIdx < blkIdx and bL <= s.price
                if bC < s.price
                    bool isFlip = signalState != -1
                    bool newLeg = s.bIdx > lastCdsBar
                    // GATE: a small p (not confirmed) closed through = deleted, no SD
                    bool gKill  = gateOn and not isFlip and newLeg and not s.conf
                    if not lowBroken and (isFlip or newLeg) and not gKill
                        lowBroken := true
                        int    num  = isFlip ? 0 : sdCount + 1
                        bool   pass = true
                        string kind = isFlip ? "CDS" + ENG : "SD" + ENG + (showNumbers ? str.tostring(num) : "")
                        if swingHighs.size() > 0
                            Swing po = swingHighs.last()
                            po.tier     := isFlip ? 1 : num + 1
                            po.official := pass
                            po4Seq      += 1
                            po.seq      := po4Seq
                            po.causes.push(Cause.new(kind, s.price, s.t, bT, false, pass, f_againstHtf(-1), f_breakScore(false, bRv, sDl, sAxBe), sAxBe, f_breakTip(kind, false, pass, bRv, sDl, sAxBe, bBe)))
                        signalState := -1
                        f_clearConf()
                        if isFlip
                            lastCdsBar := blkIdx
                            sdCount    := 0
                            hitXD      := false
                            hitXP      := false
                            bullImp    := false
                            bullPb     := false
                            bearImp    := false
                            bearPb     := false
                            cds_event  := pass
                        else
                            sdCount  := num
                            bearImp  := false
                            bearPb   := false
                            sd_event := pass
                    swingLows.remove(i)
                else if not s.swept
                    s.swept := true
                    if not lowSwept
                        lowSwept := true
                        if f_sweep(s.price, true, bRv, sDl, bL, bT)
                            swp_low_event := true

    // 2e. Swing highs: a CLOSE above = break (CDLs / LDs#). A wick only = sweep.
    bool highBroken = false
    bool highSwept  = false
    if swingHighs.size() > 0
        for i = swingHighs.size() - 1 to 0
            Swing s = swingHighs.get(i)
            if s.bIdx < blkIdx and bH >= s.price
                if bC > s.price
                    bool isFlip = signalState != 1
                    bool newLeg = s.bIdx > lastCdlBar
                    // GATE: a small p (not confirmed) closed through = deleted, no LD
                    bool gKill  = gateOn and not isFlip and newLeg and not s.conf
                    if not highBroken and (isFlip or newLeg) and not gKill
                        highBroken := true
                        int    num  = isFlip ? 0 : ldCount + 1
                        bool   pass = true
                        string kind = isFlip ? "CDL" + ENG : "LD" + ENG + (showNumbers ? str.tostring(num) : "")
                        if swingLows.size() > 0
                            Swing po = swingLows.last()
                            po.tier     := isFlip ? 1 : num + 1
                            po.official := pass
                            po4Seq      += 1
                            po.seq      := po4Seq
                            po.causes.push(Cause.new(kind, s.price, s.t, bT, true, pass, f_againstHtf(1), f_breakScore(true, bRv, sDl, sAxBu), sAxBu, f_breakTip(kind, true, pass, bRv, sDl, sAxBu, bBu)))
                        signalState := 1
                        f_clearConf()
                        if isFlip
                            lastCdlBar := blkIdx
                            ldCount    := 0
                            hitXD      := false
                            hitXP      := false
                            bullImp    := false
                            bullPb     := false
                            bearImp    := false
                            bearPb     := false
                            cdl_event  := pass
                        else
                            ldCount  := num
                            bullImp  := false
                            bullPb   := false
                            ld_event := pass
                    swingHighs.remove(i)
                else if not s.swept
                    s.swept := true
                    if not highSwept
                        highSwept := true
                        if f_sweep(s.price, false, bRv, sDl, bH, bT)
                            swp_high_event := true

    // 2f. GATE: p -> P# once the pullback reached the OPPOSITE extreme after the leg's own extreme
    if gateOn and not na(gHi) and not na(gLo)
        if signalState == 1 and bullImp and gLo <= 20 and swingHighs.size() > 0
            for s in swingHighs
                if s.bIdx > lastCdlBar and not s.conf
                    s.conf := true
                    s.cIdx := blkIdx
        if signalState == -1 and bearImp and gHi >= 80 and swingLows.size() > 0
            for s in swingLows
                if s.bIdx > lastCdsBar and not s.conf
                    s.conf := true
                    s.cIdx := blkIdx

// ═══════════════════════════════════════════════════════════════
// STEP 2b — SWEEP CLEAN-UP + STRUCTURAL VOIDS (chart timeframe, closed candles)
// ═══════════════════════════════════════════════════════════════
if barstate.isconfirmed
    // Sweep labels die on a close beyond their sweep candle
    if sweep_lbls.size() > 0
        for i = sweep_lbls.size() - 1 to 0
            bool  isLowSw = sweep_isLow.get(i)
            float lvl     = sweep_lvls.get(i)
            if time > sweep_t.get(i) and ((isLowSw and close < lvl) or (not isLowSw and close > lvl))
                label.delete(sweep_lbls.get(i))
                sweep_lbls.remove(i)
                sweep_lvls.remove(i)
                sweep_px.remove(i)
                sweep_t.remove(i)
                sweep_isLow.remove(i)

    // Structural voids (⚡ = made with strong volume)
    bool   fixedStop = gapExtMode == "3 Candles (Fixed)"
    int    gapRight  = fixedStop ? bar_index + 2 : bar_index + 1
    color  greyBox   = color.new(#636363, 80)
    color  greyLine  = color.new(#636363, 0)
    string vTag      = strong_vol ? "⚡" : ""
    string vTagUDG   = strong_vol_prev ? "⚡" : ""

    float bull_body_top = math.min(close, open)
    float bull_body_bot = math.max(close[1], open[1])
    float bear_body_top = math.min(close[1], open[1])
    float bear_body_bot = math.max(close, open)

    if show_vi
        if open > close[1] and close > close[1] and open > open[1] and high[1] > low and high[1] < bull_body_top
            color c = force_grey ? greyLine : bull_vi_css
            f_addGap(bar_index - 1, gapRight, bull_body_top, bull_body_bot, true, true, "ULG+" + vTag, color(na), c, color.new(c, 0), fixedStop)
        if open < close[1] and close < close[1] and open < open[1] and low[1] < high and low[1] > bear_body_bot
            color c = force_grey ? greyLine : bear_vi_css
            f_addGap(bar_index - 1, gapRight, bear_body_top, bear_body_bot, false, true, "ULG-" + vTag, color(na), c, color.new(c, 0), fixedStop)

    if show_og
        if low > high[1]
            f_addGap(bar_index - 1, gapRight, low, high[1], true, false, "UOG+" + vTag, force_grey ? greyBox : bull_og_css, color(na), force_grey ? greyLine : color.new(bull_og_css, 0), fixedStop)
        if high < low[1]
            f_addGap(bar_index - 1, gapRight, low[1], high, false, false, "UOG-" + vTag, force_grey ? greyBox : bear_og_css, color(na), force_grey ? greyLine : color.new(bear_og_css, 0), fixedStop)

    if show_upg
        if low > high[2] and close[1] > high[2] and not (low > high[1] or low[1] > high[2])
            f_addGap(bar_index - 2, gapRight, low, high[2], true, false, "UDG+" + vTagUDG, force_grey ? greyBox : bull_upg_css, color(na), force_grey ? greyLine : color.new(bull_upg_css, 0), fixedStop)
        if high < low[2] and close[1] < low[2] and not (high < low[1] or high[1] < low[2])
            f_addGap(bar_index - 2, gapRight, low[2], high, false, false, "UDG-" + vTagUDG, force_grey ? greyBox : bear_upg_css, color(na), force_grey ? greyLine : color.new(bear_upg_css, 0), fixedStop)

    if visual_gaps.size() > 0
        for i = visual_gaps.size() - 1 to 0
            GapBox u = visual_gaps.get(i)
            bool isFilled     = false
            bool newlyTouched = false
            if bar_index > u.creationBar
                if u.isBull
                    if not u.isTouched and low <= u.top
                        u.isTouched  := true
                        newlyTouched := true
                    isFilled := low <= u.bot
                else
                    if not u.isTouched and high >= u.bot
                        u.isTouched  := true
                        newlyTouched := true
                    isFilled := high >= u.top
            if newlyTouched
                if u.isLine
                    u.b.set_border_color(color.new(u.origBorder, 80))
                else
                    u.b.set_bgcolor(color.new(u.origBg, 85))
                u.l.set_color(color.new(u.origLine, 80))
                if not na(u.lbl)
                    u.lbl.set_textcolor(color.new(gap_lbl_col, 70))
                if gapExtMode == "Until First Touch"
                    u.stoppedExtending := true
            if isFilled
                u.stoppedExtending := true
            if isFilled and hide_filled
                box.delete(u.b)
                line.delete(u.l)
                label.delete(u.lbl)
                visual_gaps.remove(i)
            else if not u.stoppedExtending
                u.b.set_right(bar_index + 1)
                u.l.set_x2(bar_index + 1)
                if not na(u.lbl) and gap_lbl_side == "Right"
                    u.lbl.set_x(bar_index + 1)

    while visual_gaps.size() > maxGaps
        GapBox u = visual_gaps.shift()
        box.delete(u.b)
        line.delete(u.l)
        label.delete(u.lbl)

// ═══════════════════════════════════════════════════════════════
// STEP 3 — CANDLE COLORS (AX coloring independent from AX labels)
// ═══════════════════════════════════════════════════════════════
color final_candle_col = na
if show_candles
    final_candle_col := curr_BuBC ? c_bull_bc : curr_BeBC ? c_bear_bc : c_nbc
if ax_col_on and bull_accel and show_bull
    final_candle_col := DEEP_GREEN
else if ax_col_on and bear_accel and show_bear
    final_candle_col := DEEP_RED

barcolor(final_candle_col)

// ═══════════════════════════════════════════════════════════════
// STEP 4 — UN-AUCTIONED PRICE (UH$ / UL$)
// ═══════════════════════════════════════════════════════════════
bool is_ax_candle = bull_accel or bear_accel
bool fire_ul = show_uh_ul and raw_ul and (not dots_on_ax_only or is_ax_candle)
bool fire_uh = show_uh_ul and raw_uh and (not dots_on_ax_only or is_ax_candle)

var label[] uh_lbls   = array.new<label>()
var float[] uh_prices = array.new<float>()
var int[]   uh_t      = array.new<int>()
var label[] ul_lbls   = array.new<label>()
var float[] ul_prices = array.new<float>()
var int[]   ul_t      = array.new<int>()

if barstate.isconfirmed
    if uh_prices.size() > 0
        for i = uh_prices.size() - 1 to 0
            if uh_del_mode == "Touch" ? high >= uh_prices.get(i) : close > uh_prices.get(i)
                label.delete(uh_lbls.get(i))
                uh_lbls.remove(i)
                uh_prices.remove(i)
                uh_t.remove(i)

    if ul_prices.size() > 0
        for i = ul_prices.size() - 1 to 0
            if uh_del_mode == "Touch" ? low <= ul_prices.get(i) : close < ul_prices.get(i)
                label.delete(ul_lbls.get(i))
                ul_lbls.remove(i)
                ul_prices.remove(i)
                ul_t.remove(i)

    if fire_uh
        if uh_prices.size() >= MAX_MARKS
            label.delete(uh_lbls.shift())
            uh_prices.shift()
            uh_t.shift()
        uh_lbls.push(label.new(bar_index, high, "UH$", style=label.style_label_down, color=color(na), textcolor=uh_col, size=f_size(wick_dot_size), tooltip="Un-auctioned high (UH$): price never traded above this close"))
        uh_prices.push(high)
        uh_t.push(time)

    if fire_ul
        if ul_prices.size() >= MAX_MARKS
            label.delete(ul_lbls.shift())
            ul_prices.shift()
            ul_t.shift()
        ul_lbls.push(label.new(bar_index, low, "UL$", style=label.style_label_up, color=color(na), textcolor=ul_col, size=f_size(wick_dot_size), tooltip="Un-auctioned low (UL$): price never traded below this close"))
        ul_prices.push(low)
        ul_t.push(time)

// ═══════════════════════════════════════════════════════════════
// STEP 5 — ACCELERATOR LABELS (independent toggle, max N, close-based delete)
// ═══════════════════════════════════════════════════════════════
f_axTip(string name) =>
    name + (is_plus ? "+" : "-") + "\nVelocity: " + (is_plus ? "Plus (close past mid)" : "Minus (close not past mid)") + "\nDelta Source: " + (using_real_fp ? "FOOTPRINT" : "SYNTHETIC") + "\nRange: " + str.tostring(range_ratio, "#.##") + "x avg BC (need " + str.tostring(size_factor) + "x)" + "\nDelta: " + f_fmt_delta(current_delta) + (delta_base_ok ? " | " + str.tostring(delta_ratio, "#.##") + "x avg BC (need " + str.tostring(delta_factor) + "x)" : " | mixed source: direction only") + "\nVolume: " + str.tostring(rvol, "#.##") + "x avg (strong = " + str.tostring(strong_vol_factor) + "x)"

if barstate.isconfirmed
    if active_axs.size() > 0
        for i = active_axs.size() - 1 to 0
            AxData ax = active_axs.get(i)
            if (ax.isBull and close < ax.trigger) or (not ax.isBull and close > ax.trigger)
                label.delete(ax.lbl)
                label.delete(ax.tri)
                active_axs.remove(i)

    if ax_lbl_on and bull_accel and show_bull
        label tri = show_triangles ? label.new(bar_index, low, "", yloc=yloc.belowbar, style=label.style_triangleup, color=DEEP_GREEN, size=f_size(tri_size_str)) : na
        label lbl = label.new(bar_index, low, "BuAx" + (is_plus ? "+" : "-"), yloc=yloc.belowbar, style=label.style_label_up, color=color(na), textcolor=DEEP_GREEN, size=f_size(lbl_size_str), tooltip=f_axTip("Bullish Accelerator | BuAx"))
        active_axs.push(AxData.new(lbl, tri, low, true, time))

    if ax_lbl_on and bear_accel and show_bear
        label tri = show_triangles ? label.new(bar_index, high, "", yloc=yloc.abovebar, style=label.style_triangledown, color=DEEP_RED, size=f_size(tri_size_str)) : na
        label lbl = label.new(bar_index, high, "BeAx" + (is_plus ? "+" : "-"), yloc=yloc.abovebar, style=label.style_label_down, color=color(na), textcolor=DEEP_RED, size=f_size(lbl_size_str), tooltip=f_axTip("Bearish Accelerator | BeAx"))
        active_axs.push(AxData.new(lbl, tri, high, false, time))

    while active_axs.size() > max_ax
        AxData old = active_axs.shift()
        label.delete(old.lbl)
        label.delete(old.tri)

// ═══════════════════════════════════════════════════════════════
// RENDER — on the last bar everything structural is deleted and redrawn from
// state, so a PO4 removed above takes its breaks and zone with it. Overlays
// (UH$ / UL$, voids, SWP+, AX) are shown or hidden by the same range rule.
// ═══════════════════════════════════════════════════════════════
f_breakColor(Cause c) =>
    not c.pass ? FAIL_COL : htf_dim and c.against ? color.new(FAIL_COL, 30) : c.isBull ? LINE_BULL : LINE_BEAR

f_drawCause(Cause c) =>
    if showBreaks and (c.pass or show_failed)
        color  col = f_breakColor(c)
        string txt = TFP + (c.pass ? c.kind + (showStars and c.score > 0 ? " " + str.tostring(c.score) + "⭐" : "") + (c.ax ? " ⚡" : "") : str.lower(c.kind))
        drawn_lines.push(line.new(c.t1, c.price, c.t2, c.price, xloc=xloc.bar_time, color=col, width=1, style=c.pass ? line.style_solid : line.style_dotted))
        drawn_labels.push(label.new(int(math.avg(c.t1, c.t2)), c.price, txt, xloc=xloc.bar_time, color=color(na), textcolor=col, style=c.isBull ? label.style_label_down : label.style_label_up, size=f_szs(brk_size), tooltip=c.tip + (c.against ? "\nAgainst the HTF bias" : "")))

f_gapPaint(GapBox u, bool vis) =>
    color bgC = u.isTouched ? color.new(u.origBg, 85) : u.origBg
    color bdC = u.isTouched ? color.new(u.origBorder, 80) : u.origBorder
    color lnC = u.isTouched ? color.new(u.origLine, 80) : u.origLine
    color lbC = u.isTouched ? color.new(gap_lbl_col, 70) : gap_lbl_col
    if u.isLine
        u.b.set_border_color(vis ? bdC : color.new(#000000, 100))
    else
        u.b.set_bgcolor(vis ? bgC : color.new(#000000, 100))
    u.l.set_color(vis ? lnC : color.new(#000000, 100))
    if not na(u.lbl)
        u.lbl.set_textcolor(vis ? lbC : color.new(#000000, 100))

if barstate.islast
    f_clear_drawn()
    int futureT = f_future_time(line_ext)
    int spanMs  = timeframe.in_seconds(blockTF) * 1000

    // Trend markers: newest PO4 per side + the newest T1 of that side.
    Swing lastBull = na
    Swing starBull = na
    Swing lastBear = na
    Swing starBear = na
    if swingLows.size() > 0
        for s in swingLows
            if s.tier > 0
                if na(lastBull) or s.seq > lastBull.seq
                    lastBull := s
                if s.tier == 1 and (na(starBull) or s.seq > starBull.seq)
                    starBull := s
    if swingHighs.size() > 0
        for s in swingHighs
            if s.tier > 0
                if na(lastBear) or s.seq > lastBear.seq
                    lastBear := s
                if s.tier == 1 and (na(starBear) or s.seq > starBear.seq)
                    starBear := s

    // The always-drawn range = highest to lowest marker, and their candles.
    float rHi = na
    float rLo = na
    int   hiT = na
    int   loT = na
    for m in array.from(lastBull, starBull, lastBear, starBear)
        if not na(m)
            if na(rHi) or m.price > rHi
                rHi := m.price
                hiT := m.t
            if na(rLo) or m.price < rLo
                rLo := m.price
                loT := m.t

    // Live range: P# = the newest swing of the current leg that a close past
    // would turn into the next LD / SD; R# = the newest opposite swing after it.
    Swing pSw = na
    Swing rSw = na
    if signalState == 1
        for s in swingHighs
            if s.bIdx > lastCdlBar and (na(pSw) or s.bIdx > pSw.bIdx)
                pSw := s
        if not na(pSw)
            for s in swingLows
                if s.bIdx > pSw.bIdx and (na(rSw) or s.bIdx > rSw.bIdx)
                    rSw := s
    else if signalState == -1
        for s in swingLows
            if s.bIdx > lastCdsBar and (na(pSw) or s.bIdx > pSw.bIdx)
                pSw := s
        if not na(pSw)
            for s in swingHighs
                if s.bIdx > pSw.bIdx and (na(rSw) or s.bIdx > rSw.bIdx)
                    rSw := s
    int nRng = (signalState == 1 ? ldCount : sdCount) + 1
    // GATE: P# is a small p until confirmed; the R# only counts after it
    bool pCf = not na(pSw) and (not gateOn or pSw.conf)
    if gateOn and not na(rSw) and (not pCf or rSw.bIdx <= pSw.cIdx)
        rSw := na

    array<int> q = f_quota()

    // 1. PO4s (a PO4 + its breaks + its zone = ONE item), newest first
    array<Swing> po4L = array.new<Swing>()
    array<int>   po4S = array.new<int>()
    array<Swing> plnL = array.new<Swing>()
    array<int>   plnT = array.new<int>()
    for side = 0 to 1
        Swing[] arr = side == 0 ? swingHighs : swingLows
        if arr.size() > 0
            for s in arr
                if s.tier > 0
                    po4L.push(s)
                    po4S.push(s.seq)
                else
                    plnL.push(s)
                    plnT.push(s.t)
    array<Swing> vis = array.new<Swing>()
    if po4L.size() > 0
        array<int> o1 = po4S.sort_indices(order.descending)
        for k = 0 to o1.size() - 1
            Swing s = po4L.get(o1.get(k))
            if f_take(q, f_inR(s.price, rHi, rLo) or f_onMarker(s.t, hiT, loT, spanMs), not s.isHigh)
                vis.push(s)
    // 2. plain swings (the live P# / R# can always show)
    if plnL.size() > 0
        array<int> o2 = plnT.sort_indices(order.descending)
        for k = 0 to o2.size() - 1
            Swing s = plnL.get(o2.get(k))
            bool live = showLiveAlways and ((not na(pSw) and s.bIdx == pSw.bIdx and s.isHigh == pSw.isHigh) or (not na(rSw) and s.bIdx == rSw.bIdx and s.isHigh == rSw.isHigh))
            if live or f_take(q, f_inR(s.price, rHi, rLo) or f_onMarker(s.t, hiT, loT, spanMs), not s.isHigh)
                vis.push(s)

    if showSwings and vis.size() > 0
        for s in vis
            bool isPO4 = s.tier > 0
            bool isP   = not na(pSw) and s.bIdx == pSw.bIdx and s.isHigh == pSw.isHigh
            bool isR   = not na(rSw) and s.bIdx == rSw.bIdx and s.isHigh == rSw.isHigh
            bool isPL  = (signalState == 1 and not na(lastBull) and s.seq == lastBull.seq and not s.isHigh) or (signalState == -1 and not na(lastBear) and s.seq == lastBear.seq and s.isHigh)
            color  c   = isPO4 ? (s.official ? (s.isHigh ? LINE_BEAR : LINE_BULL) : FAIL_COL) : isP ? color.new(s.isHigh ? LINE_BEAR : LINE_BULL, pCf ? 0 : 40) : isR ? (s.isHigh ? LINE_BEAR : LINE_BULL) : s.isHigh ? (signalState == 1 ? BULL_TGT : color.new(LINE_BEAR, 30)) : (signalState == -1 ? BEAR_TGT : color.new(LINE_BULL, 30))
            string nm  = isPO4 ? (s.isHigh ? "BePO4" : "BuPO4") + ENG + " T" + str.tostring(s.tier) + (s.official ? "" : " ✗") : isP ? (pCf ? (s.isHigh ? "BeP" : "BuP") + str.tostring(nRng) + ENG : (s.isHigh ? "bep" : "bup") + str.tostring(nRng) + ENG + " · p") : isR ? (s.isHigh ? "BeR" : "BuR") + str.tostring(nRng) + ENG : s.isHigh ? "sh" : "sl"
            string txt = TFP + nm
            string tip = isPO4 ? (isPL ? "Protected Level (PL): the swing that made the last break. A body close through it flips the structure." : "PO4 = the swing that made this break. A body close through it deletes it with its break and zone.") : isP ? (pCf ? "P# = the newest swing of this leg. A body close past it = the next " + (signalState == 1 ? "LD" : "SD") + str.tostring(nRng) + ENG + "." : "small p: the " + gate_mode + " gate has not confirmed this pullback yet (leg's own extreme, then the opposite extreme). A close through it deletes it: no LD / SD.") : isR ? "R# = the newest swing after P#. It becomes PO4 T" + str.tostring(nRng + 1) + " on the next " + (signalState == 1 ? "LD" : "SD") + "." : (s.isHigh ? "Swing high" : "Swing low") + (s.swept ? " (swept)" : "") + " — deleted on a body close through it"
            string sty = isPO4 ? line.style_solid : isP ? line.style_dashed : line.style_dotted
            f_add_level(s.price, txt, c, isPL ? 2 : 1, sty, s.t, futureT, isPO4 ? (isPL ? 6 : 5) : isP or isR ? 4 : 2, lvl_size, tip)
            if isPO4
                if s.causes.size() > 0
                    for cz in s.causes
                        f_drawCause(cz)
                bool showZ = s.tier == 1 ? show_eblk : show_iblk
                if showZ and s.official and not na(s.oH) and not na(s.oL) and s.oH > s.oL
                    [zT, zB] = f_zoneSlice(s.oH, s.oL, not s.isHigh)
                    color zc = s.isHigh ? LINE_BEAR : LINE_BULL
                    drawn_boxes.push(box.new(s.oT, zT, futureT, zB, xloc=xloc.bar_time, border_color=na, bgcolor=color.new(zc, zone_transp), text=zone_show_name ? TFP + f_zoneName(s.tier == 1, not s.isHigh, ENG) : "", text_color=color.new(zc, 20), text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center))

    // 3. UH$ / UL$
    if uh_lbls.size() > 0
        for i = uh_lbls.size() - 1 to 0
            bool v = f_take(q, f_inR(uh_prices.get(i), rHi, rLo) or f_onMarker(uh_t.get(i), hiT, loT, spanMs), false)
            label.set_textcolor(uh_lbls.get(i), v ? uh_col : color.new(uh_col, 100))
    if ul_lbls.size() > 0
        for i = ul_lbls.size() - 1 to 0
            bool v = f_take(q, f_inR(ul_prices.get(i), rHi, rLo) or f_onMarker(ul_t.get(i), hiT, loT, spanMs), true)
            label.set_textcolor(ul_lbls.get(i), v ? ul_col : color.new(ul_col, 100))
    // 4. voids
    if visual_gaps.size() > 0
        for i = visual_gaps.size() - 1 to 0
            GapBox u = visual_gaps.get(i)
            f_gapPaint(u, f_take(q, f_boxInR(u.top, u.bot, rHi, rLo) or f_onMarker(u.t, hiT, loT, spanMs), u.isBull))
    // 5. SWP+
    if sweep_lbls.size() > 0
        for i = sweep_lbls.size() - 1 to 0
            bool isLowSw = sweep_isLow.get(i)
            bool v = f_take(q, f_inR(sweep_px.get(i), rHi, rLo) or f_onMarker(sweep_t.get(i), hiT, loT, spanMs), isLowSw)
            color sc = isLowSw ? LINE_BULL : LINE_BEAR
            label.set_textcolor(sweep_lbls.get(i), v ? sc : color.new(sc, 100))
    // 6. AX
    if active_axs.size() > 0
        for i = active_axs.size() - 1 to 0
            AxData ax = active_axs.get(i)
            bool  v  = f_take(q, f_inR(ax.trigger, rHi, rLo) or f_onMarker(ax.t, hiT, loT, spanMs), ax.isBull)
            color ac = ax.isBull ? DEEP_GREEN : DEEP_RED
            label.set_textcolor(ax.lbl, v ? ac : color.new(ac, 100))
            if not na(ax.tri)
                label.set_color(ax.tri, v ? ac : color.new(ac, 100))

    if show_tn_step
        bool bullSame = not na(starBull) and not na(lastBull) and starBull.seq == lastBull.seq
        bool bearSame = not na(starBear) and not na(lastBear) and starBear.seq == lastBear.seq
        if not na(starBull)
            drawn_labels.push(label.new(futureT, starBull.price, bullSame ? "🟢🟩" : "🟢", xloc=xloc.bar_time, style=label.style_label_right, color=color(na), textcolor=LINE_BULL, size=size.small))
        if not na(lastBull) and not bullSame
            drawn_labels.push(label.new(futureT, lastBull.price, "🟩", xloc=xloc.bar_time, style=label.style_label_right, color=color(na), textcolor=LINE_BULL, size=size.small))
        if not na(starBear)
            drawn_labels.push(label.new(futureT, starBear.price, bearSame ? "🔴🟥" : "🔴", xloc=xloc.bar_time, style=label.style_label_right, color=color(na), textcolor=LINE_BEAR, size=size.small))
        if not na(lastBear) and not bearSame
            drawn_labels.push(label.new(futureT, lastBear.price, "🟥", xloc=xloc.bar_time, style=label.style_label_right, color=color(na), textcolor=LINE_BEAR, size=size.small))

    f_draw_groups()
    f_xdxpDraw()

// ═══════════════════════════════════════════════════════════════
// HTF BIAS BOX
// ═══════════════════════════════════════════════════════════════
var table biasTbl = table.new(f_htfPos(htf_tbl_pos), 1, 1, bgcolor=#000000, border_width=1, frame_color=color.new(color.white, 70), frame_width=1)
if barstate.islast
    if htf_table and htf_src != "Off"
        string bSrc = htf_src == "Last BC" ? "Last BC" : htf_src == "Last Flip (CDL / CDS)" ? "Flip" : "Cont"
        string bEng = htf_eng == "Zone x (boxes)" ? "x" : htf_eng == "Candle c (PO4)" ? "c" : "s"
        string bDir = htfBias == 1 ? "BULL" : htfBias == -1 ? "BEAR" : "NONE"
        string bOrg = htf_src == "Last BC" ? (htfOrg == 2 ? " (from a flip " + bEng + ")" : htfOrg == 1 ? " (from a continuation " + bEng + ")" : " (plain BC)") : " · engine " + bEng
        color  bCol = htfBias == 1 ? LINE_BULL : htfBias == -1 ? LINE_BEAR : color.silver
        table.cell(biasTbl, 0, 0, "HTF " + htf_tf + " · " + bSrc + " · " + bDir + bOrg, text_color=bCol, text_size=size.small)
    else
        table.clear(biasTbl, 0, 0)

// ═══════════════════════════════════════════════════════════════
// ALERTS (official breaks only, closed bars — no repaint)
// ═══════════════════════════════════════════════════════════════
alertcondition(cdl_event, "CDLs Flip", "CDLs - bullish flip (swing engine)")
alertcondition(cds_event, "CDSs Flip", "CDSs - bearish flip (swing engine)")
alertcondition(ld_event, "LDs Continuation", "LDs - bullish continuation (current leg)")
alertcondition(sd_event, "SDs Continuation", "SDs - bearish continuation (current leg)")
alertcondition(swp_low_event, "Strong Sell-Side Sweep", "SWP+ swing low swept with strong volume + buying delta")
alertcondition(swp_high_event, "Strong Buy-Side Sweep", "SWP+ swing high swept with strong volume + selling delta")
alertcondition(bull_accel and barstate.isconfirmed, "Bullish Accelerator", "BuAx detected (range + delta + strong volume)")
alertcondition(bear_accel and barstate.isconfirmed, "Bearish Accelerator", "BeAx detected (range + delta + strong volume)")
alertcondition(fire_ul and barstate.isconfirmed, "UL$ - Unbalanced Low", "Wickless bull candle UL$ detected")
alertcondition(fire_uh and barstate.isconfirmed, "UH$ - Unbalanced High", "Wickless bear candle UH$ detected")
alertcondition(newsWarn and barstate.isconfirmed, "News Warning", "High-impact news coming in 15 / 30 minutes")
