news_pre      = input.int(5, "Window: Min Before", minval=0, maxval=120, inline="nw", group=grp_news)
news_post     = input.int(15, "Min After", minval=0, maxval=240, inline="nw", group=grp_news)
news_del      = input.bool(true, "Delete When Price Takes the Dot", inline="ndl", group=grp_news, tooltip="ON: the dot, its label and its background are deleted together when a later candle CLOSES above the dot (dot at High) / below it (dot at Low), or touches it.")
news_del_mode = input.string("Close Above / Below", "", options=["Close Above / Below", "Touch"], inline="ndl", group=grp_news)

grp_wick = "9. Un-Auctioned Price (Wickless)"
show_uh_ul      = input.bool(true, "Enable UH$/UL$ Detection", group=grp_wick, tooltip="Candles closing flat at their extreme leave un-auctioned price.")
uh_del_mode     = input.string("Close Beyond", "Delete UH$/UL$ On", options=["Close Beyond", "Touch"], group=grp_wick, tooltip="Close Beyond = deleted when a later candle CLOSES above UH$ / below UL$.\nTouch = deleted the first time a later candle's wick reaches the level.")
dots_on_ax_only = input.bool(false, "Strict: AX Candles Only", group=grp_wick)
uh_col          = input.color(color.red, "UH Color", inline="w2", group=grp_wick)
ul_col          = input.color(color.lime, "UL Color", inline="w2", group=grp_wick)
wick_dot_size   = input.string("tiny", "Marker Size", options=["tiny", "small", "normal", "large"], group=grp_wick)

grp_gaps = "10. Structural Voids (Gaps)"
show_upg        = input.bool(true, "Show UDG (Distribution)", inline="g1", group=grp_gaps, tooltip="Unfair Distribution Gap: 3-candle one-sided move with no overlap.")
bull_upg_css    = input.color(color.new(#2157f3, 80), "Bu", inline="g1", group=grp_gaps)
bear_upg_css    = input.color(color.new(#ff1100, 80), "Be", inline="g1", group=grp_gaps)
