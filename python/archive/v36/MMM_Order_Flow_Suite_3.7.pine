//@version=6
indicator("MMM Market Structure & Order Flow Suite @MaxMaserati 3.7", "MMM Order Flow @MaxMaserati 3.7", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════
// MMM ORDER FLOW SUITE 3.7 — the SWING engine "s" of the MMM foundation
//
//  HTF IN LTF: the swings are built on the STRUCTURE timeframe (closed
//            candles only) and drawn on the chart. AX, UH$/UL$ and voids
//            stay on the chart timeframe.
//  SWING   = the extreme of a leg, locked by the first opposite BC.
//            A swing dies ONLY on a body close through it (a wick is a sweep).
//  FLIP    = CDLs / CDSs  (first break against the trend)
//  CONT.   = LDs1, LDs2… / SDs1, SDs2… (only swings of the CURRENT leg count;
//            the count runs until the next flip)
//  PO4     = the swing that MADE a break becomes its origin:
//            CDL -> BuPO4s T1 · LD1 -> BuPO4s T2 · LD2 -> T3…
//            CDS -> BePO4s T1 · SD1 -> BePO4s T2…
//            Live range: BeP#s / BuP#s = the newest swing a close past
//            makes the next LD / SD · BuR#s / BeR#s = the newest swing after
//            it (the next T#). Every other swing is a plain lowercase sh / sl.
//  HUSBAND & WIFE: a break label lives on its PO4. Close through the PO4 and
//            the PO4, its break labels and its eBlock / iBlock go together.
//  🟢 / 🔴 = T1 of the newest leg · 🟩 / 🟥 = its newest T#. Everything
//            between the highest and lowest marker is ALWAYS drawn; outside
//            it only "Max Items" show (50 / 50 bull / bear, husband & wife = 1;
//            0 = nothing outside).
//  No entries, no stops: see the MMM Indicator Test Plan.
//  Every decision is taken on CLOSED candles. No repaint.
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════
const color DEEP_GREEN = #006400
const color DEEP_RED   = #8b0000
const color LINE_BULL  = #00b400
const color LINE_BEAR  = #c80000
const color BULL_TGT   = #046319
const color BEAR_TGT   = #ae0303
const int   MAX_MARKS  = 50
const int   FP_VA      = 70

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
grp_tf          = "0. Structure Timeframe (HTF in LTF)"
tfMode          = input.string("Manual", "Structure Timeframe Mode", options=["Manual", "Auto Combination"], group=grp_tf, tooltip="HTF in LTF: the structure (swings / boxes / PO4s, breaks, gate) is built on the STRUCTURE timeframe and drawn on your chart.\nManual = the timeframe below (empty = chart timeframe).\nAuto Combination = chart timeframe × 4 or × 6 (M15 chart -> H1 or H1:30).\nOnly CLOSED structure candles are used: no repaint.")
autoMultiplier  = input.string("4x", "Auto Multiplier", options=["4x", "6x"], group=grp_tf)
structTimeframe = input.timeframe("", "Structure Timeframe", group=grp_tf, tooltip="Empty = chart timeframe.")
showTfLabel     = input.bool(true, "Structure TF in Labels (H1 CDL…)", group=grp_tf)

grp_cndl = "1. Auction State (Candles)"
show_candles = input.bool(true, "Enable Auction State Colors", group=grp_cndl)
c_bull_bc    = input.color(#27ffc3, "BuBC", inline="cc", group=grp_cndl, tooltip="BuBC = candle CLOSED above the previous high. BeBC = closed below the previous low. NBC = closed inside the previous range.")
c_bear_bc    = input.color(#9c27b0, "BeBC", inline="cc", group=grp_cndl)
c_nbc        = input.color(color.white, "NBC", inline="cc", group=grp_cndl)

grp_of = "2. Order Flow (Delta & Volume)"
use_footprint     = input.bool(true, "Use Real Footprint Delta", group=grp_of, tooltip="Needs TradingView Premium. Falls back to synthetic delta when footprint data is missing.")
fp_ticks          = input.int(10, "Ticks per Row", minval=1, group=grp_of)
vol_len           = input.int(20, "Volume Average Length", minval=2, group=grp_of)
strong_vol_factor = input.float(1.5, "Strong Volume (x Average)", minval=1.0, step=0.1, group=grp_of, tooltip="Volume must be this many times the average of the PREVIOUS bars to count as STRONG.")

grp_acc = "3. Accelerators (AX)"
ax_col_on           = input.bool(true, "AX Candle Coloring", inline="axo", group=grp_acc, tooltip="Colors AX candles deep green / deep red. Independent from the labels.")
ax_lbl_on           = input.bool(true, "AX Labels", inline="axo", group=grp_acc, tooltip="BuAx / BeAx labels. Deleted when a candle CLOSES beyond the AX candle (below its low for BuAx, above its high for BeAx).")
max_ax              = input.int(25, "Max AX Labels", minval=1, maxval=100, group=grp_acc)
detect_plus_only    = input.bool(false, "Plus Velocity Only (BuAx+/BeAx+)", group=grp_acc)
size_factor         = input.float(1.5, "Range Expansion Factor", minval=1.0, step=0.1, group=grp_acc)
use_vol_filter      = input.bool(true, "Require Strong Volume", group=grp_acc)
use_delta_filter    = input.bool(true, "Enable Delta Confirmation", inline="ax1", group=grp_acc)
delta_factor        = input.float(1.5, "Delta Expansion", minval=1.0, step=0.1, inline="ax1", group=grp_acc)
ax_must_be_wickless = input.bool(false, "Strict: AX Must Be Wickless", group=grp_acc)
show_bull           = input.bool(true, "Bullish AX", inline="ax2", group=grp_acc)
show_bear           = input.bool(true, "Bearish AX", inline="ax2", group=grp_acc)
show_triangles      = input.bool(true, "Show Triangles", inline="ax3", group=grp_acc)
tri_size_str        = input.string("tiny", "Triangle Size", options=["auto", "tiny", "small", "normal", "large"], inline="ax3", group=grp_acc)
lbl_size_str        = input.string("tiny", "Label Size", options=["tiny", "small", "normal", "large"], group=grp_acc)

grp_strc = "4. Market Structure (Swing Engine s)"
showSwings   = input.bool(true, "Show Swings & PO4s", group=grp_strc)
maxKeep      = input.int(60, "Memory Guard (Swings Kept per Side)", minval=10, maxval=200, group=grp_strc, tooltip="Hard cap on stored swings per side. Plain sh / sl are dropped first, then the oldest PO4s.")
line_ext     = input.int(10, "Line Extension (Candles)", minval=0, maxval=50, group=grp_strc)
lvl_size     = input.string("tiny", "Level Label Size", options=["tiny", "small", "normal", "large"], inline="lsz", group=grp_strc)
brk_size     = input.string("tiny", "Break Label Size", options=["tiny", "small", "normal", "large"], inline="lsz", group=grp_strc)
eng_letter   = input.string("s", "Engine Letter", options=["s", "r", "none"], group=grp_strc, tooltip="Letter added to every break and PO4 so you know which engine made it.\ns = Swing (recommended: \"r\" already means Resumption in MMM Pro).")
showNumbers  = input.bool(true, "Number Breaks (LD1, LD2…)", group=grp_strc)
showBreaks   = input.bool(true, "Show Breaks", inline="s2", group=grp_strc, tooltip="Break line + label, married to its PO4. CDL / LD above the middle of the line, CDS / SD below it.")
showStars    = input.bool(true, "Grade Break Quality", inline="s2", group=grp_strc, tooltip="1-4 stars. +1 above-average volume, +2 STRONG volume, +1 delta agrees, +1 break candle is an Accelerator (⚡).")
showSweeps   = input.bool(true, "Show Strong Sweeps (SWP+)", group=grp_strc, tooltip="A wick takes a swing, the close comes back inside, with STRONG volume and delta pushing back. The swing stays. SWP+ is deleted when a candle CLOSES beyond the sweep candle.")

grp_rng      = "4. Market Structure (Swing Engine s)"
maxLines     = input.int(0, "Max Items Outside the 🟢🟩 Range", minval=0, maxval=200, group=grp_rng, tooltip="Everything between the highest and lowest 🟢🟩🔴🟥 marker is ALWAYS drawn.\nOutside that range only this many items are drawn, split 50 / 50 between bull and bear, newest first. A PO4 with its break and its zone (husband & wife) counts as ONE.\n0 = ZERO: nothing outside the range — no line, label or box — except what sits on the candle of the highest / lowest marker.\nPriority outside: PO4s first, then the other structure, then the overlays.")
showLiveAlways = input.bool(true, "Always Show the Live Range (P# / R# / forming box)", group=grp_rng, tooltip="ON: the levels of the range price is trading in right now always show, even outside the marker range.\nOFF: they follow the rule above like everything else.")
show_tn_step = input.bool(true, "Trend Markers 🟢🟩 / 🔴🟥", group=grp_rng, tooltip="🟢 / 🔴 = T1 of the newest leg (where it started).\n🟩 / 🟥 = the newest T# of that leg.")

grp_gate    = "5. Gate · Premium / Discount"
gate_mode   = input.string("NO GATE", "Gate", options=["NO GATE", "MMPD 27", "MMPD fast", "MMPD Delta"], group=grp_gate, tooltip="NO GATE = the normal indicator: no filter, every pullback / resumption counts.\n\nMMPD 27 / MMPD fast / MMPD Delta = the MMM Pro Edge mechanism, read on the STRUCTURE timeframe:\n• A pullback is a small p until the leg reached its OWN extreme (bull: oscillator ≥ 80, bear: ≤ 20) and THEN the pullback reached the OPPOSITE extreme (bull: ≤ 20, bear: ≥ 80). Then it becomes the capital P#.\n• A close through a small p deletes it: no LD / SD, the leg goes on.\n• Only a confirmed P# can make an LD / SD. The resumption (R#) only counts after the P# is confirmed.\n• Flips (CDL / CDS) are structure: a close through the last T# always flips.\n• XD / XP labels mark where the oscillator touched Extreme Discount (≤ 20) / Extreme Premium (≥ 80).\n\nMMPD Delta = the order-flow version (built on candle delta).")
gate_fast   = input.int(9, "MMPD fast Length", minval=5, maxval=50, group=grp_gate)
show_xdxp   = input.bool(true, "XD / XP Labels (gate on)", inline="xdxp", group=grp_gate, tooltip="Boxed XD / XP labels when a gate is on. XD = Extreme Discount (oscillator ≤ 20), XP = Extreme Premium (≥ 80). The label follows the extreme while the oscillator stays in the zone, and is deleted when a close breaks it after it left the zone. They have their own max (they are not counted in the 🟢🟩 range max).")
xdxp_max    = input.int(6, "Max", minval=1, maxval=30, inline="xdxp", group=grp_gate)
xdxp_size   = input.string("small", "", options=["tiny", "small", "normal"], inline="xdxp", group=grp_gate)
zone_side   = input.string("Long in Discount / Short in Premium", "Premium / Discount Side", options=["Long in Discount / Short in Premium", "Long in Premium / Short in Discount"], group=grp_gate, tooltip="Which part of every eBlock / iBlock is drawn.\nStandard = long in the DISCOUNT part (lower), short in the PREMIUM part (upper).\nOpposite (op.) = long in premium, short in discount.\nTest both: this is the Premium vs Discount test.")
zone_tier   = input.string("50% (0-50% / 50-100%)", "Zone Depth", options=["Extreme (0-12.5% / 87.5-100%)", "Balanced (12.5-25% / 75-87.5%)", "Standard (25-50% / 50-75%)", "50% (0-50% / 50-100%)"], group=grp_gate, tooltip="How deep into the origin candle / box the zone sits, measured from the side chosen above.")
grp_zone       = "6. eBlock / iBlock"
show_eblk      = input.bool(true, "eBlock  (Flip Zone · CDL / CDS)", group=grp_zone, tooltip="The zone of every T1 PO4 — the origin of a FLIP (CDL / CDS). It lives exactly as long as its PO4 (husband & wife).")
show_iblk      = input.bool(true, "iBlock  (Continuation Zone · LD / SD)", group=grp_zone, tooltip="The zone of every T2, T3… PO4 — the origin of a CONTINUATION (LD / SD). It lives exactly as long as its PO4.")
zone_naming    = input.string("eBlock / iBlock", "Zone Naming", options=["eBlock / iBlock", "External / Internal Entry Zone", "Flip / Continuation Zone"], group=grp_zone)
zone_show_name = input.bool(true, "Name Inside Box", inline="zn", group=grp_zone)
zone_transp    = input.int(85, "Transparency", minval=0, maxval=100, inline="zn", group=grp_zone)
grp_htf     = "7. HTF Bias (HTF in LTF)"
htf_src     = input.string("Off", "HTF Bias From", options=["Off", "Last BC", "Last Flip (CDL / CDS)", "Last Continuation (LD / SD)"], group=grp_htf, tooltip="Read on the LAST CLOSED HTF candle only (no repaint).\n\nOff = no HTF bias (B0).\nLast BC = direction of the last HTF body close candle (B1). The box also shows where that BC came from: a flip, a continuation, or a plain BC.\nLast Flip = direction of the last HTF CDL / CDS of the engine below (the trend).\nLast Continuation = direction of the last HTF LD / SD made AFTER the last flip. No continuation yet = no bias.")
htf_eng     = input.string("Swing s (swings)", "HTF Break Engine", options=["Zone x (boxes)", "Candle c (PO4)", "Swing s (swings)"], group=grp_htf, tooltip="Which MMM engine reads the HTF breaks:\nx = boxes (Concepts Pro+) = B2 zone break\nc = PO4 candles (MMM Pro) = B3 candle break\ns = swings (Order Flow Suite) = B4 swing break\nTest all three: same HTF, different engine.")
htf_tf      = input.timeframe("240", "HTF Timeframe", group=grp_htf)
htf_dim     = input.bool(true, "Dim Breaks Against HTF Bias", group=grp_htf, tooltip="A break against the HTF bias is drawn in grey. Nothing is hidden.")
htf_table   = input.bool(true, "Show HTF Bias Box", inline="hb", group=grp_htf)
htf_tbl_pos = input.string("Top Right", "", options=["Top Left", "Top Center", "Top Right", "Bottom Left", "Bottom Center", "Bottom Right"], inline="hb", group=grp_htf)
grp_news      = "8. News"
news_paste    = input.text_area("2026-01-09 08:30 USD H NFP\n2026-02-11 08:30 USD H NFP\n2026-03-06 08:30 USD H NFP\n2026-04-03 08:30 USD H NFP\n2026-05-08 08:30 USD H NFP\n2026-06-05 08:30 USD H NFP\n2026-07-02 08:30 USD H NFP\n2026-08-07 08:30 USD H NFP\n2026-09-04 08:30 USD H NFP\n2026-10-02 08:30 USD H NFP\n2026-11-06 08:30 USD H NFP\n2026-12-04 08:30 USD H NFP\n2027-01-08 08:30 USD H NFP\n2027-02-05 08:30 USD H NFP\n2027-03-05 08:30 USD H NFP\n2027-04-02 08:30 USD H NFP\n2027-05-07 08:30 USD H NFP\n2027-06-04 08:30 USD H NFP\n2027-07-02 08:30 USD H NFP\n2027-08-06 08:30 USD H NFP\n2027-09-03 08:30 USD H NFP\n2027-10-08 08:30 USD H NFP\n2027-11-05 08:30 USD H NFP\n2027-12-03 08:30 USD H NFP\n2026-01-13 08:30 USD H CPI\n2026-02-13 08:30 USD H CPI\n2026-03-11 08:30 USD H CPI\n2026-04-10 08:30 USD H CPI\n2026-05-12 08:30 USD H CPI\n2026-06-10 08:30 USD H CPI\n2026-07-14 08:30 USD H CPI\n2026-08-12 08:30 USD H CPI\n2026-09-11 08:30 USD H CPI\n2026-10-14 08:30 USD H CPI\n2026-11-10 08:30 USD H CPI\n2026-12-10 08:30 USD H CPI\n2027-01-13 08:30 USD H CPI\n2027-02-11 08:30 USD H CPI\n2027-03-10 08:30 USD H CPI\n2027-04-13 08:30 USD H CPI\n2027-05-12 08:30 USD H CPI\n2027-06-10 08:30 USD H CPI\n2027-07-14 08:30 USD H CPI\n2027-08-11 08:30 USD H CPI\n2027-09-14 08:30 USD H CPI\n2027-10-14 08:30 USD H CPI\n2027-11-10 08:30 USD H CPI\n2027-12-10 08:30 USD H CPI\n2026-01-28 14:00 USD H FOMC\n2026-01-28 14:30 USD H FOMC PC\n2026-03-18 14:00 USD H FOMC\n2026-03-18 14:30 USD H FOMC PC\n2026-04-29 14:00 USD H FOMC\n2026-04-29 14:30 USD H FOMC PC\n2026-06-17 14:00 USD H FOMC\n2026-06-17 14:30 USD H FOMC PC\n2026-07-29 14:00 USD H FOMC\n2026-07-29 14:30 USD H FOMC PC\n2026-09-16 14:00 USD H FOMC\n2026-09-16 14:30 USD H FOMC PC\n2026-10-28 14:00 USD H FOMC\n2026-10-28 14:30 USD H FOMC PC\n2026-12-09 14:00 USD H FOMC\n2026-12-09 14:30 USD H FOMC PC\n2027-01-27 14:00 USD H FOMC\n2027-01-27 14:30 USD H FOMC PC\n2027-03-17 14:00 USD H FOMC\n2027-03-17 14:30 USD H FOMC PC\n2027-04-28 14:00 USD H FOMC\n2027-04-28 14:30 USD H FOMC PC\n2027-06-09 14:00 USD H FOMC\n2027-06-09 14:30 USD H FOMC PC\n2027-07-28 14:00 USD H FOMC\n2027-07-28 14:30 USD H FOMC PC\n2027-09-15 14:00 USD H FOMC\n2027-09-15 14:30 USD H FOMC PC\n2027-10-27 14:00 USD H FOMC\n2027-10-27 14:30 USD H FOMC PC\n2027-12-08 14:00 USD H FOMC\n2027-12-08 14:30 USD H FOMC PC", "News Calendar (one box for all)", group=grp_news, tooltip="ONE box for every event. One event per line:\nYYYY-MM-DD HH:MM CUR I Title\nTime = New York. I = H (red) · M (orange) · L (yellow) · N (grey).\nIt comes filled with NFP, CPI and FOMC for 2026–2027. Paste the extra weeks made by the MMM News Converter page at the end.")
news_cur      = input.string("USD", "Currencies", group=grp_news, tooltip="Comma list of currencies used. ES / NQ = USD.")
news_red      = input.bool(true,  "🔴 High", inline="imp", group=grp_news, tooltip="Which impacts are used: red = High, orange = Medium, yellow = Low, grey = holiday / non-economic.")
news_org      = input.bool(false, "🟠 Medium", inline="imp", group=grp_news)
news_yel      = input.bool(false, "🟡 Low", inline="imp", group=grp_news)
news_gry      = input.bool(false, "⚪ Grey", inline="imp", group=grp_news)
news_warn     = input.string("30", "Warning: Minutes Before", options=["15", "30"], group=grp_news, tooltip="The dot sits on the candle that holds this time (news time minus 15 or 30 minutes): a closed candle or the live one.")
news_dot      = input.bool(true, "Dot", inline="nd", group=grp_news)
news_lbl      = input.bool(true, "Label (CPI / FOMC…)", inline="nd", group=grp_news, tooltip="Tiny name next to the dot: ABOVE the dot when the candle is bearish, BELOW it when the candle is bullish.")
news_dot_at   = input.string("High", "At", options=["High", "Low"], inline="nd", group=grp_news)
news_max      = input.int(5, "Max Dots + Labels", minval=0, maxval=100, group=grp_news, tooltip="How many news dots / labels stay on the chart (newest first).")
