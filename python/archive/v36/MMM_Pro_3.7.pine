// ═══════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════

// ─── Structural Voids (ORIGINAL — untouched) ───
type GapBox
    box    b
    line   l
    label  lbl
    float  top
    float  bot
    bool   isBull
    string gType
    bool   isTouched
    bool   stoppedExtending
    color  origBg
    color  origBorder
    color  origLine
    color  origLblText
    int    creationBar
    float  mid
    box[]  slices
    bool[] sliceTouched
    bool   greyed = false
    bool   dim    = false
    int    t      = 0

type RenderZone
    int    t
    int    end_t
    float  z_top
    float  z_bot
    float  z_mid
    color  bg_col
    bool   isBull
    float  c_top
    float  c_bot
    string blockName     // drawn STRICTLY INSIDE the box via box.new(text=...)
    float  volPct
    string tsz = "tiny"

// ─── STATE MACHINE NODE (Foundation type + visual fields for entries/eBlocks) ───
type Node
    float  price
    int    t
    bool   isGap
    bool   isPrimary
    bool   shiftPrinted     = false   // debounces the CDL/CDS marker
    bool   isPhase3Internal = false   // resumption-role dynamic created after Rn locked
    bool   isForced         = false   // P# placed on an NBC (NBC Forced Pullback)
    bool   delivered        = false   // P# only: price closed past the P# candle's far edge
    // VISUAL BRIDGE — candle OHLC for eBlocks / iBlocks.
    float  c_high           = na
    float  c_low            = na
    float  c_open           = na
    float  c_close          = na
    int    c_time           = na
    float  c_volPct         = na   // anchor candle's relative volume, for the block's volume label

// ─── Tn ORIGIN (PO4) ───
type POLine
    float  price
    int    t
    int    side
    int    tier
    bool   isDirect
    // Coupled cause marker ("wife") — dies with this record automatically.
    string causeText
    int    causeT
    float  causePrice
    bool   causeMajor
    int    causeBreakT
    // true = placed on a candle that is NOT a body close in the break
    // direction (an NBC, or an opposite BC, broke the level).
    bool   isForced         = false
    // VISUAL BRIDGE
    float  c_high           = na
    float  c_low            = na
    float  c_open           = na
    float  c_close          = na
    int    c_time           = na
    float  c_volPct         = na
    bool   po4_touched      = false
    int    po4_freeze_t     = na
    bool   official         = true    // the break that made this Tn passed the gate
    bool   against          = false   // the break went against the HTF bias

// ─── Standalone CDS/CDL not coupled to a Tn ───
type ShiftMarker
    float  price
    int    ownerT
    int    breakT
    string markerTxt
    int    side          // 1 = bullish break (CDL), -1 = bearish break (CDS)
    bool   isInternal
    bool   fromPullback
    int    guardianT
    float  guardianPrice
    // true = the FIRST pullback-direction CDS/CDL after this range's P#. It is
    // married to that P# (guardianT/guardianPrice = the P#'s bar + price) and
    // lives exactly as long as the P# does — not as long as a Forced guardian.
    bool   pMarried = false

// ─── RIGHT-EDGE RENDER GROUP (from the original script) ───
// Every forward-extending level draws its label at the same x. Rather than
// hiding lower-priority levels, levels sharing a price are MERGED into one
// line whose label joins every name with " & " — so nothing is lost and
// nothing overlaps. Styling comes from the highest-priority member.
type EdgeLvl
    float         price
    array<string> labels
    color         ln_col
    int           ln_width
    string        ln_style
    int           b_time
    int           e_time
    int           priority
    string        txt_sz

// ─── Guardian minted at every break, anchors marker lifetime ───
type ForcedNode
    float  price
    int    t
    int    side
    string lbl

// ═══════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════
var array<GapBox>      visual_gaps  = array.new<GapBox>()
var array<POLine>      poLines      = array.new<POLine>()
var array<ShiftMarker> shiftMarkers = array.new<ShiftMarker>()
var array<ForcedNode>  forcedNodes  = array.new<ForcedNode>()
var array<EdgeLvl>     render_groups = array.new<EdgeLvl>()

var array<line>  drawn_lines   = array.new<line>()
var array<label> drawn_labels  = array.new<label>()
var array<box>   drawn_zones   = array.new<box>()   // eBlock / iBlock boxes
var array<line>  drawn_z_lines = array.new<line>()

// STATIC anchors (Pn / Rn) — frozen once set per range.
var Node buStatic = na
var Node beStatic = na
// DYNAMIC trackers — raw and gap tracked INDEPENDENTLY, "like replaces like".
// TREND-PHASE CONTROL slots — the MC / GMC printed in the trend's own
// direction BEFORE a pullback forms. They are separate from the dynamic slots
// on purpose: a resumption-phase MCR / GMCR must never overwrite them. Only a
// newer MC / GMC, a break (CDS / CDL), or a full range reset removes them.
var Node buCtlRaw = na
var Node buCtlGap = na
var Node beCtlRaw = na
var Node beCtlGap = na
var Node buDynRaw = na
var Node buDynGap = na
var Node beDynRaw = na
var Node beDynGap = na

var int   mainSide = 0
var int   curTier  = 0
var float tnPrice  = na
var int   tnTime   = na
var bool  primaryPullbackDone   = false
var bool  primaryResumptionDone = false

// RANGE SHIFT MEMORY — the most recent CDL and CDS printed since the current Tn
// formed. On a reversal, T1 ADOPTS this earlier shift instead of printing a new
// one at the broken PO4. The PO4 break only prints its own CDL/CDS when NO
// shift happened in the range (no GMC existed between Pn and Tn — blueprint
// 9.2). This is what stops "CDL following CDL" / "CDS following CDS".
// Reset every time a new Tn forms.
// FIRST P-SHIFT — has the current range's P# already produced its first
// pullback-direction CDS/CDL? The first one is capital and married to the P#;
// every later one in the same range is internal (small letters).
var bool firstPShiftDone = false
// FIRST R-SHIFT — has the current R# (GMCR# / MCR#) already produced its first
// resumption-direction CDL / CDS? Only that first one is capital and married
// to the R#; later ones (made by the unnumbered GMCR / MCR) are small letters.
var bool firstRShiftDone = false
var int    rngCdlT      = na
var float  rngCdlPrice  = na
var string rngCdlTxt    = ""
var int    rngCdlBreakT = na
var int    rngCdsT      = na
var float  rngCdsPrice  = na
var string rngCdsTxt    = ""
var int    rngCdsBreakT = na

// Urgency Gap Anticipation (ORIGINAL — untouched)
var float tc_bull_lvl      = na
var int   tc_bull_t        = na
var bool  tc_bull_violated = false
var float tc_bear_lvl      = na
var int   tc_bear_t        = na
var bool  tc_bear_violated = false

// MC Anticipation (ORIGINAL — untouched)
var float ant_bull_price  = na
var int   ant_bull_t      = na
var bool  ant_bull_active = false
var float ant_bull_h      = na
var float ant_bull_l      = na
var float ant_bull_o      = na
var float ant_bull_c      = na
var float ant_bull_v      = na   // relative volume of the MC candle, stored when it printed

var float ant_bear_price  = na
var int   ant_bear_t      = na
var bool  ant_bear_active = false
var float ant_bear_h      = na
var float ant_bear_l      = na
var float ant_bear_o      = na
var float ant_bear_c      = na
var float ant_bear_v      = na

// ─── ALERT FLAGS ───
bool alert_po4_bull = false
bool alert_po4_bear = false
bool alert_gmc_bull = false
bool alert_gmc_bear = false
bool alert_cdl      = false
bool alert_cds      = false
bool alert_ld       = false
bool alert_sd       = false

// ═══════════════════════════════════════════════════════════════
// GATE OSCILLATORS (same math as Super MMPD / MMM Pro Edge)
// ═══════════════════════════════════════════════════════════════
const color FAIL_COL = #9e9e9e
bool gateOn = gate_mode != "NO GATE"
bool show_failed = false   // MMM Pro Edge: a break that fails the gate is never made, so nothing fails

f_xsa(float src, int len) =>
    var float out = na
    float ma = ta.sma(src, len)
    out := na(out) ? ma : (src + out * (len - 1)) / len
    out

f_mmpd(int len) =>
    float cl = (close - ta.lowest(low, len)) / (ta.highest(high, len) - ta.lowest(low, len)) * 100
    float s1 = f_xsa(cl, 5)
    float s2 = f_xsa(s1, 3)
    float c  = (3 * s1 - 2 * s2 - 50) * 1.032 + 50
    float o  = ta.ema(((2 * close + high + low + open) / 5 - ta.lowest(low, len + 7)) / (ta.highest(high, len + 7) - ta.lowest(low, len + 7)) * 100, 13)
    [c, o]

f_dma() =>
    float v  = na(volume) or volume == 0 ? 1.0 : volume
    float dl = close > open and close > close[1] ? v : close < open and close < close[1] ? -v : close > close[1] ? v * 0.5 : close < close[1] ? -v * 0.5 : 0.0
    float ds = ta.ema(dl, 3)
    float lo = ta.lowest(ds, 14)
    float dr = ta.highest(ds, 14) - lo
    float c  = ta.ema(dr > 0 ? (ds - lo) / dr * 100 : 50, 3)
    float o  = ta.ema(c, 13)
    [c, o]

f_gateNow() =>
    [c1, o1] = f_mmpd(27)
    [c2, o2] = f_mmpd(gate_fast)
    [c3, o3] = f_dma()
    float hi = gate_mode == "MMPD 27" ? math.max(c1, o1) : gate_mode == "MMPD fast" ? math.max(c2, o2) : math.max(c3, o3)
    float lo = gate_mode == "MMPD 27" ? math.min(c1, o1) : gate_mode == "MMPD fast" ? math.min(c2, o2) : math.min(c3, o3)
    [hi, lo]

f_gatePrev() =>
    [hi, lo] = f_gateNow()
    [hi[1], lo[1]]

// Gate memory (impulse -> pullback -> continuation)
var bool hitXD   = false   // oscillator <= 20 since the last flip
var bool hitXP   = false   // oscillator >= 80 since the last flip
var bool bullImp = false   // bull leg reached its own extreme (>= 80)
var bool bullPb  = false   // then the pullback reached <= 20
var bool bearImp = false
var bool bearPb  = false

// Zone slice of an origin candle / box: which part is drawn depends on the
// Premium / Discount side and the depth.
f_zoneSlice(float top, float bot, bool isBull) =>
    bool  lowSide = zone_side == "Long in Discount / Short in Premium" ? isBull : not isBull
    float rng = top - bot
    float zT = na
    float zB = na
    if zone_tier == "Extreme (0-12.5% / 87.5-100%)"
        zT := lowSide ? bot + rng * 0.125 : top
        zB := lowSide ? bot : bot + rng * 0.875
    else if zone_tier == "Balanced (12.5-25% / 75-87.5%)"
        zT := lowSide ? bot + rng * 0.25 : bot + rng * 0.875
        zB := lowSide ? bot + rng * 0.125 : bot + rng * 0.75
    else if zone_tier == "Standard (25-50% / 50-75%)"
        zT := lowSide ? bot + rng * 0.50 : bot + rng * 0.75
        zB := lowSide ? bot + rng * 0.25 : bot + rng * 0.50
    else
        zT := lowSide ? bot + rng * 0.50 : top
        zB := lowSide ? bot : bot + rng * 0.50
    [zT, zB]

// Zone name from the naming scheme. isFlip = T1 (CDL / CDS), else T2+ (LD / SD).
f_zoneName(bool isFlip, bool isBull, string eng) =>
    string fl = (isBull ? "CDL" : "CDS") + eng
    string co = (isBull ? "LD" : "SD") + eng
    zone_naming == "eBlock / iBlock" ? (isFlip ? "MMM eBlock " + fl : "MMM iBlock " + co) : zone_naming == "External / Internal Entry Zone" ? (isFlip ? "External Entry Zone " + fl : "Internal Entry Zone " + co) : (isFlip ? "Flip Zone " + fl : "Continuation Zone " + co)

// ═══════════════════════════════════════════════════════════════
// MMM ZONE ENGINE (x) — box break logic inside the MMM Pro T# / P# / R# system.
// One block candle per call when doStep is true (state lives inside).
//  BOX     = expander BC + the candles that close back inside it.
//            G1 grow: an inside candle's wick past the edge pushes the edge out.
//            G0 fixed: the box keeps the range it was born with.
//  TREND   = the last PO4 x (Tn). Bull: BuPO4x below price · Bear: BePO4x above.
//  P#      = the FIRST box after Tn = the pullback start.
//            Bull: its HIGH is the level · Bear: its LOW is the level.
//  R#      = the first box formed after the P# box ended = the resumption base.
//            Bull: its LOW · Bear: its HIGH. A close back through it erases it.
//  LDx#    = a body close past P# -> R# becomes T(#+1) (no R# = the pullback extreme).
//  CDLx / CDSx = a body close past the last T# -> the P# level becomes the new T1
//            (no P# = the extreme of the leg). Every other box break is ignored.
// Returns the state + this candle's events.
// ═══════════════════════════════════════════════════════════════
// GATE (gOn): P# is a small p until the leg reached its own extreme and THEN
// the pullback reached the opposite extreme (gh / gl = oscillator high / low).
// A close past a small p deletes it (no LDx). R# only forms after the P# is
// confirmed. Flips stay structural.
f_zoneEngine(bool doStep, float o, float h, float l, float c, float v, float ph, float pl, int t, bool grow, bool expMode, bool gOn, float gh, float gl) =>
    var bool  zWait = false
    var float exH   = na
    var float exL   = na
    var int   exT   = na
    var int   exDir = 0
    var bool  zLive = false
    var float bxH   = na
    var float bxL   = na
    var int   bxT   = na
    var int   bxId  = 0
    var float bxD   = 0.0
    var float bxV   = 0.0
    var int   side  = 0
    var int   tier  = 0
    var float tnP   = na
    var int   tnT   = na
    var float pP    = na
    var int   pT    = na
    var int   pId   = -1
    var bool  pLive = false
    var float pOH   = na
    var float pOL   = na
    var float rP    = na
    var int   rT    = na
    var int   rId   = -1
    var bool  rLive = false
    var float rOH   = na
    var float rOL   = na
    var float legHi = na
    var float legHiL = na
    var int   legHiT = na
    var float legLo = na
    var float legLoH = na
    var int   legLoT = na
    var float pbHi  = na
    var float pbHiL = na
    var int   pbHiT = na
    var float pbLo  = na
    var float pbLoH = na
    var int   pbLoT = na
    var bool  imp   = false
    var bool  pConf = false
    int   evType = 0
    int   evDir  = 0
    int   evNum  = 0
    float brkP   = na
    int   brkT   = na
    float nTnP   = na
    int   nTnT   = na
    float nOH    = na
    float nOL    = na
    int   nOT    = na
    bool  endF   = false
    float endH   = na
    float endL   = na
    int   endT   = na
    int   endRole = 0
    float endNdb = 0.0
    int   formRole = -1
    if doStep and not na(c) and not na(ph) and not na(pl)
        bool  bu  = c > ph
        bool  be  = c < pl
        bool  bc  = bu or be
        float rg  = h - l
        float dlt = rg > 0 ? nz(v) * ((c - l) - (h - c)) / rg : 0.0
        bool  formed = false
        // 1. BOX DETECTOR
        if zLive
            if c > bxH or c < bxL
                endF    := true
                endH    := bxH
                endL    := bxL
                endT    := bxT
                endRole := bxId == pId ? 1 : bxId == rId ? 2 : 0
                endNdb  := bxV > 0 ? bxD / bxV : 0.0
                if bxId == pId
                    pLive := false
                if bxId == rId
                    rLive := false
                zLive := false
                zWait := bc
                if bc
                    exH   := h
                    exL   := l
                    exT   := t
                    exDir := bu ? 1 : -1
            else
                if grow
                    bxH := math.max(bxH, h)
                    bxL := math.min(bxL, l)
                bxD += dlt
                bxV += nz(v)
        else if zWait
            if bc
                exH   := h
                exL   := l
                exT   := t
                exDir := bu ? 1 : -1
            else
                zLive  := true
                zWait  := false
                formed := true
                bxId   += 1
                bxT    := exT
                bxD    := dlt
                bxV    := nz(v)
                if expMode
                    bxH := grow ? math.max(exH, h) : exH
                    bxL := grow ? math.min(exL, l) : exL
                else
                    bxH := h
                    bxL := l
        else if bc
            zWait := true
            exH   := h
            exL   := l
            exT   := t
            exDir := bu ? 1 : -1
        // live P# / R# boxes carry their level while they grow
        if zLive and bxId == pId
            pP  := side == 1 ? bxH : bxL
            pOH := bxH
            pOL := bxL
        if zLive and bxId == rId
            rP  := side == 1 ? bxL : bxH
            rOH := bxH
            rOL := bxL
        // 2. EXTREMES (leg since Tn, pullback since P#)
        if side != 0
            if na(legHi) or h > legHi
                legHi  := h
                legHiL := l
                legHiT := t
            if na(legLo) or l < legLo
                legLo  := l
                legLoH := h
                legLoT := t
        if not na(pP)
            if na(pbHi) or h > pbHi
                pbHi  := h
                pbHiL := l
                pbHiT := t
            if na(pbLo) or l < pbLo
                pbLo  := l
                pbLoH := h
                pbLoT := t
        // GATE: the leg reached its OWN extreme (bull >= 80 / bear <= 20)
        bool pConfBefore = pConf
        if gOn and side != 0 and not imp and not na(gh) and not na(gl) and ((side == 1 and gh >= 80) or (side == -1 and gl <= 20))
            imp := true
        bool pKill = false
        // 3. STRUCTURE: Reversal > Continuation > R# invalidation
        if side == 1
            if c < tnP
                evType := 1
                evDir  := -1
                brkP   := tnP
                brkT   := tnT
                bool hasP = not na(pP)
                nTnP := hasP ? pP : legHi
                nTnT := hasP ? pT : legHiT
                nOH  := hasP ? pOH : legHi
                nOL  := hasP ? pOL : legHiL
                nOT  := hasP ? pT : legHiT
            else if not na(pP) and c > pP and gOn and not pConfBefore
                pKill := true
            else if not na(pP) and c > pP
                evType := 2
                evDir  := 1
                evNum  := tier
                brkP   := pP
                brkT   := pT
                bool hasR = not na(rP)
                nTnP := hasR ? rP : pbLo
                nTnT := hasR ? rT : pbLoT
                nOH  := hasR ? rOH : pbLoH
                nOL  := hasR ? rOL : pbLo
                nOT  := hasR ? rT : pbLoT
            else if not na(rP) and c < rP
                rP    := na
                rT    := na
                rId   := -1
                rLive := false
        else if side == -1
            if c > tnP
                evType := 1
                evDir  := 1
                brkP   := tnP
                brkT   := tnT
                bool hasP = not na(pP)
                nTnP := hasP ? pP : legLo
                nTnT := hasP ? pT : legLoT
                nOH  := hasP ? pOH : legLoH
                nOL  := hasP ? pOL : legLo
                nOT  := hasP ? pT : legLoT
            else if not na(pP) and c < pP and gOn and not pConfBefore
                pKill := true
            else if not na(pP) and c < pP
                evType := 2
                evDir  := -1
                evNum  := tier
                brkP   := pP
                brkT   := pT
                bool hasR = not na(rP)
                nTnP := hasR ? rP : pbHi
                nTnT := hasR ? rT : pbHiT
                nOH  := hasR ? rOH : pbHi
                nOL  := hasR ? rOL : pbHiL
                nOT  := hasR ? rT : pbHiT
            else if not na(rP) and c > rP
                rP    := na
                rT    := na
                rId   := -1
                rLive := false
        else if endF
            // GENESIS: the first box break starts the first trend
            evType := 1
            evDir  := c > endH ? 1 : -1
            brkP   := evDir == 1 ? endH : endL
            brkT   := endT
            nTnP   := evDir == 1 ? endL : endH
            nTnT   := endT
            nOH    := endH
            nOL    := endL
            nOT    := endT
        if pKill
            // small p closed through before the gate confirmed it -> deleted, no LDx / SDx
            pP    := na
            pT    := na
            pId   := -1
            pLive := false
            rP    := na
            rT    := na
            rId   := -1
            rLive := false
            pbHi  := na
            pbLo  := na
        if evType != 0
            imp   := not gOn
            pConf := false
            side  := evDir
            tier  := evType == 1 ? 1 : tier + 1
            tnP   := nTnP
            tnT   := nTnT
            pP    := na
            pT    := na
            pId   := -1
            pLive := false
            rP    := na
            rT    := na
            rId   := -1
            rLive := false
            legHi  := h
            legHiL := l
            legHiT := t
            legLo  := l
            legLoH := h
            legLoT := t
            pbHi  := na
            pbLo  := na
        // GATE: p -> P# once the pullback reached the OPPOSITE extreme after the leg's own extreme
        bool pConfPrev = pConf
        if gOn and evType == 0 and not pKill and not na(pP) and not pConf and imp and not na(gh) and not na(gl) and ((side == 1 and gl <= 20) or (side == -1 and gh >= 80))
            pConf := true
        // 4. ROLE of a box born on this candle
        if formed
            formRole := 0
            if side != 0 and na(pP)
                pId   := bxId
                pLive := true
                pP    := side == 1 ? bxH : bxL
                pT    := bxT
                pOH   := bxH
                pOL   := bxL
                pbHi  := bxH
                pbHiL := bxL
                pbHiT := bxT
                pbLo  := bxL
                pbLoH := bxH
                pbLoT := bxT
                formRole := 1
            else if side != 0 and not pLive and na(rP) and (not gOn or pConfPrev)
                rId   := bxId
                rLive := true
                rP    := side == 1 ? bxL : bxH
                rT    := bxT
                rOH   := bxH
                rOL   := bxL
                formRole := 2
    float liveNdb = bxV > 0 ? bxD / bxV : 0.0
    int   liveRole = zLive ? (bxId == pId ? 1 : bxId == rId ? 2 : 0) : -1
    [side, tier, tnP, tnT, pP, pT, rP, rT, evType, evDir, evNum, brkP, brkT, nTnP, nTnT, nOH, nOL, nOT, zLive, bxH, bxL, bxT, liveNdb, liveRole, endF, endH, endL, endT, endRole, endNdb, pConf]

// ═══════════════════════════════════════════════════════════════
// HTF BIAS — compact copies of the three MMM engines, run on the HTF.
// Last CLOSED HTF candle only ([1] + lookahead_on) = no repaint.
// Each returns [flip side, continuation side, last BC, BC origin]
// origin: 2 = the last BC was a flip candle, 1 = a continuation candle, 0 = plain.
// ═══════════════════════════════════════════════════════════════
f_htfSwing() =>
    var float   tH    = high
    var float   tL    = low
    var int     tSt   = 0
    var int     sig   = 0
    var int     lastC = 0
    var int     cdlB  = -1
    var int     cdsB  = -1
    var float[] hs    = array.new<float>()
    var int[]   hsb   = array.new<int>()
    var float[] ls    = array.new<float>()
    var int[]   lsb   = array.new<int>()
    bool flipEv = false
    bool contEv = false
    bool bu = close > high[1]
    bool be = close < low[1]
    if tSt == 0
        tH := math.max(tH, high)
        tL := math.min(tL, low)
    if tSt == 1 and high >= tH
        tH := high
    if tSt == -1 and low <= tL
        tL := low
    if be and tSt >= 0
        hs.push(tH)
        hsb.push(bar_index)
        tSt := -1
        tL  := low
    else if bu and tSt <= 0
        ls.push(tL)
        lsb.push(bar_index)
        tSt := 1
        tH  := high
    bool lowDone = false
    if ls.size() > 0
        for i = ls.size() - 1 to 0
            float p = ls.get(i)
            int   b = lsb.get(i)
            if b < bar_index and close < p
                if not lowDone
                    bool flip = sig != -1
                    if flip or b > cdsB
                        lowDone := true
                        if flip
                            cdsB   := bar_index
                            lastC  := 0
                            flipEv := true
                        else
                            lastC  := -1
                            contEv := true
                        sig := -1
                ls.remove(i)
                lsb.remove(i)
    bool highDone = false
    if hs.size() > 0
        for i = hs.size() - 1 to 0
            float p = hs.get(i)
            int   b = hsb.get(i)
            if b < bar_index and close > p
                if not highDone
                    bool flip = sig != 1
                    if flip or b > cdlB
                        highDone := true
                        if flip
                            cdlB   := bar_index
                            lastC  := 0
                            flipEv := true
                        else
                            lastC  := 1
                            contEv := true
                        sig := 1
                hs.remove(i)
                hsb.remove(i)
    while ls.size() > 20
        ls.shift()
        lsb.shift()
    while hs.size() > 20
        hs.shift()
        hsb.shift()
    [sig, lastC, flipEv, contEv]

f_htfCandle() =>
    var int   side  = 0
    var float tn    = na
    var float pb    = na
    var float rs    = na
    var int   lastC = 0
    bool flipEv = false
    bool contEv = false
    bool bu   = close > high[1]
    bool be   = close < low[1]
    bool done = false
    if side == 1
        if close < tn
            side   := -1
            tn     := na(pb) ? open : pb
            pb     := na
            rs     := na
            lastC  := 0
            done   := true
            flipEv := true
        else if not na(pb) and close > pb
            tn     := na(rs) ? open : rs
            pb     := na
            rs     := na
            lastC  := 1
            done   := true
            contEv := true
    else if side == -1
        if close > tn
            side   := 1
            tn     := na(pb) ? open : pb
            pb     := na
            rs     := na
            lastC  := 0
            done   := true
            flipEv := true
        else if not na(pb) and close < pb
            tn     := na(rs) ? open : rs
            pb     := na
            rs     := na
            lastC  := -1
            done   := true
            contEv := true
    else
        if bu or be
            side   := bu ? 1 : -1
            tn     := open
            done   := true
            flipEv := true
    if not done
        if side == 1
            if not na(rs) and close < rs
                rs := na
            if be and na(pb)
                pb := open
            else if bu and not na(pb) and na(rs)
                rs := open
        else if side == -1
            if not na(rs) and close > rs
                rs := na
            if bu and na(pb)
                pb := open
            else if be and not na(pb) and na(rs)
                rs := open
    [side, lastC, flipEv, contEv]

f_htfZone() =>
    var int lastC = 0
    [zs, zt, ztn, ztt, zp, zpt, zr, zrt, zev, zdir, znum, zbp, zbt, zntp, zntt, zoh, zol, zot, zlive, zbh, zbl, zbt2, zndb, zrole, zef, zeh, zel, zet, zer, zen, zpc] = f_zoneEngine(true, open, high, low, close, volume, high[1], low[1], time, true, true, false, na, na)
    if zev == 1
        lastC := 0
    if zev == 2
        lastC := zdir
    [zs, lastC, zev == 1, zev == 2]

f_htfAll() =>
    var int lastBC = 0
    var int bcOrg  = 0
    [s1, c1, f1, n1] = f_htfSwing()
    [s2, c2, f2, n2] = f_htfCandle()
    [s3, c3, f3, n3] = f_htfZone()
    bool useX = htf_eng == "Zone x (boxes)"
    bool useC = htf_eng == "Candle c (PO4)"
    int  sd = useX ? s3 : useC ? s2 : s1
    int  cn = useX ? c3 : useC ? c2 : c1
    bool fe = useX ? f3 : useC ? f2 : f1
    bool ne = useX ? n3 : useC ? n2 : n1
    bool bu = close > high[1]
    bool be = close < low[1]
    if bu or be
        lastBC := bu ? 1 : -1
        bcOrg  := fe ? 2 : ne ? 1 : 0
    [nz(sd[1]), nz(cn[1]), nz(lastBC[1]), nz(bcOrg[1])]

[htfSig, htfCont, htfBC, htfOrg] = request.security(syminfo.tickerid, htf_tf, f_htfAll(), lookahead=barmerge.lookahead_on)
int  htfBias = htf_src == "Last BC" ? htfBC : htf_src == "Last Flip (CDL / CDS)" ? htfSig : htf_src == "Last Continuation (LD / SD)" ? htfCont : 0

// true when a break in direction dir goes AGAINST the HTF bias
f_againstHtf(int dir) =>
    htf_src != "Off" and htfBias != 0 and htfBias != dir

f_htfPos(string p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Bottom Left"   => position.bottom_left
        "Bottom Right"  => position.bottom_right
        => position.bottom_center

// ═══════════════════════════════════════════════════════════════
// NEWS ENGINE (shared by every MMM indicator) — light: no library and no
// external request. Events come from the one calendar box.
// ═══════════════════════════════════════════════════════════════
const string NWS_TZ = "America/New_York"

type NewsMark
    label dot
    label txt
    box   bg
    float price
    bool  atHi
    int   bar
    int   wS
    int   wE

f_nwImpOk(string imp) =>
    imp == "H" ? news_red : imp == "M" ? news_org : imp == "L" ? news_yel : imp == "N" ? news_gry : false

f_nwCol(string imp) =>
    imp == "H" ? color.red : imp == "M" ? color.orange : imp == "L" ? color.yellow : color.gray

f_nwRank(string imp) =>
    imp == "H" ? 4 : imp == "M" ? 3 : imp == "L" ? 2 : 1

f_nwDate(string d, int hh, int mm) =>
    int t = na
    if str.length(d) == 10
        float y  = str.tonumber(str.substring(d, 0, 4))
        float m  = str.tonumber(str.substring(d, 5, 7))
        float dd = str.tonumber(str.substring(d, 8, 10))
        if not na(y) and not na(m) and not na(dd)
            t := timestamp(NWS_TZ, int(y), int(m), int(dd), hh, mm)
    t

var array<int>    nwT = array.new<int>()
var array<string> nwI = array.new<string>()
var array<string> nwN = array.new<string>()

if barstate.isfirst
    array<int>    tT = array.new<int>()
    array<string> tI = array.new<string>()
    array<string> tN = array.new<string>()
    string curList = "," + str.replace_all(str.upper(news_cur), " ", "") + ","
    for ln in str.split(str.replace_all(news_paste, ";", "\n"), "\n")
        array<string> tk = str.split(str.trim(ln), " ")
        if tk.size() >= 4
            string dS  = tk.get(0)
            string tS  = tk.get(1)
            string cur = str.upper(tk.get(2))
            string imp = str.upper(tk.get(3))
            if str.length(tS) == 5 and str.contains(curList, "," + cur + ",") and f_nwImpOk(imp)
                float hh = str.tonumber(str.substring(tS, 0, 2))
                float mm = str.tonumber(str.substring(tS, 3, 5))
                if not na(hh) and not na(mm)
                    int t = f_nwDate(dS, int(hh), int(mm))
                    if not na(t)
                        string ttl = ""
                        if tk.size() > 4
                            for k = 4 to tk.size() - 1
                                ttl += (k > 4 ? " " : "") + tk.get(k)
                        tT.push(t)
                        tI.push(imp)
                        tN.push(str.length(ttl) > 0 ? ttl : cur)
    if tT.size() > 0
        array<int> ord = tT.sort_indices(order.ascending)
        for k = 0 to ord.size() - 1
            nwT.push(tT.get(ord.get(k)))
            nwI.push(tI.get(ord.get(k)))
            nwN.push(tN.get(ord.get(k)))

int    nwPre    = news_pre * 60000
int    nwPost   = news_post * 60000
int    nwWarn   = (news_warn == "15" ? 15 : 30) * 60000
int    nwBarMs  = timeframe.in_seconds(timeframe.period) * 1000
int    nwEnd    = nz(time_close, time + nwBarMs)
var int nwPtr   = 0
bool   nwInWin  = false
int    nwWinS   = na
int    nwWinE   = na
string nwWarnTxt = ""
string nwWarnTip = ""
string nwWarnImp = ""
int    nwWarnS  = na
int    nwWarnE  = na
if timeframe.isintraday and nwT.size() > 0
    while nwPtr < nwT.size()
        if nwT.get(nwPtr) + nwPost < time
            nwPtr += 1
        else
            break
    if nwPtr < nwT.size()
        for j = nwPtr to nwT.size() - 1
            int et = nwT.get(j)
            if et - math.max(nwPre, nwWarn) >= nwEnd
                break
            if time < et + nwPost and nwEnd > et - nwPre
                nwInWin := true
                nwWinS  := na(nwWinS) ? et - nwPre : math.min(nwWinS, et - nwPre)
                nwWinE  := na(nwWinE) ? et + nwPost : math.max(nwWinE, et + nwPost)
            int wt = et - nwWarn
            if wt >= time and wt < nwEnd
                string nm = nwN.get(j)
                if not str.contains(nwWarnTxt, nm)
                    nwWarnTxt += (str.length(nwWarnTxt) > 0 ? "/" : "") + nm
                nwWarnTip += (str.length(nwWarnTip) > 0 ? "\n" : "") + str.format_time(et, "HH:mm", NWS_TZ) + " NY · " + nwI.get(j) + " · " + nm
                nwWarnS := na(nwWarnS) ? et - nwPre : math.min(nwWarnS, et - nwPre)
                nwWarnE := na(nwWarnE) ? et + nwPost : math.max(nwWarnE, et + nwPost)
                if str.length(nwWarnImp) == 0 or f_nwRank(nwI.get(j)) > f_nwRank(nwWarnImp)
                    nwWarnImp := nwI.get(j)
bool newsBlock = nwInWin
bool newsWarn  = str.length(nwWarnTxt) > 0

var array<NewsMark> nwMarks = array.new<NewsMark>()
var int nwKillE = na   // end of a window whose dot was taken: no new shading before it

f_nwMake(bool keep) =>
    color dc   = f_nwCol(nwWarnImp)
    bool  atHi = news_dot_at == "High"
    float p    = atHi ? high : low
    label d    = news_dot ? label.new(bar_index, p, "", style=label.style_circle, color=dc, textcolor=dc, size=size.tiny, tooltip="News in " + news_warn + " min:\n" + nwWarnTip) : na
    label tx   = news_lbl ? label.new(bar_index, p, nwWarnTxt, style=close < open ? label.style_label_down : label.style_label_up, color=color(na), textcolor=dc, size=size.tiny, tooltip=nwWarnTip) : na
    if keep
        nwMarks.push(NewsMark.new(d, tx, na, p, atHi, bar_index, nwWarnS, nwWarnE))
    keep

// Live candle: a temporary dot (rolled back every tick). Closed candle: kept.
if newsWarn and (news_dot or news_lbl)
    f_nwMake(barstate.isconfirmed)

if barstate.isconfirmed and timeframe.isintraday
    // Background: shade the window of the newest mark (or start one when the
    // warning candle was missed).
    if nwInWin and news_bg and (na(nwKillE) or time >= nwKillE)
        NewsMark m = na
        if nwMarks.size() > 0
            m := nwMarks.last()
        if na(m) or time >= m.wE
            m := NewsMark.new(na, na, na, na, true, bar_index, nwWinS, nwWinE)
            nwMarks.push(m)
        if na(m.bg)
            m.bg := box.new(time, high, nwEnd, low, xloc=xloc.bar_time, border_color=na, bgcolor=color.new(color.orange, 85))
        else
            m.bg.set_right(nwEnd)
            m.bg.set_top(math.max(m.bg.get_top(), high))
            m.bg.set_bottom(math.min(m.bg.get_bottom(), low))
    // Deletion: a later candle takes the dot -> dot, label and background go together.
    if news_del and nwMarks.size() > 0
        for i = nwMarks.size() - 1 to 0
            NewsMark m = nwMarks.get(i)
            if not na(m.price) and bar_index > m.bar
                bool hit = news_del_mode == "Touch" ? (m.atHi ? high >= m.price : low <= m.price) : (m.atHi ? close > m.price : close < m.price)
                if hit
                    if not na(m.wE)
                        nwKillE := na(nwKillE) ? m.wE : math.max(nwKillE, m.wE)
                    label.delete(m.dot)
                    label.delete(m.txt)
                    box.delete(m.bg)
                    nwMarks.remove(i)
    // Caps: dots + labels share one count, backgrounds have their own.
    int nDot = 0
    int nBg  = 0
    if nwMarks.size() > 0
        for i = nwMarks.size() - 1 to 0
            NewsMark m = nwMarks.get(i)
            if not na(m.dot) or not na(m.txt)
                nDot += 1
                if nDot > news_max
                    label.delete(m.dot)
                    label.delete(m.txt)
                    m.dot := na
                    m.txt := na
            if not na(m.bg)
                nBg += 1
                if nBg > news_bg_max
                    box.delete(m.bg)
                    m.bg := na
            if na(m.dot) and na(m.txt) and na(m.bg) and time >= m.wE
                nwMarks.remove(i)

// ═══════════════════════════════════════════════════════════════
// STRUCTURE TIMEFRAME — last CLOSED structure candle ([1] + lookahead_on).
// On the chart timeframe the candle is read directly (no delay).
// ═══════════════════════════════════════════════════════════════
f_get_auto_tf(string _tf, string _multStr) =>
    int mult = _multStr == "4x" ? 4 : 6
    int tf_sec = timeframe.in_seconds(_tf)
    string res = _tf
    if not na(tf_sec)
        int tf_mins = math.round(tf_sec / 60)
        if tf_sec < 60
            res := str.tostring(tf_sec * mult) + "S"
        else if tf_mins < 1440
            res := str.tostring(tf_mins * mult)
        else if tf_mins == 1440
            res := str.tostring(mult) + "D"
        else if tf_mins == 10080
            res := str.tostring(mult) + "W"
        else
            res := str.tostring(mult) + "M"
    res

f_tfName(string t) =>
    string s = str.length(t) == 0 ? timeframe.period : t
    switch s
        "1"   => "M1"
        "3"   => "M3"
        "5"   => "M5"
        "15"  => "M15"
        "30"  => "M30"
        "45"  => "M45"
        "60"  => "H1"
        "120" => "H2"
        "180" => "H3"
        "240" => "H4"
        "360" => "H6"
        "480" => "H8"
        "720" => "H12"
        => s

string blockTF     = tfMode == "Auto Combination" ? f_get_auto_tf(timeframe.period, autoMultiplier) : (structTimeframe == "" ? timeframe.period : structTimeframe)
bool   blockSameTF = timeframe.in_seconds(blockTF) <= timeframe.in_seconds(timeframe.period)
string TFP         = showTfLabel and not blockSameTF ? f_tfName(blockTF) + " " : ""

// Structure candle: OHLCV, its history, a close-location delta and its RVOL.
f_blockNow() =>
    float rg = high - low
    float v  = nz(volume)
    float dl = rg > 0 ? v * ((close - low) - (high - close)) / rg : 0.0
    float av = ta.sma(v, 20)[1]
    float rv = nz(av) > 0 ? v / av : 0.0
    [time, open, high, low, close, v, high[1], low[1], high[2], low[2], open[1], close[1], time[1], dl, rv]

f_blockPrev() =>
    [t0, o0, h0, l0, c0, v0, ph0, pl0, ph2, pl2, po0, pc0, pt0, dl0, rv0] = f_blockNow()
    [t0[1], o0[1], h0[1], l0[1], c0[1], v0[1], ph0[1], pl0[1], ph2[1], pl2[1], po0[1], pc0[1], pt0[1], dl0[1], rv0[1]]

[n_t, n_o, n_h, n_l, n_c, n_v, n_h1, n_l1, n_h2, n_l2, n_o1, n_c1, n_t1, n_dl, n_rv] = f_blockNow()
[s_t, s_o, s_h, s_l, s_c, s_v, s_h1, s_l1, s_h2, s_l2, s_o1, s_c1, s_t1, s_dl, s_rv] = request.security(syminfo.tickerid, blockTF, f_blockPrev(), lookahead=barmerge.lookahead_on)
[g_hi_htf, g_lo_htf] = request.security(syminfo.tickerid, blockTF, f_gatePrev(), lookahead=barmerge.lookahead_on)
[g_hi_now, g_lo_now] = f_gateNow()

int   bT  = blockSameTF ? n_t  : s_t
float bO  = blockSameTF ? n_o  : s_o
float bH  = blockSameTF ? n_h  : s_h
float bL  = blockSameTF ? n_l  : s_l
float bC  = blockSameTF ? n_c  : s_c
float bV  = blockSameTF ? n_v  : s_v
float bH1 = blockSameTF ? n_h1 : s_h1
float bL1 = blockSameTF ? n_l1 : s_l1
float bH2 = blockSameTF ? n_h2 : s_h2
float bL2 = blockSameTF ? n_l2 : s_l2
float bO1 = blockSameTF ? n_o1 : s_o1
float bC1 = blockSameTF ? n_c1 : s_c1
int   bT1 = blockSameTF ? n_t1 : s_t1
float bDl = blockSameTF ? n_dl : s_dl
float bRv = blockSameTF ? n_rv : s_rv
float bVp = bRv * 100
float gHi = blockSameTF ? g_hi_now : g_hi_htf
float gLo = blockSameTF ? g_lo_now : g_lo_htf

var int prevBlockT = 0
bool newBlock = not na(bT) and bT != prevBlockT
prevBlockT := nz(bT, prevBlockT)
bool stepNow = barstate.isconfirmed and newBlock

var bool legOfficial = true   // the break that made the current Tn passed the gate
string ENGT = eng_tag ? "c" : ""

// Engine letter on every break name (c = candle engine).
f_eng(string txt) =>
    string r = txt
    if eng_tag
        r := str.replace_all(r, "CDL", "CDLc")
        r := str.replace_all(r, "CDS", "CDSc")
        r := str.replace_all(r, "cdl", "cdlc")
        r := str.replace_all(r, "cds", "cdsc")
        r := str.replace_all(r, "LD", "LDc")
        r := str.replace_all(r, "SD", "SDc")
        r := str.replace_all(r, "ld", "ldc")
        r := str.replace_all(r, "sd", "sdc")
    r

f_xuName(bool gap, bool isBull) =>
    string b = zone_naming == "eBlock / iBlock" ? (gap ? "MMM XU iBlock" : "MMM U iBlock") : zone_naming == "External / Internal Entry Zone" ? (gap ? "XU Internal Entry Zone" : "U Internal Entry Zone") : (gap ? "XU Continuation Zone" : "U Continuation Zone")
    b + (isBull ? " L" : " S")

// ═══════════════════════════════════════════════════════════════════════════
// HELPERS (all global scope — Pine rejects declarations inside if blocks)
// ═══════════════════════════════════════════════════════════════════════════
// STRICT PULLBACKS: in "GMPO (Gap-Confirmed Only)" a raw MP is not a pullback
// at all. It cannot anchor P#, cannot validate LD / SD, and cannot become T1 on
// a reversal. It must be gap-confirmed first. In "MPO (Raw Pullback)" both raw
// and gap-confirmed pullbacks count, exactly as before.
bool strictP = p1_validate_mode == "GMPO (Gap-Confirmed Only)"

f_eps() => math.max(syminfo.mintick * 0.51, 1e-5)

// GATE (MMM Pro Edge): which P# / R# node the gate has confirmed (time + price key).
var int   pConfT = na
var float pConfP = na
var int   rConfT = na
var float rConfP = na
f_isPConf(Node n) =>
    not gateOn or (not na(n) and not na(pConfT) and n.t == pConfT and math.abs(n.price - pConfP) <= f_eps())
f_isRConf(Node n) =>
    not gateOn or (not na(n) and not na(rConfT) and n.t == rConfT and math.abs(n.price - rConfP) <= f_eps())
f_gTxt(string t, bool ok, string tag) =>
    ok ? t : TFP + str.lower(str.substring(t, str.length(TFP))) + tag
f_gCol(color c, bool ok) =>
    ok ? c : color.new(c, 40)

f_sz(string s) =>
    s == "large" ? size.large : s == "normal" ? size.normal : s == "small" ? size.small : size.tiny

f_ln_style(string s) =>
    s == "Solid" ? line.style_solid : s == "Dotted" ? line.style_dotted : line.style_dashed

var int bar_time_diff = timeframe.in_seconds() * 1000
f_future_time(int ext) =>
    int diff = time - nz(time[1], time)
    if diff <= 0
        diff := bar_time_diff
    if diff <= 0
        diff := 60000
    time + math.round(diff * ext)

// Swaps MC/GMC/MP/GMP for the Urgency naming when selected. Longer tokens are
// replaced first so GMC doesn't partially match the MC replacement.
// Converts EVERY structural token to the Urgency scheme when selected —
// uppercase and lowercase alike, resumptions (MCR/GMCR -> UCR/XUCR) included,
// and the long-form "GM Pullback / M Pullback" naming too. Longest tokens are
// replaced first so GMCR never partially matches the GMC or MC rules.
f_apply_naming(string txt) =>
    string result = txt
    if label_naming_scheme == "UC / XUC / UP / XUP"
        // long-form pullback naming first (it contains the short tokens)
        result := str.replace_all(result, "GM Pullback", "XUP")
        result := str.replace_all(result, "M Pullback",  "UP")
        result := str.replace_all(result, "gm pullback", "xup")
        result := str.replace_all(result, "m pullback",  "up")
        // uppercase
        result := str.replace_all(result, "GMCR", "XUCR")
        result := str.replace_all(result, "GMC",  "XUC")
        result := str.replace_all(result, "GMP",  "XUP")
        result := str.replace_all(result, "MCR",  "UCR")
        result := str.replace_all(result, "MC",   "UC")
        result := str.replace_all(result, "MP",   "UP")
        // lowercase (internal/secondary labels)
        result := str.replace_all(result, "gmcr", "xucr")
        result := str.replace_all(result, "gmc",  "xuc")
        result := str.replace_all(result, "gmp",  "xup")
        result := str.replace_all(result, "mcr",  "ucr")
        result := str.replace_all(result, "mc",   "uc")
        result := str.replace_all(result, "mp",   "up")
    result

// Marker lifetime is anchored ONLY to the dedicated Forced guardians, never to
// the shared MP/MC/MCR slots — those churn constantly and would sweep markers
// within a bar or two. Every break mints its own guardian.
f_guardianExists(int gT, float gPrice) =>
    bool found = false
    if forcedNodes.size() > 0
        for fn in forcedNodes
            if fn.t == gT and math.abs(fn.price - gPrice) <= f_eps()
                found := true
    found

// Is there a live PO4 origin at this exact bar + price? After an LD / SD the
// R# becomes the new Tn, so the R#'s first CDL / CDS stays married to that Tn.
f_poLineAt(int gT, float gP) =>
    bool found = false
    if poLines.size() > 0
        for pl in poLines
            if pl.t == gT and math.abs(pl.price - gP) <= f_eps()
                found := true
    found

// A P#-married CDS lives on the bull trend's BeX pullback anchor (beStatic);
// a P#-married CDL lives on the bear trend's BuX pullback anchor (buStatic).
// Alive = that exact anchor (same bar + price) still exists.
// The REAL node (one of the six state slots) that sits at this exact bar +
// price, or na. This is the husband when the breaking candle was a body close.
f_slotNodeAt(int gT, float gP) =>
    Node res = na
    if not na(buStatic) and buStatic.t == gT and math.abs(buStatic.price - gP) <= f_eps()
        res := buStatic
    if na(res) and not na(beStatic) and beStatic.t == gT and math.abs(beStatic.price - gP) <= f_eps()
        res := beStatic
    if na(res) and not na(buDynRaw) and buDynRaw.t == gT and math.abs(buDynRaw.price - gP) <= f_eps()
        res := buDynRaw
    if na(res) and not na(buDynGap) and buDynGap.t == gT and math.abs(buDynGap.price - gP) <= f_eps()
        res := buDynGap
    if na(res) and not na(beDynRaw) and beDynRaw.t == gT and math.abs(beDynRaw.price - gP) <= f_eps()
        res := beDynRaw
    if na(res) and not na(beDynGap) and beDynGap.t == gT and math.abs(beDynGap.price - gP) <= f_eps()
        res := beDynGap
    if na(res) and not na(buCtlRaw) and buCtlRaw.t == gT and math.abs(buCtlRaw.price - gP) <= f_eps()
        res := buCtlRaw
    if na(res) and not na(buCtlGap) and buCtlGap.t == gT and math.abs(buCtlGap.price - gP) <= f_eps()
        res := buCtlGap
    if na(res) and not na(beCtlRaw) and beCtlRaw.t == gT and math.abs(beCtlRaw.price - gP) <= f_eps()
        res := beCtlRaw
    if na(res) and not na(beCtlGap) and beCtlGap.t == gT and math.abs(beCtlGap.price - gP) <= f_eps()
        res := beCtlGap
    res

// Does ANY husband exist at this bar + price — a real node or a Forced one?
f_nodeExistsAt(int gT, float gP) =>
    not na(f_slotNodeAt(gT, gP)) or f_guardianExists(gT, gP)

f_pAnchorAlive(ShiftMarker sm) =>
    Node a = sm.side == -1 ? beStatic : buStatic
    not na(a) and a.t == sm.guardianT and math.abs(a.price - sm.guardianPrice) <= f_eps()

// Merges a level into the right-edge render groups. Levels within one tick of
// each other collapse into a single line; their labels are joined with " & "
// and the highest-priority member dictates color, width, style and text size.
f_add_level(float p_price, string p_text, color p_col, int p_width, string p_style, int p_start_t, int p_end_t, int p_prio, string p_txt_sz) =>
    bool found = false
    int safe_start = nz(p_start_t, time)
    int safe_end   = nz(p_end_t, time)
    int final_b    = math.min(safe_start, safe_end)
    int final_e    = math.max(safe_start, safe_end)

    if render_groups.size() > 0
        for grp in render_groups
            if math.abs(grp.price - p_price) <= f_eps()
                found := true
                if str.length(p_text) > 0 and array.indexof(grp.labels, p_text) == -1
                    grp.labels.push(p_text)
                grp.b_time := math.min(grp.b_time, final_b)
                grp.e_time := math.max(grp.e_time, final_e)
                if p_prio > grp.priority
                    grp.ln_col   := p_col
                    grp.ln_width := p_width
                    grp.ln_style := p_style
                    grp.priority := p_prio
                    grp.txt_sz   := p_txt_sz
                break

    if not found
        array<string> new_labels = array.new<string>()
        if str.length(p_text) > 0
            new_labels.push(p_text)
        render_groups.push(EdgeLvl.new(price=p_price, labels=new_labels, ln_col=p_col, ln_width=p_width, ln_style=p_style, b_time=final_b, e_time=final_e, priority=p_prio, txt_sz=p_txt_sz))

f_draw_groups() =>
    if render_groups.size() > 0
        for grp in render_groups
            string combined_txt = array.join(grp.labels, " & ")
            drawn_lines.push(line.new(grp.b_time, grp.price, grp.e_time, grp.price, xloc=xloc.bar_time, color=grp.ln_col, width=grp.ln_width, style=grp.ln_style))
            drawn_labels.push(label.new(grp.e_time, grp.price, combined_txt, xloc=xloc.bar_time, textcolor=grp.ln_col, color=color(na), style=label.style_label_left, size=f_sz(grp.txt_sz)))
    render_groups.clear()

// STATIC anchor text — capitalized, numbered to the range's tier.
f_staticText(Node n, string candleType, bool isPullbackRole, int tier) =>
    string pullLbl = label_gmp_mp == "GMP / MP" ? (n.isGap ? "GMP" : "MP") : (n.isGap ? "GM Pullback" : "M Pullback")
    string roleLabel = isPullbackRole ? pullLbl : (n.isGap ? "GMCR" : "MCR")
    candleType + " " + roleLabel + (show_tiers ? str.tostring(tier) : "")

// DYNAMIC pullback text — lowercase, never numbered (internal, counter-trend).
f_dynPullbackText(Node n, string candleType) =>
    string pullLbl = label_gmp_mp == "GMP / MP" ? (n.isGap ? "GMP" : "MP") : (n.isGap ? "GM Pullback" : "M Pullback")
    str.lower(candleType + " " + pullLbl)

// DYNAMIC resumption text — always capitalized (with-trend), never numbered.
// Uses the node's OWN stamped phase flag so it can't retroactively relabel.
f_dynResumeText(Node n, string candleType) =>
    string roleLabel = n.isPhase3Internal ? (n.isGap ? "GMCR" : "MCR") : (n.isGap ? "GMC" : "MC")
    candleType + " " + roleLabel

// PURGE OFF + a range closing: the state machine must empty its slots, but a
// node still married to a CDS / CDL cannot just vanish. Each such node is kept
// on the chart as a standalone husband (same bar, price and name) so the pair
// stays together until price closes back through it.
// EXCEPTION: a marker whose husband just BECAME the new Tn (the R# promoted on
// an LD / SD) is not copied — it stays married to that PO4 instead, so no
// "BuX GMCR#" label is ever drawn beside the new "BuPO4 T#".
f_preserveHusbands(int oldSide, int tier) =>
    if shiftMarkers.size() > 0
        for sm in shiftMarkers
            if not sm.pMarried and not f_guardianExists(sm.guardianT, sm.guardianPrice) and not f_poLineAt(sm.guardianT, sm.guardianPrice)
                Node h = f_slotNodeAt(sm.guardianT, sm.guardianPrice)
                if not na(h)
                    bool   isBu   = sm.side == 1
                    bool   pbRole = isBu ? oldSide == -1 : oldSide == 1
                    string ct     = isBu ? "BuX" : "BeX"
                    string lbl    = h.isPrimary ? f_staticText(h, ct, pbRole, tier) : (pbRole ? f_dynPullbackText(h, ct) : f_dynResumeText(h, ct))
                    forcedNodes.push(ForcedNode.new(price=h.price, t=h.t, side=sm.side, lbl=lbl))

// p1_validate_mode display filter: in "GMPO (Gap-Confirmed Only)" mode only
// gap-confirmed pullbacks (GMP) are plotted. Raw MP levels are still tracked
// and still validate LD/SD — they are simply not drawn. Origins (PO4) are
// never affected by this.
// Anchor-candle relative volume, as a percentage of its 20-bar average.
// Called ONCE per bar at global scope (g_volPct below), so the average is
// built on every bar. Never call it inside an if block or the render.
var int volLen = 20
f_volPct() =>
    float avg = ta.sma(volume, volLen)
    avg > 0 ? volume / avg * 100 : float(na)

float g_volPct = f_volPct()

f_pullbackVisible(Node n) =>
    p1_validate_mode == "MPO (Raw Pullback)" or n.isGap

f_buildSlices(float gTop, float gBot, color bgCol, int le, int re) =>
    box[]  sl  = array.new<box>()
    bool[] tch = array.new<bool>()
    float h = (gTop - gBot) / slices_count
    for k = 0 to slices_count - 1
        sl.push(box.new(le, gTop-k*h, re, gTop-(k+1)*h, bgcolor=bgCol, border_color=na))
        tch.push(false)
    [sl, tch]

method erase(GapBox u) =>
    if not na(u.b)
        box.delete(u.b)
    if not na(u.l)
        line.delete(u.l)
    if not na(u.lbl)
        label.delete(u.lbl)
    for s in u.slices
        box.delete(s)

// Builds a fractional eBlock/iBlock zone from a candle's OHLC.
f_pushZone(array<RenderZone> arr, int zt, int zend, float ch, float cl, float co, float cc, bool isBull, color bg, string blockName, float volPct) =>
    float calc_top = zone_calc_basis == "High/Low" ? ch : math.max(co, cc)
    float calc_bot = zone_calc_basis == "High/Low" ? cl : math.min(co, cc)
    [z_top, z_bot] = f_zoneSlice(calc_top, calc_bot, isBull)
    arr.push(RenderZone.new(zt, zend, z_top, z_bot, (z_top + z_bot) / 2, bg, isBull, calc_top, calc_bot, blockName, volPct))

// ─── REAL-TIME URGENCY FAILURE DETECTION (ORIGINAL — untouched) ───
if show_tc
    if tc_bull_violated
        tc_bull_lvl := na
        tc_bull_violated := false
    if not na(tc_bull_lvl) and low <= tc_bull_lvl and not tc_bull_violated
        tc_bull_violated := true

    if tc_bear_violated
        tc_bear_lvl := na
        tc_bear_violated := false
    if not na(tc_bear_lvl) and high >= tc_bear_lvl and not tc_bear_violated
        tc_bear_violated := true

// ═══════════════════════════════════════════════════════════════════════════
// CONFIRMED STRUCTURE CANDLE — waterfall (Armor Rule 1): gap-confirm →
// evaluate breaks → resolve → assign this candle → lifetime sweeps.
// HTF in LTF: it runs once per CLOSED structure candle (bO / bH / bL / bC).
// ═══════════════════════════════════════════════════════════════════════════
if stepNow

    // GATE MEMORY — this candle's oscillator (only matters when a gate is on)
    if gateOn and not na(gHi) and not na(gLo)
        if gHi >= 80
            hitXP := true
            if mainSide == 1
                bullImp := true
            if mainSide == -1 and bearImp
                bearPb := true
        if gLo <= 20
            hitXD := true
            if mainSide == -1
                bearImp := true
            if mainSide == 1 and bullImp
                bullPb := true

    // MMM PRO EDGE GATE: the P# stays a small p until the leg reached its own
    // extreme and THEN the pullback reached the OPPOSITE extreme. A close past a
    // small p deletes it (no LD / SD). pConfBefore = the state before this candle.
    Node gPn = na
    if mainSide == 1
        gPn := beStatic
    else if mainSide == -1
        gPn := buStatic
    bool pConfBefore = f_isPConf(gPn)
    if gateOn and not na(gPn) and not pConfBefore and not na(gHi) and not na(gLo)
        if (mainSide == 1 and bullImp and gLo <= 20) or (mainSide == -1 and bearImp and gHi >= 80)
            pConfT := gPn.t
            pConfP := gPn.price
            // as in MMM Pro Edge: only an R formed AFTER the confirmation counts
            if primaryResumptionDone
                if mainSide == 1
                    buStatic := na
                else
                    beStatic := na
                primaryResumptionDone := false
                firstRShiftDone       := false

    // TWO-WAY CANDLE: a candle that opens beyond one side of the prior range
    // and CLOSES beyond the other side is ONE body close only — the close
    // decides. It never mints a bull node and a bear node at the same price.
    bool isBuX = bC > bH1 or (bO > bH1 and not (bC < bL1))
    bool isBeX = bC < bL1  or (bO < bL1  and not (bC > bH1))
    bool isNBC = not isBuX and not isBeX
    float curVolPct = bVp

    // usedAsDirectBreak lock — a candle that skipped a pending state and became
    // the new Tn directly must not ALSO be assigned to an MP/MC/MCR slot.
    bool buLockedThisBar = false
    bool beLockedThisBar = false

    float udg_min = min_udg_ticks * syminfo.mintick
    bool  bullUdg = (bL - bH2) >= udg_min and bC1 > bH2 and not (bL > bH1)
    bool  bearUdg = (bL2 - bH) >= udg_min and bC1 < bL2 and not (bH < bL1)

    // GAP CONFIRMATION (state machine): candle 2 is a GMC whenever a gap is
    // left between candle 1 and candle 3 — INCLUDING when candle 3 opens fully
    // beyond candle 2 (gap over gap), and when candle 2 only OPENED beyond
    // candle 1 and closed back inside. Candle 2 must be a body close (a node
    // only exists for a BuX / BeX candle). bullUdg / bearUdg above stay for
    // drawing the voids only (UDG vs UOG remain separate on the chart).
    bool  bullGapCf = (bL - bH2) >= udg_min
    bool  bearGapCf = (bL2 - bH) >= udg_min

    float bull_gap_top = math.min(bC, bO)
    float bull_gap_bot = math.max(bC1, bO1)
    bool  bull_ulg_now = bO>bC1 and bH1>bL and bC>bC1 and bO>bO1 and bH1<bull_gap_top
    bool  bull_uog_now = bL > bH1

    float bear_gap_top = math.min(bC1, bO1)
    float bear_gap_bot = math.max(bC, bO)
    bool  bear_ulg_now = bO<bC1 and bL1<bH and bC<bC1 and bO<bO1 and bL1>bear_gap_bot
    bool  bear_uog_now = bH < bL1

    // ─── MC ANTICIPATION TRACKING (ORIGINAL — untouched) ───
    if ant_bear_active and bC > ant_bear_price
        ant_bear_active := false
    if ant_bull_active and bC < ant_bull_price
        ant_bull_active := false

    if isBuX
        if ant_mode == "Last Active Only"
            ant_bear_active := false
        ant_bull_price  := bO
        ant_bull_t      := bT
        ant_bull_h      := bH
        ant_bull_l      := bL
        ant_bull_o      := bO
        ant_bull_c      := bC
        ant_bull_v      := curVolPct
        ant_bull_active := true
    if isBeX
        if ant_mode == "Last Active Only"
            ant_bull_active := false
        ant_bear_price  := bO
        ant_bear_t      := bT
        ant_bear_h      := bH
        ant_bear_l      := bL
        ant_bear_o      := bO
        ant_bear_c      := bC
        ant_bear_v      := curVolPct
        ant_bear_active := true

    // ─── URGENCY GAP ANTICIPATION (ORIGINAL — untouched) ───
    if show_tc
        if isBuX
            if tc_mode=="Last Active Only"
                tc_bear_lvl := na
                tc_bear_violated := false
            tc_bull_lvl  := bH1
            tc_bull_t    := nz(bT1, bT)
            tc_bull_violated := false
        if isBeX
            if tc_mode=="Last Active Only"
                tc_bull_lvl := na
                tc_bull_violated := false
            tc_bear_lvl  := bL1
            tc_bear_t    := nz(bT1, bT)
            tc_bear_violated := false

    // ═══════════════════════════════════════════════════════════════════════
    // STEP 1: gap-confirm. STATIC upgrades isGap in place (same entity).
    // DYNAMIC raw instead SPAWNS the separate gap slot (both must coexist).
    // Entry prices are computed here, at the moment a gap confirms — this is
    // the original script's UDG entry logic, re-homed onto the new Nodes.
    // Only the numbered P# / R# and the trend-phase GMC carry entries now;
    // internal dynamics never do.
    // ═══════════════════════════════════════════════════════════════════════
    // A gap confirms the MIDDLE candle of the three — the previous bar. Only the
    // node born of THAT candle is upgraded; an older, unrelated MC is never
    // promoted by a gap that isn't its own.
    int gapT = nz(bT1, bT)

    if bullGapCf
        if not na(buDynRaw) and buDynRaw.t == gapT and strictP and mainSide == -1 and not primaryPullbackDone
            // STRICT mode: this raw pullback just gap-confirmed — NOW it becomes
            // the numbered P# anchor, at its own candle's price and bar.
            buStatic := Node.new(price=buDynRaw.price, t=buDynRaw.t, isGap=true, isPrimary=true, c_high=buDynRaw.c_high, c_low=buDynRaw.c_low, c_open=buDynRaw.c_open, c_close=buDynRaw.c_close, c_time=buDynRaw.c_time, c_volPct=buDynRaw.c_volPct)
            primaryPullbackDone := true
            firstPShiftDone     := false
            if not na(ant_bull_price) and math.abs(ant_bull_price - buDynRaw.price) <= f_eps()
                ant_bull_active := false
            buDynRaw := na
            buDynGap := na
            alert_gmc_bull := true
        else if not na(buDynRaw) and buDynRaw.t == gapT
            buDynGap := Node.new(price=buDynRaw.price, t=buDynRaw.t, isGap=true, isPrimary=false, isPhase3Internal=buDynRaw.isPhase3Internal, c_high=buDynRaw.c_high, c_low=buDynRaw.c_low, c_open=buDynRaw.c_open, c_close=buDynRaw.c_close, c_time=buDynRaw.c_time, c_volPct=buDynRaw.c_volPct)
            // URGENCY -> EXTREME URGENCY is an UPGRADE of the same level, not a
            // second level. The MC that just became GMC is retired (and so is
            // its anticipation line at that price), so "MC & GMC" can never
            // stack. A fresh MC only appears on the next body-close candle.
            if not na(ant_bull_price) and math.abs(ant_bull_price - buDynRaw.price) <= f_eps()
                ant_bull_active := false
            buDynRaw := na
            alert_gmc_bull := true
        else if not na(buCtlRaw) and buCtlRaw.t == gapT
            // Trend-phase MC -> GMC (like replaces like: a newer GMC retires the old one)
            buCtlGap := Node.new(price=buCtlRaw.price, t=buCtlRaw.t, isGap=true, isPrimary=false, isPhase3Internal=false, c_high=buCtlRaw.c_high, c_low=buCtlRaw.c_low, c_open=buCtlRaw.c_open, c_close=buCtlRaw.c_close, c_time=buCtlRaw.c_time, c_volPct=buCtlRaw.c_volPct)
            if not na(ant_bull_price) and math.abs(ant_bull_price - buCtlRaw.price) <= f_eps()
                ant_bull_active := false
            buCtlRaw := na
            alert_gmc_bull := true
        else if not na(buStatic) and not buStatic.isGap and buStatic.t == gapT
            buStatic.isGap := true
            // Static anchor upgraded in place — retire the MC line at its level.
            if not na(ant_bull_price) and math.abs(ant_bull_price - buStatic.price) <= f_eps()
                ant_bull_active := false
            alert_gmc_bull := true

    if bearGapCf
        if not na(beDynRaw) and beDynRaw.t == gapT and strictP and mainSide == 1 and not primaryPullbackDone
            // Mirror of the bull side.
            beStatic := Node.new(price=beDynRaw.price, t=beDynRaw.t, isGap=true, isPrimary=true, c_high=beDynRaw.c_high, c_low=beDynRaw.c_low, c_open=beDynRaw.c_open, c_close=beDynRaw.c_close, c_time=beDynRaw.c_time, c_volPct=beDynRaw.c_volPct)
            primaryPullbackDone := true
            firstPShiftDone     := false
            if not na(ant_bear_price) and math.abs(ant_bear_price - beDynRaw.price) <= f_eps()
                ant_bear_active := false
            beDynRaw := na
            beDynGap := na
            alert_gmc_bear := true
        else if not na(beDynRaw) and beDynRaw.t == gapT
            beDynGap := Node.new(price=beDynRaw.price, t=beDynRaw.t, isGap=true, isPrimary=false, isPhase3Internal=beDynRaw.isPhase3Internal, c_high=beDynRaw.c_high, c_low=beDynRaw.c_low, c_open=beDynRaw.c_open, c_close=beDynRaw.c_close, c_time=beDynRaw.c_time, c_volPct=beDynRaw.c_volPct)
            // Mirror of the bull side: MC upgrades to GMC, never stacks beside it.
            if not na(ant_bear_price) and math.abs(ant_bear_price - beDynRaw.price) <= f_eps()
                ant_bear_active := false
            beDynRaw := na
            alert_gmc_bear := true
        else if not na(beCtlRaw) and beCtlRaw.t == gapT
            beCtlGap := Node.new(price=beCtlRaw.price, t=beCtlRaw.t, isGap=true, isPrimary=false, isPhase3Internal=false, c_high=beCtlRaw.c_high, c_low=beCtlRaw.c_low, c_open=beCtlRaw.c_open, c_close=beCtlRaw.c_close, c_time=beCtlRaw.c_time, c_volPct=beCtlRaw.c_volPct)
            if not na(ant_bear_price) and math.abs(ant_bear_price - beCtlRaw.price) <= f_eps()
                ant_bear_active := false
            beCtlRaw := na
            alert_gmc_bear := true
        else if not na(beStatic) and not beStatic.isGap and beStatic.t == gapT
            beStatic.isGap := true
            if not na(ant_bear_price) and math.abs(ant_bear_price - beStatic.price) <= f_eps()
                ant_bear_active := false
            alert_gmc_bear := true

    // ═══════════════════════════════════════════════════════════════════════
    // STEP 2: CDL / CDS — breaking ANY active gap-confirmed node.
    // Capitalization: Phase-1 trend GMC = UPPERCASE.
    // Pullback-role, Phase-3 internal and R# (resumption) breaks = lowercase.
    // ═══════════════════════════════════════════════════════════════════════
    bool beDynPullbackRole = mainSide == 1
    bool buDynPullbackRole = mainSide == -1

    bool cdlFromStatic   = not na(beStatic) and beStatic.isGap and bC > beStatic.price
    bool cdlFromDynamic  = not na(beDynGap) and bC > beDynGap.price
    bool cdlDynamicUpper = cdlFromDynamic and not beDynPullbackRole and not beDynGap.isPhase3Internal
    bool cdlFromCtl      = not na(beCtlGap) and bC > beCtlGap.price
    bool cdlFired = cdlFromStatic or cdlFromDynamic or cdlFromCtl

    bool cdsFromStatic   = not na(buStatic) and buStatic.isGap and bC < buStatic.price
    bool cdsFromDynamic  = not na(buDynGap) and bC < buDynGap.price
    bool cdsDynamicUpper = cdsFromDynamic and not buDynPullbackRole and not buDynGap.isPhase3Internal
    bool cdsFromCtl      = not na(buCtlGap) and bC < buCtlGap.price
    bool cdsFired = cdsFromStatic or cdsFromDynamic or cdsFromCtl

    bool   pendCdl      = false
    int    pendCdlT     = 0
    float  pendCdlPrice = na
    string pendCdlTxt   = ""
    bool   pendCdlMajor = false
    bool   pendCdlPb    = false
    bool   pendCdlSmall = false   // locked to small letters (R# or later internal GMC break)

    bool   pendCds      = false
    int    pendCdsT     = 0
    float  pendCdsPrice = na
    string pendCdsTxt   = ""
    bool   pendCdsMajor = false
    bool   pendCdsPb    = false
    bool   pendCdsSmall = false

    bool clearBeDynGap = false
    bool clearBuDynGap = false
    bool clearBeCtlGap = false
    bool clearBuCtlGap = false

    // A static node broken while holding the PULLBACK role IS the LD/SD event
    // by definition — its standalone CDL/CDS is suppressed to avoid overlap.
    bool cdlIsLdEvent = cdlFromStatic and mainSide == 1
    bool cdsIsSdEvent = cdsFromStatic and mainSide == -1

    // R# (RESUMPTION) BREAK: breaking GMCR# while the trend's PO4 is still
    // intact is only an INTERNAL small-letter cdl / cds — never a reversal.
    // If a NEWER with-trend GMC was printed after the R#, that newer (last)
    // GMC carries the small break, and the R# is just deleted with no marker.
    bool cdlStaticIsR    = cdlFromStatic and mainSide == -1
    bool cdlStaticSilent = cdlStaticIsR and not na(beDynGap) and beDynGap.t > beStatic.t
    bool cdsStaticIsR    = cdsFromStatic and mainSide == 1
    bool cdsStaticSilent = cdsStaticIsR and not na(buDynGap) and buDynGap.t > buStatic.t

    if cdlFromStatic and not cdlIsLdEvent and not cdlStaticSilent and not beStatic.shiftPrinted
        beStatic.shiftPrinted := true
        pendCdl      := true
        pendCdlT     := beStatic.t
        pendCdlPrice := beStatic.price
        pendCdlMajor := not cdlStaticIsR
        pendCdlTxt   := cdlStaticIsR ? "cdl" : "CDL"
        pendCdlPb    := false
        pendCdlSmall := cdlStaticIsR
    else if cdlFromCtl and not beCtlGap.shiftPrinted
        // Trend-phase GMC broken — the trend's own shift: CAPITAL.
        beCtlGap.shiftPrinted := true
        pendCdl      := true
        pendCdlT     := beCtlGap.t
        pendCdlPrice := beCtlGap.price
        pendCdlMajor := true
        pendCdlTxt   := "CDL"
        pendCdlPb    := false
        clearBeCtlGap := true
    else if cdlFromDynamic and not beDynGap.shiftPrinted
        beDynGap.shiftPrinted := true
        pendCdl      := true
        pendCdlT     := beDynGap.t
        pendCdlPrice := beDynGap.price
        pendCdlMajor := cdlDynamicUpper
        pendCdlTxt   := pendCdlMajor ? "CDL" : "cdl"
        pendCdlPb    := beDynPullbackRole
        pendCdlSmall := not beDynPullbackRole and beDynGap.isPhase3Internal
        clearBeDynGap := true

    if cdsFromStatic and not cdsIsSdEvent and not cdsStaticSilent and not buStatic.shiftPrinted
        buStatic.shiftPrinted := true
        pendCds      := true
        pendCdsT     := buStatic.t
        pendCdsPrice := buStatic.price
        pendCdsMajor := not cdsStaticIsR
        pendCdsTxt   := cdsStaticIsR ? "cds" : "CDS"
        pendCdsPb    := false
        pendCdsSmall := cdsStaticIsR
    else if cdsFromCtl and not buCtlGap.shiftPrinted
        buCtlGap.shiftPrinted := true
        pendCds      := true
        pendCdsT     := buCtlGap.t
        pendCdsPrice := buCtlGap.price
        pendCdsMajor := true
        pendCdsTxt   := "CDS"
        pendCdsPb    := false
        clearBuCtlGap := true
    else if cdsFromDynamic and not buDynGap.shiftPrinted
        buDynGap.shiftPrinted := true
        pendCds      := true
        pendCdsT     := buDynGap.t
        pendCdsPrice := buDynGap.price
        pendCdsMajor := cdsDynamicUpper
        pendCdsTxt   := pendCdsMajor ? "CDS" : "cds"
        pendCdsPb    := buDynPullbackRole
        pendCdsSmall := not buDynPullbackRole and buDynGap.isPhase3Internal
        clearBuDynGap := true

    // ── P# DELIVERY: did the pullback close past its P# candle's far edge?
    // (bull trend: a close below the BeX P# candle's low; bear trend: a close
    // above the BuX P# candle's high). Used by the Absorbed P# Filter. ──
    if mainSide == 1 and not na(beStatic) and not na(beStatic.c_low) and bC < beStatic.c_low
        beStatic.delivered := true
    if mainSide == -1 and not na(buStatic) and not na(buStatic.c_high) and bC > buStatic.c_high
        buStatic.delivered := true

    // ── STEP 3: LD / SD — breaking the STATIC pullback (range boundary).
    // NOTE: p1_validate_mode is purely a DISPLAY filter for pullback levels
    // (see the render block). It must never gate the state machine — a raw MP
    // still validates continuation exactly as before, and origins are never
    // affected by it.
    // ABSORBED P#: a raw P# taken back before it delivered and before any R#
    // locked is not a pullback — it is NOT an LD / SD (see the filter input).
    bool ldRaw = mainSide == 1  and not na(beStatic) and bC > beStatic.price
    bool sdRaw = mainSide == -1 and not na(buStatic) and bC < buStatic.price
    bool ldGateKill = ldRaw and gateOn and not pConfBefore
    bool sdGateKill = sdRaw and gateOn and not pConfBefore
    bool ldAbsorbed = (ldRaw and pb_absorb_filter and not beStatic.isGap and not beStatic.delivered and not primaryResumptionDone) or ldGateKill
    bool sdAbsorbed = (sdRaw and pb_absorb_filter and not buStatic.isGap and not buStatic.delivered and not primaryResumptionDone) or sdGateKill
    bool ldFired = ldRaw and not ldAbsorbed
    bool sdFired = sdRaw and not sdAbsorbed

    // ── STEP 4: Tn broken? ──
    bool tnBroken = not na(tnPrice) and ((mainSide == 1 and bC < tnPrice) or (mainSide == -1 and bC > tnPrice))

    // ── NBC FORCED PULLBACK detection — measured BEFORE Step 4b clears the
    // trend-phase MC / GMC. Trend phase only (no P# yet), NBC candle only. ──
    int  sideBefore  = mainSide
    bool nbcPbInBull = pb_nbc_forced and not strictP and isNBC and mainSide == 1  and not primaryPullbackDone and ((not na(buCtlRaw) and bC < buCtlRaw.price - f_eps()) or (not na(buCtlGap) and bC < buCtlGap.price))
    bool nbcPbInBear = pb_nbc_forced and not strictP and isNBC and mainSide == -1 and not primaryPullbackDone and ((not na(beCtlRaw) and bC > beCtlRaw.price + f_eps()) or (not na(beCtlGap) and bC > beCtlGap.price))

    // ═══════════════════════════════════════════════════════════════════════
    // RESOLUTION (Armor Rule 2) — strict priority:
    // Reversal > Continuation > Invalidation. Internal shifts handled above.
    // ═══════════════════════════════════════════════════════════════════════
    if tnBroken
        bool normalShiftAlso = mainSide == 1 ? cdsFired : cdlFired
        int  newSide = -mainSide
        // GATE: a flip is official only if the old leg reached its extreme.
        bool flipPass = true   // MMM Pro Edge: a flip is structure, never gated
        legOfficial := flipPass
        hitXD   := false
        hitXP   := false
        bullImp := false
        bullPb  := false
        bearImp := false
        bearPb  := false
        int  preTierR = curTier
        Node promoted = newSide == 1 ? buStatic : beStatic

        float newPrice = not na(promoted) ? promoted.price : bO
        int   newTime  = not na(promoted) ? promoted.t     : bT
        float nH = not na(promoted) ? promoted.c_high  : bH
        float nL = not na(promoted) ? promoted.c_low   : bL
        float nO = not na(promoted) ? promoted.c_open  : bO
        float nC = not na(promoted) ? promoted.c_close : bC
        int   nT = not na(promoted) ? promoted.c_time  : bT
        float nV = not na(promoted) ? promoted.c_volPct : curVolPct


        // FORCED T1: no P# to promote AND the breaking candle is not a body
        // close in the new direction (an NBC broke the old Tn) — or the P#
        // being promoted was itself an NBC Forced P#.
        bool tForced = na(promoted) ? not (newSide == 1 ? isBuX : isBeX) : promoted.isForced

        // Direct Reversal (9.2): P1 never existed to promote — THIS candle
        // skipped that state and became the new T1 directly. Lock it out of
        // Step 5 so it isn't also assigned as the new trend's MC/MCR.
        if na(promoted)
            if newSide == 1
                buLockedThisBar := true
            else
                beLockedThisBar := true

        bool   useCdl = mainSide == -1
        string causeText  = useCdl ? pendCdlTxt   : pendCdsTxt
        int    causeT     = useCdl ? pendCdlT     : pendCdsT
        float  causePrice = useCdl ? pendCdlPrice : pendCdsPrice
        bool   causeMajor = useCdl ? pendCdlMajor : pendCdsMajor
        bool   consumed   = useCdl ? pendCdl      : pendCds
        int    causeBreakT = bT
        if useCdl
            pendCdl := false
        else
            pendCds := false

        // Reversal wipes every node of the old range (below). Every small-letter
        // internal cds / cdl was married to one of those nodes, so it dies with
        // it — it is NEVER promoted to capital. The break that mattered (the
        // first, P#-married CDS / CDL) is already capital and is adopted by the
        // new T1 through the range memory.
        // Purge ON  -> small letters are cleared with the old range.
        // Purge OFF -> small letters stay on the chart as history, still in
        //              small letters (never promoted), each kept alive by its
        //              own guardian until price closes back through it.
        if purge_internal and shiftMarkers.size() > 0
            for smr = shiftMarkers.size() - 1 to 0
                if shiftMarkers.get(smr).isInternal
                    shiftMarkers.remove(smr)

        // GUARANTEED CAUSE (blueprint 9.2): if no shift fired on THIS bar, the
        // physical break of the old Tn level is itself the CDS/CDL. A Tn can
        // never end up without its married marker. tnPrice/tnTime still hold
        // the OLD Tn here — reassignment happens below.
        if not consumed
            bool hadRangeShift = useCdl ? not na(rngCdlPrice) : not na(rngCdsPrice)
            if hadRangeShift
                // A GMC existed and was already broken earlier in this range —
                // that shift IS this T1's cause. Adopt it; no new label at PO4.
                causeText   := str.upper(useCdl ? rngCdlTxt : rngCdsTxt)
                causeT      := useCdl ? rngCdlT      : rngCdsT
                causePrice  := useCdl ? rngCdlPrice  : rngCdsPrice
                causeBreakT := useCdl ? rngCdlBreakT : rngCdsBreakT
                causeMajor  := true
                // Remove its standalone copy so it's drawn once, on the T1.
                if shiftMarkers.size() > 0
                    for ai = shiftMarkers.size() - 1 to 0
                        ShiftMarker am = shiftMarkers.get(ai)
                        if am.side == newSide and am.ownerT == causeT and math.abs(am.price - causePrice) <= f_eps()
                            shiftMarkers.remove(ai)
            else
                // No GMC between Pn and Tn (rare 9.2 case): the PO4 break
                // itself is the CDL/CDS.
                causeText   := useCdl ? "CDL" : "CDS"
                causeT      := nz(tnTime, newTime)
                causePrice  := nz(tnPrice, newPrice)
                causeMajor  := true
                causeBreakT := bT

        mainSide := newSide
        curTier  := 1
        tnPrice  := newPrice
        tnTime   := newTime
        primaryPullbackDone   := false
        primaryResumptionDone := false

        POLine newPl = POLine.new(price=newPrice, t=newTime, side=newSide, tier=1, isDirect=not normalShiftAlso, causeText=causeText, causeT=causeT, causePrice=causePrice, causeMajor=causeMajor, causeBreakT=causeBreakT, isForced=tForced, c_high=nH, c_low=nL, c_open=nO, c_close=nC, c_time=nT, c_volPct=nV, official=flipPass, against=f_againstHtf(newSide))
        poLines.push(newPl)
        rngCdlT := na
        rngCdlPrice := na
        rngCdlTxt := ""
        rngCdlBreakT := na
        rngCdsT := na
        rngCdsPrice := na
        rngCdsTxt := ""
        rngCdsBreakT := na
        firstPShiftDone := false
        firstRShiftDone := false

        if flipPass
            if newSide == 1
                alert_po4_bull := true
                alert_cdl      := true
            else
                alert_po4_bear := true
                alert_cds      := true

        f_preserveHusbands(-newSide, preTierR)
        // CARRY-OVER ON REVERSAL: a gap-confirmed level on the NEWLY-WINNING
        // side is not a pullback any more — it is now the newest level of the
        // new trend's own direction. Deleting it would lose the last GMC, and a
        // later break of it (a CDL / CDS) would be missed entirely. So it moves
        // into the trend-phase slots instead of being wiped. Its raw partner
        // moves with it as the new MC.
        Node carryGap = newSide == 1 ? buDynGap : beDynGap
        Node carryRaw = newSide == 1 ? buDynRaw : beDynRaw

        buStatic := na
        beStatic := na
        buDynRaw := na
        buDynGap := na
        beDynRaw := na
        beDynGap := na
        buCtlRaw := na
        buCtlGap := na
        beCtlRaw := na
        beCtlGap := na

        if newSide == 1
            buCtlGap := carryGap
            buCtlRaw := carryRaw
        else
            beCtlGap := carryGap
            beCtlRaw := carryRaw


    else if ldFired or sdFired
        Node promoted       = mainSide == 1 ? buStatic : beStatic
        Node brokenPullback = mainSide == 1 ? beStatic : buStatic
        int  oldTier = curTier
        // GATE: a continuation is official only if the leg reached its own
        // extreme and THEN the pullback reached the opposite extreme.
        bool contPass = true   // gated before: a small p can never make an LD / SD
        legOfficial := contPass
        bullImp := false
        bullPb  := false
        bearImp := false
        bearPb  := false

        float newPrice = not na(promoted) ? promoted.price : bO
        int   newTime  = not na(promoted) ? promoted.t     : bT
        bool  wasDirect = na(promoted)
        float nH = not na(promoted) ? promoted.c_high  : bH
        float nL = not na(promoted) ? promoted.c_low   : bL
        float nO = not na(promoted) ? promoted.c_open  : bO
        float nC = not na(promoted) ? promoted.c_close : bC
        int   nT = not na(promoted) ? promoted.c_time  : bT
        float nV = not na(promoted) ? promoted.c_volPct : curVolPct

        // FORCED Tn: no R# to promote AND the breaking candle is not a body
        // close in the trend direction (an NBC delivered the LD / SD).
        bool tForced2 = wasDirect ? not (mainSide == 1 ? isBuX : isBeX) : promoted.isForced

        // Direct Continuation (9.1): R1 never existed to promote.
        if wasDirect
            if mainSide == 1
                buLockedThisBar := true
            else
                beLockedThisBar := true

        // "+" = Strong Break: the broken pullback was gap-confirmed (GMP#), so
        // this break also carried a structural shift. Raw MP# prints plain.
        string causeText = (mainSide == 1 ? "LD" : "SD") + str.tostring(oldTier) + (brokenPullback.isGap ? "+" : "")

        curTier += 1
        tnPrice := newPrice
        tnTime  := newTime
        primaryPullbackDone   := false
        primaryResumptionDone := false

        POLine newPl2 = POLine.new(price=newPrice, t=newTime, side=mainSide, tier=curTier, isDirect=wasDirect, causeText=causeText, causeT=brokenPullback.t, causePrice=brokenPullback.price, causeMajor=true, causeBreakT=bT, isForced=tForced2, c_high=nH, c_low=nL, c_open=nO, c_close=nC, c_time=nT, c_volPct=nV, official=contPass, against=f_againstHtf(mainSide))
        poLines.push(newPl2)
        rngCdlT := na
        rngCdlPrice := na
        rngCdlTxt := ""
        rngCdlBreakT := na
        rngCdsT := na
        rngCdsPrice := na
        rngCdsTxt := ""
        rngCdsBreakT := na
        firstPShiftDone := false
        firstRShiftDone := false

        if contPass
            if mainSide == 1
                alert_po4_bull := true
                alert_ld       := true
            else
                alert_po4_bear := true
                alert_sd       := true

        // Tn-Pn range resolved — optionally clear every lowercase internal
        // marker belonging to the range just closed.
        if purge_internal and shiftMarkers.size() > 0
            for smi = shiftMarkers.size() - 1 to 0
                if shiftMarkers.get(smi).isInternal
                    shiftMarkers.remove(smi)

        // The R# just became the new Tn (pushed above), so its first CDL / CDS
        // now stays married to that PO4 — no "BuX GMCR#" copy is kept beside it.
        f_preserveHusbands(mainSide, oldTier)
        buStatic := na
        beStatic := na
        buDynRaw := na
        buDynGap := na
        beDynRaw := na
        beDynGap := na
        buCtlRaw := na
        buCtlGap := na
        beCtlRaw := na
        beCtlGap := na

    else
        // ABSORBED P#: the pullback never delivered — erase P# and go back to
        // the trend phase. The next opposite BC can become the real P#.
        if ldAbsorbed
            beStatic := na
            primaryPullbackDone := false
            firstPShiftDone     := false
            // GATE: a small p closed through -> its small r goes with it (R needs a confirmed P#)
            if ldGateKill and primaryResumptionDone
                buStatic := na
                primaryResumptionDone := false
                firstRShiftDone       := false
        if sdAbsorbed
            buStatic := na
            primaryPullbackDone := false
            firstPShiftDone     := false
            if sdGateKill and primaryResumptionDone
                beStatic := na
                primaryResumptionDone := false
                firstRShiftDone       := false

        // PRIORITY 3 — MID-TREND INVALIDATION: the static Rn dies on a price
        // break regardless of gap status, reverting to Phase 2 (Pn survives).
        // ARMOR RULE 5: the gap-confirmed dynamic tracker is the sole monitor
        // for CDS/CDL and must NEVER be cleared here — only a real break, a
        // newer gap node, or a full range reset may clear it.
        bool rnFailedBull = mainSide == 1  and not na(buStatic) and bC < buStatic.price
        bool rnFailedBear = mainSide == -1 and not na(beStatic) and bC > beStatic.price

        // Only the failed Rn anchor dies here. The last active MC / GMC are
        // left alone: if this same candle actually broke them, Step 4b (MC)
        // and Step 2 (GMC -> CDS/CDL) already remove them; if it didn't, they
        // are still valid and must stay on the chart.
        if rnFailedBull
            buStatic := na
            primaryResumptionDone := false
            firstRShiftDone       := false

        if rnFailedBear
            beStatic := na
            primaryResumptionDone := false
            firstRShiftDone       := false

        // GENESIS — the very first trend this chart establishes.
        if mainSide == 0 and (cdlFired or cdsFired)
            int side = cdlFired ? 1 : -1
            bool gPass = true
            legOfficial := gPass
            hitXD   := false
            hitXP   := false
            bullImp := false
            bullPb  := false
            bearImp := false
            bearPb  := false
            bool   gUseCdl = side == 1
            string causeText  = gUseCdl ? pendCdlTxt   : pendCdsTxt
            int    causeT     = gUseCdl ? pendCdlT     : pendCdsT
            float  causePrice = gUseCdl ? pendCdlPrice : pendCdsPrice
            bool   causeMajor = gUseCdl ? pendCdlMajor : pendCdsMajor
            int    gCauseBreakT = bT
            bool   gConsumed = gUseCdl ? pendCdl : pendCds
            bool   gForced   = not (side == 1 ? isBuX : isBeX)
            if gUseCdl
                pendCdl := false
            else
                pendCds := false

            // Same guarantee as the reversal branch — genesis T1 always shows
            // the shift that established it.
            if not gConsumed
                causeText    := side == 1 ? "CDL" : "CDS"
                causeT       := bT
                causePrice   := bO
                causeMajor   := true
                gCauseBreakT := bT


            if side == 1
                buLockedThisBar := true
            else
                beLockedThisBar := true

            mainSide := side
            curTier  := 1
            tnPrice  := bO
            tnTime   := bT
            primaryPullbackDone   := false
            primaryResumptionDone := false

            POLine gPl = POLine.new(price=bO, t=bT, side=side, tier=1, isDirect=false, causeText=causeText, causeT=causeT, causePrice=causePrice, causeMajor=causeMajor, causeBreakT=gCauseBreakT, isForced=gForced, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct, official=gPass, against=f_againstHtf(side))
            poLines.push(gPl)
            rngCdlT := na
            rngCdlPrice := na
            rngCdlTxt := ""
            rngCdlBreakT := na
            rngCdsT := na
            rngCdsPrice := na
            rngCdsTxt := ""
            rngCdsBreakT := na
            firstPShiftDone := false
            firstRShiftDone := false

            if gPass
                if side == 1
                    alert_po4_bull := true
                    alert_cdl      := true
                else
                    alert_po4_bear := true
                    alert_cds      := true

            buStatic := na
            beStatic := na
            buDynRaw := na
            buDynGap := na
            beDynRaw := na
            beDynGap := na
            buCtlRaw := na
            buCtlGap := na
            beCtlRaw := na
            beCtlGap := na

    // ── STEP 4b: DYNAMIC NODE VIOLATION. A tracked MP/MC/MCR (raw or gap) is
    // deleted the moment price closes through it, replacement or not. Runs
    // BEFORE Step 5 so a node minted from THIS candle isn't killed by its own
    // close (e.g. a BuX qualifying on open > high[1] but closing red). ──
    if not na(buDynRaw) and bC < buDynRaw.price - f_eps()
        buDynRaw := na
    if not na(buDynGap) and bC < buDynGap.price - f_eps()
        buDynGap := na
    if not na(beDynRaw) and bC > beDynRaw.price + f_eps()
        beDynRaw := na
    if not na(beDynGap) and bC > beDynGap.price + f_eps()
        beDynGap := na
    if not na(buCtlRaw) and bC < buCtlRaw.price - f_eps()
        buCtlRaw := na
    if not na(buCtlGap) and bC < buCtlGap.price - f_eps()
        buCtlGap := na
    if not na(beCtlRaw) and bC > beCtlRaw.price + f_eps()
        beCtlRaw := na
    if not na(beCtlGap) and bC > beCtlGap.price + f_eps()
        beCtlGap := na

    // ═══════════════════════════════════════════════════════════════════════
    // STEP 5 (Armor Rules 1.4 / 4): assign THIS candle to tracking, only after
    // breaks are resolved. Runs regardless of an ordinary break — except the
    // direct-break carve-out above.
    // Entries: P# -> Pullback family, R# -> Continuation family, trend-phase
    // MC -> Trend family. Internal dynamics get no entry.
    // ═══════════════════════════════════════════════════════════════════════
    if isBuX and not buLockedThisBar
        bool pullbackRole = mainSide == -1
        if pullbackRole
            // STRICT mode: a raw MP never anchors P# — it waits in the raw slot
            // until a gap confirms it (see the gap-confirm step above).
            if not primaryPullbackDone and not strictP
                buStatic := Node.new(price=bO, t=bT, isGap=false, isPrimary=true, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)
                primaryPullbackDone := true
                firstPShiftDone := false   // new P# — its first shift is still to come
                // This candle IS the numbered anchor — retire any leftover
                // unnumbered dynamic so a stale copy can't sit beside it.
                buDynRaw := na
                buDynGap := na
            else
                buDynRaw := Node.new(price=bO, t=bT, isGap=false, isPrimary=false, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)
        else
            bool canLockStatic = primaryPullbackDone and not primaryResumptionDone
            if canLockStatic
                buStatic := Node.new(price=bO, t=bT, isGap=false, isPrimary=true, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)
                primaryResumptionDone := true
                firstRShiftDone       := false   // new R# — its first shift is still to come
                // Do NOT clear buDynRaw / buDynGap here. On the resumption side
                // those slots hold the LAST ACTIVE trend-phase MC / GMC, which
                // must stay on the chart until price actually breaks them (CDS)
                // or a newer one replaces them. Wiping them here is what erased
                // the last GMC the moment MCR# locked in.
            else if not primaryPullbackDone
                // TREND phase (no pullback yet): this is an MC -> its own slot,
                // so a later MCR / GMCR can never overwrite it.
                buCtlRaw := Node.new(price=bO, t=bT, isGap=false, isPrimary=false, isPhase3Internal=false, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)
            else
                buDynRaw := Node.new(price=bO, t=bT, isGap=false, isPrimary=false, isPhase3Internal=primaryResumptionDone, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)

    if isBeX and not beLockedThisBar
        bool pullbackRole = mainSide == 1
        if pullbackRole
            // STRICT mode: a raw MP never anchors P# — it waits in the raw slot
            // until a gap confirms it (see the gap-confirm step above).
            if not primaryPullbackDone and not strictP
                beStatic := Node.new(price=bO, t=bT, isGap=false, isPrimary=true, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)
                primaryPullbackDone := true
                firstPShiftDone := false   // new P# — its first shift is still to come
                beDynRaw := na
                beDynGap := na
            else
                beDynRaw := Node.new(price=bO, t=bT, isGap=false, isPrimary=false, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)
        else
            bool canLockStatic = primaryPullbackDone and not primaryResumptionDone
            if canLockStatic
                beStatic := Node.new(price=bO, t=bT, isGap=false, isPrimary=true, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)
                primaryResumptionDone := true
                firstRShiftDone       := false   // new R# — its first shift is still to come
                // Mirror of the bull side: keep the last active MC / GMC.
            else if not primaryPullbackDone
                // TREND phase (no pullback yet): this is an MC -> its own slot,
                // so a later MCR / GMCR can never overwrite it.
                beCtlRaw := Node.new(price=bO, t=bT, isGap=false, isPrimary=false, isPhase3Internal=false, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)
            else
                beDynRaw := Node.new(price=bO, t=bT, isGap=false, isPrimary=false, isPhase3Internal=primaryResumptionDone, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)

    // ── STEP 5a: NBC FORCED PULLBACK. An NBC closed through the last trend
    // body close with no opposite BC printed: its open becomes the P#
    // ("NBC Forced MP#"). Runs before 5b so a CDS / CDL fired by this same
    // candle is married to this P#. Skipped if the range changed this bar. ──
    if nbcPbInBull and mainSide == sideBefore and not primaryPullbackDone
        beStatic := Node.new(price=bO, t=bT, isGap=false, isPrimary=true, isForced=true, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)
        primaryPullbackDone := true
        firstPShiftDone     := false
        beDynRaw := na
        beDynGap := na
    if nbcPbInBear and mainSide == sideBefore and not primaryPullbackDone
        buStatic := Node.new(price=bO, t=bT, isGap=false, isPrimary=true, isForced=true, c_high=bH, c_low=bL, c_open=bO, c_close=bC, c_time=bT, c_volPct=curVolPct)
        primaryPullbackDone := true
        firstPShiftDone     := false
        buDynRaw := na
        buDynGap := na

    // ── STEP 5b: any pending shift marker NOT consumed by a Tn becomes a
    // standalone ShiftMarker, married to the guardian minted below. ──
    // PULLBACK-DIRECTION SHIFTS once this range's P# exists (bull trend: CDS
    // against a BeX P#; bear trend: CDL against a BuX P#):
    //   - the FIRST one = the pullback forced the break of the last GMC.
    //     Capital, and married to the P#: it lives as long as the P# lives.
    //   - every LATER one in the same range = internal. Small letters, and it
    //     keeps the normal Forced-guardian lifetime.
    //   - an R# break or a later internal GMC break is ALWAYS small letters —
    //     it is never promoted to the capital P#-married shift.
    // RESUMPTION-DIRECTION SHIFTS once this range's R# exists (bull trend: CDL
    // through the pullback's gmp; bear trend: CDS through the pullback's gmp):
    //   - the FIRST one = CAPITAL, married to the R# (GMCR# / MCR#). It lives
    //     as long as the R# does — and, after an LD / SD, as long as the new
    //     Tn the R# became.
    //   - every LATER one (made by the unnumbered GMCR / MCR) = small letters,
    //     internal, cleared when the range closes.
    bool cdsPMarried = false
    bool cdlPMarried = false
    bool cdsRMarried = false
    bool cdlRMarried = false
    if pendCds and mainSide == 1 and not na(beStatic)
        if pendCdsSmall
            pendCdsTxt   := "cds"
            pendCdsMajor := false
        else if not firstPShiftDone
            cdsPMarried     := true
            firstPShiftDone := true
            pendCdsTxt      := "CDS"
            pendCdsMajor    := true
        else
            pendCdsTxt   := "cds"
            pendCdsMajor := false
    if pendCdl and mainSide == -1 and not na(buStatic)
        if pendCdlSmall
            pendCdlTxt   := "cdl"
            pendCdlMajor := false
        else if not firstPShiftDone
            cdlPMarried     := true
            firstPShiftDone := true
            pendCdlTxt      := "CDL"
            pendCdlMajor    := true
        else
            pendCdlTxt   := "cdl"
            pendCdlMajor := false
    if pendCdl and mainSide == 1 and pendCdlPb and primaryResumptionDone and not na(buStatic)
        if not firstRShiftDone
            cdlRMarried     := true
            firstRShiftDone := true
            pendCdlTxt      := "CDL"
            pendCdlMajor    := true
        else
            pendCdlTxt   := "cdl"
            pendCdlMajor := false
    if pendCds and mainSide == -1 and pendCdsPb and primaryResumptionDone and not na(beStatic)
        if not firstRShiftDone
            cdsRMarried     := true
            firstRShiftDone := true
            pendCdsTxt      := "CDS"
            pendCdsMajor    := true
        else
            pendCdsTxt   := "cds"
            pendCdsMajor := false

    if pendCdl
        // Range memory keeps the FIRST shift (and always the P#-married one),
        // so a later reversal adopts the break that actually mattered.
        if na(rngCdlPrice) or cdlPMarried
            rngCdlT      := pendCdlT
            rngCdlPrice  := pendCdlPrice
            rngCdlTxt    := pendCdlTxt
            rngCdlBreakT := bT
        int   gT = bT
        float gP = bO
        if cdlPMarried or cdlRMarried
            gT := buStatic.t
            gP := buStatic.price
        shiftMarkers.push(ShiftMarker.new(price=pendCdlPrice, ownerT=pendCdlT, breakT=bT, markerTxt=pendCdlTxt, side=1, isInternal=not pendCdlMajor, fromPullback=pendCdlPb, guardianT=gT, guardianPrice=gP, pMarried=cdlPMarried))
    if pendCds
        if na(rngCdsPrice) or cdsPMarried
            rngCdsT      := pendCdsT
            rngCdsPrice  := pendCdsPrice
            rngCdsTxt    := pendCdsTxt
            rngCdsBreakT := bT
        int   gT2 = bT
        float gP2 = bO
        if cdsPMarried or cdsRMarried
            gT2 := beStatic.t
            gP2 := beStatic.price
        shiftMarkers.push(ShiftMarker.new(price=pendCdsPrice, ownerT=pendCdsT, breakT=bT, markerTxt=pendCdsTxt, side=-1, isInternal=not pendCdsMajor, fromPullback=pendCdsPb, guardianT=gT2, guardianPrice=gP2, pMarried=cdsPMarried))

    // FORCED GUARDIANS: every break mints its own guardian at the breaking
    // candle's open. This is what the CDS/CDL is married to — it survives the
    // churn of the shared slots, and the marker dies only when price closes
    // back through this break candle's own open.
    // The label names the candle that actually did the break: an NBC break
    // prints "NBC Forced ...", never "BuX / BeX Forced ...".
    // P#-married and R#-married markers already have their husband — no guardian.
    bool needCdlGuard = pendCdl and not cdlPMarried and not cdlRMarried
    bool needCdsGuard = pendCds and not cdsPMarried and not cdsRMarried
    if (needCdlGuard or needCdsGuard) and not f_nodeExistsAt(bT, bO)
        int fSide = needCdlGuard ? 1 : -1
        bool fPullbackRole = fSide == 1 ? (mainSide == -1) : (mainSide == 1)
        string fType = fPullbackRole ? "MP" : (primaryPullbackDone ? "MCR" : "MC")
        bool   fInDirBC = fSide == 1 ? isBuX : isBeX
        string fCandle  = fInDirBC ? (fSide == 1 ? "BuX" : "BeX") : isNBC ? "NBC" : (fSide == 1 ? "BeX" : "BuX")
        string fLbl = fCandle + " Forced " + fType
        // LIKE REPLACES LIKE: retire any existing guardian of the same side
        // and role first; its married marker is swept below.
        if forcedNodes.size() > 0
            for fri = forcedNodes.size() - 1 to 0
                ForcedNode fr = forcedNodes.get(fri)
                if fr.side == fSide and str.endswith(fr.lbl, " Forced " + fType)
                    forcedNodes.remove(fri)
        forcedNodes.push(ForcedNode.new(price=bO, t=bT, side=fSide, lbl=fLbl))

    // A broken gap node is replaced by its marker — drop it so its own
    // forward-extending line and label stop rendering.
    if clearBeDynGap
        beDynGap := na
    if clearBuDynGap
        buDynGap := na
    if clearBeCtlGap
        beCtlGap := na
    if clearBuCtlGap
        buCtlGap := na

    // ── STEP 5c: MEMORY GUARD. Pine retains every array element for the whole
    // history; without a cap these grow until "Memory limits exceeded" kills
    // the script mid-run, which silently stops ALL drawing. Storage cap only —
    // nothing here reflects a structural violation. ──
    while poLines.size() > max_history
        poLines.remove(0)
    while shiftMarkers.size() > max_history
        shiftMarkers.remove(0)
    while forcedNodes.size() > max_history
        forcedNodes.remove(0)

    // ── STEP 5d: Forced guardians die on violation, like any real node. ──
    if forcedNodes.size() > 0
        for fi = forcedNodes.size() - 1 to 0
            ForcedNode fn = forcedNodes.get(fi)
            if (fn.side == 1 and bC < fn.price - f_eps()) or (fn.side == -1 and bC > fn.price + f_eps())
                forcedNodes.remove(fi)

    // ── STEP 5e: MARKER LIFETIME SWEEP (Husband & Wife for CDS/CDL). Runs
    // after Step 5 so a marker created this bar always finds its guardian.
    // Any marker whose guardian is gone dies with it. An R#-married marker's
    // guardian is the R# itself — and after an LD / SD, the Tn the R# became. ──
    if shiftMarkers.size() > 0
        for smi2 = shiftMarkers.size() - 1 to 0
            ShiftMarker sm2 = shiftMarkers.get(smi2)
            bool alive = sm2.pMarried ? f_pAnchorAlive(sm2) : (f_nodeExistsAt(sm2.guardianT, sm2.guardianPrice) or f_poLineAt(sm2.guardianT, sm2.guardianPrice))
            if not alive
                shiftMarkers.remove(smi2)

    // ── STEP 5f: a Forced guardian exists ONLY to keep its CDS / CDL alive.
    // Once no marker references it any more, it is an orphan — remove it, so
    // a husband never stands on the chart without his wife. ──
    if forcedNodes.size() > 0
        for fo = forcedNodes.size() - 1 to 0
            ForcedNode fnO = forcedNodes.get(fo)
            bool guardsSomething = false
            if shiftMarkers.size() > 0
                for smO in shiftMarkers
                    if not smO.pMarried and smO.guardianT == fnO.t and math.abs(smO.guardianPrice - fnO.price) <= f_eps()
                        guardsSomething := true
            if not guardsSomething
                forcedNodes.remove(fo)

    // MMM PRO EDGE GATE: the R# stays a small r until a CDL (bull) / CDS (bear)
    // prints while it is alive, with the P# already confirmed.
    if gateOn and primaryResumptionDone
        Node gRn = na
        Node gPc = na
        if mainSide == 1
            gRn := buStatic
            gPc := beStatic
        else if mainSide == -1
            gRn := beStatic
            gPc := buStatic
        if not na(gRn) and not f_isRConf(gRn) and f_isPConf(gPc) and (mainSide == 1 ? cdlFired : cdsFired)
            rConfT := gRn.t
            rConfP := gRn.price

    // ── STEP 6: Husband & Wife — delete any Tn individually violated. Its
    // cause marker dies with it automatically (fields on the same record). ──
    if poLines.size() > 0
        for i = poLines.size() - 1 to 0
            POLine pl = poLines.get(i)
            if (pl.side == 1 and bC < pl.price - f_eps()) or (pl.side == -1 and bC > pl.price + f_eps())
                poLines.remove(i)
            else
                if not pl.po4_touched
                    if (pl.side == 1 and bL <= pl.price) or (pl.side == -1 and bH >= pl.price)
                        pl.po4_touched  := true
                        pl.po4_freeze_t := bT


// ═══════════════════════════════════════════════════════════════════════════
// STRUCTURAL VOIDS — chart timeframe, closed candles (not part of the
// structure, so they stay on your chart candles).
// ═══════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed
    float udg_min = min_udg_ticks * syminfo.mintick
    bool  bullUdg = (low - high[2]) >= udg_min and close[1] > high[2] and not (low > high[1])
    bool  bearUdg = (low[2] - high) >= udg_min and close[1] < low[2] and not (high < low[1])
    float bull_gap_top = math.min(close, open)
    float bull_gap_bot = math.max(close[1], open[1])
    bool  bull_ulg_now = open>close[1] and high[1]>low and close>close[1] and open>open[1] and high[1]<bull_gap_top
    bool  bull_uog_now = low > high[1]
    float bear_gap_top = math.min(close[1], open[1])
    float bear_gap_bot = math.max(close, open)
    bool  bear_ulg_now = open<close[1] and low[1]<high and close<close[1] and open<open[1] and low[1]>bear_gap_bot
    bool  bear_uog_now = high < low[1]

    // ═══════════════════════════════════════════════════════════════════════
    // STRUCTURAL VOIDS ENGINE (ORIGINAL — untouched)
    // ═══════════════════════════════════════════════════════════════════════
    color grey_box  = color.new(#636363,85)
    color grey_line = color.new(#636363,60)
    if visual_gaps.size() > 0
        for i = visual_gaps.size()-1 to 0
            GapBox u = visual_gaps.get(i)
            bool isFilled     = false
            bool newlyTouched = false
            bool isSlicedLoop = gapExtMode=="Filled & Unfilled (Sliced)"
            if bar_index >= u.creationBar
                if u.isBull
                    if low<=u.top and not u.isTouched
                        u.isTouched  := true
                        newlyTouched := true
                    if low<=u.bot
                        isFilled := true
                    if not u.stoppedExtending and not isSlicedLoop and not na(u.mid) and low<=u.mid
                        u.stoppedExtending := true
                        u.greyed := true
                        if u.gType=="ULG"
                            box.set_border_color(u.b, grey_line)
                        else
                            box.set_bgcolor(u.b, grey_box)
                        if not na(u.l)
                            line.set_color(u.l, grey_line)
                        if not na(u.lbl)
                            label.set_textcolor(u.lbl, color.new(gap_lbl_col,70))
                else
                    if high>=u.bot and not u.isTouched
                        u.isTouched  := true
                        newlyTouched := true
                    if high>=u.top
                        isFilled := true
                    if not u.stoppedExtending and not isSlicedLoop and not na(u.mid) and high>=u.mid
                        u.stoppedExtending := true
                        u.greyed := true
                        if u.gType=="ULG"
                            box.set_border_color(u.b, grey_line)
                        else
                            box.set_bgcolor(u.b, grey_box)
                        if not na(u.l)
                            line.set_color(u.l, grey_line)
                        if not na(u.lbl)
                            label.set_textcolor(u.lbl, color.new(gap_lbl_col,70))
            if newlyTouched and not isSlicedLoop
                if not u.stoppedExtending
                    u.dim := true
                    if u.gType=="ULG"
                        box.set_border_color(u.b, color.new(u.origBorder,80))
                    else
                        box.set_bgcolor(u.b, color.new(u.origBg,85))
                    if not na(u.l)
                        line.set_color(u.l, color.new(u.origLine,80))
                    if not na(u.lbl)
                        label.set_textcolor(u.lbl, color.new(u.origLblText,70))
                if gapExtMode=="Until First Touch"
                    u.stoppedExtending := true
            if isSlicedLoop and not isFilled and u.slices.size()>0
                for j=0 to u.slices.size()-1
                    if not u.sliceTouched.get(j)
                        box sBox = u.slices.get(j)
                        if high>=box.get_bottom(sBox) and low<=box.get_top(sBox)
                            box.set_bgcolor(sBox, col_partial)
                            box.set_border_color(sBox, na)
                            u.sliceTouched.set(j, true)
                            box.set_right(sBox, bar_index)
            if hide_filled and isFilled
                u.erase()
                visual_gaps.remove(i)
            else if not isFilled
                if isSlicedLoop and u.slices.size()>0
                    for j=0 to u.slices.size()-1
                        if not u.sliceTouched.get(j)
                            box.set_right(u.slices.get(j), bar_index+1)
                    if not na(u.l)
                        line.set_x2(u.l, bar_index+1)
                else if not u.stoppedExtending
                    box.set_right(u.b, bar_index+1)
                    if not na(u.l)
                        line.set_x2(u.l, bar_index+1)
                    if not na(u.lbl) and gap_lbl_side=="Right"
                        label.set_x(u.lbl, bar_index+1)

    bool isMini   = gapExtMode=="Minimalistic"
    bool isSliced = gapExtMode=="Filled & Unfilled (Sliced)"
    int  upg_right = isMini ? bar_index+mini_len : bar_index+1
    int  gap_lbl_x = gap_lbl_side=="Right" ? upg_right : bar_index-1

    if show_vi and show_all_gaps and bull_ulg_now
        int le = bar_index-1
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x,math.avg(bull_gap_top,bull_gap_bot),"ULG+",color=color.new(color.white,100),textcolor=gap_lbl_col,style=label.style_none,size=size.tiny) : label(na)
        box bx_g  = isSliced ? box.new(le,bull_gap_top,upg_right,bull_gap_bot,border_color=na,bgcolor=color.new(bull_vi_css,100)) : box.new(le,bull_gap_top,upg_right,bull_gap_bot,border_color=bull_vi_css,bgcolor=na,border_style=line.style_dotted)
        line ln_g  = show_midlines ? line.new(le,math.avg(bull_gap_top,bull_gap_bot),upg_right,math.avg(bull_gap_top,bull_gap_bot),color=color.new(bull_vi_css,0),style=line.style_dotted,width=1) : line(na)
        box[] sl_g  = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp,tch_tmp] = f_buildSlices(bull_gap_top,bull_gap_bot,color.new(bull_vi_css,60),le,upg_right)
            sl_g  := sl_tmp
            tch_g  := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=bull_gap_top, bot=bull_gap_bot, isBull=true, gType="ULG", isTouched=false, stoppedExtending=isMini, origBg=color(na), origBorder=bull_vi_css, origLine=color.new(bull_vi_css,0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(bull_gap_top,bull_gap_bot), slices=sl_g, sliceTouched=tch_g))

    if show_og and show_all_gaps and bull_uog_now
        int le = bar_index-1
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x,math.avg(low,high[1]),"UOG+",color=color.new(color.white,100),textcolor=gap_lbl_col,style=label.style_none,size=size.tiny) : label(na)
        box bx_g  = isSliced ? box.new(le,low,upg_right,high[1],border_color=na,bgcolor=color.new(bull_og_css,100)) : box.new(le,low,upg_right,high[1],border_color=na,bgcolor=bull_og_css)
        line ln_g  = show_midlines ? line.new(le,math.avg(low,high[1]),upg_right,math.avg(low,high[1]),color=color.new(bull_og_css,0),style=line.style_dotted,width=1) : line(na)
        box[] sl_g  = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp,tch_tmp] = f_buildSlices(low,high[1],bull_og_css,le,upg_right)
            sl_g  := sl_tmp
            tch_g  := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=low, bot=high[1], isBull=true, gType="UOG", isTouched=false, stoppedExtending=isMini, origBg=bull_og_css, origBorder=color(na), origLine=color.new(bull_og_css,0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(low,high[1]), slices=sl_g, sliceTouched=tch_g))

    if show_upg and show_all_gaps and bullUdg
        int le = bar_index-2
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x,math.avg(low,high[2]),"UDG+",color=color.new(color.white,100),textcolor=gap_lbl_col,style=label.style_none,size=size.tiny) : label(na)
        box bx_g  = isSliced ? box.new(le,low,upg_right,high[2],border_color=na,bgcolor=color.new(bull_upg_css,100)) : box.new(le,low,upg_right,high[2],border_color=na,bgcolor=bull_upg_css)
        line ln_g  = show_midlines ? line.new(le,math.avg(low,high[2]),upg_right,math.avg(low,high[2]),color=color.new(bull_upg_css,0),style=line.style_dotted,width=1) : line(na)
        box[] sl_g  = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp,tch_tmp] = f_buildSlices(low,high[2],bull_upg_css,le,upg_right)
            sl_g  := sl_tmp
            tch_g  := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=low, bot=high[2], isBull=true, gType="UDG", isTouched=false, stoppedExtending=isMini, origBg=bull_upg_css, origBorder=color(na), origLine=color.new(bull_upg_css,0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(low,high[2]), slices=sl_g, sliceTouched=tch_g))

    if show_vi and show_all_gaps and bear_ulg_now
        int le = bar_index-1
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x,math.avg(bear_gap_top,bear_gap_bot),"ULG-",color=color.new(color.white,100),textcolor=gap_lbl_col,style=label.style_none,size=size.tiny) : label(na)
        box bx_g  = isSliced ? box.new(le,bear_gap_top,upg_right,bear_gap_bot,border_color=na,bgcolor=color.new(bear_vi_css,100)) : box.new(le,bear_gap_top,upg_right,bear_gap_bot,border_color=bear_vi_css,bgcolor=na,border_style=line.style_dotted)
        line ln_g  = show_midlines ? line.new(le,math.avg(bear_gap_top,bear_gap_bot),upg_right,math.avg(bear_gap_top,bear_gap_bot),color=color.new(bear_vi_css,0),style=line.style_dotted,width=1) : line(na)
        box[] sl_g  = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp,tch_tmp] = f_buildSlices(bear_gap_top,bear_gap_bot,color.new(bear_vi_css,60),le,upg_right)
            sl_g  := sl_tmp
            tch_g  := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=bear_gap_top, bot=bear_gap_bot, isBull=false, gType="ULG", isTouched=false, stoppedExtending=isMini, origBg=color(na), origBorder=bear_vi_css, origLine=color.new(bear_vi_css,0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(bear_gap_top,bear_gap_bot), slices=sl_g, sliceTouched=tch_g))

    if show_og and show_all_gaps and bear_uog_now
        int le = bar_index-1
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x,math.avg(low[1],high),"UOG-",color=color.new(color.white,100),textcolor=gap_lbl_col,style=label.style_none,size=size.tiny) : label(na)
        box bx_g  = isSliced ? box.new(le,low[1],upg_right,high,border_color=na,bgcolor=color.new(bear_og_css,100)) : box.new(le,low[1],upg_right,high,border_color=na,bgcolor=bear_og_css)
        line ln_g  = show_midlines ? line.new(le,math.avg(low[1],high),upg_right,math.avg(low[1],high),color=color.new(bear_og_css,0),style=line.style_dotted,width=1) : line(na)
        box[] sl_g  = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp,tch_tmp] = f_buildSlices(low[1],high,bear_og_css,le,upg_right)
            sl_g  := sl_tmp
            tch_g  := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=low[1], bot=high, isBull=false, gType="UOG", isTouched=false, stoppedExtending=isMini, origBg=bear_og_css, origBorder=color(na), origLine=color.new(bear_og_css,0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(low[1],high), slices=sl_g, sliceTouched=tch_g))

    if show_upg and show_all_gaps and bearUdg
        int le = bar_index-2
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x,math.avg(low[2],high),"UDG-",color=color.new(color.white,100),textcolor=gap_lbl_col,style=label.style_none,size=size.tiny) : label(na)
        box bx_g  = isSliced ? box.new(le,low[2],upg_right,high,border_color=na,bgcolor=color.new(bear_upg_css,100)) : box.new(le,low[2],upg_right,high,border_color=na,bgcolor=bear_upg_css)
        line ln_g  = show_midlines ? line.new(le,math.avg(low[2],high),upg_right,math.avg(low[2],high),color=color.new(bear_upg_css,0),style=line.style_dotted,width=1) : line(na)
        box[] sl_g  = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp,tch_tmp] = f_buildSlices(low[2],high,bear_upg_css,le,upg_right)
            sl_g  := sl_tmp
            tch_g  := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=low[2], bot=high, isBull=false, gType="UDG", isTouched=false, stoppedExtending=isMini, origBg=bear_upg_css, origBorder=color(na), origLine=color.new(bear_upg_css,0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(low[2],high), slices=sl_g, sliceTouched=tch_g))

    if limit_gaps
        while visual_gaps.size() > maxGaps
            visual_gaps.get(0).erase()
            visual_gaps.remove(0)

// ═══════════════════════════════════════════════════════════════
// BC FLOW STATS (chart timeframe) + VOLATILITY STOP (S6) IN POINTS
//  run          = BCs in one direction until the first opposite BC
//  pure run     = BCs in a row with NO NBC between
//  flip         = an opposite BC · continuation = a same-side BC after an NBC pause
// Index 0 = bull runs, 1 = bear runs.
// ═══════════════════════════════════════════════════════════════
var int stDir   = 0
var int stPure  = 0
var int stRun   = 0
var int stNbc   = 0
var int stConts = 0
var array<float> stPureFlipS = array.from(0.0, 0.0)
var array<int>   stPureFlipN = array.from(0, 0)
var array<float> stPureNbcS  = array.from(0.0, 0.0)
var array<int>   stPureNbcN  = array.from(0, 0)
var array<float> stRunS      = array.from(0.0, 0.0)
var array<int>   stRunN      = array.from(0, 0)
var array<float> stNbcFlipS  = array.from(0.0, 0.0)
var array<int>   stNbcFlipN  = array.from(0, 0)
var array<float> stNbcContS  = array.from(0.0, 0.0)
var array<int>   stNbcContN  = array.from(0, 0)
var array<float> stContS     = array.from(0.0, 0.0)
var array<int>   stImmFlip   = array.from(0, 0)

f_stAdd(array<float> s, array<int> n, int k, float v) =>
    s.set(k, s.get(k) + v)
    n.set(k, n.get(k) + 1)

if barstate.isconfirmed and bar_index > 0
    int sd = close > high[1] ? 1 : close < low[1] ? -1 : 0
    int sk = stDir == 1 ? 0 : 1
    if sd == 0
        if stDir != 0
            if stNbc == 0 and stPure > 0
                f_stAdd(stPureNbcS, stPureNbcN, sk, stPure)
            stNbc  += 1
            stPure := 0
    else if stDir == 0
        stDir   := sd
        stPure  := 1
        stRun   := 1
        stNbc   := 0
        stConts := 0
    else if sd == stDir
        if stNbc > 0
            f_stAdd(stNbcContS, stNbcContN, sk, stNbc)
            stConts += 1
            stPure  := 1
        else
            stPure += 1
        stRun += 1
        stNbc := 0
    else
        if stNbc == 0
            f_stAdd(stPureFlipS, stPureFlipN, sk, stPure)
            stImmFlip.set(sk, stImmFlip.get(sk) + 1)
        f_stAdd(stRunS, stRunN, sk, stRun)
        f_stAdd(stNbcFlipS, stNbcFlipN, sk, stNbc)
        stContS.set(sk, stContS.get(sk) + stConts)
        stDir   := sd
        stPure  := 1
        stRun   := 1
        stNbc   := 0
        stConts := 0

float stAtrV  = ta.atr(st_atr)
float stFixV  = st_fix > 0 ? st_fix : str.contains(syminfo.root, "NQ") ? 50.0 : str.contains(syminfo.root, "ES") ? 20.0 : na

f_stAvg(array<float> s, array<int> n, int k) =>
    n.get(k) > 0 ? str.tostring(s.get(k) / n.get(k), "#.##") + "  (" + str.tostring(n.get(k)) + ")" : "—"

f_stPos(string p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

var table stHelp = table.new(f_stPos(st_hpos), 1, 1, bgcolor=#000000, frame_color=color.new(color.white, 70), frame_width=1)
var table stTbl = table.new(f_stPos(st_pos), 3, 14, bgcolor=#000000, frame_color=color.new(color.white, 70), frame_width=1, border_color=color.new(color.white, 85), border_width=1)
if barstate.islast and st_on
    string sz = st_sz == "Tiny" ? size.tiny : st_sz == "Normal" ? size.normal : size.small
    color  hd = #e1b31a
    color  wt = color.white
    color  bu = #27ffc3
    color  be = #c77dff
    table.cell(stTbl, 0, 0, "MMM BC FLOW · " + f_tfName(timeframe.period), text_color=hd, text_size=sz)
    table.cell(stTbl, 1, 0, "BULL runs", text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 0, "BEAR runs", text_color=be, text_size=sz)
    table.cell(stTbl, 0, 1, "Pure run → opposite BC: avg BCs (n)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 1, f_stAvg(stPureFlipS, stPureFlipN, 0), text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 1, f_stAvg(stPureFlipS, stPureFlipN, 1), text_color=be, text_size=sz)
    table.cell(stTbl, 0, 2, "Pure run → first NBC: avg BCs (n)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 2, f_stAvg(stPureNbcS, stPureNbcN, 0), text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 2, f_stAvg(stPureNbcS, stPureNbcN, 1), text_color=be, text_size=sz)
    table.cell(stTbl, 0, 3, "Run with NBC pauses → flip: avg BCs (n)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 3, f_stAvg(stRunS, stRunN, 0), text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 3, f_stAvg(stRunS, stRunN, 1), text_color=be, text_size=sz)
    table.cell(stTbl, 0, 4, "NBCs before a FLIP: avg (n)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 4, f_stAvg(stNbcFlipS, stNbcFlipN, 0), text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 4, f_stAvg(stNbcFlipS, stNbcFlipN, 1), text_color=be, text_size=sz)
    table.cell(stTbl, 0, 5, "NBCs before a CONTINUATION: avg (n)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 5, f_stAvg(stNbcContS, stNbcContN, 0), text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 5, f_stAvg(stNbcContS, stNbcContN, 1), text_color=be, text_size=sz)
    table.cell(stTbl, 0, 6, "Continuations per run: avg", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 6, stRunN.get(0) > 0 ? str.tostring(stContS.get(0) / stRunN.get(0), "#.##") : "—", text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 6, stRunN.get(1) > 0 ? str.tostring(stContS.get(1) / stRunN.get(1), "#.##") : "—", text_color=be, text_size=sz)
    table.cell(stTbl, 0, 7, "Flip straight after a BC (no NBC): %", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 7, stRunN.get(0) > 0 ? str.tostring(stImmFlip.get(0) * 100.0 / stRunN.get(0), "#.#") + "%" : "—", text_color=bu, text_size=sz)
    table.cell(stTbl, 2, 7, stRunN.get(1) > 0 ? str.tostring(stImmFlip.get(1) * 100.0 / stRunN.get(1), "#.#") + "%" : "—", text_color=be, text_size=sz)
    table.cell(stTbl, 0, 8, "ATR(" + str.tostring(st_atr) + ") = average candle range, pts", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 8, str.tostring(stAtrV, format.mintick), text_color=wt, text_size=sz)
    table.merge_cells(stTbl, 1, 8, 2, 8)
    table.cell(stTbl, 0, 9, "S6 volatility stop 1.0 / 1.5 / 2.0 × ATR, pts", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 9, str.tostring(stAtrV, "#.##") + " / " + str.tostring(stAtrV * 1.5, "#.##") + " / " + str.tostring(stAtrV * 2.0, "#.##"), text_color=color.orange, text_size=sz)
    table.merge_cells(stTbl, 1, 9, 2, 9)
    table.cell(stTbl, 0, 10, "S0 fixed stop, pts (1:2 target)", text_color=wt, text_size=sz, text_halign=text.align_left)
    table.cell(stTbl, 1, 10, na(stFixV) ? "set it in the inputs" : str.tostring(stFixV, "#.##") + "  →  TP " + str.tostring(stFixV * 2, "#.##"), text_color=color.orange, text_size=sz)
    table.merge_cells(stTbl, 1, 10, 2, 10)
if barstate.islast and st_help
    table.cell(stHelp, 0, 0, "BC FLOW — Run = BCs one way until the first opposite BC · Pure = no NBC between · Flip = opposite BC · Continuation = same-side BC after an NBC pause · (n) = how many counted · S6 = ATR stop · S0 = fixed stop", text_color=color.silver, text_size=size.tiny, text_halign=text.align_left)

// ═══════════════════════════════════════════════════════════════
// XD / XP LABELS (MMM Pro Edge) — gate on only, read on the STRUCTURE candle.
// XD = oscillator <= 20 (Extreme Discount) at the candle low · XP = >= 80 at
// the high. A live label follows the extreme while the oscillator stays in the
// zone; once it left the zone, a close through the label deletes it.
// ═══════════════════════════════════════════════════════════════
type XdxpMark
    float price
    int   t
    int   side
    bool  live

var array<XdxpMark> xdxpArr = array.new<XdxpMark>()

if stepNow and gateOn and not na(gHi) and not na(gLo)
    XdxpMark xdLastD = na
    XdxpMark xdLastP = na
    if xdxpArr.size() > 0
        for xm in xdxpArr
            if xm.side == 1 and xm.live
                xdLastD := xm
            if xm.side == -1 and xm.live
                xdLastP := xm
    if gLo <= 20
        if not na(xdLastD)
            if bL < xdLastD.price
                xdLastD.price := bL
                xdLastD.t     := bT
        else
            xdxpArr.push(XdxpMark.new(bL, bT, 1, true))
    else if not na(xdLastD)
        xdLastD.live := false
    if gHi >= 80
        if not na(xdLastP)
            if bH > xdLastP.price
                xdLastP.price := bH
                xdLastP.t     := bT
        else
            xdxpArr.push(XdxpMark.new(bH, bT, -1, true))
    else if not na(xdLastP)
        xdLastP.live := false
    if xdxpArr.size() > 0
        for i = xdxpArr.size() - 1 to 0
            XdxpMark xm = xdxpArr.get(i)
            if not xm.live and ((xm.side == 1 and bC < xm.price - syminfo.mintick * 0.5) or (xm.side == -1 and bC > xm.price + syminfo.mintick * 0.5))
                xdxpArr.remove(i)
    while xdxpArr.size() > 30
        xdxpArr.shift()

// Called inside the render (barstate.islast), after the levels.
f_xdxpDraw() =>
    if gateOn and show_xdxp and xdxpArr.size() > 0
        int xdN = 0
        for i = xdxpArr.size() - 1 to 0
            if xdN >= xdxp_max
                break
            XdxpMark xm = xdxpArr.get(i)
            xdN += 1
            bool xdIsD = xm.side == 1
            drawn_labels.push(label.new(xm.t, xm.price, TFP + (xdIsD ? "XD" : "XP"), xloc=xloc.bar_time, style=xdIsD ? label.style_label_up : label.style_label_down, color=color.new(xdIsD ? mc_bull_col : mc_bear_col, xm.live ? 0 : 35), textcolor=color.white, size=xdxp_size == "normal" ? size.normal : xdxp_size == "tiny" ? size.tiny : size.small, tooltip=(xdIsD ? "XD = Extreme Discount: " : "XP = Extreme Premium: ") + gate_mode + (xdIsD ? " <= 20" : " >= 80") + (xm.live ? " (still in the zone)" : "")))

// ═══════════════════════════════════════════════════════════════════════════
// RENDER — runs once on the last bar. Everything is deleted and redrawn from
// state, so any record removed above vanishes on the very next redraw (this
// is what makes Husband & Wife deletions automatic).
// Draw order IS priority order for right-edge overlap protection:
//   Tn > static anchors > dynamics > forced guardians > MC/urgency.
// ═══════════════════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════
// OUTSIDE-RANGE ALLOCATOR — inside the marker range = always drawn; outside =
// a 50 / 50 bull / bear budget, newest first. q = [bull left, bear left].
// ═══════════════════════════════════════════════════════════════
f_inR(float p, float hi, float lo) =>
    not na(hi) and not na(lo) and not na(p) and p <= hi + f_eps() and p >= lo - f_eps()

f_boxInR(float top, float bot, float hi, float lo) =>
    not na(hi) and not na(lo) and top <= hi + f_eps() and bot >= lo - f_eps()

// Items born on the candle of the highest / lowest marker (one STRUCTURE candle
// = spanMs wide) are allowed even with Max = 0.
f_onMarker(int t, int hiT, int loT, int spanMs) =>
    int w = math.max(nz(spanMs), 1)
    not na(t) and ((not na(hiT) and t >= hiT and t < hiT + w) or (not na(loT) and t >= loT and t < loT + w))

f_quota() =>
    int qBull = int(math.ceil(maxLines / 2.0))
    array.from(qBull, maxLines - qBull)

f_take(array<int> q, bool inside, bool isBull) =>
    bool ok = inside
    if not ok
        int k = isBull ? 0 : 1
        if q.get(k) > 0
            q.set(k, q.get(k) - 1)
            ok := true
    ok

f_inRange(float p, float hi, float lo) =>
    not na(hi) and not na(lo) and p <= hi + f_eps() and p >= lo - f_eps()

// A live-range level (P# / R#, MC / GMC, MP / GMP, urgency): always drawn when
// "Always Show the Live Range" is ON, else only inside the range or on the
// marker candle.
f_liveOk(float p, int t, float rHi, float rLo, int hiT, int loT, int spanMs) =>
    showLiveAlways or f_inR(p, rHi, rLo) or f_onMarker(t, hiT, loT, spanMs)

// Void shown / hidden by the range rule, restored to the colour it had.
f_proGapPaint(GapBox u, bool vis) =>
    color hid = color.new(#000000, 100)
    color gl  = color.new(#636363, 60)
    color gb  = color.new(#636363, 85)
    if u.slices.size() > 0
        for j = 0 to u.slices.size() - 1
            color sb = u.sliceTouched.get(j) ? col_partial : (u.gType == "ULG" ? color.new(u.origBorder, 60) : u.origBg)
            box.set_bgcolor(u.slices.get(j), vis ? sb : hid)
    else
        if u.gType == "ULG"
            box.set_border_color(u.b, vis ? (u.greyed ? gl : u.dim ? color.new(u.origBorder, 80) : u.origBorder) : hid)
        else
            box.set_bgcolor(u.b, vis ? (u.greyed ? gb : u.dim ? color.new(u.origBg, 85) : u.origBg) : hid)
    if not na(u.l)
        line.set_color(u.l, vis ? (u.greyed ? gl : u.dim ? color.new(u.origLine, 80) : u.origLine) : hid)
    if not na(u.lbl)
        label.set_textcolor(u.lbl, vis ? (u.greyed or u.dim ? color.new(u.origLblText, 70) : u.origLblText) : hid)

// Is the real node at this bar + price DRAWN right now? (same rules as below)
f_slotDrawn(int gT, float gP, float rHi, float rLo, int hiT, int loT, int spanMs) =>
    bool d = false
    if not na(buStatic) and buStatic.t == gT and math.abs(buStatic.price - gP) <= f_eps() and f_liveOk(buStatic.price, buStatic.t, rHi, rLo, hiT, loT, spanMs)
        d := d or (mainSide == -1 ? (show_gmp_lines and f_pullbackVisible(buStatic)) : mainSide == 1 ? show_gmc_lines : false)
    if not na(beStatic) and beStatic.t == gT and math.abs(beStatic.price - gP) <= f_eps() and f_liveOk(beStatic.price, beStatic.t, rHi, rLo, hiT, loT, spanMs)
        d := d or (mainSide == 1 ? (show_gmp_lines and f_pullbackVisible(beStatic)) : mainSide == -1 ? show_gmc_lines : false)
    if not na(buDynRaw) and buDynRaw.t == gT and math.abs(buDynRaw.price - gP) <= f_eps() and f_liveOk(buDynRaw.price, buDynRaw.t, rHi, rLo, hiT, loT, spanMs)
        d := d or (show_mp_lines and (mainSide != -1 or f_pullbackVisible(buDynRaw)))
    if not na(buDynGap) and buDynGap.t == gT and math.abs(buDynGap.price - gP) <= f_eps() and f_liveOk(buDynGap.price, buDynGap.t, rHi, rLo, hiT, loT, spanMs)
        d := d or (show_gmp_lines and (mainSide != -1 or f_pullbackVisible(buDynGap)))
    if not na(beDynRaw) and beDynRaw.t == gT and math.abs(beDynRaw.price - gP) <= f_eps() and f_liveOk(beDynRaw.price, beDynRaw.t, rHi, rLo, hiT, loT, spanMs)
        d := d or (show_mp_lines and (mainSide != 1 or f_pullbackVisible(beDynRaw)))
    if not na(beDynGap) and beDynGap.t == gT and math.abs(beDynGap.price - gP) <= f_eps() and f_liveOk(beDynGap.price, beDynGap.t, rHi, rLo, hiT, loT, spanMs)
        d := d or (show_gmp_lines and (mainSide != 1 or f_pullbackVisible(beDynGap)))
    if not na(buCtlRaw) and buCtlRaw.t == gT and math.abs(buCtlRaw.price - gP) <= f_eps() and f_liveOk(buCtlRaw.price, buCtlRaw.t, rHi, rLo, hiT, loT, spanMs)
        d := d or show_ant
    if not na(buCtlGap) and buCtlGap.t == gT and math.abs(buCtlGap.price - gP) <= f_eps() and f_liveOk(buCtlGap.price, buCtlGap.t, rHi, rLo, hiT, loT, spanMs)
        d := d or show_gmc_lines
    if not na(beCtlRaw) and beCtlRaw.t == gT and math.abs(beCtlRaw.price - gP) <= f_eps() and f_liveOk(beCtlRaw.price, beCtlRaw.t, rHi, rLo, hiT, loT, spanMs)
        d := d or show_ant
    if not na(beCtlGap) and beCtlGap.t == gT and math.abs(beCtlGap.price - gP) <= f_eps() and f_liveOk(beCtlGap.price, beCtlGap.t, rHi, rLo, hiT, loT, spanMs)
        d := d or show_gmc_lines
    d and f_liveOk(gP, gT, rHi, rLo, hiT, loT, spanMs)

// Is a P#-married marker's husband (the P# itself) drawn?
f_pDrawn(ShiftMarker sm, float rHi, float rLo, int hiT, int loT, int spanMs) =>
    Node a = sm.side == -1 ? beStatic : buStatic
    bool pRole = (sm.side == -1 and mainSide == 1) or (sm.side == 1 and mainSide == -1)
    f_pAnchorAlive(sm) and pRole and show_gmp_lines and f_pullbackVisible(a) and not na(a) and f_liveOk(a.price, a.t, rHi, rLo, hiT, loT, spanMs)

f_inList(array<int> ts, array<float> ps, int gT, float gP) =>
    bool f = false
    if ts.size() > 0
        for k = 0 to ts.size() - 1
            if ts.get(k) == gT and math.abs(ps.get(k) - gP) <= f_eps()
                f := true
                break
    f

if barstate.islast
    if drawn_lines.size() > 0
        for ln in drawn_lines
            line.delete(ln)
        drawn_lines.clear()
    if drawn_labels.size() > 0
        for lb in drawn_labels
            label.delete(lb)
        drawn_labels.clear()
    if drawn_zones.size() > 0
        for bx in drawn_zones
            box.delete(bx)
        drawn_zones.clear()
    if drawn_z_lines.size() > 0
        for zl in drawn_z_lines
            line.delete(zl)
        drawn_z_lines.clear()

    int futureT    = f_future_time(ext_mc)
    int futureAnt  = f_future_time(ant_ext)
    int futureTc   = f_future_time(ext_ant)
    int futureZone = f_future_time(zone_ext)   // right edge shared by ALL eBlocks / iBlocks

    array<RenderZone> temp_zones = array.new<RenderZone>()
    render_groups.clear()

    // PHASE GATE for the MC anticipation line (MC only exists in the trend phase).
    bool antBullPhaseOk = mainSide != -1 and not primaryPullbackDone
    bool antBearPhaseOk = mainSide != 1  and not primaryPullbackDone

    // ─── TREND & MOMENTUM MARKERS — computed FIRST: they set the always-drawn range ───
    // 🟢 / 🔴 = the START of the leg (its T1). 🟩 / 🟥 = the newest Tn.
    float starBullP = na
    float starBearP = na
    float lastBullP = na
    float lastBearP = na
    int   starBullT = na
    int   starBearT = na
    int   lastBullT = na
    int   lastBearT = na
    if poLines.size() > 0
        for mIdx = poLines.size() - 1 to 0
            POLine mp = poLines.get(mIdx)
            if mp.side == 1
                if na(lastBullP)
                    lastBullP := mp.price
                    lastBullT := mp.t
                if mp.tier == 1 and na(starBullP)
                    starBullP := mp.price
                    starBullT := mp.t
            else
                if na(lastBearP)
                    lastBearP := mp.price
                    lastBearT := mp.t
                if mp.tier == 1 and na(starBearP)
                    starBearP := mp.price
                    starBearT := mp.t
    float rHi = na
    float rLo = na
    int   hiT = na
    int   loT = na
    array<float> mkP = array.from(starBullP, lastBullP, starBearP, lastBearP)
    array<int>   mkT = array.from(starBullT, lastBullT, starBearT, lastBearT)
    for k = 0 to 3
        float pv = mkP.get(k)
        if not na(pv)
            if na(rHi) or pv > rHi
                rHi := pv
                hiT := mkT.get(k)
            if na(rLo) or pv < rLo
                rLo := pv
                loT := mkT.get(k)
    int spanMs = timeframe.in_seconds(blockTF) * 1000
    array<int> q = f_quota()   // [bull left, bear left] outside the range

    // ─── Tn ORIGINS + coupled cause markers + eBlock / iBlock ───
    // Inside the marker range: always drawn. Outside: newest first, up to the max.
    array<int>   poT = array.new<int>()
    array<float> poP = array.new<float>()
    if show_orig_lines and poLines.size() > 0
        for plIdx = poLines.size() - 1 to 0
            POLine pl = poLines.get(plIdx)
            bool hidden = pl.po4_touched and po4_trig_mode == "Hide"
            bool take   = not hidden and f_take(q, f_inR(pl.price, rHi, rLo) or f_onMarker(pl.t, hiT, loT, spanMs), pl.side == 1)
            if take
                poT.push(pl.t)
                poP.push(pl.price)
                color c  = pl.side == 1 ? mc_bull_col : mc_bear_col
                bool isT1 = show_t1 and pl.tier == 1
                int  w   = isT1 ? t1_width : tn_label_hdr ? tn_width : 2
                string st = isT1 ? f_ln_style(t1_line_style) : tn_label_hdr ? f_ln_style(tn_line_style) : line.style_solid
                string sz = isT1 ? t1_size : tn_label_hdr ? tn_size : orig_size
                int lineEnd = (pl.po4_touched and po4_trig_mode == "Stop Extending") ? pl.po4_freeze_t : futureT
                string txt = TFP + (pl.side == 1 ? "BuPO4" : "BePO4") + ENGT + (show_tiers ? " T" + str.tostring(pl.tier) : "") + (pl.isForced ? " Forced" : "") + (pl.official ? "" : " ✗")
                f_add_level(pl.price, txt, c, w, st, pl.t, lineEnd, 5, sz)

                // Coupled cause marker ("wife") — redrawn from this record.
                // CDLc / LDc above the middle of the break line, CDSc / SDc below it.
                if str.length(pl.causeText) > 0 and not na(pl.causePrice)
                    int    causeEnd = math.max(pl.causeBreakT, pl.causeT)
                    bool   isLdSd   = str.contains(pl.causeText, "LD") or str.contains(pl.causeText, "SD")
                    color  bc       = isLdSd ? (pl.side == 1 ? ld_base_col : sd_base_col) : c
                    color  uc       = not pl.official ? FAIL_COL : htf_dim and pl.against ? color.new(FAIL_COL, 30) : bc
                    string ct       = TFP + f_eng(pl.official ? pl.causeText : str.lower(pl.causeText))
                    if (not isLdSd or show_pb) and (pl.official or show_failed)
                        drawn_lines.push(line.new(pl.causeT, pl.causePrice, causeEnd, pl.causePrice, xloc=xloc.bar_time, color=uc, width=pl.causeMajor ? (isLdSd ? ld_width : cd_width) : 1, style=pl.official ? line.style_solid : line.style_dotted))
                        drawn_labels.push(label.new(math.round(math.avg(pl.causeT, causeEnd)), pl.causePrice, ct, xloc=xloc.bar_time, style=pl.side == 1 ? label.style_label_down : label.style_label_up, textcolor=uc, color=color(na), size=f_sz(not pl.causeMajor ? "tiny" : isLdSd ? ld_size : cd_size), tooltip=ct + (pl.official ? " (official)" : " (failed " + gate_mode + ")") + (pl.against ? "\nAgainst the HTF bias" : "")))

                // BLOCK CLASS: a T1 born of a CDL/CDS flip = eBlock; a T2+ born of an
                // LD/SD continuation = iBlock. Lives exactly as long as its PO4.
                bool plIsLdSd = str.contains(pl.causeText, "LD") or str.contains(pl.causeText, "SD")
                bool plZoneOn = plIsLdSd ? show_iblk : show_eblk
                if show_zones and plZoneOn and pl.official and not na(pl.c_high)
                    f_pushZone(temp_zones, pl.c_time, lineEnd, pl.c_high, pl.c_low, pl.c_open, pl.c_close, pl.side == 1, pl.side == 1 ? zone_pel_col : zone_pes_col, TFP + f_zoneName(not plIsLdSd, pl.side == 1, ENGT), pl.c_volPct)
                    RenderZone rzN = temp_zones.last()
                    rzN.tsz := plIsLdSd ? iblk_size : eblk_size

    // ─── Standalone CDS/CDL markers — drawn ONLY with their husband ───
    // Husband = the P# (P#-married), a Forced guardian, a live PO4 or a real node.
    array<int>   gVisT = array.new<int>()
    array<float> gVisP = array.new<float>()
    if shiftMarkers.size() > 0
        for smIdx = shiftMarkers.size() - 1 to 0
            ShiftMarker sm = shiftMarkers.get(smIdx)
            if sm.isInternal and not show_int_cd
                continue
            bool isGuard = not sm.pMarried and f_guardianExists(sm.guardianT, sm.guardianPrice)
            bool husband = sm.pMarried ? f_pDrawn(sm, rHi, rLo, hiT, loT, spanMs) : isGuard ? true : (f_inList(poT, poP, sm.guardianT, sm.guardianPrice) or f_slotDrawn(sm.guardianT, sm.guardianPrice, rHi, rLo, hiT, loT, spanMs))
            if not husband
                continue
            if not f_take(q, f_inR(sm.price, rHi, rLo) or f_onMarker(sm.ownerT, hiT, loT, spanMs) or f_onMarker(sm.breakT, hiT, loT, spanMs), sm.side == 1)
                continue
            if isGuard
                gVisT.push(sm.guardianT)
                gVisP.push(sm.guardianPrice)
            color smCol  = sm.side == 1 ? mc_bull_col : mc_bear_col
            color useCol = sm.isInternal ? color.new(smCol, 40) : smCol
            drawn_lines.push(line.new(sm.ownerT, sm.price, sm.breakT, sm.price, xloc=xloc.bar_time, color=useCol, width=sm.isInternal ? 1 : cd_width, style=line.style_solid))
            drawn_labels.push(label.new(math.round(math.avg(sm.ownerT, sm.breakT)), sm.price, TFP + f_eng(sm.markerTxt), xloc=xloc.bar_time, textcolor=useCol, color=color(na), style=sm.side == 1 ? label.style_label_down : label.style_label_up, size=f_sz(sm.isInternal ? "tiny" : cd_size)))

    // ─── STATIC anchors — Pn dashed, Rn dotted, capitalized + numbered ───
    if mainSide == 1 and not na(beStatic) and show_gmp_lines and f_pullbackVisible(beStatic) and f_liveOk(beStatic.price, beStatic.t, rHi, rLo, hiT, loT, spanMs)
        bool isP1 = show_p1 and curTier == 1
        f_add_level(beStatic.price, f_gTxt(TFP + f_apply_naming(f_staticText(beStatic, beStatic.isForced ? "NBC Forced" : "BeX", true, curTier)), f_isPConf(beStatic), " · p"), f_gCol(mc_bear_col, f_isPConf(beStatic)), isP1 ? p1_width : pn_label_hdr ? pn_width : 1, isP1 ? f_ln_style(p1_line_style) : pn_label_hdr ? f_ln_style(pn_line_style) : line.style_solid, beStatic.t, futureT, 4, isP1 ? p1_size : pn_label_hdr ? pn_size : (beStatic.isGap ? gmp_size : mp_size))
    if mainSide == -1 and not na(buStatic) and show_gmp_lines and f_pullbackVisible(buStatic) and f_liveOk(buStatic.price, buStatic.t, rHi, rLo, hiT, loT, spanMs)
        bool isP1 = show_p1 and curTier == 1
        f_add_level(buStatic.price, f_gTxt(TFP + f_apply_naming(f_staticText(buStatic, buStatic.isForced ? "NBC Forced" : "BuX", true, curTier)), f_isPConf(buStatic), " · p"), f_gCol(mc_bull_col, f_isPConf(buStatic)), isP1 ? p1_width : pn_label_hdr ? pn_width : 1, isP1 ? f_ln_style(p1_line_style) : pn_label_hdr ? f_ln_style(pn_line_style) : line.style_solid, buStatic.t, futureT, 4, isP1 ? p1_size : pn_label_hdr ? pn_size : (buStatic.isGap ? gmp_size : mp_size))
    if mainSide == 1 and not na(buStatic) and show_gmc_lines and f_liveOk(buStatic.price, buStatic.t, rHi, rLo, hiT, loT, spanMs)
        f_add_level(buStatic.price, f_gTxt(TFP + f_apply_naming(f_staticText(buStatic, "BuX", false, curTier)), not primaryResumptionDone or f_isRConf(buStatic), " · r"), f_gCol(mc_bull_col, not primaryResumptionDone or f_isRConf(buStatic)), 1, line.style_solid, buStatic.t, futureT, 4, gmc_size)
        if show_zones and (buStatic.isGap ? zone_gmc : zone_mc) and not na(buStatic.c_high)
            f_pushZone(temp_zones, buStatic.c_time, futureT, buStatic.c_high, buStatic.c_low, buStatic.c_open, buStatic.c_close, true, zone_pel_col, f_xuName(buStatic.isGap, true), buStatic.c_volPct)
    if mainSide == -1 and not na(beStatic) and show_gmc_lines and f_liveOk(beStatic.price, beStatic.t, rHi, rLo, hiT, loT, spanMs)
        f_add_level(beStatic.price, f_gTxt(TFP + f_apply_naming(f_staticText(beStatic, "BeX", false, curTier)), not primaryResumptionDone or f_isRConf(beStatic), " · r"), f_gCol(mc_bear_col, not primaryResumptionDone or f_isRConf(beStatic)), 1, line.style_solid, beStatic.t, futureT, 4, gmc_size)
        if show_zones and (beStatic.isGap ? zone_gmc : zone_mc) and not na(beStatic.c_high)
            f_pushZone(temp_zones, beStatic.c_time, futureT, beStatic.c_high, beStatic.c_low, beStatic.c_open, beStatic.c_close, false, zone_pes_col, f_xuName(beStatic.isGap, false), beStatic.c_volPct)

    // ─── DYNAMIC internal trackers ───
    if not na(buDynRaw) and show_mp_lines and (not (mainSide == -1) or f_pullbackVisible(buDynRaw)) and f_liveOk(buDynRaw.price, buDynRaw.t, rHi, rLo, hiT, loT, spanMs)
        bool pbRole = mainSide == -1
        f_add_level(buDynRaw.price, TFP + f_apply_naming(pbRole ? f_dynPullbackText(buDynRaw, "BuX") : f_dynResumeText(buDynRaw, "BuX")), color.new(mc_bull_col, 40), 1, line.style_solid, buDynRaw.t, futureT, 3, lqc_size)
    if not na(buDynGap) and show_gmp_lines and (not (mainSide == -1) or f_pullbackVisible(buDynGap)) and f_liveOk(buDynGap.price, buDynGap.t, rHi, rLo, hiT, loT, spanMs)
        bool pbRole = mainSide == -1
        f_add_level(buDynGap.price, TFP + f_apply_naming(pbRole ? f_dynPullbackText(buDynGap, "BuX") : f_dynResumeText(buDynGap, "BuX")), color.new(mc_bull_col, 15), 1, line.style_solid, buDynGap.t, futureT, 3, lqc_size)
        if show_zones and zone_gmc and not pbRole and not na(buDynGap.c_high)
            f_pushZone(temp_zones, buDynGap.c_time, futureT, buDynGap.c_high, buDynGap.c_low, buDynGap.c_open, buDynGap.c_close, true, zone_pel_col, f_xuName(true, true), buDynGap.c_volPct)
    if not na(beDynRaw) and show_mp_lines and (not (mainSide == 1) or f_pullbackVisible(beDynRaw)) and f_liveOk(beDynRaw.price, beDynRaw.t, rHi, rLo, hiT, loT, spanMs)
        bool pbRole = mainSide == 1
        f_add_level(beDynRaw.price, TFP + f_apply_naming(pbRole ? f_dynPullbackText(beDynRaw, "BeX") : f_dynResumeText(beDynRaw, "BeX")), color.new(mc_bear_col, 40), 1, line.style_solid, beDynRaw.t, futureT, 3, lqc_size)
    if not na(beDynGap) and show_gmp_lines and (not (mainSide == 1) or f_pullbackVisible(beDynGap)) and f_liveOk(beDynGap.price, beDynGap.t, rHi, rLo, hiT, loT, spanMs)
        bool pbRole = mainSide == 1
        f_add_level(beDynGap.price, TFP + f_apply_naming(pbRole ? f_dynPullbackText(beDynGap, "BeX") : f_dynResumeText(beDynGap, "BeX")), color.new(mc_bear_col, 15), 1, line.style_solid, beDynGap.t, futureT, 3, lqc_size)
        if show_zones and zone_gmc and not pbRole and not na(beDynGap.c_high)
            f_pushZone(temp_zones, beDynGap.c_time, futureT, beDynGap.c_high, beDynGap.c_low, beDynGap.c_open, beDynGap.c_close, false, zone_pes_col, f_xuName(true, false), beDynGap.c_volPct)

    // ─── TREND & MOMENTUM MARKERS (drawn) ───
    if show_tn_step
        bool bullSame = not na(starBullP) and not na(lastBullP) and math.abs(starBullP - lastBullP) <= f_eps()
        bool bearSame = not na(starBearP) and not na(lastBearP) and math.abs(starBearP - lastBearP) <= f_eps()
        if not na(starBullP)
            drawn_labels.push(label.new(futureT, starBullP, bullSame ? "🟢🟩" : "🟢", xloc=xloc.bar_time, style=label.style_label_right, textcolor=tm_bull_col, color=color(na), size=size.small))
        if not na(lastBullP) and not bullSame
            drawn_labels.push(label.new(futureT, lastBullP, "🟩", xloc=xloc.bar_time, style=label.style_label_right, textcolor=tm_bull_col, color=color(na), size=size.small))
        if not na(starBearP)
            drawn_labels.push(label.new(futureT, starBearP, bearSame ? "🔴🟥" : "🔴", xloc=xloc.bar_time, style=label.style_label_right, textcolor=tm_bear_col, color=color(na), size=size.small))
        if not na(lastBearP) and not bearSame
            drawn_labels.push(label.new(futureT, lastBearP, "🟥", xloc=xloc.bar_time, style=label.style_label_right, textcolor=tm_bear_col, color=color(na), size=size.small))

    // ─── TREND-PHASE MC / GMC (own slots — survive the pullback & resumption) ───
    if not na(buCtlRaw) and show_ant and f_liveOk(buCtlRaw.price, buCtlRaw.t, rHi, rLo, hiT, loT, spanMs)
        f_add_level(buCtlRaw.price, TFP + f_apply_naming(f_dynResumeText(buCtlRaw, "BuX")), color.new(mc_bull_col, 40), 1, line.style_solid, buCtlRaw.t, futureT, 3, lqc_size)
    if not na(buCtlGap) and show_gmc_lines and f_liveOk(buCtlGap.price, buCtlGap.t, rHi, rLo, hiT, loT, spanMs)
        f_add_level(buCtlGap.price, TFP + f_apply_naming(f_dynResumeText(buCtlGap, "BuX")), color.new(mc_bull_col, 15), 1, line.style_solid, buCtlGap.t, futureT, 3, lqc_size)
        if show_zones and zone_gmc and not na(buCtlGap.c_high)
            f_pushZone(temp_zones, buCtlGap.c_time, futureT, buCtlGap.c_high, buCtlGap.c_low, buCtlGap.c_open, buCtlGap.c_close, true, zone_pel_col, f_xuName(true, true), buCtlGap.c_volPct)
    if not na(beCtlRaw) and show_ant and f_liveOk(beCtlRaw.price, beCtlRaw.t, rHi, rLo, hiT, loT, spanMs)
        f_add_level(beCtlRaw.price, TFP + f_apply_naming(f_dynResumeText(beCtlRaw, "BeX")), color.new(mc_bear_col, 40), 1, line.style_solid, beCtlRaw.t, futureT, 3, lqc_size)
    if not na(beCtlGap) and show_gmc_lines and f_liveOk(beCtlGap.price, beCtlGap.t, rHi, rLo, hiT, loT, spanMs)
        f_add_level(beCtlGap.price, TFP + f_apply_naming(f_dynResumeText(beCtlGap, "BeX")), color.new(mc_bear_col, 15), 1, line.style_solid, beCtlGap.t, futureT, 3, lqc_size)
        if show_zones and zone_gmc and not na(beCtlGap.c_high)
            f_pushZone(temp_zones, beCtlGap.c_time, futureT, beCtlGap.c_high, beCtlGap.c_low, beCtlGap.c_open, beCtlGap.c_close, false, zone_pes_col, f_xuName(true, false), beCtlGap.c_volPct)

    // ─── FORCED guardians — drawn only when one of their markers is drawn ───
    if forcedNodes.size() > 0
        for fn in forcedNodes
            if f_inList(gVisT, gVisP, fn.t, fn.price)
                color fnCol = color.new(fn.side == 1 ? lqc_buy_col : lqc_sell_col, 55)
                f_add_level(fn.price, TFP + fn.lbl, fnCol, 1, line.style_dotted, fn.t, futureT, 2, lqc_size)

    // ─── MC ANTICIPATION LINES ───
    if show_ant
        if ant_bull_active and antBullPhaseOk and f_liveOk(ant_bull_price, ant_bull_t, rHi, rLo, hiT, loT, spanMs)
            f_add_level(ant_bull_price, TFP + f_apply_naming("BuX MC"), mc_bull_col, 1, line.style_dotted, ant_bull_t, futureAnt, 2, ant_size)
        if ant_bear_active and antBearPhaseOk and f_liveOk(ant_bear_price, ant_bear_t, rHi, rLo, hiT, loT, spanMs)
            f_add_level(ant_bear_price, TFP + f_apply_naming("BeX MC"), mc_bear_col, 1, line.style_dotted, ant_bear_t, futureAnt, 2, ant_size)

    // U iBlock volume uses the value stored when the MC candle printed.
    if show_zones and zone_mc
        if ant_bull_active and antBullPhaseOk and not na(ant_bull_h) and f_liveOk(ant_bull_price, ant_bull_t, rHi, rLo, hiT, loT, spanMs)
            f_pushZone(temp_zones, ant_bull_t, futureAnt, ant_bull_h, ant_bull_l, ant_bull_o, ant_bull_c, true, zone_pel_col, f_xuName(false, true), ant_bull_v)
        if ant_bear_active and antBearPhaseOk and not na(ant_bear_h) and f_liveOk(ant_bear_price, ant_bear_t, rHi, rLo, hiT, loT, spanMs)
            f_pushZone(temp_zones, ant_bear_t, futureAnt, ant_bear_h, ant_bear_l, ant_bear_o, ant_bear_c, false, zone_pes_col, f_xuName(false, false), ant_bear_v)

    // ─── URGENCY GAP ANTICIPATION LINES ───
    if show_tc
        if not na(tc_bull_lvl) and f_liveOk(tc_bull_lvl, tc_bull_t, rHi, rLo, hiT, loT, spanMs)
            f_add_level(tc_bull_lvl, tc_bull_violated ? "Buy Urgency Gap Anticipation ✕" : "Buy Urgency Gap Anticipation⬀", tc_bull_col, 2, line.style_solid, tc_bull_t, futureTc, 3, tc_size)
        if not na(tc_bear_lvl) and f_liveOk(tc_bear_lvl, tc_bear_t, rHi, rLo, hiT, loT, spanMs)
            f_add_level(tc_bear_lvl, tc_bear_violated ? "Sell Urgency Gap Anticipation ✕" : "Sell Urgency Gap Anticipation⬂", tc_bear_col, 2, line.style_solid, tc_bear_t, futureTc, 3, tc_size)

    // Flush every merged right-edge level: one line per price, labels joined
    // with " & " so co-located levels read together instead of overlapping.
    f_draw_groups()
    f_xdxpDraw()

    // ─── STRUCTURAL VOIDS: inside / marker candle always, outside from the budget ───
    if visual_gaps.size() > 0
        for i = visual_gaps.size() - 1 to 0
            GapBox u = visual_gaps.get(i)
            f_proGapPaint(u, f_take(q, f_boxInR(u.top, u.bot, rHi, rLo) or f_onMarker(u.t, hiT, loT, spanMs), u.isBull))

    // ─── eBLOCK / iBLOCK BOXES ───
    if temp_zones.size() > 0
        array<int> t_vals = array.new<int>()
        for tz in temp_zones
            t_vals.push(tz.t)
        array<int> sorted_idx = array.sort_indices(t_vals)
        int left_shift = math.round(bar_time_diff / 2)
        int start_idx  = limit_zones ? math.max(0, sorted_idx.size() - max_zones) : 0
        string style_50 = line_50_style == "Solid" ? line.style_solid : line_50_style == "Dotted" ? line.style_dotted : line.style_dashed
        for i = start_idx to sorted_idx.size() - 1
            RenderZone rz = temp_zones.get(sorted_idx.get(i))
            int left_edge = rz.t - left_shift
            color txtCol = color.new(rz.isBull ? mc_bull_col : mc_bear_col, 0)
            drawn_zones.push(box.new(left_edge, rz.z_top, futureZone, rz.z_bot, xloc=xloc.bar_time, border_color=na, bgcolor=rz.bg_col, text=zone_show_name ? rz.blockName : "", text_color=txtCol, text_size=f_sz(rz.tsz), text_halign=text.align_right, text_valign=text.align_center))
            if zone_show_vol and not na(rz.volPct)
                string vTier = rz.volPct >= 150 ? "Strong" : rz.volPct >= 80 ? "Normal" : "Weak"
                string vFire = rz.volPct >= 150 ? " 🔥" : ""
                string vTxt  = vTier + ": " + str.tostring(math.round(rz.volPct)) + "%" + vFire
                float  vY    = rz.isBull ? rz.z_bot : rz.z_top
                drawn_labels.push(label.new(left_edge, vY, vTxt, xloc=xloc.bar_time, yloc=yloc.price, style=rz.isBull ? label.style_label_up : label.style_label_down, textcolor=txtCol, color=color(na), size=size.tiny))
            if show_50_line
                drawn_z_lines.push(line.new(left_edge, rz.z_mid, futureZone, rz.z_mid, xloc=xloc.bar_time, color=color.new(rz.bg_col, 0), width=line_50_width, style=style_50))
                float v_target = rz.isBull ? rz.c_bot : rz.c_top
                drawn_z_lines.push(line.new(futureZone, rz.z_mid, futureZone, v_target, xloc=xloc.bar_time, color=color.new(rz.bg_col, 0), width=line_50_width, style=style_50))

// ═══════════════════════════════════════════════════════════════════════════
// CANDLE COLORING: Structural Delta Bias (conviction) + NBC override.
// ═══════════════════════════════════════════════════════════════════════════
bool candle_is_bull = close > open
bool candle_is_bear = close < open
bool candle_is_doji = close == open

f_ccm_zone(float price, float bodyTop, float bodyBot, float hi, float lo) =>
    int z = price > hi ? 1 : price > bodyTop ? 2 : price >= bodyBot ? 3 : price >= lo ? 4 : 5
    z

float ccm_bodyTop = math.max(open[1], close[1])
float ccm_bodyBot = math.min(open[1], close[1])
float ccm_hi      = high[1]
float ccm_lo      = low[1]

int ccm_closeZone = f_ccm_zone(close, ccm_bodyTop, ccm_bodyBot, ccm_hi, ccm_lo)

bool ccm_netBullStance = ccm_closeZone < 3
bool ccm_netBearStance = ccm_closeZone > 3
int  ccm_magnitude     = math.abs(ccm_closeZone - 3)

bool ccm_gapAbsorbedBull = ccm_netBullStance and candle_is_bear
bool ccm_gapAbsorbedBear = ccm_netBearStance and candle_is_bull

color ccm_tierColor = na
if candle_is_doji
    ccm_tierColor := ccm_doji_col
else if ccm_gapAbsorbedBull
    ccm_tierColor := ccm_gap_bull_col
else if ccm_gapAbsorbedBear
    ccm_tierColor := ccm_gap_bear_col
else if ccm_closeZone == 3 and candle_is_bear
    ccm_tierColor := ccm_pause_col
else if ccm_netBullStance
    ccm_tierColor := ccm_magnitude == 2 ? ccm_strongest_bull : ccm_magnitude == 1 ? ccm_strong_bull : ccm_weak_bull
else if ccm_netBearStance
    ccm_tierColor := ccm_magnitude == 2 ? ccm_strongest_bear : ccm_magnitude == 1 ? ccm_strong_bear : ccm_weak_bear
else
    ccm_tierColor := ccm_weak_bull

color final_bar_color = show_ccm_color ? ccm_tierColor : na

// NBC (Non-Body-Close) — neither a BuX nor a BeX. Applied last: every NBC
// gets the one flat color.
bool candle_is_nbc = not (close > high[1] or open > high[1]) and not (close < low[1] or open < low[1])
if show_nbc_color and candle_is_nbc
    final_bar_color := nbc_col

// CLOSED CANDLES ONLY — the live (still forming) candle is never colored.
if not barstate.isconfirmed
    final_bar_color := na

barcolor(final_bar_color)

// ═══════════════════════════════════════════════════════════════
// HTF BIAS BOX
// ═══════════════════════════════════════════════════════════════
var table biasTbl = table.new(f_htfPos(htf_tbl_pos), 1, 1, bgcolor=#000000, border_width=1, frame_color=color.new(color.white, 70), frame_width=1)
if barstate.islast
    if htf_table and htf_src != "Off"
        string bSrc = htf_src == "Last BC" ? "Last BC" : htf_src == "Last Flip (CDL / CDS)" ? "Flip" : "Cont"
        string bEng = htf_eng == "Zone x (boxes)" ? "x" : htf_eng == "Candle c (PO4)" ? "c" : "s"
        string bDir = htfBias == 1 ? "BULL" : htfBias == -1 ? "BEAR" : "NONE"
        string bOrg = htf_src == "Last BC" ? (htfOrg == 2 ? " (from a flip " + bEng + ")" : htfOrg == 1 ? " (from a continuation " + bEng + ")" : " (plain BC)") : " · engine " + bEng
        color  bCol = htfBias == 1 ? bull_col : htfBias == -1 ? bear_col : color.silver
        table.cell(biasTbl, 0, 0, "HTF " + htf_tf + " · " + bSrc + " · " + bDir + bOrg, text_color=bCol, text_size=size.small)
    else
        table.clear(biasTbl, 0, 0)


// ═══════════════════════════════════════════════════════════════════════════
// ALERTS (official breaks only, closed bars)
// ═══════════════════════════════════════════════════════════════════════════
alertcondition(alert_po4_bull, title="New BuPO4", message="New BuPO4 (bullish origin) confirmed on {{ticker}} at {{close}}")
alertcondition(alert_po4_bear, title="New BePO4", message="New BePO4 (bearish origin) confirmed on {{ticker}} at {{close}}")
alertcondition(alert_cdl, title="CDLc Flip (official)", message="CDLc - bullish flip (candle engine) on {{ticker}} at {{close}}")
alertcondition(alert_cds, title="CDSc Flip (official)", message="CDSc - bearish flip (candle engine) on {{ticker}} at {{close}}")
alertcondition(alert_ld, title="LDc Continuation (official)", message="LDc - bullish continuation (candle engine) on {{ticker}} at {{close}}")
alertcondition(alert_sd, title="SDc Continuation (official)", message="SDc - bearish continuation (candle engine) on {{ticker}} at {{close}}")
alertcondition(alert_gmc_bull, title="New BuX GMC", message="New BuX GMC (bullish momentum) confirmed on {{ticker}} at {{close}}")
alertcondition(alert_gmc_bear, title="New BeX GMC", message="New BeX GMC (bearish momentum) confirmed on {{ticker}} at {{close}}")
alertcondition(newsWarn and barstate.isconfirmed, title="News Warning", message="News coming in 15 / 30 minutes on {{ticker}}")
