f_mmcb(float o, float h, float l, float c, float ph, float pl) =>
    int t = -1
    if not na(ph) and not na(pl) and not na(c)
        float rg  = h - l
        float pos = rg > 0 ? (c - l) / rg : 0.5
        bool  tH  = h > ph
        bool  tL  = l < pl
        if c > ph
            t := tL ? (pos >= 0.75 ? 2 : 3) : (pos >= 0.75 ? 0 : 1)
        else if c < pl
            t := tH ? (pos <= 0.25 ? 10 : 11) : (pos <= 0.25 ? 8 : 9)
        else
            if tL and not tH
                t := pos >= 0.5 ? 4 : 5
            else if tH and not tL
                t := pos <= 0.5 ? 12 : 13
            else if tH and tL
                t := pos >= 0.5 ? 7 : 15
            else
                t := pos >= 0.5 ? 6 : 14
    t

f_tfIdx(int sec) =>
    sec <= 420 ? 0 : sec <= 1800 ? 1 : sec <= 7200 ? 2 : sec <= 28800 ? 3 : 4

f_od(array<int> a, int tfi, int ty) =>
    ty < 0 ? -1 : a.get(tfi * 16 + ty)

f_pct(int v) =>
    v < 0 ? "—" : str.tostring(v) + "%"

f_ctlIdx(float pos, int k) =>
    int th = pos < 1.0 / 3.0 ? 0 : pos < 2.0 / 3.0 ? 1 : 2
    int ag = k <= 1 ? 0 : k <= 3 ? 1 : k <= 6 ? 2 : 3
    th * 4 + ag

f_ctlUp(float pos, int k) =>
    CTL_UP.get(f_ctlIdx(pos, k))

f_num(int n) =>
    n < 0 ? "<20" : n == 0 ? "0" : str.tostring(n, "#,###")

f_rr(float r) =>
    r <= -98 ? "—" : (r > 0 ? "+" : "") + str.tostring(r, "0.00")

int TFI_CH = f_tfIdx(timeframe.in_seconds(timeframe.period))
int TFI_ST = f_tfIdx(timeframe.in_seconds(blockTF))
bool TF_EXACT = array.from(300, 900, 3600, 14400, 86400).includes(timeframe.in_seconds(timeframe.period))

// ═══════════════════════════════════════════════════════════════
// ENGINE CALL (every bar; it only moves on a new closed block candle)
// ═══════════════════════════════════════════════════════════════
[zSide, zTier, zTnP, zTnT, zPP, zPT, zRP, zRT, eType, eDir, eNum, eBrkP, eBrkT, eTnP, eTnT, eOH, eOL, eOT, eLive, eBxH, eBxL, eBxT, eLiveNdb, eLiveRole, eEndF, eEndH, eEndL, eEndT, eEndRole, eEndNdb, ePConf] = f_zoneEngine(stepNow, bO, bH, bL, bC, bV, bH1, bL1, bT, boxGrow, expMode, gateOn, gHi, gLo)

// ═══════════════════════════════════════════════════════════════
// TYPES & STATE
// ═══════════════════════════════════════════════════════════════
type ZCause
    string kind
    float  price
    int    t1
    int    t2
    bool   isBull
    bool   pass
    bool   against

type ZPO
    float  price
    int    t
    int    side
    int    tier
    bool   official
    int    seq
    float  oH
    float  oL
    int    oT
    ZCause cause

type ZBox
    float top
    float bot
    int   t1
    int   t2
    int   role
    float ndb
    float poc  = na
    float pocV = na
    float pocS = na

// ─── BOX vPOC: the price with the most volume inside the box ───
// each inside structure candle's volume is spread evenly over its range (clipped to the box)
var array<float> pcH = array.new<float>()
var array<float> pcL = array.new<float>()
var array<float> pcV = array.new<float>()
var int          pcBoxT  = na
var array<float> pocHist = array.new<float>()

f_poc(float top, float bot, int bins) =>
    float pp = na
    float pv = 0.0
    float tv = 0.0
    if pcH.size() > 0 and top > bot and bins > 0
        float bw  = (top - bot) / bins
        array<float> acc = array.new<float>(bins, 0.0)
        for i = 0 to pcH.size() - 1
            float ch = math.min(pcH.get(i), top)
            float cl = math.max(pcL.get(i), bot)
            float cv = pcV.get(i)
            if cv > 0 and ch >= cl
                tv += cv
                int b0 = math.min(bins - 1, math.max(0, int(math.floor((cl - bot) / bw))))
                int b1 = math.min(bins - 1, math.max(0, int(math.floor((ch - bot) / bw))))
                float per = cv / (b1 - b0 + 1)
                for b = b0 to b1
                    acc.set(b, acc.get(b) + per)
        if tv > 0
            int mi = acc.indexof(acc.max())
            pp := bot + (mi + 0.5) * bw
            pv := acc.get(mi)
    [pp, pv, tv]

// line width 1–6 from the POC volume vs the average POC volume of the last 20 boxes
f_pocW(float pv) =>
    float av = pocHist.size() > 0 ? pocHist.avg() : na
    float r  = na(av) or av <= 0 ? 1.0 : pv / av
    int   w  = r < 0.5 ? 1 : r < 0.8 ? 2 : r < 1.2 ? 3 : r < 1.6 ? 4 : r < 2.2 ? 5 : 6
    [w, r]

var array<ZPO>  po4s     = array.new<ZPO>()
var array<ZBox> pastBox  = array.new<ZBox>()
var int         po4Seq   = 0
var int         prevSide = 0

bool ev_cdl = false
bool ev_cds = false
bool ev_ld  = false
bool ev_sd  = false

if stepNow
    // GATE MEMORY — this block candle's oscillator, read in the trend it formed in
    if gateOn and not na(gHi) and not na(gLo)
        if gHi >= 80
            hitXP := true
            if prevSide == 1
                bullImp := true
            if prevSide == -1 and bearImp
                bearPb := true
        if gLo <= 20
            hitXD := true
            if prevSide == -1
                bearImp := true
            if prevSide == 1 and bullImp
                bullPb := true

    // HUSBAND & WIFE: a block close through a PO4 deletes it with its break and zone
    if po4s.size() > 0
        for i = po4s.size() - 1 to 0
            ZPO p = po4s.get(i)
            if (p.side == 1 and bC < p.price) or (p.side == -1 and bC > p.price)
                if pastBox.size() > 0
                    for j = pastBox.size() - 1 to 0
                        if pastBox.get(j).t1 == p.oT
                            pastBox.remove(j)
                po4s.remove(i)

    // A past box (ended this candle) is kept for drawing
    if eEndF
        ZBox nb = ZBox.new(eEndH, eEndL, eEndT, bT, eEndRole, eEndNdb)
        if poc_on and pcBoxT == eEndT
            [nbP, nbV, nbT] = f_poc(eEndH, eEndL, poc_bins)
            if not na(nbP)
                nb.poc  := nbP
                nb.pocV := nbV
                nb.pocS := nbV / nbT
                pocHist.push(nbV)
                while pocHist.size() > 20
                    pocHist.shift()
        pastBox.push(nb)
        while pastBox.size() > 60
            pastBox.shift()
    // the candles inside the live box feed its vPOC
    if eLive and not na(eBxT)
        if na(pcBoxT) or pcBoxT != eBxT
            pcH.clear()
            pcL.clear()
            pcV.clear()
            pcBoxT := eBxT
        pcH.push(bH)
        pcL.push(bL)
        pcV.push(nz(bV))
        while pcH.size() > 300
            pcH.shift()
            pcL.shift()
            pcV.shift()
    else
        pcH.clear()
        pcL.clear()
        pcV.clear()
        pcBoxT := na

    // A structural event -> the new T# PO4 with its married break
    if eType != 0
        bool isFlip = eType == 1
        bool up     = eDir == 1
        bool pass   = true
        string kind = TFP + (isFlip ? (up ? "CDLx" : "CDSx") : (up ? "LDx" : "SDx") + str.tostring(eNum))
        po4Seq += 1
        ZCause cz = ZCause.new(kind, eBrkP, nz(eBrkT, bT), bT, up, pass, f_againstHtf(eDir))
        po4s.push(ZPO.new(eTnP, nz(eTnT, bT), eDir, isFlip ? 1 : eNum + 1, pass, po4Seq, eOH, eOL, nz(eOT, bT), cz))
        while po4s.size() > maxKeep
            po4s.shift()
        if isFlip
            hitXD   := false
            hitXP   := false
            bullImp := false
            bullPb  := false
            bearImp := false
            bearPb  := false
            ev_cdl  := pass and up
            ev_cds  := pass and not up
        else
            bullImp := false
            bullPb  := false
            bearImp := false
            bearPb  := false
            ev_ld   := pass and up
            ev_sd   := pass and not up
    // BOX LIFETIME: a box that did NOT turn into a PO4 (and is not the live P# / R#)
    // is deleted on a block close through it (bear box: above its top · bull box: below its bottom).
    if pastBox.size() > 0
        for i = pastBox.size() - 1 to 0
            ZBox zb = pastBox.get(i)
            bool married = (not na(zPT) and zb.t1 == zPT) or (not na(zRT) and zb.t1 == zRT)
            if not married and po4s.size() > 0
                for p in po4s
                    if p.oT == zb.t1
                        married := true
                        break
            bool bearBox = zb.ndb < 0
            if not married and ((bearBox and bC > zb.top) or (not bearBox and bC < zb.bot))
                pastBox.remove(i)
    prevSide := zSide

// ═══════════════════════════════════════════════════════════════
// BALANCE CONTROL — read at every closed structure candle inside the live box
// ═══════════════════════════════════════════════════════════════
var int   ctlBoxT = na
var int   ctlK    = 0
var float ctlPos  = na
var float ctlUp   = na
float ctlUpPrev = ctlUp
if stepNow
    if eLive and not na(eBxH) and not na(eBxL) and eBxH > eBxL
        if na(ctlBoxT) or ctlBoxT != eBxT
            ctlBoxT := eBxT
            ctlK    := 1
        else
            ctlK += 1
        ctlPos := math.max(0.0, math.min(1.0, (bC - eBxL) / (eBxH - eBxL)))
        ctlUp  := f_ctlUp(ctlPos, ctlK)
    else
        ctlBoxT := na
        ctlK    := 0
        ctlPos  := na
        ctlUp   := na
float ctlMinF = ctl_min / 100.0
bool ev_ctlBuy  = stepNow and not na(ctlUp) and ctlUp >= ctlMinF and (na(ctlUpPrev) or ctlUpPrev < ctlMinF)
bool ev_ctlSell = stepNow and not na(ctlUp) and 1 - ctlUp >= ctlMinF and (na(ctlUpPrev) or 1 - ctlUpPrev < ctlMinF)

bool ctlTested = not expMode and boxGrow
f_ctlText(float up, int k, float ndb, int th) =>
    string d  = ctl_delta ? (ndb >= 0.05 ? " · Δ+" : ndb <= -0.05 ? " · Δ−" : " · Δ0") : ""
    string md = ctlTested ? "" : "untested mode · "
    string tx = th == 2 ? "BUYERS " + str.tostring(math.round(up * 100)) + "% up" : th == 0 ? "SELLERS " + str.tostring(math.round((1 - up) * 100)) + "% down" : "NO CONTROL · " + str.tostring(math.round(up * 100)) + "% up"
    md + tx + " · " + str.tostring(k) + "c" + d

f_pocTip(float p, float pv, float tv, float r, int w, bool live) =>
    "vPOC " + str.tostring(p, format.mintick) + (live ? " · live box" : " · ended box") + "\nThe price with the most volume inside the box (each structure candle's volume spread evenly over its range, " + str.tostring(poc_bins) + " rows).\n" + str.tostring(math.round(tv > 0 ? pv / tv * 100 : 0)) + "% of the box volume sits at this row.\nLine width " + str.tostring(w) + " / 6 = POC volume ×" + str.tostring(r, "0.0") + " the average POC of the last 20 boxes.\nTested as an ENTRY: the POC did no better than the P / MP / BAL ladder (±0.02 avg RR), and winners touched it first only 5–11%. Use it as information, not as the entry."

// ═══════════════════════════════════════════════════════════════
// SWING ENGINE s — protected levels (structure timeframe)
// ═══════════════════════════════════════════════════════════════
var float swTH  = na
var int   swTHT = na
var float swTL  = na
var int   swTLT = na
var int   swSt  = 0
var array<float> shP = array.new<float>()
var array<int>   shT = array.new<int>()
var array<float> slP = array.new<float>()
var array<int>   slT = array.new<int>()
if stepNow and not na(bH1)
    if na(swTH)
        swTH  := bH
        swTHT := bT
        swTL  := bL
        swTLT := bT
    if swSt == 0
        if bH > swTH
            swTH  := bH
            swTHT := bT
        if bL < swTL
            swTL  := bL
            swTLT := bT
    if swSt == 1 and bH >= swTH
        swTH  := bH
        swTHT := bT
    if swSt == -1 and bL <= swTL
        swTL  := bL
        swTLT := bT
    bool sBu = bC > bH1
    bool sBe = bC < bL1
    if sBe and swSt >= 0
        shP.push(swTH)
        shT.push(swTHT)
        swSt  := -1
        swTL  := bL
        swTLT := bT
    else if sBu and swSt <= 0
        slP.push(swTL)
        slT.push(swTLT)
        swSt  := 1
        swTH  := bH
        swTHT := bT
    if shP.size() > 0
        for i = shP.size() - 1 to 0
            if shT.get(i) < bT and bC > shP.get(i)
                shP.remove(i)
                shT.remove(i)
    if slP.size() > 0
        for i = slP.size() - 1 to 0
            if slT.get(i) < bT and bC < slP.get(i)
                slP.remove(i)
                slT.remove(i)
    while shP.size() > 20
        shP.shift()
        shT.shift()
    while slP.size() > 20
        slP.shift()
        slT.shift()

// ═══════════════════════════════════════════════════════════════
// PULLBACK ZONE — after a closed structure BC / AFs+ candle
// ═══════════════════════════════════════════════════════════════
var int    pzSide = 0
var float  pzTop  = na
var float  pzBot  = na
var int    pzT    = na
var float  pzTgt  = na
var float  pzProt = na
var int    pzN    = 0
var int    pzType = -1
var bool   pzPlus = true
var string pzEnd  = ""
if stepNow and not na(bH1)
    // 1) the live zone reads this candle first
    if pzSide != 0
        bool tgtHit = pzSide == 1 ? bH > pzTgt : bL < pzTgt
        bool prtHit = pzSide == 1 ? bL < pzProt : bH > pzProt
        pzN += 1
        if tgtHit or prtHit or pzN >= 3
            pzEnd  := tgtHit ? "target taken" : prtHit ? "protected end broke" : "expired"
            pzSide := 0
    // 2) a new zone from this candle
    int pty = f_mmcb(bO, bH, bL, bC, bH1, bL1)
    bool okT = pty == 0 or pty == 1 or pty == 2 or pty == 3 or pty == 4 or pty == 8 or pty == 9 or pty == 10 or pty == 11 or pty == 12
    float prg = bH - bL
    if okT and prg > 0
        int   s    = MM_SIDE.get(pty)
        bool  plus = pty == 0 or pty == 2 or pty == 4 or pty == 8 or pty == 10 or pty == 12
        float lvA  = s == 1 ? bL + (plus ? 0.875 : 0.5) * prg : bH - (plus ? 0.875 : 0.5) * prg
        float lvB  = s == 1 ? bL + (plus ? 0.75 : 0.25) * prg : bH - (plus ? 0.75 : 0.25) * prg
        float zt   = math.max(lvA, lvB)
        float zbm  = math.min(lvA, lvB)
        if s == 1
            zt := math.min(zt, bC)
        else
            zbm := math.max(zbm, bC)
        // a plus candle that closed under its MP has no P–MP pullback left: use its BAL–MD band (tested BAL odds)
        if plus and zt <= zbm
            plus := false
            lvA  := s == 1 ? bL + 0.5 * prg : bH - 0.5 * prg
            lvB  := s == 1 ? bL + 0.25 * prg : bH - 0.25 * prg
            zt   := math.max(lvA, lvB)
            zbm  := math.min(lvA, lvB)
            if s == 1
                zt := math.min(zt, bC)
            else
                zbm := math.max(zbm, bC)
        if zt > zbm
            pzSide := s
            pzTop  := zt
            pzBot  := zbm
            pzT    := bT
            pzTgt  := s == 1 ? bH : bL
            pzProt := s == 1 ? bL : bH
            pzN    := 0
            pzType := pty
            pzPlus := plus
            pzEnd  := ""

f_pzText() =>
    string nm = MM_NAME.get(pzType)
    string st = ""
    if pbz_stats
        if pzPlus
            st := " · P fills " + f_pct(f_od(OD_PF, TFI_ST, pzType)) + " → target " + f_pct(f_od(OD_PW, TFI_ST, pzType)) + " · MP " + f_pct(f_od(OD_MF, TFI_ST, pzType)) + " → " + f_pct(f_od(OD_MW, TFI_ST, pzType))
        else
            st := " · BAL fills " + f_pct(f_od(OD_BF, TFI_ST, pzType)) + " → target " + f_pct(f_od(OD_BW, TFI_ST, pzType))
    TFP + nm + (pzPlus ? " P–MP" : " BAL–MD") + st + (pbz_stats ? " (" + TF_TEST.get(TFI_ST) + " test)" : "")

// ═══════════════════════════════════════════════════════════════
// CHART-TIMEFRAME CANDLES: compass ring buffer + GMC tags
// ═══════════════════════════════════════════════════════════════
int ch_ty = f_mmcb(open, high, low, close, high[1], low[1])
var array<int>   cmT  = array.new<int>()
var array<float> cmH  = array.new<float>()
var array<float> cmL  = array.new<float>()
var array<int>   cmY  = array.new<int>()
if barstate.isconfirmed and ch_ty >= 0
    cmT.push(time)
    cmH.push(high)
    cmL.push(low)
    cmY.push(ch_ty)
    while cmT.size() > 60
        cmT.shift()
        cmH.shift()
        cmL.shift()
        cmY.shift()

// GMC (chart TF): c1 = [2], c2 = [1], c3 = this candle
bool gm_bull = close[1] > high[2] and low > high[2]
bool gm_bear = close[1] < low[2] and high < low[2]
f_gmGroup(int ty, bool bull) =>
    string g = "other"
    if bull
        g := ty == 0 or ty == 2 ? "BC+" : ty == 1 or ty == 3 ? "BC−" : ty == 6 or ty == 14 ? "CI" : ty == 12 or ty == 13 ? "AFs against" : ty == 4 or ty == 5 ? "AFs with" : "other"
    else
        g := ty == 8 or ty == 10 ? "BC+" : ty == 9 or ty == 11 ? "BC−" : ty == 6 or ty == 14 ? "CI" : ty == 4 or ty == 5 ? "AFs against" : ty == 12 or ty == 13 ? "AFs with" : "other"
    g
string gm_grp  = gm_bull or gm_bear ? f_gmGroup(ch_ty, gm_bull) : ""
int    gm_sec  = timeframe.in_seconds(timeframe.period)
bool   gm_gold = (gm_bull and gm_grp == "BC−" and gm_sec == 14400) or (gm_bear and gm_grp == "BC−" and gm_sec == 3600 and ed_win) or (gm_bull and gm_grp == "AFs against" and gm_sec == 3600) or ((gm_bull or gm_bear) and gm_grp == "AFs against" and gm_sec == 900 and ed_win)

f_gmGi(string g) =>
    g == "BC+" ? 0 : g == "BC−" ? 1 : g == "CI" ? 2 : g == "AFs against" ? 3 : g == "AFs with" ? 4 : 5

// index into the GM_ tables (-1 = timeframe not tested: Daily and up)
f_gmIdx(int side, string g) =>
    TFI_CH < 4 ? TFI_CH * 12 + (side == 1 ? 0 : 6) + f_gmGi(g) : -1

// short text at the line: fixed 50 · 1:2 · WR and avg RR, NQ 2022–25 → MNQ 2026
f_gmShort(int i) =>
    string r = ""
    if i < 0
        r := "not tested on this TF"
    else if GM_W1.get(i) < 0
        r := "under 20 tests"
    else
        r := "1:2 WR " + str.tostring(GM_W1.get(i)) + "%→" + (GM_W2.get(i) < 0 ? "—" : str.tostring(GM_W2.get(i)) + "%") + " · avg RR " + f_rr(GM_R1.get(i)) + "→" + f_rr(GM_R2.get(i))
    r

f_gmGoldTip(int side, string g) =>
    string r = ""
    if side == 1 and g == "BC−" and gm_sec == 14400
        r := "\n★ 4H GMC▲ c3 BC−: ATR×1.5 · 1:2 · 2-NBC exit = 130 trades WR 55% +0.20 → 41 trades WR 56% +0.22. Small sample: size small."
    else if side == -1 and g == "BC−" and gm_sec == 3600
        r := "\n★ 1h GMC▼ c3 BC−, Asia + NY AM only: fixed 50 · 1:2 = 176 trades WR 42% +0.24 → 62 trades WR 39% +0.14."
    else if side == 1 and g == "AFs against" and gm_sec == 3600
        r := "\n★ 1h GMC▲ c3 AFs against: fixed 50 · 1:2 = 626 trades WR 40% +0.16 → 185 trades WR 37% +0.10."
    else if g == "AFs against" and gm_sec == 900
        r := "\n★ 15m GMC c3 AFs against, Asia + NY AM: fixed 50 · 1:2 = 2,388 trades WR 37% +0.08 → 262 WR 34% −0.01 (gone) · ATR×1 · 1:6 = WR 19% +0.19 → 19% +0.20 (held)."
    r

f_gmTip(int i, int side, string g, float lvl, bool gd) =>
    string tf = i < 0 ? "" : TF_TEST.get(TFI_CH)
    string s  = "GMC " + (side == 1 ? "▲ bull" : "▼ bear") + " · candle 3 = " + g + "\nGMC OPEN " + str.tostring(lvl, format.mintick) + " = the open of the gap candle (c2)."
    s += "\nDeleted when " + (gmc_kill == "Close through the GMC open" ? "a candle closes back through the GMC open" : gmc_kill == "Close through c1 (gap closed)" ? "a candle closes back through c1 (the gap is closed)" : "it is pushed out by newer GMCs (delete rule off)") + "."
    if i < 0
        s += "\nNot tested on this timeframe (Daily and up: too few GMCs)."
    else
        s += "\nTESTED · " + tf + " · entry = c3 close · all sessions · NQ 2022–25 → MNQ 2026:"
        s += "\n• fixed 50 · 1:2: " + f_num(GM_N1.get(i)) + " trades · WR " + (GM_W1.get(i) < 0 ? "—" : str.tostring(GM_W1.get(i)) + "%") + " · " + f_rr(GM_R1.get(i)) + " avg RR  →  " + f_num(GM_N2.get(i)) + " · WR " + (GM_W2.get(i) < 0 ? "—" : str.tostring(GM_W2.get(i)) + "%") + " · " + f_rr(GM_R2.get(i))
        s += "\n• ATR×1.5 · 1:2 · exit at the 2nd NBC: WR " + (GM_W3.get(i) < 0 ? "—" : str.tostring(GM_W3.get(i)) + "%") + " · " + f_rr(GM_R3.get(i)) + "  →  WR " + (GM_W4.get(i) < 0 ? "—" : str.tostring(GM_W4.get(i)) + "%") + " · " + f_rr(GM_R4.get(i))
        s += "\nEntry AT the GMC open (XU) was tested too: it lost on 1h, ≈ the c3 close elsewhere."
    s + (gd ? f_gmGoldTip(side, g) : "")

var array<int>    gmT  = array.new<int>()
var array<int>    gmT2 = array.new<int>()
var array<float>  gmP  = array.new<float>()
var array<float>  gmO  = array.new<float>()
var array<float>  gmC1 = array.new<float>()
var array<int>    gmS  = array.new<int>()
var array<string> gmX  = array.new<string>()
var array<bool>   gmG  = array.new<bool>()
var array<int>    gmI  = array.new<int>()
var int gmDead = 0
bool ev_gmGoldL = false
bool ev_gmGoldS = false
f_gmRemove(int i) =>
    gmT.remove(i)
    gmT2.remove(i)
    gmP.remove(i)
    gmO.remove(i)
    gmC1.remove(i)
    gmS.remove(i)
    gmX.remove(i)
    gmG.remove(i)
    gmI.remove(i)
    true
if barstate.isconfirmed
    // 1) DELETE violated GMCs (checked on every later closed candle)
    if gmc_kill != "Off" and gmT.size() > 0
        for i = gmT.size() - 1 to 0
            int   sd  = gmS.get(i)
            float lvl = gmc_kill == "Close through the GMC open" ? gmO.get(i) : gmC1.get(i)
            if time > gmT.get(i) and (sd == 1 ? close < lvl : close > lvl)
                f_gmRemove(i)
                gmDead += 1
    // 2) a new GMC on this closed candle
    if gm_bull or gm_bear
        int sd = gm_bull ? 1 : -1
        gmT.push(time)
        gmT2.push(time[1])
        gmP.push(gm_bull ? low : high)
        gmO.push(open[1])
        gmC1.push(gm_bull ? high[2] : low[2])
        gmS.push(sd)
        gmX.push(gm_grp)
        gmG.push(gm_gold)
        gmI.push(f_gmIdx(sd, gm_grp))
        ev_gmGoldL := gm_gold and gm_bull
        ev_gmGoldS := gm_gold and gm_bear
    while gmT.size() > 60
        f_gmRemove(0)

// ═══════════════════════════════════════════════════════════════
// CANDLE COLORING (chart timeframe, closed candles)
// ═══════════════════════════════════════════════════════════════
bool cBu = close > high[1]
bool cBe = close < low[1]
color ccm_base_bull = ccm_mmm_theme ? #27ffc3 : #00c853
color ccm_base_bear = ccm_mmm_theme ? #9c27b0 : #d50000
f_ccm_zone(float price, float bodyTop, float bodyBot, float hi, float lo) =>
    price > hi ? 1 : price > bodyTop ? 2 : price >= bodyBot ? 3 : price >= lo ? 4 : 5
int  ccm_z   = f_ccm_zone(close, math.max(open[1], close[1]), math.min(open[1], close[1]), high[1], low[1])
int  ccm_mag = math.abs(ccm_z - 3)
color candleColor = na
if barstate.isconfirmed
    if colorMode == "BC / NBC (x)"
        candleColor := cBu ? c_bull_bc : cBe ? c_bear_bc : c_nbc
    else if colorMode == "Conviction (c)"
        bool nbcC = not (close > high[1] or open > high[1]) and not (close < low[1] or open < low[1])
        if nbcC
            candleColor := c_nbc
        else if close == open
            candleColor := #616161
        else if ccm_z < 3 and close < open
            candleColor := color.red
        else if ccm_z > 3 and close > open
            candleColor := color.lime
        else if ccm_z == 3 and close < open
            candleColor := #9e9e9e
        else if ccm_z < 3
            candleColor := ccm_mag == 2 ? ccm_base_bull : color.new(ccm_base_bull, 40)
        else if ccm_z > 3
            candleColor := ccm_mag == 2 ? ccm_base_bear : color.new(ccm_base_bear, 40)
        else
            candleColor := color.new(ccm_base_bull, 80)
barcolor(candleColor)

// ═══════════════════════════════════════════════════════════════
// STRUCTURAL VOIDS (c) — chart timeframe, closed candles
// ═══════════════════════════════════════════════════════════════
type GapBox
    box    b
    line   l
    label  lbl
    float  top
    float  bot
    bool   isBull
    string gType
    bool   isTouched
    bool   stoppedExtending
    color  origBg
    color  origBorder
    color  origLine
    color  origLblText
    int    creationBar
    float  mid
    box[]  slices
    bool[] sliceTouched
    bool   greyed = false
    bool   dim    = false
    int    t      = 0

var array<GapBox> visual_gaps = array.new<GapBox>()

f_buildSlices(float gTop, float gBot, color bgCol, int le, int re) =>
    box[]  sl  = array.new<box>()
    bool[] tch = array.new<bool>()
    float h = (gTop - gBot) / slices_count
    for k = 0 to slices_count - 1
        sl.push(box.new(le, gTop - k * h, re, gTop - (k + 1) * h, bgcolor=bgCol, border_color=na))
        tch.push(false)
    [sl, tch]

method erase(GapBox u) =>
    if not na(u.b)
        box.delete(u.b)
    if not na(u.l)
        line.delete(u.l)
    if not na(u.lbl)
        label.delete(u.lbl)
    for s in u.slices
        box.delete(s)

if barstate.isconfirmed and show_all_gaps
    float udg_min = min_udg_ticks * syminfo.mintick
    bool  bullUdg = (low - high[2]) >= udg_min and close[1] > high[2] and not (low > high[1])
    bool  bearUdg = (low[2] - high) >= udg_min and close[1] < low[2] and not (high < low[1])
    float bull_gap_top = math.min(close, open)
    float bull_gap_bot = math.max(close[1], open[1])
    bool  bull_ulg_now = open > close[1] and high[1] > low and close > close[1] and open > open[1] and high[1] < bull_gap_top
    bool  bull_uog_now = low > high[1]
    float bear_gap_top = math.min(close[1], open[1])
    float bear_gap_bot = math.max(close, open)
    bool  bear_ulg_now = open < close[1] and low[1] < high and close < close[1] and open < open[1] and low[1] > bear_gap_bot
    bool  bear_uog_now = high < low[1]
    color grey_box  = color.new(#636363, 85)
    color grey_line = color.new(#636363, 60)
    if visual_gaps.size() > 0
        for i = visual_gaps.size() - 1 to 0
            GapBox u = visual_gaps.get(i)
            bool isFilled     = false
            bool newlyTouched = false
            bool isSlicedLoop = gapExtMode == "Filled & Unfilled (Sliced)"
            if bar_index >= u.creationBar
                if u.isBull
                    if low <= u.top and not u.isTouched
                        u.isTouched  := true
                        newlyTouched := true
                    if low <= u.bot
                        isFilled := true
                    if not u.stoppedExtending and not isSlicedLoop and not na(u.mid) and low <= u.mid
                        u.stoppedExtending := true
                        u.greyed := true
                        if u.gType == "ULG"
                            box.set_border_color(u.b, grey_line)
                        else
                            box.set_bgcolor(u.b, grey_box)
                        if not na(u.l)
                            line.set_color(u.l, grey_line)
                        if not na(u.lbl)
                            label.set_textcolor(u.lbl, color.new(gap_lbl_col, 70))
                else
                    if high >= u.bot and not u.isTouched
                        u.isTouched  := true
                        newlyTouched := true
                    if high >= u.top
                        isFilled := true
                    if not u.stoppedExtending and not isSlicedLoop and not na(u.mid) and high >= u.mid
                        u.stoppedExtending := true
                        u.greyed := true
                        if u.gType == "ULG"
                            box.set_border_color(u.b, grey_line)
                        else
                            box.set_bgcolor(u.b, grey_box)
                        if not na(u.l)
                            line.set_color(u.l, grey_line)
                        if not na(u.lbl)
                            label.set_textcolor(u.lbl, color.new(gap_lbl_col, 70))
            if newlyTouched and not isSlicedLoop
                if not u.stoppedExtending
                    u.dim := true
                    if u.gType == "ULG"
                        box.set_border_color(u.b, color.new(u.origBorder, 80))
                    else
                        box.set_bgcolor(u.b, color.new(u.origBg, 85))
                    if not na(u.l)
                        line.set_color(u.l, color.new(u.origLine, 80))
                    if not na(u.lbl)
                        label.set_textcolor(u.lbl, color.new(u.origLblText, 70))
                if gapExtMode == "Until First Touch"
                    u.stoppedExtending := true
            if isSlicedLoop and not isFilled and u.slices.size() > 0
                for j = 0 to u.slices.size() - 1
                    if not u.sliceTouched.get(j)
                        box sBox = u.slices.get(j)
                        if high >= box.get_bottom(sBox) and low <= box.get_top(sBox)
                            box.set_bgcolor(sBox, col_partial)
                            box.set_border_color(sBox, na)
                            u.sliceTouched.set(j, true)
                            box.set_right(sBox, bar_index)
            if hide_filled and isFilled
                u.erase()
                visual_gaps.remove(i)
            else if not isFilled
                if isSlicedLoop and u.slices.size() > 0
                    for j = 0 to u.slices.size() - 1
                        if not u.sliceTouched.get(j)
                            box.set_right(u.slices.get(j), bar_index + 1)
                    if not na(u.l)
                        line.set_x2(u.l, bar_index + 1)
                else if not u.stoppedExtending
                    box.set_right(u.b, bar_index + 1)
                    if not na(u.l)
                        line.set_x2(u.l, bar_index + 1)
                    if not na(u.lbl) and gap_lbl_side == "Right"
                        label.set_x(u.lbl, bar_index + 1)
    bool isMini   = gapExtMode == "Minimalistic"
    bool isSliced = gapExtMode == "Filled & Unfilled (Sliced)"
    int  upg_right = isMini ? bar_index + mini_len : bar_index + 1
    int  gap_lbl_x = gap_lbl_side == "Right" ? upg_right : bar_index - 1
    if show_vi and bull_ulg_now
        int le = bar_index - 1
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x, math.avg(bull_gap_top, bull_gap_bot), "ULG+", color=color.new(color.white, 100), textcolor=gap_lbl_col, style=label.style_none, size=f_lsz(gap_size)) : label(na)
        box bx_g = isSliced ? box.new(le, bull_gap_top, upg_right, bull_gap_bot, border_color=na, bgcolor=color.new(bull_vi_css, 100)) : box.new(le, bull_gap_top, upg_right, bull_gap_bot, border_color=bull_vi_css, bgcolor=na, border_style=line.style_dotted)
        line ln_g = show_midlines ? line.new(le, math.avg(bull_gap_top, bull_gap_bot), upg_right, math.avg(bull_gap_top, bull_gap_bot), color=color.new(bull_vi_css, 0), style=line.style_dotted, width=1) : line(na)
        box[] sl_g = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp, tch_tmp] = f_buildSlices(bull_gap_top, bull_gap_bot, color.new(bull_vi_css, 60), le, upg_right)
            sl_g  := sl_tmp
            tch_g := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=bull_gap_top, bot=bull_gap_bot, isBull=true, gType="ULG", isTouched=false, stoppedExtending=isMini, origBg=color(na), origBorder=bull_vi_css, origLine=color.new(bull_vi_css, 0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(bull_gap_top, bull_gap_bot), slices=sl_g, sliceTouched=tch_g))
    if show_og and bull_uog_now
        int le = bar_index - 1
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x, math.avg(low, high[1]), "UOG+", color=color.new(color.white, 100), textcolor=gap_lbl_col, style=label.style_none, size=f_lsz(gap_size)) : label(na)
        box bx_g = isSliced ? box.new(le, low, upg_right, high[1], border_color=na, bgcolor=color.new(bull_og_css, 100)) : box.new(le, low, upg_right, high[1], border_color=na, bgcolor=bull_og_css)
        line ln_g = show_midlines ? line.new(le, math.avg(low, high[1]), upg_right, math.avg(low, high[1]), color=color.new(bull_og_css, 0), style=line.style_dotted, width=1) : line(na)
        box[] sl_g = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp, tch_tmp] = f_buildSlices(low, high[1], bull_og_css, le, upg_right)
            sl_g  := sl_tmp
            tch_g := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=low, bot=high[1], isBull=true, gType="UOG", isTouched=false, stoppedExtending=isMini, origBg=bull_og_css, origBorder=color(na), origLine=color.new(bull_og_css, 0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(low, high[1]), slices=sl_g, sliceTouched=tch_g))
    if show_upg and bullUdg
        int le = bar_index - 2
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x, math.avg(low, high[2]), "UDG+", color=color.new(color.white, 100), textcolor=gap_lbl_col, style=label.style_none, size=f_lsz(gap_size)) : label(na)
        box bx_g = isSliced ? box.new(le, low, upg_right, high[2], border_color=na, bgcolor=color.new(bull_upg_css, 100)) : box.new(le, low, upg_right, high[2], border_color=na, bgcolor=bull_upg_css)
        line ln_g = show_midlines ? line.new(le, math.avg(low, high[2]), upg_right, math.avg(low, high[2]), color=color.new(bull_upg_css, 0), style=line.style_dotted, width=1) : line(na)
        box[] sl_g = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp, tch_tmp] = f_buildSlices(low, high[2], bull_upg_css, le, upg_right)
            sl_g  := sl_tmp
            tch_g := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=low, bot=high[2], isBull=true, gType="UDG", isTouched=false, stoppedExtending=isMini, origBg=bull_upg_css, origBorder=color(na), origLine=color.new(bull_upg_css, 0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(low, high[2]), slices=sl_g, sliceTouched=tch_g))
    if show_vi and bear_ulg_now
        int le = bar_index - 1
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x, math.avg(bear_gap_top, bear_gap_bot), "ULG-", color=color.new(color.white, 100), textcolor=gap_lbl_col, style=label.style_none, size=f_lsz(gap_size)) : label(na)
        box bx_g = isSliced ? box.new(le, bear_gap_top, upg_right, bear_gap_bot, border_color=na, bgcolor=color.new(bear_vi_css, 100)) : box.new(le, bear_gap_top, upg_right, bear_gap_bot, border_color=bear_vi_css, bgcolor=na, border_style=line.style_dotted)
        line ln_g = show_midlines ? line.new(le, math.avg(bear_gap_top, bear_gap_bot), upg_right, math.avg(bear_gap_top, bear_gap_bot), color=color.new(bear_vi_css, 0), style=line.style_dotted, width=1) : line(na)
        box[] sl_g = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp, tch_tmp] = f_buildSlices(bear_gap_top, bear_gap_bot, color.new(bear_vi_css, 60), le, upg_right)
            sl_g  := sl_tmp
            tch_g := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=bear_gap_top, bot=bear_gap_bot, isBull=false, gType="ULG", isTouched=false, stoppedExtending=isMini, origBg=color(na), origBorder=bear_vi_css, origLine=color.new(bear_vi_css, 0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(bear_gap_top, bear_gap_bot), slices=sl_g, sliceTouched=tch_g))
    if show_og and bear_uog_now
        int le = bar_index - 1
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x, math.avg(low[1], high), "UOG-", color=color.new(color.white, 100), textcolor=gap_lbl_col, style=label.style_none, size=f_lsz(gap_size)) : label(na)
        box bx_g = isSliced ? box.new(le, low[1], upg_right, high, border_color=na, bgcolor=color.new(bear_og_css, 100)) : box.new(le, low[1], upg_right, high, border_color=na, bgcolor=bear_og_css)
        line ln_g = show_midlines ? line.new(le, math.avg(low[1], high), upg_right, math.avg(low[1], high), color=color.new(bear_og_css, 0), style=line.style_dotted, width=1) : line(na)
        box[] sl_g = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp, tch_tmp] = f_buildSlices(low[1], high, bear_og_css, le, upg_right)
            sl_g  := sl_tmp
            tch_g := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=low[1], bot=high, isBull=false, gType="UOG", isTouched=false, stoppedExtending=isMini, origBg=bear_og_css, origBorder=color(na), origLine=color.new(bear_og_css, 0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(low[1], high), slices=sl_g, sliceTouched=tch_g))
    if show_upg and bearUdg
        int le = bar_index - 2
        label lbl_g = show_gap_labels ? label.new(gap_lbl_x, math.avg(low[2], high), "UDG-", color=color.new(color.white, 100), textcolor=gap_lbl_col, style=label.style_none, size=f_lsz(gap_size)) : label(na)
        box bx_g = isSliced ? box.new(le, low[2], upg_right, high, border_color=na, bgcolor=color.new(bear_upg_css, 100)) : box.new(le, low[2], upg_right, high, border_color=na, bgcolor=bear_upg_css)
        line ln_g = show_midlines ? line.new(le, math.avg(low[2], high), upg_right, math.avg(low[2], high), color=color.new(bear_upg_css, 0), style=line.style_dotted, width=1) : line(na)
        box[] sl_g = array.new<box>()
        bool[] tch_g = array.new<bool>()
        if isSliced
            [sl_tmp, tch_tmp] = f_buildSlices(low[2], high, bear_upg_css, le, upg_right)
            sl_g  := sl_tmp
            tch_g := tch_tmp
        visual_gaps.push(GapBox.new(b=bx_g, l=ln_g, lbl=lbl_g, top=low[2], bot=high, isBull=false, gType="UDG", isTouched=false, stoppedExtending=isMini, origBg=bear_upg_css, origBorder=color(na), origLine=color.new(bear_upg_css, 0), origLblText=gap_lbl_col, creationBar=bar_index, t=time, mid=math.avg(low[2], high), slices=sl_g, sliceTouched=tch_g))
    if maxGaps > 0
        while visual_gaps.size() > maxGaps
            visual_gaps.get(0).erase()
            visual_gaps.remove(0)

// Void shown / hidden by the range rule, restored to the colour it had.
f_proGapPaint(GapBox u, bool vis) =>
    color hid = color.new(#000000, 100)
    color gl  = color.new(#636363, 60)
    color gb  = color.new(#636363, 85)
    if u.slices.size() > 0
        for j = 0 to u.slices.size() - 1
            color sb = u.sliceTouched.get(j) ? col_partial : (u.gType == "ULG" ? color.new(u.origBorder, 60) : u.origBg)
            box.set_bgcolor(u.slices.get(j), vis ? sb : hid)
    else
        if u.gType == "ULG"
            box.set_border_color(u.b, vis ? (u.greyed ? gl : u.dim ? color.new(u.origBorder, 80) : u.origBorder) : hid)
        else
            box.set_bgcolor(u.b, vis ? (u.greyed ? gb : u.dim ? color.new(u.origBg, 85) : u.origBg) : hid)
    if not na(u.l)
        line.set_color(u.l, vis ? (u.greyed ? gl : u.dim ? color.new(u.origLine, 80) : u.origLine) : hid)
    if not na(u.lbl)
        label.set_textcolor(u.lbl, vis ? (u.greyed or u.dim ? color.new(u.origLblText, 70) : u.origLblText) : hid)

// ═══════════════════════════════════════════════════════════════
// RENDER — on the last bar everything is deleted and redrawn from state.
// ═══════════════════════════════════════════════════════════════
f_ndbCol(float ndb) =>
    color.new(ndb >= 0.05 ? BOX_ACC : ndb <= -0.05 ? BOX_DIS : BOX_NEU, boxTransp)

if barstate.islast
    f_clear_drawn()
    int futureT = f_future_time(line_ext)

    // Trend markers
    ZPO lastBull = na
    ZPO starBull = na
    ZPO lastBear = na
    ZPO starBear = na
    if po4s.size() > 0
        for p in po4s
            if p.side == 1
                if na(lastBull) or p.seq > lastBull.seq
                    lastBull := p
                if p.tier == 1 and (na(starBull) or p.seq > starBull.seq)
                    starBull := p
            else
                if na(lastBear) or p.seq > lastBear.seq
                    lastBear := p
                if p.tier == 1 and (na(starBear) or p.seq > starBear.seq)
                    starBear := p
    float rHi = na
    float rLo = na
    int   hiT = na
    int   loT = na
    for m in array.from(lastBull, starBull, lastBear, starBear)
        if not na(m)
            if na(rHi) or m.price > rHi
                rHi := m.price
                hiT := m.t
            if na(rLo) or m.price < rLo
                rLo := m.price
                loT := m.t
    int spanMs = timeframe.in_seconds(blockTF) * 1000
    array<int> q = f_quota()
    bool pCf = not gateOn or ePConf

    // 1. PO4s, newest first (PO4 + break + zone = ONE item)
    array<ZPO> vis = array.new<ZPO>()
    if po4s.size() > 0
        array<int> sq = array.new<int>()
        for p in po4s
            sq.push(p.seq)
        array<int> ord = sq.sort_indices(order.descending)
        for k = 0 to ord.size() - 1
            ZPO p = po4s.get(ord.get(k))
            if f_take(q, f_inR(p.price, rHi, rLo) or f_onMarker(p.t, hiT, loT, spanMs), p.side == 1)
                vis.push(p)

    if vis.size() > 0
        for p in vis
            bool  isBull = p.side == 1
            bool  isTn   = (zSide == 1 and not na(lastBull) and p.seq == lastBull.seq) or (zSide == -1 and not na(lastBear) and p.seq == lastBear.seq)
            color c      = p.official ? (isBull ? c_bull_po4 : c_bear_po4) : FAIL_COL
            string txt   = TFP + (isBull ? "BuPO4x" : "BePO4x") + " T" + str.tostring(p.tier) + (p.official ? "" : " ✗")
            f_add_level(p.price, txt, c, isTn ? 2 : 1, line.style_solid, p.t, futureT, isTn ? 6 : 5, f_lsz(lvl_size), isTn ? "Current T# (the trend origin). A block close through it = the flip." : "PO4 x. A block close through it deletes it with its break and zone.")
            ZCause cz = p.cause
            if showBreaks and not na(cz) and (cz.pass or show_failed)
                color bc = not cz.pass ? FAIL_COL : htf_dim and cz.against ? color.new(FAIL_COL, 30) : isBull ? c_bull_po4 : c_bear_po4
                drawn_lines.push(line.new(cz.t1, cz.price, cz.t2, cz.price, xloc=xloc.bar_time, color=bc, width=1, style=cz.pass ? line.style_solid : line.style_dotted))
                drawn_labels.push(label.new(int(math.avg(cz.t1, cz.t2)), cz.price, cz.kind, xloc=xloc.bar_time, color=color(na), textcolor=bc, style=cz.isBull ? label.style_label_down : label.style_label_up, size=f_szs(f_lsz(brk_size)), tooltip=cz.kind + (cz.against ? "\nAgainst the HTF bias" : "")))
            bool showZ = p.tier == 1 ? show_eblk : show_iblk
            if showZ and p.official and not na(p.oH) and not na(p.oL) and p.oH > p.oL
                [zT, zB] = f_zoneSlice(p.oH, p.oL, isBull)
                color zc = isBull ? c_bull_po4 : c_bear_po4
                drawn_boxes.push(box.new(p.oT, zT, futureT, zB, xloc=xloc.bar_time, border_color=na, bgcolor=color.new(zc, zone_transp), text=zone_show_name ? TFP + f_zoneName(p.tier == 1, isBull, ENG) : "", text_color=color.new(zc, 20), text_size=f_lsz(zone_size), text_halign=text.align_right, text_valign=text.align_center))

    // Current range: P# and R#
    if showPR and zSide != 0
        bool pOk = not na(zPP) and (showLiveAlways or f_take(q, f_inR(zPP, rHi, rLo) or f_onMarker(zPT, hiT, loT, spanMs), zSide == -1))
        bool rOk = not na(zRP) and (showLiveAlways or f_take(q, f_inR(zRP, rHi, rLo) or f_onMarker(zRT, hiT, loT, spanMs), zSide == 1))
        if pOk
            f_add_level(zPP, TFP + (pCf ? (zSide == 1 ? "BeP" : "BuP") : (zSide == 1 ? "bep" : "bup")) + str.tostring(zTier) + "x" + (pCf ? "" : " · p"), color.new(zSide == 1 ? c_bear_po4 : c_bull_po4, pCf ? 0 : 40), 1, line.style_dashed, zPT, futureT, 4, f_lsz(lvl_size), pCf ? "P# = pullback start. A block close " + (zSide == 1 ? "above" : "below") + " it = " + (zSide == 1 ? "LDx" : "SDx") + str.tostring(zTier) + "." : "small p: the " + gate_mode + " gate has not confirmed this pullback yet.")
        if rOk
            f_add_level(zRP, TFP + (zSide == 1 ? "BuR" : "BeR") + str.tostring(zTier) + "x", zSide == 1 ? c_bull_po4 : c_bear_po4, 1, line.style_dotted, zRT, futureT, 3, f_lsz(lvl_size), "R# = resumption base. It becomes T" + str.tostring(zTier + 1) + " on the next " + (zSide == 1 ? "LDx" : "SDx") + ". A block close back through it erases it.")

    // Swing protected levels (engine s)
    if sw_on
        int ns = 0
        if slP.size() > 0
            for i = slP.size() - 1 to 0
                if ns >= sw_max
                    break
                if showLiveAlways or f_take(q, f_inR(slP.get(i), rHi, rLo) or f_onMarker(slT.get(i), hiT, loT, spanMs), true)
                    f_add_level(slP.get(i), TFP + "SL s", color.new(c_bull_bc, 20), 1, line.style_dotted, slT.get(i), futureT, 2, f_lsz(sw_size), "Swing low (engine s) = protected level for longs. A structure close below it deletes it.")
                    ns += 1
        ns := 0
        if shP.size() > 0
            for i = shP.size() - 1 to 0
                if ns >= sw_max
                    break
                if showLiveAlways or f_take(q, f_inR(shP.get(i), rHi, rLo) or f_onMarker(shT.get(i), hiT, loT, spanMs), false)
                    f_add_level(shP.get(i), TFP + "SH s", color.new(c_bear_bc, 20), 1, line.style_dotted, shT.get(i), futureT, 2, f_lsz(sw_size), "Swing high (engine s) = protected level for shorts. A structure close above it deletes it.")
                    ns += 1

    // Boxes: the forming one (with BALANCE CONTROL), then the last ended ones
    if showLiveBox and eLive and not na(eBxH) and (showLiveAlways or f_take(q, f_boxInR(eBxH, eBxL, rHi, rLo) or f_onMarker(eBxT, hiT, loT, spanMs), zSide == 1))
        string roleTxt = eLiveRole == 1 ? TFP + (pCf ? (zSide == 1 ? "BeP" : "BuP") : (zSide == 1 ? "bep" : "bup")) + str.tostring(zTier) + "x" : eLiveRole == 2 ? TFP + (zSide == 1 ? "BuR" : "BeR") + str.tostring(zTier) + "x" : ""
        drawn_boxes.push(box.new(eBxT, eBxH, time, eBxL, xloc=xloc.bar_time, border_color=na, bgcolor=f_ndbCol(eLiveNdb), text=roleTxt, text_color=color.new(BOX_NEU, 10), text_size=f_lsz(zone_size), text_halign=text.align_left, text_valign=text.align_top))
        if eBxH > eBxL
            float w3  = (eBxH - eBxL) / 3.0
            float lvU = eBxL + 2 * w3
            float lvD = eBxL + w3
            int   th  = na(ctlPos) ? 1 : ctlPos < 1.0 / 3.0 ? 0 : ctlPos < 2.0 / 3.0 ? 1 : 2
            bool  strong = ctlTested and not na(ctlUp) and (th == 2 ? ctlUp >= ctlMinF : th == 0 ? 1 - ctlUp >= ctlMinF : false)
            // CONTROL LINES: green = top third starts (buyers above it) · red = bottom third ends (sellers below it)
            if ctl_thirds
                drawn_lines.push(line.new(eBxT, lvU, time, lvU, xloc=xloc.bar_time, color=color.new(ctl_buCol, th == 2 ? 0 : 60), style=line.style_solid, width=th == 2 ? (strong ? 3 : 2) : 1))
                drawn_lines.push(line.new(eBxT, lvD, time, lvD, xloc=xloc.bar_time, color=color.new(ctl_beCol, th == 0 ? 0 : 60), style=line.style_solid, width=th == 0 ? (strong ? 3 : 2) : 1))
            if ctl_on and not na(ctlUp)
                int    ci  = f_ctlIdx(ctlPos, ctlK)
                string thN = th == 2 ? "top third" : th == 1 ? "middle third" : "bottom third"
                string agN = ctlK <= 1 ? "1 candle" : ctlK <= 3 ? "2–3 candles" : ctlK <= 6 ? "4–6 candles" : "7+ candles"
                bool   buyC = ctlUp >= 0.5
                float  pr   = buyC ? ctlUp : 1 - ctlUp
                color  cc   = not ctlTested ? EL_MUTE : th == 2 ? (strong ? ctl_buCol : color.new(ctl_buCol, 35)) : th == 0 ? (strong ? ctl_beCol : color.new(ctl_beCol, 35)) : EL_LBL
                string tip  = "BALANCE CONTROL (live)\nLast structure close at " + str.tostring(math.round(ctlPos * 100)) + "% of the box (" + thN + ") · " + str.tostring(ctlK) + " candle(s) inside.\nTested odds the box breaks UP first in this cell (" + thN + ", " + agN + "): NQ 2022–25 " + str.tostring(math.round(CTL_NQ.get(ci) * 100)) + "% · MNQ 2026 " + str.tostring(math.round(CTL_MQ.get(ci) * 100)) + "% · " + f_num(CTL_N.get(ci)) + " live closes tested.\nGreen line = start of the top third: closes above it = BUYERS (66–72% up, 72–79% after 7+ candles).\nRed line = end of the bottom third: closes below it = SELLERS (62–68% down).\nBetween = no control (~50%).\nDelta (Δ) moves the odds only ±3 pts: a tie-breaker." + (ctlTested ? "" : "\nUNTESTED MODE: the odds were tested on Contraction + G1 only.")
                float  ty   = th == 2 ? lvU : th == 0 ? lvD : eBxL + 1.5 * w3
                drawn_labels.push(label.new(time, ty, f_ctlText(ctlUp, ctlK, eLiveNdb, th), xloc=xloc.bar_time, style=th == 2 ? label.style_label_lower_left : th == 0 ? label.style_label_upper_left : label.style_label_left, color=color(na), textcolor=cc, size=f_lsz(ctl_size), tooltip=tip))
            // vPOC of the live box
            if poc_on
                [lpP, lpV, lpT] = f_poc(eBxH, eBxL, poc_bins)
                if not na(lpP)
                    [pw, pr2] = f_pocW(lpV)
                    drawn_lines.push(line.new(eBxT, lpP, time, lpP, xloc=xloc.bar_time, color=poc_col, style=line.style_solid, width=pw))
                    if poc_txt != "Off"
                        drawn_labels.push(label.new(time, lpP, "vPOC " + str.tostring(lpP, format.mintick) + " · ×" + str.tostring(pr2, "0.0") + " vol", xloc=xloc.bar_time, style=label.style_label_left, color=color(na), textcolor=poc_col, size=f_lsz(poc_size), tooltip=f_pocTip(lpP, lpV, lpT, pr2, pw, true)))
    if pastBox.size() > 0 and maxBoxes > 0
        int drawnB = 0
        for i = pastBox.size() - 1 to 0
            ZBox zb = pastBox.get(i)
            bool want = zb.role > 0 ? showRoleBoxes : showIntBoxes
            bool onM  = (not na(hiT) and zb.t1 <= hiT and zb.t2 >= hiT) or (not na(loT) and zb.t1 <= loT and zb.t2 >= loT)
            if want and f_take(q, f_boxInR(zb.top, zb.bot, rHi, rLo) or onM, zb.ndb >= 0)
                drawn_boxes.push(box.new(zb.t1, zb.top, zb.t2, zb.bot, xloc=xloc.bar_time, border_color=na, bgcolor=f_ndbCol(zb.ndb)))
                if poc_on and poc_past and not na(zb.poc)
                    [pw, pr2] = f_pocW(zb.pocV)
                    drawn_lines.push(line.new(zb.t1, zb.poc, zb.t2, zb.poc, xloc=xloc.bar_time, color=color.new(poc_col, 25), style=line.style_solid, width=pw))
                    if poc_txt == "All boxes"
                        drawn_labels.push(label.new(zb.t2, zb.poc, "vPOC ×" + str.tostring(pr2, "0.0"), xloc=xloc.bar_time, style=label.style_label_left, color=color(na), textcolor=color.new(poc_col, 25), size=f_lsz(poc_size), tooltip=f_pocTip(zb.poc, zb.pocV, zb.pocV / zb.pocS, pr2, pw, false)))
                drawnB += 1
                if drawnB >= maxBoxes
                    break

    // Pullback zone (always live-range)
    if pbz_on and pzSide != 0 and not na(pzTop)
        color pc = pzSide == 1 ? c_bull_bc : c_bear_bc
        drawn_boxes.push(box.new(pzT, pzTop, futureT, pzBot, xloc=xloc.bar_time, border_color=na, bgcolor=color.new(pc, pbz_transp), text=f_pzText(), text_color=color.new(pc, 0), text_size=f_lsz(pbz_size), text_halign=text.align_right, text_valign=text.align_center))

    if show_tn_step
        bool bullSame = not na(starBull) and not na(lastBull) and starBull.seq == lastBull.seq
        bool bearSame = not na(starBear) and not na(lastBear) and starBear.seq == lastBear.seq
        if not na(starBull)
            drawn_labels.push(label.new(futureT, starBull.price, bullSame ? "🟢🟩" : "🟢", xloc=xloc.bar_time, style=label.style_label_right, color=color(na), textcolor=c_bull_po4, size=f_lsz(tn_size)))
        if not na(lastBull) and not bullSame
            drawn_labels.push(label.new(futureT, lastBull.price, "🟩", xloc=xloc.bar_time, style=label.style_label_right, color=color(na), textcolor=c_bull_po4, size=f_lsz(tn_size)))
        if not na(starBear)
            drawn_labels.push(label.new(futureT, starBear.price, bearSame ? "🔴🟥" : "🔴", xloc=xloc.bar_time, style=label.style_label_right, color=color(na), textcolor=c_bear_po4, size=f_lsz(tn_size)))
        if not na(lastBear) and not bearSame
            drawn_labels.push(label.new(futureT, lastBear.price, "🟥", xloc=xloc.bar_time, style=label.style_label_right, color=color(na), textcolor=c_bear_po4, size=f_lsz(tn_size)))

    // Candle compass tags (chart TF, last N closed candles) · only the newest one is still open, older ones are faded
    if cmp_on and cmT.size() > 0
        int nC = 0
        int lastI = cmT.size() - 1
        for i = lastI to 0
            if nC >= cmp_n
                break
            int ty = cmY.get(i)
            int sd = MM_SIDE.get(ty)
            color tc = ty <= 7 ? c_bull_bc : c_bear_bc
            string res = ""
            if i < lastI
                bool took = sd == 1 ? cmH.get(i + 1) > cmH.get(i) : cmL.get(i + 1) < cmL.get(i)
                bool brk  = sd == 1 ? cmL.get(i + 1) < cmL.get(i) : cmH.get(i + 1) > cmH.get(i)
                res := "\nRESULT: " + (took and brk ? "the next candle took both ends (order unknown)" : took ? "the next candle took it ✓" : brk ? "the next candle broke the protected end ✗" : "the next candle took neither")
            string tp = MM_NAME.get(ty) + " · lean " + (sd == 1 ? "LONG" : "SHORT") + "\nNext candle takes its " + (sd == 1 ? "high" : "low") + " before its " + (sd == 1 ? "low" : "high") + ":\n• NQ 2022–25: " + f_pct(f_od(OD_TGT, TFI_CH, ty)) + " of " + f_num(f_od(OD_N, TFI_CH, ty)) + " candles\n• MNQ 2026: " + f_pct(f_od(OD_T2, TFI_CH, ty)) + " of " + f_num(f_od(OD_N2, TFI_CH, ty)) + " candles\nProtected end broken first (NQ): " + f_pct(f_od(OD_PRT, TFI_CH, ty)) + "\n(" + TF_TEST.get(TFI_CH) + " test)" + res
            drawn_labels.push(label.new(cmT.get(i), sd == 1 ? cmL.get(i) : cmH.get(i), MM_TAG.get(ty), xloc=xloc.bar_time, style=sd == 1 ? label.style_label_up : label.style_label_down, color=color(na), textcolor=color.new(tc, i == lastI ? 0 : 55), size=f_lsz(cmp_size), tooltip=tp))
            nC += 1

    // GMC: a solid line at the GMC OPEN (the gap candle's open) and / or a tag on candle 3.
    // A GMC is deleted when it is violated (see the engine), so only live GMCs are drawn.
    if gmc_on and gmT.size() > 0
        int nG = 0
        for i = gmT.size() - 1 to 0
            if nG >= gmc_max
                break
            bool gd = gmG.get(i)
            if gmc_gold and not gd
                continue
            int    sd = gmS.get(i)
            float  go = gmO.get(i)
            color  gc = gd ? EL_GOLD : (sd == 1 ? c_bull_bc : c_bear_bc)
            string nm = "GMC" + (sd == 1 ? "▲" : "▼") + " " + gmX.get(i) + (gd ? " ★" : "")
            string tp = f_gmTip(gmI.get(i), sd, gmX.get(i), go, gd)
            if gmc_mode != "Labels"
                drawn_lines.push(line.new(gmT2.get(i), go, futureT, go, xloc=xloc.bar_time, color=color.new(gc, 10), style=line.style_solid, width=gd ? 2 : 1))
                drawn_labels.push(label.new(futureT, go, nm + " " + str.tostring(go, format.mintick) + (gmc_text == "With stats" ? " · " + f_gmShort(gmI.get(i)) : ""), xloc=xloc.bar_time, style=label.style_label_left, color=color(na), textcolor=gc, size=f_lsz(gmc_size), tooltip=tp))
            if gmc_mode != "Lines"
                drawn_labels.push(label.new(gmT.get(i), gmP.get(i), nm, xloc=xloc.bar_time, style=sd == 1 ? label.style_label_up : label.style_label_down, color=gd ? color.new(EL_GOLD, 20) : color.new(EL_BG, 30), textcolor=gd ? EL_BG : (sd == 1 ? c_bull_bc : c_bear_bc), size=f_lsz(gmc_size), tooltip=tp))
            nG += 1

    // Structural voids: inside / marker candle always, outside from the budget
    if visual_gaps.size() > 0
        for i = visual_gaps.size() - 1 to 0
            GapBox u = visual_gaps.get(i)
            f_proGapPaint(u, f_take(q, f_boxInR(u.top, u.bot, rHi, rLo) or f_onMarker(u.t, hiT, loT, spanMs), u.isBull))

    f_draw_groups()
    f_xdxpDraw()

// ═══════════════════════════════════════════════════════════════
// HTF BIAS BOX
// ═══════════════════════════════════════════════════════════════
var table biasTbl = table.new(f_htfPos(htf_tbl_pos), 2, 1, bgcolor=EL_BG, border_width=1, border_color=EL_BRD, frame_color=EL_FRM, frame_width=1)
string htfTxt = htf_src == "Off" ? "off" : (htfBias == 1 ? "BULL" : htfBias == -1 ? "BEAR" : "NONE") + " · " + htf_tf + " · " + (htf_src == "Last BC" ? (htfOrg == 2 ? "BC from a flip" : htfOrg == 1 ? "BC from a continuation" : "plain BC") : htf_src == "Last Flip (CDL / CDS)" ? "last flip" : "last continuation")
if barstate.islast
    if htf_table and htf_src != "Off" and not map_on
        string bSrc = htf_src == "Last BC" ? "Last BC" : htf_src == "Last Flip (CDL / CDS)" ? "Flip" : "Cont"
        string bEng = htf_eng == "Zone x (boxes)" ? "x" : htf_eng == "Candle c (PO4)" ? "c" : "s"
        string bDir = htfBias == 1 ? "BULL" : htfBias == -1 ? "BEAR" : "NONE"
        string bOrg = htf_src == "Last BC" ? (htfOrg == 2 ? "from a flip " + bEng : htfOrg == 1 ? "from a continuation " + bEng : "plain BC") : "engine " + bEng
        color  bCol = htfBias == 1 ? EL_POS : htfBias == -1 ? EL_NEG : EL_LBL
        f_elCell(biasTbl, 0, 0, "HTF " + htf_tf + " · " + bSrc, EL_GOLD, EL_SEC, text.align_left, f_lsz(map_sz))
        f_elCell(biasTbl, 1, 0, bDir + "  ·  " + bOrg, bCol, EL_ROW, text.align_left, f_lsz(map_sz))
    else
        table.clear(biasTbl, 0, 0, 1, 0)

// ═══════════════════════════════════════════════════════════════
// MMM MAP TABLE — the whole map in one read, the test data on top, the research facts below
// ═══════════════════════════════════════════════════════════════
int MAP_LIVE0 = 1 + (map_data ? 2 : 0)
int MAP_FACT0 = MAP_LIVE0 + 9
var table mapTbl = table.new(f_elPos(map_pos), 2, 20, bgcolor=EL_BG, frame_color=EL_FRM, frame_width=1, border_color=EL_BRD, border_width=1)
if barstate.isfirst
    table.merge_cells(mapTbl, 0, 0, 1, 0)
    if map_facts
        table.merge_cells(mapTbl, 0, MAP_FACT0, 1, MAP_FACT0)
if barstate.islast and map_on
    string z = f_lsz(map_sz)
    f_elCell(mapTbl, 0, 0, "MMM PRO U · MAP · " + f_tfName(blockTF) + " structure", EL_GOLD, EL_BG, text.align_center, z)
    // 1) what the numbers were tested on
    if map_data
        f_elCell(mapTbl, 0, 1, "DATA", EL_GOLD, EL_SEC, text.align_left, z)
        f_elCell(mapTbl, 1, 1, "NQ Dec 2022 – Dec 2025 (1m replay) · re-check MNQ Jul – Oct 2026", EL_VAL, EL_SEC, text.align_left, z)
        f_elCell(mapTbl, 0, 2, "TESTED", EL_GOLD, EL_SEC, text.align_left, z)
        f_elCell(mapTbl, 1, 2, TF_TEST.get(TFI_CH) + " candles " + f_num(TF_N1.get(TFI_CH)) + " NQ + " + f_num(TF_N2.get(TFI_CH)) + " MNQ" + (TF_EXACT ? "" : " (nearest tested TF)") + " · boxes 68,895 (214,892 closes) · A → B = NQ → MNQ", EL_VAL, EL_SEC, text.align_left, z)
    // 2) the live map
    int r0 = MAP_LIVE0
    array<string> rn = array.from("STRUCTURE", "BALANCE", "CANDLE", "PULLBACK", "GMC", "PROTECTED", "HTF BIAS", "SESSION", "NEWS")
    for r = 0 to 8
        f_elCell(mapTbl, 0, r0 + r, rn.get(r), EL_LBL, f_elRowBg(r), text.align_left, z)
    string stTxt = zSide == 1 ? "BULL · T" + str.tostring(zTier) + " x" : zSide == -1 ? "BEAR · T" + str.tostring(zTier) + " x" : "no trend yet"
    stTxt += (not na(zPP) ? " · P#" : "") + (not na(zRP) ? " · R#" : "")
    f_elCell(mapTbl, 1, r0, stTxt, zSide == 1 ? EL_POS : zSide == -1 ? EL_NEG : EL_LBL, f_elRowBg(0), text.align_left, z)
    string blTxt = "no live box (price is moving)"
    color  blCol = EL_LBL
    if not na(ctlUp)
        int ci = f_ctlIdx(ctlPos, ctlK)
        int th = ctlPos < 1.0 / 3.0 ? 0 : ctlPos < 2.0 / 3.0 ? 1 : 2
        blTxt := f_ctlText(ctlUp, ctlK, eLiveNdb, th) + " · close at " + str.tostring(math.round(ctlPos * 100)) + "% · up " + str.tostring(math.round(CTL_NQ.get(ci) * 100)) + "→" + str.tostring(math.round(CTL_MQ.get(ci) * 100)) + "% (n " + f_num(CTL_N.get(ci)) + ")"
        blCol := not ctlTested ? EL_MUTE : th == 2 ? (ctlUp >= ctlMinF ? EL_POS : EL_VAL) : th == 0 ? (1 - ctlUp >= ctlMinF ? EL_NEG : EL_VAL) : EL_LBL
    f_elCell(mapTbl, 1, r0 + 1, blTxt, blCol, f_elRowBg(1), text.align_left, z)
    string cdTxt = "—"
    color  cdCol = EL_LBL
    if cmY.size() > 0
        int ty = cmY.last()
        int sd = MM_SIDE.get(ty)
        cdTxt := MM_NAME.get(ty) + " · takes its " + (sd == 1 ? "high" : "low") + " " + f_pct(f_od(OD_TGT, TFI_CH, ty)) + "→" + f_pct(f_od(OD_T2, TFI_CH, ty)) + " (n " + f_num(f_od(OD_N, TFI_CH, ty)) + ")"
        cdCol := sd == 1 ? EL_POS : EL_NEG
    f_elCell(mapTbl, 1, r0 + 2, cdTxt, cdCol, f_elRowBg(2), text.align_left, z)
    string pzTx = pzSide != 0 ? MM_NAME.get(pzType) + (pzPlus ? " · P–MP " : " · BAL–MD ") + str.tostring(pzBot, format.mintick) + "–" + str.tostring(pzTop, format.mintick) + (pzPlus ? " · P fills " + f_pct(f_od(OD_PF, TFI_ST, pzType)) + " → target " + f_pct(f_od(OD_PW, TFI_ST, pzType)) : " · BAL fills " + f_pct(f_od(OD_BF, TFI_ST, pzType)) + " → target " + f_pct(f_od(OD_BW, TFI_ST, pzType))) : (str.length(pzEnd) > 0 ? "last zone: " + pzEnd : "none")
    f_elCell(mapTbl, 1, r0 + 3, pzTx, pzSide == 1 ? EL_POS : pzSide == -1 ? EL_NEG : EL_LBL, f_elRowBg(3), text.align_left, z)
    string gmTx = "none live" + (gmDead > 0 ? " · " + str.tostring(gmDead) + " violated → deleted" : "")
    color  gmCl = EL_LBL
    if gmT.size() > 0
        int gi = gmT.size() - 1
        int gs = gmS.get(gi)
        gmTx := (gs == 1 ? "▲ " : "▼ ") + gmX.get(gi) + (gmG.get(gi) ? " ★" : "") + " · open " + str.tostring(gmO.get(gi), format.mintick) + " · " + f_gmShort(gmI.get(gi))
        gmCl := gmG.get(gi) ? EL_GOLD : gs == 1 ? EL_POS : EL_NEG
    f_elCell(mapTbl, 1, r0 + 4, gmTx, gmCl, f_elRowBg(4), text.align_left, z)
    string prTxt = (slP.size() > 0 ? "SL s " + str.tostring(slP.last(), format.mintick) : "SL s —") + "  ·  " + (shP.size() > 0 ? "SH s " + str.tostring(shP.last(), format.mintick) : "SH s —")
    f_elCell(mapTbl, 1, r0 + 5, prTxt, EL_VAL, f_elRowBg(5), text.align_left, z)
    f_elCell(mapTbl, 1, r0 + 6, htfTxt, htfBias == 1 ? EL_POS : htfBias == -1 ? EL_NEG : EL_LBL, f_elRowBg(6), text.align_left, z)
    f_elCell(mapTbl, 1, r0 + 7, ed_sName + (ed_win ? " ✔ tested window (Asia + NY AM)" : " ✖ outside Asia / NY AM"), ed_win ? EL_POS : EL_LBL, f_elRowBg(7), text.align_left, z)
    f_elCell(mapTbl, 1, r0 + 8, newsWarn ? "⚠ " + nwWarnTxt : newsBlock ? "⚠ in the news window" : "clear", newsWarn or newsBlock ? EL_WARN : EL_LBL, f_elRowBg(8), text.align_left, z)
    // 3) research facts (same data) to decide with
    if map_facts
        f_elCell(mapTbl, 0, MAP_FACT0, "FACTS · 652,872 entry × stop × exit combos · trust themes, not one combo", EL_GOLD, EL_SEC, text.align_center, z)
        array<string> fk = array.from("2-NBC EXIT", "PRO+ STALL", "POC ENTRY", "LTF ENTRY", "60% @ 1:2")
        array<string> fv = array.from("WR +10 pts (33% → 45%) · avg RR −0.003 · a win-rate tool", "stall exit −0.009 RR · SuperTrend flip 0.000 · no gain", "no better than the P / MP / BAL ladder (±0.02 RR)", "HTF idea + LTF flip entry −0.13 to −0.24 RR · target came first 61–68%", "not reached · closest 4H GMC▲ BC−: WR 55% → 56% (ATR stop) · 55% → 61% (candle stop)")
        for i = 0 to 4
            f_elCell(mapTbl, 0, MAP_FACT0 + 1 + i, fk.get(i), EL_LBL, f_elRowBg(i), text.align_left, z)
            f_elCell(mapTbl, 1, MAP_FACT0 + 1 + i, fv.get(i), EL_VAL, f_elRowBg(i), text.align_left, z)

// ═══════════════════════════════════════════════════════════════
// ALERTS (closed candles only — no repaint)
// ═══════════════════════════════════════════════════════════════
alertcondition(ev_cdl, "CDLx Flip", "MMM PRO U · CDLx bullish flip on {{ticker}} at {{close}}")
alertcondition(ev_cds, "CDSx Flip", "MMM PRO U · CDSx bearish flip on {{ticker}} at {{close}}")
alertcondition(ev_ld, "LDx Continuation", "MMM PRO U · LDx bullish continuation on {{ticker}} at {{close}}")
alertcondition(ev_sd, "SDx Continuation", "MMM PRO U · SDx bearish continuation on {{ticker}} at {{close}}")
alertcondition(ev_ctlBuy, "Balance: BUYERS in control", "MMM PRO U · BUYERS control the live box on {{ticker}} (odds ≥ threshold)")
alertcondition(ev_ctlSell, "Balance: SELLERS in control", "MMM PRO U · SELLERS control the live box on {{ticker}} (odds ≥ threshold)")
alertcondition(ev_gmGoldL, "Gold GMC Long", "MMM PRO U · tested GMC long (★) on {{ticker}} at {{close}}")
alertcondition(ev_gmGoldS, "Gold GMC Short", "MMM PRO U · tested GMC short (★) on {{ticker}} at {{close}}")
alertcondition(newsWarn and barstate.isconfirmed, "News Warning", "MMM PRO U · news coming in 15 / 30 minutes on {{ticker}}")
