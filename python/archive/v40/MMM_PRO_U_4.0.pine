var array<int> OD_PRT = array.from(9, 29, 6, 14, 21, 28, 25, 21, 9, 29, 5, 15, 22, 28, 25, 18, 8, 29, 5, 16, 20, 28, 24, 20, 8, 26, 5, 13, 22, 28, 24, 19, 7, 29, 6, 26, 18, 28, 22, 19, 7, 28, 4, 17, 19, 26, 25, 20, 7, 31, 5, 37, 18, 25, 18, 17, 8, 28, 5, 26, 16, 25, 23, 20, 3, 31, 0, -1, 21, 21, 26, 20, 12, 29, 4, -1, 25, 20, 17, 17)
var array<int> OD_PF  = array.from(88, -1, 87, -1, 89, 91, 89, 91, 89, -1, 88, -1, 89, 90, 91, 92, 89, -1, 89, -1, 91, 96, 92, 88, 91, -1, 89, -1, 92, 92, 93, 94, 90, -1, 86, -1, 88, 92, 93, 98, 92, -1, 92, -1, 94, 89, 96, 97, 85, -1, 88, -1, 91, -1, 89, -1, 88, -1, 88, -1, 94, 86, 94, -1, 89, -1, 95, -1, 79, -1, -1, -1, 91, -1, 86, -1, 71, -1, -1, -1)
var array<int> OD_PW  = array.from(65, -1, 61, -1, 66, 64, 65, 67, 64, -1, 62, -1, 65, 67, 67, 66, 72, -1, 69, -1, 74, 74, 75, 71, 71, -1, 66, -1, 75, 75, 75, 71, 75, -1, 74, -1, 80, 76, 79, 70, 75, -1, 72, -1, 79, 82, 74, 76, 74, -1, 86, -1, 72, -1, 72, -1, 76, -1, 76, -1, 79, 42, 81, -1, 79, -1, 65, -1, 74, -1, -1, -1, 80, -1, 72, -1, 67, -1, -1, -1)
var array<int> OD_MF  = array.from(79, -1, 73, -1, 81, 88, 83, 82, 80, -1, 75, -1, 83, 87, 85, 85, 78, -1, 72, -1, 83, 90, 84, 82, 82, -1, 77, -1, 86, 88, 87, 89, 79, -1, 73, -1, 78, 90, 84, 88, 81, -1, 80, -1, 88, 86, 88, 84, 76, -1, 67, -1, 76, 93, 81, 86, 77, -1, 83, -1, 88, 87, 87, 78, 76, -1, 75, -1, 77, -1, 84, -1, 82, -1, 88, -1, 81, -1, 87, -1)
var array<int> OD_MW  = array.from(50, -1, 44, -1, 54, 55, 55, 50, 49, -1, 43, -1, 53, 55, 55, 52, 55, -1, 49, -1, 59, 60, 61, 53, 54, -1, 46, -1, 61, 59, 61, 53, 58, -1, 51, -1, 63, 60, 64, 63, 56, -1, 49, -1, 63, 63, 62, 53, 58, -1, 66, -1, 57, 50, 60, 66, 52, -1, 67, -1, 63, 40, 53, 69, 62, -1, 48, -1, 76, -1, 74, -1, 49, -1, 32, -1, 62, -1, 62, -1)
var array<int> OD_BF  = array.from(48, 76, 39, 65, 66, 79, 71, 69, 50, 77, 42, 66, 70, 77, 73, 70, 48, 78, 37, 64, 67, 81, 72, 70, 51, 79, 42, 71, 72, 79, 75, 74, 46, 79, 43, 78, 64, 83, 71, 74, 51, 77, 45, 68, 71, 79, 76, 75, 45, 79, 41, 75, 67, 84, 67, 76, 50, 74, 53, 76, 70, 71, 76, 72, 43, 83, 43, -1, 64, 79, 70, 75, 56, 89, 48, -1, 73, 87, 80, 75)
var array<int> OD_BW  = array.from(25, 27, 16, 21, 31, 34, 35, 24, 23, 27, 17, 20, 31, 33, 34, 25, 26, 31, 17, 20, 35, 36, 36, 28, 25, 31, 15, 19, 36, 36, 36, 28, 27, 33, 25, 45, 34, 33, 37, 36, 27, 31, 22, 23, 35, 38, 39, 31, 34, 37, 36, 28, 38, 31, 36, 47, 28, 33, 42, 37, 41, 28, 26, 38, 37, 42, 8, -1, 33, 47, 35, 20, 15, 29, 0, -1, 34, 46, 43, 28)
var array<string> TF_TEST = array.from("5m", "15m", "1h", "4H", "D")
// how many candles of each type were tested (NQ Dec 2022 – Dec 2025, -1 = under 20)
