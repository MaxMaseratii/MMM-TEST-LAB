var array<int> TF_N2  = array.from(5478, 6935, 1698, 367, 0)
// Balance control: live odds the box breaks UP first, by close third (bottom / middle / top) × candles inside (1 / 2–3 / 4–6 / 7+)
// every close inside a live Contraction G1 box · NQ 2022–25 (5m 15m 1h, 60,743 boxes) and MNQ Jul–Oct 2026 (5m 10m 15m, 8,152 boxes)
var array<float> CTL_NQ = array.from(0.387, 0.379, 0.362, 0.323, 0.524, 0.527, 0.526, 0.515, 0.654, 0.670, 0.699, 0.717)
var array<float> CTL_MQ = array.from(0.362, 0.335, 0.297, 0.314, 0.506, 0.491, 0.460, 0.528, 0.622, 0.650, 0.674, 0.784)
